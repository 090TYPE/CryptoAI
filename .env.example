# Copy to .env (which is gitignored) and fill in. docker-compose reads it automatically.

# Custodial master key — AES-256, base64 of 32 bytes.
# Generate:  openssl rand -base64 32
CRYPTOAI_KEK_B64=

# Admin token guarding the /api/keys endpoints.
ADMIN_TOKEN=

# Optional overrides (safe defaults if omitted)
DB_PASSWORD=postgres
WITHDRAWAL_DELAY_MINUTES=30

# CryptoAI server contour. Copy to .env (gitignored) and fill in; compose reads it automatically.
#
#   cp .env.example .env
#   docker compose up -d --build api worker
#
# Only the two REQUIRED values have no default - compose refuses to start without them. Everything
# else is commented out and annotated with the default the code actually uses, so an empty .env
# still produces a working server.

# ── Required ─────────────────────────────────────────────────────────────────
# Custodial master key - AES-256, base64 of 32 bytes.  Generate: openssl rand -base64 32
CRYPTOAI_KEK_B64=
# Guards /api/keys. That endpoint fails CLOSED when this is unset, so leaving it blank does not
# expose the admin surface - it disables it.
ADMIN_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=postgres

# ── Licensing ────────────────────────────────────────────────────────────────
# RSA public key verifying client licence tokens. Falls back to the key embedded in the app, which
# is fine in dev and wrong in production - set it explicitly there.
# LICENSE_PUBLIC_KEY_PEM=
# Requests per minute per licence (per IP when unauthenticated).
# RATE_LIMIT_PER_MIN=120

# ── AI ───────────────────────────────────────────────────────────────────────
# Server-held vendor keys. WITHOUT ONE every AI panel in every client correctly reports
# "AI is not set up on the server yet" - the product runs, but half of it is empty.
# These can also be set from the admin console into provider_keys, which takes effect on the next
# collector run with no redeploy.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Spend controls on the AI proxy. The request body used to be forwarded verbatim, which let a client
# choose the model, the output length and the context size while the server paid for all three.
# The allowlist MUST contain every model shipped clients actually send or this gate becomes an
# outage - current clients send claude-sonnet-4-6 and gpt-4o.
# AI_ALLOWED_ANTHROPIC_MODELS=claude-sonnet-4-6,claude-haiku-4-5-20251001,claude-3-5-haiku-20241022,claude-sonnet-5
# AI_ALLOWED_OPENAI_MODELS=gpt-4o-mini,gpt-4o
# Clamping is silent, so keep this above the largest legitimate request (AiSignalDeskProvider: 2000).
# AI_MAX_TOKENS_CAP=2048
# AI_MAX_REQUEST_BYTES=131072
# Must clear a full agent transcript: the runners append two messages per iteration, up to 24.
# AI_MAX_MESSAGES=64
# Per-licence daily token budget, charged from the vendor's own reported usage.
# AI_DAILY_TOKENS_PER_LICENSE=200000
#
# Models for the server's own jobs.
# AI_ASK_MODEL=claude-haiku-4-5-20251001
# AI_SCORE_MODEL=claude-3-5-haiku-20241022
# AI_DIGEST_MODEL=
# AI_ANOMALY_MODEL=
#
# Cost bounds for the background AI jobs.
# AI_SCORE_BATCH=5
# AI_SCORE_MAX_AGE_HOURS=24
# AI_ANOMALY_BATCH=
# AI_ANOMALY_COOLDOWN_HOURS=
# AI_ANOMALY_MIN_MOVE_PCT=
# AI_REVIEW_BATCH=
# AI_REVIEW_DAYS=

# ── Candle collection ────────────────────────────────────────────────────────
# Tokens claimed per tick, and how often a tick runs. Mind the ceiling this implies:
# POLL_BATCH / POLL_TICK_SECONDS * 60 requests per minute at full cadence. GeckoTerminal's free
# tier is roughly 30/min, so past a few dozen hot tokens you need provider keys or a slower
# cadence - otherwise the free source starts answering 429 and candles stop.
# POLL_BATCH=50
# POLL_TICK_SECONDS=5
# POLL_CANDLE_LIMIT=60
# Tokens missing a pool address, resolved per run via DexScreener (free, no key).
# POOL_RESOLVE_BATCH=20
#
# Demand-driven backoff: a token read recently keeps full cadence, one nobody has opened in an hour
# drops back. Tokens with an active price alert are exempt, and a just-added token counts as hot.
# POLL_HOT_WINDOW_S=300
# POLL_WARM_WINDOW_S=3600
# POLL_WARM_INTERVAL_S=300
# POLL_COLD_INTERVAL_S=900

# ── Shared-response cache ────────────────────────────────────────────────────
# Seconds. Each is matched to how often the collector behind that endpoint actually writes:
# caching longer serves stale data, caching shorter just burns database reads.
# CACHE_TTL_CANDLES=20
# CACHE_TTL_TOKEN=20
# CACHE_TTL_NEWS=60
# CACHE_TTL_SENTIMENT=120
# CACHE_TTL_GAS=30
# CACHE_TTL_ONCHAIN=300
# CACHE_TTL_WHALES=60
# CACHE_TTL_LIQUIDATIONS=60
# CACHE_TTL_DIGESTS=120
# Largest watchlist served in one composite request.
# WATCHLIST_MAX_TOKENS=200

# ── Custodial (dormant: trading and bots run on the user's machine) ───────────
# WITHDRAWAL_DELAY_MINUTES=30
# MANUAL_MAX_NOTIONAL_USD=5000

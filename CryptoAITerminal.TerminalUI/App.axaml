<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CryptoAITerminal.TerminalUI.Converters"
             x:Class="CryptoAITerminal.TerminalUI.App"
             RequestedThemeVariant="Dark">
	<Application.Resources>
		<conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
		<conv:StarRatioConverter x:Key="StarRatioConverter"/>

		<!-- Portfolio desk: per-row dynamic accent colours (hex/argb/rgba strings → Brush). -->
		<conv:StringToBrushConverter x:Key="StringToBrush"/>
		<!-- Portfolio desk: 0–100 percent → star GridLength for proportional fill bars. -->
		<conv:PercentToStarConverter x:Key="PercentToStar"/>

		<!-- Markets board: active pill / sort / segment / timeframe highlighting.
		     Bound value = selected key; ConverterParameter = this element's key. -->
		<conv:KeyMatchBrushConverter x:Key="PillActiveText"
		                             ActiveBrush="#21E6C1" InactiveBrush="#3D5A72" />
		<conv:KeyMatchBrushConverter x:Key="SegActiveText"
		                             ActiveBrush="#21E6C1" InactiveBrush="#5A7A94" />
		<conv:KeyMatchBrushConverter x:Key="SegActiveBg"
		                             ActiveBrush="#0E2A2A" InactiveBrush="Transparent" />
		<conv:KeyMatchBrushConverter x:Key="TfActiveText"
		                             ActiveBrush="#21E6C1" InactiveBrush="#8FA3B8" />
		<conv:KeyMatchBrushConverter x:Key="TfActiveBg"
		                             ActiveBrush="#0E2A2A" InactiveBrush="#0A1422" />
		<conv:KeyMatchBrushConverter x:Key="TfActiveBorder"
		                             ActiveBrush="#21E6C1" InactiveBrush="#152233" />

		<!-- Reference typefaces (bundled from Assets/Fonts) -->
		<FontFamily x:Key="FontDisplay">avares://CryptoAITerminal.TerminalUI/Assets/Fonts/SpaceGrotesk.ttf#Space Grotesk</FontFamily>
		<FontFamily x:Key="FontMono">avares://CryptoAITerminal.TerminalUI/Assets/Fonts/DMMono-Regular.ttf#DM Mono</FontFamily>

		<!-- Fluent берёт акцент из системной темы Windows (по умолчанию синий).
		     Тумблерами здесь включают живое исполнение — цвет не должен зависеть
		     от настроек ОС. Application.Resources проверяются раньше Styles,
		     поэтому эти значения перекрывают тему. -->
		<Color x:Key="SystemAccentColor">#21E6C1</Color>
		<Color x:Key="SystemAccentColorDark1">#1BC7A8</Color>
		<Color x:Key="SystemAccentColorDark2">#149B85</Color>
		<Color x:Key="SystemAccentColorDark3">#0E7263</Color>
		<Color x:Key="SystemAccentColorLight1">#4CEDD0</Color>
		<Color x:Key="SystemAccentColorLight2">#7FF3DE</Color>
		<Color x:Key="SystemAccentColorLight3">#B2F8EB</Color>
	</Application.Resources>
	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="/Styles/AppStyles.axaml" />
	</Application.Styles>
</Application>

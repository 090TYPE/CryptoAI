<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- ============================================================
         ПАЛИТРА — выровнена под референс-дизайн дашборда
         bg #060D14 · карточка #07101A · бордер #152233 · 14px
    ============================================================ -->
    <!-- Цвета фона -->
    <SolidColorBrush x:Key="AppBg" Color="#060D14" />
    <SolidColorBrush x:Key="AppBg2" Color="#07101A" />
    <!-- Уровни поверхностей -->
    <SolidColorBrush x:Key="Surface0" Color="#060D14" />
    <SolidColorBrush x:Key="Surface1" Color="#07101A" />
    <SolidColorBrush x:Key="Surface2" Color="#0A1422" />
    <SolidColorBrush x:Key="Surface3" Color="#0D1828" />
    <!-- Вложенные панели (внутри карточек) -->
    <SolidColorBrush x:Key="SurfaceInner" Color="#060D14" />
    <SolidColorBrush x:Key="SurfaceInner2" Color="#0A131E" />
    <!-- Бордеры -->
    <SolidColorBrush x:Key="PanelStroke" Color="#152233" />
    <SolidColorBrush x:Key="PanelStrokeBright" Color="#22384F" />
    <SolidColorBrush x:Key="PanelStrokeSubtle" Color="#111C28" />
    <!-- Текст.
         Значения TextSoft и TextDim подняты до контраста WCAG AA на фоне #07101A: были #5A7A94
         (4,2:1) и #3D5A72 (2,6:1), а самый частый размер текста в приложении — 9–11px, где 4,5:1
         это минимум, а не пожелание. Прежний #2d4a5e давал 2,1:1 и стоял на 378 подписях, включая
         данные, а не только заголовки колонок. Для рамок и разделителей тёмные оттенки остались
         как были — там контраст текста ни при чём. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E8F4FF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#D0E4F4" />
    <SolidColorBrush x:Key="TextMuted" Color="#8FA3B8" />
    <SolidColorBrush x:Key="TextSoft" Color="#7C97AF" />
    <SolidColorBrush x:Key="TextDim" Color="#6A85A0" />
    <!-- Fluent paints ToggleSwitch, Slider and selection highlights with the Windows accent colour,
         which is whatever the user picked in personalisation — by default blue. The switches here
         arm real money (Auto-Execute, Auto-Reinvest, auto mode), so they must read as this app's
         accent, not as a system default that changes per machine. -->
    <Color x:Key="SystemAccentColor">#21E6C1</Color>
    <Color x:Key="SystemAccentColorDark1">#1BC7A8</Color>
    <Color x:Key="SystemAccentColorDark2">#149E86</Color>
    <Color x:Key="SystemAccentColorLight1">#4FF1D4</Color>
    <Color x:Key="SystemAccentColorLight2">#7FF6E1</Color>

    <!-- Акценты -->
    <SolidColorBrush x:Key="Accent" Color="#21E6C1" />
    <SolidColorBrush x:Key="AccentSoft" Color="#0E2A2A" />
    <SolidColorBrush x:Key="AccentBlue" Color="#5BC0FF" />
    <SolidColorBrush x:Key="AccentPurple" Color="#A78BFA" />
    <!-- Статус -->
    <SolidColorBrush x:Key="Positive" Color="#3DDC84" />
    <SolidColorBrush x:Key="Negative" Color="#FF6B6B" />
    <SolidColorBrush x:Key="Warning" Color="#F4B860" />

    <!-- Устаревшие алиасы (обратная совместимость) -->
    <SolidColorBrush x:Key="PanelBg" Color="#07101A" />
    <SolidColorBrush x:Key="PanelBgAlt" Color="#060D14" />

    <!-- ============================================================
         ТИПОГРАФИЧЕСКАЯ ШКАЛА
         Восемь ступеней вместо двух десятков разрозненных значений (включая дробные
         9.5/10.5/11.5/12.5, которые на 100% масштабе дают разную субпиксельную высоту строки
         у соседних колонок одной таблицы). Нижние ступени намеренно плотные: это торговый
         терминал, основная масса подписей живёт на 10–12px, и поднимать её до «читаемых» 13
         значит потерять по строке в каждой панели.
    ============================================================ -->
    <x:Double x:Key="FsMicro">10</x:Double>
    <x:Double x:Key="FsCaption">11</x:Double>
    <x:Double x:Key="FsSmall">12</x:Double>
    <x:Double x:Key="FsBody">13</x:Double>
    <x:Double x:Key="FsSubhead">15</x:Double>
    <x:Double x:Key="FsTitle">18</x:Double>
    <x:Double x:Key="FsH2">22</x:Double>
    <x:Double x:Key="FsH1">28</x:Double>
  </Styles.Resources>

  <!-- ============================================================
       WINDOW
  ============================================================ -->
  <Style Selector="Window">
    <Setter Property="Background" Value="#060D14" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Inter, Arial" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- ============================================================
       ПАНЕЛИ
  ============================================================ -->

  <!-- Панель дашборда — плоская карточка в стиле референса. -->
  <Style Selector="Border.Panel">
    <Setter Property="Background" Value="#07101A" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderBrush" Value="#152233" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.HeroPanel">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#11242C" Offset="0" />
        <GradientStop Color="#171E30" Offset="0.55" />
        <GradientStop Color="#111824" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="BorderBrush" Value="#2F4C58" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="22" />
    <Setter Property="BoxShadow">
      <BoxShadows>0 24 54 0 #44050A14</BoxShadows>
    </Setter>
  </Style>

  <Style Selector="Border.SoftPanel">
    <Setter Property="Background" Value="#07101A" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderBrush" Value="#152233" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.SectionPanel">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#101924" Offset="0" />
        <GradientStop Color="#0C141D" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="BorderBrush" Value="#294052" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow">
      <BoxShadows>0 18 42 0 #22040A12</BoxShadows>
    </Setter>
  </Style>

  <Style Selector="Border.SurfaceCard">
    <Setter Property="Background" Value="#07101A" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderBrush" Value="#152233" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <!-- Сайдбар: плоская панель во всю высоту, только правая граница -->
  <Style Selector="Border.SidebarShell">
    <Setter Property="Background" Value="#050C14" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="#0D1B27" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Топбар: плоская панель, только нижняя граница -->
  <Style Selector="Border.TopBarShell">
    <Setter Property="Background" Value="#050C14" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="#0D1B27" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- Групповой заголовок в сайдбаре (TRADING, PORTFOLIO, …) -->
  <Style Selector="TextBlock.SideNavGroup">
    <Setter Property="FontSize" Value="{DynamicResource FsMicro}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="#4E7A96" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Тикер-элемент в топбаре -->
  <Style Selector="Border.TickerItem">
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- Пульсирующая точка статуса (CONNECTED / AI ON / сессия) -->
  <Style Selector="Ellipse.PulseDot">
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">   <Setter Property="Opacity" Value="1.0" /></KeyFrame>
        <KeyFrame Cue="50%">  <Setter Property="Opacity" Value="0.3" /></KeyFrame>
        <KeyFrame Cue="100%"> <Setter Property="Opacity" Value="1.0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ============================================================
       ТИПОГРАФИКА
  ============================================================ -->
  <Style Selector="TextBlock.H1">
    <Setter Property="FontSize" Value="{DynamicResource FsH1}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.H2">
    <Setter Property="FontSize" Value="{DynamicResource FsTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.Overline">
    <Setter Property="FontSize" Value="{DynamicResource FsCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSoft}" />
  </Style>

  <Style Selector="TextBlock.Metric">
    <Setter Property="FontSize" Value="{DynamicResource FsH2}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.SecondaryCopy">
    <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <Style Selector="TextBlock.Value">
    <Setter Property="FontSize" Value="{DynamicResource FsH1}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- ============================================================
       НАВИГАЦИЯ
  ============================================================ -->
  <!-- Иконка меню: тонкая контурная (line-icon, как в примере).
       Цвет наследуется от Foreground кнопки через привязку на каждой иконке. -->
  <Style Selector="Path.NavIcon">
    <Setter Property="StrokeThickness" Value="1.9" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.SideNavButton">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#5A7A94" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
  </Style>

  <!-- Fluent applies the hover/pressed visual to PART_ContentPresenter, so a Background
       setter on the Button itself is overridden and never shows. -->
  <Style Selector="Button.SideNavButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0A1826" />
    <Setter Property="Foreground" Value="#C8DCEF" />
  </Style>

  <!-- Активный пункт меню — плоская заливка -->
  <Style Selector="Button.SideNavButton.active">
    <Setter Property="Background" Value="#0B2030" />
    <Setter Property="Foreground" Value="#D4EEFF" />
  </Style>

  <!-- ============================================================
       КНОПКИ
  ============================================================ -->
  <Style Selector="Button">
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
    <Setter Property="Background" Value="#121A24" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBright}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <!-- Fluent applies the hover/pressed visual to PART_ContentPresenter, so a Background
       setter on the Button itself is overridden and never shows. -->
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1A2840" />
    <Setter Property="BorderBrush" Value="#4A7AAA" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform">
      <ScaleTransform ScaleX="0.975" ScaleY="0.975" />
    </Setter>
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- AccentButton — стандартная акцентная кнопка для действий в панелях -->
  <Style Selector="Button.AccentButton">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#149B85" Offset="0" />
        <GradientStop Color="#21E6C1" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="#051018" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <!-- Fluent applies the hover/pressed visual to PART_ContentPresenter, so a Background
       setter on the Button itself is overridden and never shows. -->
  <Style Selector="Button.AccentButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1A2E3A" />
    <Setter Property="Foreground" Value="#3A5570" />
  </Style>

  <Style Selector="Button.BuyButton">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#18A05D" Offset="0" />
        <GradientStop Color="#31D67C" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.SellButton">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D74D5C" Offset="0" />
        <GradientStop Color="#FF776A" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.GhostButton">
    <Setter Property="Background" Value="#0F1721" />
    <Setter Property="BorderBrush" Value="#2A3A4B" />
  </Style>

  <!-- Timeframe button: active state (selected) -->
  <Style Selector="Button.GhostButton.active">
    <Setter Property="Background"   Value="#132030" />
    <Setter Property="BorderBrush"  Value="#21E6C1" />
    <Setter Property="Foreground"   Value="#21E6C1" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Плоская кнопка деск-страниц: шаблон рисует ровно то, что задано на самой кнопке
       (Background/BorderBrush/BorderThickness/CornerRadius/Padding), без серого хрома Fluent
       и без PART_ContentPresenter, на который вешаются ховер-сеттеры темы.
       Десять View держали побайтово одинаковую копию этого ControlTemplate под
       Selector="Button" — то есть переопределяли ВСЕ кнопки страницы разом. Класс делает
       область действия явной; имя FlatChrome, а не Flat, потому что Button.Flat уже занят
       локально в PortfolioView и AiSignalsView под другой смысл (кликабельная строка). -->
  <Style Selector="Button.FlatChrome">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.FlatChrome:pointerover">
    <Setter Property="Opacity" Value="0.86" />
  </Style>

  <Style Selector="Button.FlatChrome:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- ============================================================
       ФОРМ-ЭЛЕМЕНТЫ
  ============================================================ -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="#131F2E" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="#445E78" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="#152130" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <Style Selector="TextBox:pointerover">
    <Setter Property="BorderBrush" Value="#5A7A9A" />
  </Style>

  <Style Selector="TextBox.LogBox">
    <Setter Property="Background" Value="#0B1119" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
    <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="#131F2E" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="#445E78" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
  </Style>

  <Style Selector="NumericUpDown:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="#152130" />
  </Style>

  <Style Selector="NumericUpDown:pointerover">
    <Setter Property="BorderBrush" Value="#5A7A9A" />
  </Style>

  <!-- Compact spinner arrows so the number itself stays visible even in
       narrow numeric fields (default chevrons eat most of the width). -->
  <Style Selector="ButtonSpinner /template/ RepeatButton">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="#131F2E" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="#445E78" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="#101821" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="#172230" />
  </Style>

  <Style Selector="Slider.TradeSlider">
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <!-- ToggleSwitch: the "on" pill is drawn by the template, so it needs template-targeted setters
       the same way Button hover does. These switches gate live execution — Auto-Execute in the
       arbitrage scanner, Auto-Reinvest in funding arb — so "on" has to be unmistakable. -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ToggleSwitch:unchecked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="#16232F" />
  </Style>

  <!-- Slider: in Avalonia's Fluent template the track is two RepeatButtons, not a Foreground brush —
       PART_DecreaseButton is the filled portion, PART_IncreaseButton the remainder. -->
  <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="Background" Value="#16232F" />
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>

  <!-- ============================================================
       ЧЕКБОКСЫ — крупный, выровненный бокс 22px с акцентной галкой
  ============================================================ -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Background="Transparent">
          <Border Name="Box"
                  Grid.Column="0"
                  Width="22" Height="22"
                  CornerRadius="6"
                  Background="#0E151E"
                  BorderBrush="#3C566E"
                  BorderThickness="1.4"
                  VerticalAlignment="Center">
            <Path Name="Check"
                  Stretch="Uniform"
                  Width="12" Height="12"
                  Stroke="#04101A"
                  StrokeThickness="2.4"
                  StrokeJoin="Round"
                  StrokeLineCap="Round"
                  Data="M2,7 L6,11 L13,3"
                  IsVisible="False" />
          </Border>
          <ContentPresenter Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="CheckBox:pointerover /template/ Border#Box">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="CheckBox:checked /template/ Border#Box">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="CheckBox:checked /template/ Path#Check">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="CheckBox:indeterminate /template/ Border#Box">
    <Setter Property="Background" Value="#173D3D" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="CheckBox:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Wrap checkbox captions instead of letting them run off the edge. Russian labels are
       15-30% longer than the English source, so fixed-width panels were cutting them
       ("Включить защиту исполнения перед покуп…"). -->
  <Style Selector="CheckBox /template/ ContentPresenter">
    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
  </Style>

  <!-- ============================================================
       СПИСКИ
  ============================================================ -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="#111924" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#172231" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#17373B" Offset="0" />
        <GradientStop Color="#1A2540" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ============================================================
       ТАБЫ
  ============================================================ -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TabControl > TabItem">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TabControl > TabItem /template/ ContentPresenter">
    <Setter Property="Background" Value="#101822" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,8" />
  </Style>

  <Style Selector="TabControl > TabItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#182333" />
  </Style>

  <Style Selector="TabControl > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TabControl > TabItem:selected /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#11323A" Offset="0" />
        <GradientStop Color="#16293A" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TabControl.PrimaryNavTabs">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TabControl.PrimaryNavTabs > TabItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="Transparent" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="0" />
  </Style>

  <Style Selector="TabControl.PrimaryNavTabs > TabItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="0" />
  </Style>

  <Style Selector="TabControl.PrimaryNavTabs > TabItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TabControl.PrimaryNavTabs > TabItem:selected">
    <Setter Property="Foreground" Value="Transparent" />
  </Style>

  <Style Selector="TabControl.PrimaryNavTabs > TabItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TabControl.DeskTabs > TabItem">
    <Setter Property="Foreground" Value="#8FA3B8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,22,0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TabControl.DeskTabs > TabItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,6,0,10" />
  </Style>

  <Style Selector="TabControl.DeskTabs > TabItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#21E6C1" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!-- ============================================================
       МЕНЮ
  ============================================================ -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="#0C121A" />
    <Setter Property="BorderBrush" Value="#1D2733" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="MenuItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#17202B" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- ============================================================
       СКРОЛЛБАРЫ
  ============================================================ -->
  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollViewer.PageScroll">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="8" />
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="#2A3A4C" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="#3A4F65" />
  </Style>

  <!-- ============================================================
       EXPANDER
  ============================================================ -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="#111924" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="Expander:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
  </Style>

  <!-- ============================================================
       SNIPER / RISK / GUARD
  ============================================================ -->
  <Style Selector="Border.ExecutionGuardCard">
    <Setter Property="Background" Value="{DynamicResource Surface1}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderBrush" Value="#203140" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.GuardStripCard">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E1823" Offset="0" />
        <GradientStop Color="#101A27" Offset="0.58" />
        <GradientStop Color="#0A121B" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BorderBrush" Value="#274052" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="BoxShadow">
      <BoxShadows>0 16 40 0 #26040A12</BoxShadows>
    </Setter>
  </Style>

  <Style Selector="Border.GuardChip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BorderBrush" Value="#234050" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Background" Value="#10202A" />
  </Style>

  <!-- ============================================================
       СПЛЭШ-ЭКРАН
  ============================================================ -->
  <Style Selector="Border.SplashOverlay">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#050B11" Offset="0" />
        <GradientStop Color="#09131C" Offset="0.45" />
        <GradientStop Color="#050A10" Offset="1" />
      </LinearGradientBrush>
    </Setter>
  </Style>

  <Style Selector="Ellipse.SplashAuraPrimary">
    <Setter Property="Fill" Value="#2239D8C8" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Effect">
      <BlurEffect Radius="140" />
    </Setter>
  </Style>

  <Style Selector="Ellipse.SplashAuraSecondary">
    <Setter Property="Fill" Value="#1B57A8FF" />
    <Setter Property="Opacity" Value="0.38" />
    <Setter Property="Effect">
      <BlurEffect Radius="110" />
    </Setter>
  </Style>

  <Style Selector="Ellipse.SplashAuraTertiary">
    <Setter Property="Fill" Value="#1EDD8E58" />
    <Setter Property="Opacity" Value="0.34" />
    <Setter Property="Effect">
      <BlurEffect Radius="96" />
    </Setter>
  </Style>

  <Style Selector="Border.SplashLogoShell">
    <Setter Property="Width" Value="220" />
    <Setter Property="Height" Value="220" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Ellipse.SplashLogoHalo">
    <Setter Property="Fill" Value="#2421E6C1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Effect">
      <BlurEffect Radius="48" />
    </Setter>
  </Style>

  <Style Selector="Border.SplashLogoCore">
    <Setter Property="Width" Value="164" />
    <Setter Property="Height" Value="164" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="82" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#102635" Offset="0" />
        <GradientStop Color="#0A141E" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#2E5968" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BoxShadow">
      <BoxShadows>0 0 40 0 #221FE6C1, 0 26 62 0 #42030A11</BoxShadows>
    </Setter>
  </Style>

  <Style Selector="TextBlock.SplashTitle">
    <Setter Property="FontSize" Value="{DynamicResource FsH1}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="2.2" />
    <Setter Property="Foreground" Value="#F6FBFF" />
  </Style>

  <Style Selector="TextBlock.SplashSubtitle">
    <Setter Property="FontSize" Value="{DynamicResource FsSubhead}" />
    <Setter Property="Foreground" Value="#9AB0C3" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.SplashProgressTrack">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="#12202D" />
    <Setter Property="BorderBrush" Value="#223447" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.SplashProgressFill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#159A84" Offset="0" />
        <GradientStop Color="#21E6C1" Offset="0.55" />
        <GradientStop Color="#74D8FF" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BoxShadow">
      <BoxShadows>0 0 18 0 #441FE6C1</BoxShadows>
    </Setter>
  </Style>

  <Style Selector="TextBlock.SplashStatus">
    <Setter Property="Foreground" Value="#C2D6E6" />
    <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
  </Style>

  <Style Selector="Border.SplashMetricChip">
    <Setter Property="Background" Value="#0D1721" />
    <Setter Property="BorderBrush" Value="#223242" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,7" />
  </Style>

  <!-- ============================================================
       ВИДЖЕТЫ ДАШБОРДА — общие стили в стиле референс-дизайна
       (плоские тёмные карточки, моноширинные числа, бейджи)
  ============================================================ -->

  <!-- Заголовок виджета: мелкий, верхний регистр, приглушённый -->
  <Style Selector="TextBlock.WidgetTitle">
    <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="#8FA3B8" />
  </Style>

  <!-- Микро-подпись (метка над числом) -->
  <Style Selector="TextBlock.StatLabel">
    <Setter Property="FontSize" Value="{DynamicResource FsMicro}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="#5A7A94" />
  </Style>

  <!-- Моноширинное число (цены, объёмы) -->
  <Style Selector="TextBlock.Mono">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Плоская стат-ячейка (внутри виджета) -->
  <Style Selector="Border.StatCell">
    <Setter Property="Background" Value="#060D14" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderBrush" Value="#111C28" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- Бейдж-счётчик (напр. «8 coins») справа в шапке -->
  <Style Selector="Border.CountBadge">
    <Setter Property="Background" Value="#0A1422" />
    <Setter Property="BorderBrush" Value="#152233" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <!-- Бейдж LIVE -->
  <Style Selector="Border.LivePill">
    <Setter Property="Background" Value="#0E2A2A" />
    <Setter Property="BorderBrush" Value="#21E6C1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <!-- Кнопка таймфрейма графика (компактная) -->
  <Style Selector="Button.TfButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="{DynamicResource FsCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="#0A1422" />
    <Setter Property="BorderBrush" Value="#152233" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#8FA3B8" />
  </Style>
  <Style Selector="Button.TfButton.active">
    <Setter Property="Background" Value="#0E2A2A" />
    <Setter Property="BorderBrush" Value="#21E6C1" />
    <Setter Property="Foreground" Value="#21E6C1" />
  </Style>

  <!-- Маленькая «таблеточная» кнопка действия в виджете (Trade/Watch) -->
  <Style Selector="Button.MiniPill">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="{DynamicResource FsMicro}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="#0A1422" />
    <Setter Property="BorderBrush" Value="#22384F" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

</Styles>

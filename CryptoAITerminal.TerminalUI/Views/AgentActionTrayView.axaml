<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.AgentActionTrayView"
             x:DataType="vm:AgentActionTrayViewModel"
             x:CompileBindings="True">
  <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="8" IsVisible="{Binding HasPending}">
    <StackPanel Spacing="6">
      <TextBlock Text="AGENT WANTS TO:" Foreground="{DynamicResource Warning}" FontWeight="Bold" FontSize="{DynamicResource FsCaption}" />
      <ItemsControl ItemsSource="{Binding Pending}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AgentActionProposalViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
              <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="✓" Foreground="{DynamicResource Positive}" Margin="4,0"
                      ToolTip.Tip="Approve action" AutomationProperties.Name="Approve agent action"
                      Command="{Binding $parent[ItemsControl].((vm:AgentActionTrayViewModel)DataContext).ApproveCommand}" CommandParameter="{Binding}" />
              <Button Grid.Column="2" Content="✕" Foreground="{DynamicResource Negative}"
                      ToolTip.Tip="Reject action" AutomationProperties.Name="Reject agent action"
                      Command="{Binding $parent[ItemsControl].((vm:AgentActionTrayViewModel)DataContext).RejectCommand}" CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.AiSignalsView"
             x:DataType="vm:AiSignalDeskViewModel"
             x:CompileBindings="True"
             FontFamily="{StaticResource FontDisplay}"
             FontSize="{DynamicResource FsBody}"
             Foreground="{DynamicResource TextSecondary}">

  <UserControl.Styles>
    <!-- Flat, chrome-less buttons used across the desk -->
    <Style Selector="Button.Flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.Flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.Pill">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource FsMicro}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.Pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface3}" />
    </Style>
    <Style Selector="Button.Tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource FsMicro}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.Tab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <!-- The whole desk runs on AiSignalDeskVM, but x:DataType cannot sit on the node that switches
       DataContext: it would also retype that node's own DataContext binding, which has to resolve
       against MainWindowViewModel. Hence the root declares the shell type (it carries no other
       binding) and the desk type is declared here, on its single child. -->
  <Grid RowDefinitions="54,*" Background="{DynamicResource Surface0}"
        x:DataType="vm:AiSignalDeskViewModel">

    <!-- ════════ HEADER ════════ -->
    <Border Grid.Row="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="14,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Title -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0" Padding="0,0,16,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="/" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSubhead}" FontWeight="Light" VerticalAlignment="Center" />
            <TextBlock Text="AI Signal" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Regime -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0" Padding="14,0">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="REGIME" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Background="{Binding RegimeBadgeBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding RegimeBadgeBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="5" Padding="8,2">
              <TextBlock Text="{Binding RegimeLabel}" Foreground="{Binding RegimeBadgeColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
            </Border>
          </StackPanel>
        </Border>

        <!-- Accuracy -->
        <Border Grid.Column="2" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0" Padding="14,0">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="SIGNAL ACCURACY" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="73%" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}" />
              <TextBlock Text="7d: 68% · 30d: 71%" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Signals today -->
        <Border Grid.Column="3" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0" Padding="14,0">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="SIGNALS TODAY" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
            <TextBlock Text="{Binding SignalCount}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}" />
          </StackPanel>
        </Border>

        <!-- Ticker tape -->
        <Border Grid.Column="4" ClipToBounds="True" Padding="14,0">
          <ItemsControl ItemsSource="{Binding Ticker}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="28" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AiSignalTickerViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Sym}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <TextBlock Text="{Binding Price}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsSmall}" FontFamily="{StaticResource FontMono}" />
                  <TextBlock Text="{Binding Chg}" Foreground="{Binding ChgColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Right cluster -->
        <Border Grid.Column="5" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1,0,0,0" Padding="14,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="analysing…" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold"
                       VerticalAlignment="Center" IsVisible="{Binding IsGenerating}" />
            <Button Classes="Pill" Content="↻ REFRESH" Padding="8,4" Foreground="{DynamicResource TextSoft}"
                    Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsGenerating}" />
            <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4">
              <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
            </Border>
            <!-- 180, not 300: this sits in an Auto-width column, so a wider error line steals that
                 much space from the '*' ticker strip beside it. Full text stays in the tooltip. -->
            <TextBlock Text="{Binding AiError}" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold"
                       VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding HasAiError}" ToolTip.Tip="{Binding AiError}" />
            <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="10" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Positive}" />
                <TextBlock Text="LIVE" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <!-- The hardcoded "AI ON" lamp was removed: it was lit unconditionally, so the header
                 read "offline · heuristic" and "Daily AI limit reached" next to a green AI ON. The
                 SourceLabel border above already states the real state. -->

          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ════════ CONTENT ════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="258,*,270" ColumnSpacing="8" Margin="8">

      <!-- ──────── LEFT: SIGNAL FEED ──────── -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="7">

        <!-- Feed header + filters -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Padding="10,8">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="SIGNAL FEED" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" />
                <TextBlock Text="LIVE" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Filters}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AiSignalFilterViewModel">
                  <Button Classes="Pill"
                          Margin="1,0"
                          Content="{Binding Label}"
                          Background="{Binding Background, Converter={StaticResource StringToBrush}}"
                          BorderBrush="{Binding BorderBrush, Converter={StaticResource StringToBrush}}"
                          Foreground="{Binding Foreground, Converter={StaticResource StringToBrush}}"
                          HorizontalAlignment="Stretch"
                          Command="{Binding Command}"
                          CommandParameter="{Binding Key}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Signal cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding FeedItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AiSignalCardViewModel">
                <Button Classes="Flat" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                        Command="{Binding Command}" CommandParameter="{Binding}">
                  <Border Background="{Binding CardBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding CardBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1"
                          CornerRadius="10" Padding="10,8">
                    <StackPanel Spacing="7">
                      <!-- symbol + badge -->
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Border Width="26" Height="26" CornerRadius="7" Background="{Binding LogoBg, Converter={StaticResource StringToBrush}}"
                                  BorderBrush="#1a2d3e" BorderThickness="1">
                            <TextBlock Text="{Binding Logo}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Sym}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" />
                            <TextBlock Text="{Binding TfExch}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                          </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding DirBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding DirBorder, Converter={StaticResource StringToBrush}}"
                                BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DirLabel}" Foreground="{Binding DirColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                        </Border>
                      </Grid>
                      <!-- confidence bar -->
                      <Grid Height="2" Background="{DynamicResource Surface2}">
                        <Grid.ColumnDefinitions>
                          <!-- ColumnDefinition is not a StyledElement and so carries no DataContext of
                               its own; a compiled binding on it has nothing to resolve against. Only
                               these two bindings drop to reflection — the bar fill below stays compiled. -->
                          <ColumnDefinition Width="{ReflectionBinding ConfW, Converter={StaticResource StarRatioConverter}}" />
                          <ColumnDefinition Width="{ReflectionBinding ConfW, Converter={StaticResource StarRatioConverter}, ConverterParameter=rest}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding DirColor, Converter={StaticResource StringToBrush}}" Opacity="0.8" />
                      </Grid>
                      <!-- reason -->
                      <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap"
                                 MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="14" />
                      <!-- footer -->
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ConfPct}" Foreground="{Binding DirColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}"
                                   FontFamily="{StaticResource FontMono}" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}"
                                   FontFamily="{StaticResource FontMono}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- DEX Trending -->
        <Border Grid.Row="2" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Padding="10,8">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="DEX TRENDING" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
              <Border Grid.Column="1" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                <TextBlock Text="AI RANKED" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding DexTokens}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AiSignalDexTokenViewModel">
                  <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,4">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="22" Height="22" CornerRadius="5" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1">
                          <TextBlock Text="{Binding Logo}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Sym}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                          <TextBlock Text="{Binding ChainScore}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Signal}" Foreground="{Binding SigColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Change}" Foreground="{DynamicResource Positive}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ──────── CENTER: INTELLIGENCE HUB ──────── -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">

        <!-- Row 1: Regime + News -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="7">

          <!-- Market Regime -->
          <Border Grid.Column="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Padding="12,10">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="MARKET REGIME" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                <Border Grid.Column="1" Background="#1421E6C1" BorderBrush="#3321E6C1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                  <TextBlock Text="NEW" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                </Border>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Background="{Binding RegimeBadgeBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding RegimeBadgeBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="7" Padding="12,4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding RegimeLabel}" Foreground="{Binding RegimeBadgeColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding RegimeSummary}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding RegimeMeta}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- News Digest -->
          <Border Grid.Column="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Padding="12,10">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="NEWS DIGEST" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                <Border Grid.Column="1" Background="{Binding NewsBadgeBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding NewsBadgeBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="5" Padding="8,2">
                  <TextBlock Text="{Binding NewsBias}" Foreground="{Binding NewsBadgeColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding NewsSummary}"
                         Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" LineHeight="15" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              <ItemsControl ItemsSource="{Binding NewsBullets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AiSignalNewsBulletViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="4" Height="4" Fill="{Binding DotColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <!-- AI Opportunities -->
        <Border Grid.Row="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" MaxHeight="200" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="AI OPPORTUNITIES" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="updated 47s ago" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Opportunities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AiSignalOpportunityViewModel">
                    <Border BorderBrush="{DynamicResource Surface1}" BorderThickness="0,0,0,1" Padding="12,6">
                      <Grid ColumnDefinitions="90,Auto,64,*">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Sym}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Exch}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding BiasBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BiasBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1"
                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                          <TextBlock Text="{Binding Bias}" Foreground="{Binding BiasColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,8,0">
                          <TextBlock Text="{Binding Score}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold"
                                     FontFamily="{StaticResource FontMono}" MinWidth="22" />
                          <Grid Height="3" Width="30" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                              <!-- Reflection: ColumnDefinition has no DataContext for a compiled binding. -->
                              <ColumnDefinition Width="{ReflectionBinding Bar, Converter={StaticResource StarRatioConverter}}" />
                              <ColumnDefinition Width="{ReflectionBinding Bar, Converter={StaticResource StarRatioConverter}, ConverterParameter=rest}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding BiasColor, Converter={StaticResource StringToBrush}}" Opacity="0.85" CornerRadius="2" />
                          </Grid>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Reason}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" LineHeight="13"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Market Insights row -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Insights}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AiSignalInsightViewModel">
              <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Padding="10,8" Margin="0,0,6,0">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{Binding SigBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding SigBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="{Binding Sig}" Foreground="{Binding SigColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" LineHeight="13" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Multi-TF Signal Heatmap -->
        <Border Grid.Row="3" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Padding="12,10" MinHeight="200">
          <Grid RowDefinitions="Auto,*" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <TextBlock Text="MULTI-TIMEFRAME SIGNAL HEATMAP" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Border Width="8" Height="8" CornerRadius="2" Background="#8C3DDC84" />
                  <TextBlock Text="LONG" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Border Width="8" Height="8" CornerRadius="2" Background="#8CFF6B6B" />
                  <TextBlock Text="SHORT" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Border Width="8" Height="8" CornerRadius="2" Background="#59F4B860" />
                  <TextBlock Text="HOLD" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" />
                </StackPanel>
                <Border Background="#1421E6C1" BorderBrush="#3321E6C1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                  <TextBlock Text="NEW" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                </Border>
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="3">
              <!-- header row: blank corner + timeframes -->
              <Grid ColumnDefinitions="42,*">
                <ItemsControl Grid.Column="1" ItemsSource="{Binding HeatmapTimeframes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <!-- data rows -->
              <ItemsControl ItemsSource="{Binding HeatmapRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AiSignalHeatmapRowViewModel">
                    <Grid ColumnDefinitions="42,*" Margin="0,0,0,2">
                      <TextBlock Text="{Binding Symbol}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AiSignalHeatmapCellViewModel">
                            <Border Height="26" CornerRadius="4" Margin="1,0" Background="{Binding Background, Converter={StaticResource StringToBrush}}"
                                    BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}" BorderThickness="1">
                              <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ──────── RIGHT: SIGNAL DETAIL ──────── -->
      <Border Grid.Column="2" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">

          <!-- Selected signal header -->
          <Border Grid.Row="0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,12">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="34" Height="34" CornerRadius="9" Background="{Binding SelLogoBg, Converter={StaticResource StringToBrush}}" BorderBrush="#1a2d3e" BorderThickness="1">
                    <TextBlock Text="{Binding SelLogo}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding SelSym}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" />
                      <TextBlock Text="/USDT" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}">
                      <Run Text="{Binding SelTf}" /><Run Text=" · " /><Run Text="{Binding SelExch}" />
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{Binding SelDirBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding SelDirBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelDirLabel}" Foreground="{Binding SelDirColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSmall}" FontWeight="ExtraBold" />
                </Border>
              </Grid>

              <!-- Confidence display -->
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelConf}" Foreground="{Binding SelDirColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsH1}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}" />
                    <TextBlock Text="%" Foreground="{Binding SelDirColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsH1}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}" />
                  </StackPanel>
                  <TextBlock Text="CONFIDENCE" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                  <Grid Height="5" Background="{DynamicResource Surface2}">
                    <Grid.ColumnDefinitions>
                      <!-- Reflection: ColumnDefinition has no DataContext for a compiled binding. -->
                      <ColumnDefinition Width="{ReflectionBinding SelConfW, Converter={StaticResource StarRatioConverter}}" />
                      <ColumnDefinition Width="{ReflectionBinding SelConfW, Converter={StaticResource StarRatioConverter}, ConverterParameter=rest}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding SelDirColor, Converter={StaticResource StringToBrush}}" Opacity="0.85" CornerRadius="3" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding SelPrice}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" FontFamily="{StaticResource FontMono}" />
                    <TextBlock Text="{Binding SelChange}" Foreground="{Binding SelChangeColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Detail tabs -->
          <Border Grid.Row="1" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="8,0">
            <ItemsControl ItemsSource="{Binding DetailTabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AiSignalDetailTabViewModel">
                  <Button Classes="Tab" Content="{Binding Label}" Foreground="{Binding Foreground, Converter={StaticResource StringToBrush}}"
                          BorderBrush="{Binding BorderColor, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Stretch"
                          Command="{Binding Command}" CommandParameter="{Binding Key}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Tab content -->
          <Grid Grid.Row="2">

            <!-- SIGNAL TAB -->
            <ScrollViewer IsVisible="{Binding IsSignalTab}" Padding="12,12" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding SelReason}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" LineHeight="17" TextWrapping="Wrap" />
                <Border Height="1" Background="{DynamicResource Surface2}" />
                <StackPanel Spacing="7">
                  <TextBlock Text="SIGNAL METADATA" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Generated" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                    <TextBlock Grid.Column="1" Text="{Binding SelTime}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Timeframe" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                    <TextBlock Grid.Column="1" Text="{Binding SelTf}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Exchange" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                    <TextBlock Grid.Column="1" Text="{Binding SelExch}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Model" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                    <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                  </Grid>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Surface2}" />

                <!-- Multi-TF consensus -->
                <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="MULTI-TF CONSENSUS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="NEW" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding ConsensusCount}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsH2}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="timeframes agree" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
                        <TextBlock Text="{Binding ConsensusLabel}" Foreground="{Binding SelDirColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" />
                      </StackPanel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ConsensusBars}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AiSignalConsensusBarViewModel">
                          <Border Height="4" CornerRadius="2" Margin="1,0" Background="{Binding Color, Converter={StaticResource StringToBrush}}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Quick execute -->
                <Button Content="{Binding SelDirLabelExecute}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding SelDirBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding SelDirBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1"
                        Foreground="{Binding SelDirColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsBody}" FontWeight="ExtraBold" CornerRadius="8" Padding="0,10" />
              </StackPanel>
            </ScrollViewer>

            <!-- TP/SL TAB -->
            <ScrollViewer IsVisible="{Binding IsTpSlTab}" Padding="12,12" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Border Grid.Column="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PositiveTintStroke}" BorderThickness="1" CornerRadius="9" Padding="10,10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="TAKE PROFIT" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      <TextBlock Text="{Binding TpslTp}" Foreground="{DynamicResource Positive}" FontSize="{DynamicResource FsTitle}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}" />
                      <TextBlock Text="{Binding TpslTpPrice}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{DynamicResource Surface0}" BorderBrush="#2a0c10" BorderThickness="1" CornerRadius="9" Padding="10,10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="STOP LOSS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      <TextBlock Text="{Binding TpslSl}" Foreground="{DynamicResource Negative}" FontSize="{DynamicResource FsTitle}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}" />
                      <TextBlock Text="{Binding TpslSlPrice}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Border Grid.Column="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="R : R Ratio" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding TpslRr}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}" />
                    </Grid>
                  </Border>
                  <Border Grid.Column="1" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Trailing" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="ENABLED" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </Grid>
                  </Border>
                </Grid>
                <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="AI RATIONALE" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    <TextBlock Text="{Binding TpslRationale}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" LineHeight="16" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Height="1" Background="{DynamicResource Surface2}" />
                <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="DYNAMIC ADJUSTMENT" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="24h ATR" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                      <TextBlock Grid.Column="1" Text="{Binding TpslAtr}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Volatility tier" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                      <TextBlock Grid.Column="1" Text="MEDIUM" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Suggested size" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                      <TextBlock Grid.Column="1" Text="{Binding TpslSize}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- PAIRS / STAT ARB TAB -->
            <ScrollViewer IsVisible="{Binding IsStatArbTab}" Padding="12,12" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                  <StackPanel Spacing="0">
                    <TextBlock Text="TOP PAIR — BTC / ETH" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,0,0,8" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="BTC" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" />
                        <TextBlock Text=" / " Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
                        <TextBlock Text="ETH" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#8C1D4A2E" BorderBrush="#1a4a2e" BorderThickness="1" CornerRadius="5" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="LONG A / SHORT B" Foreground="{DynamicResource Positive}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      </Border>
                    </Grid>
                    <StackPanel Spacing="6" Margin="0,0,0,10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Correlation" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                        <TextBlock Grid.Column="1" Text="0.92" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Z-Score" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                        <TextBlock Grid.Column="1" Text="−2.31" Foreground="{DynamicResource AccentBlue}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" FontFamily="{StaticResource FontMono}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Half-life" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                        <TextBlock Grid.Column="1" Text="8 bars" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Score" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                        <TextBlock Grid.Column="1" Text="78 / 100" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                      </Grid>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource Surface2}" Margin="0,0,0,8" />
                    <TextBlock Text="Z-score stretched to −2.31; pairs historically mean-revert within 8 bars at this level. BTC cheap relative to ETH — long BTC, short ETH."
                               Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" LineHeight="14" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                  <StackPanel Spacing="0">
                    <TextBlock Text="PAIR 2 — SOL / BNB" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,0,0,8" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SOL" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" />
                        <TextBlock Text=" / " Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                        <TextBlock Text="BNB" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#734A3810" BorderBrush="{DynamicResource WarningTintStroke}" BorderThickness="1" CornerRadius="5" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="WAIT" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      </Border>
                    </Grid>
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Correlation" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                        <TextBlock Grid.Column="1" Text="0.78" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Z-Score" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                        <TextBlock Grid.Column="1" Text="−0.84" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Score" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                        <TextBlock Grid.Column="1" Text="41 / 100" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- COACH TAB -->
            <ScrollViewer IsVisible="{Binding IsJournalTab}" Padding="12,12" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="PERFORMANCE SUMMARY" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    <TextBlock Text="{Binding JournalSummary}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" LineHeight="17" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <StackPanel Spacing="7">
                  <TextBlock Text="STRENGTHS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <ItemsControl ItemsSource="{Binding JournalStrengths}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                          <Ellipse Width="4" Height="4" Fill="{DynamicResource Positive}" VerticalAlignment="Top" Margin="0,4,0,0" />
                          <TextBlock Text="{Binding}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" LineHeight="14" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Spacing="7">
                  <TextBlock Text="LEAKS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <ItemsControl ItemsSource="{Binding JournalLeaks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                          <Ellipse Width="4" Height="4" Fill="{DynamicResource Negative}" VerticalAlignment="Top" Margin="0,4,0,0" />
                          <TextBlock Text="{Binding}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" LineHeight="14" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Spacing="7">
                  <TextBlock Text="SUGGESTIONS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <ItemsControl ItemsSource="{Binding JournalSuggestions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                          <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,4,0,0" />
                          <TextBlock Text="{Binding}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" LineHeight="14" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Surface2}" />
                <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="AI ALERT BUILDER" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                      <TextBlock Text="ping me if BTC breaks 70k..." Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" />
                    </Border>
                    <Button Content="Set Alert via AI →" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#1421E6C1" BorderBrush="{DynamicResource AccentTintStroke}" BorderThickness="1" Foreground="{DynamicResource Accent}"
                            FontSize="{DynamicResource FsMicro}" FontWeight="Bold" CornerRadius="6" Padding="0,6" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- ASK AI TAB -->
            <Grid IsVisible="{Binding IsAskTab}" RowDefinitions="*,Auto,Auto" Margin="12,12">

              <!-- Chat history -->
              <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ChatMessages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AiSignalChatMessageViewModel">
                      <Grid Margin="0,0,0,8">
                        <!-- AI message -->
                        <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding IsAi}" HorizontalAlignment="Left">
                          <Border Width="22" Height="22" CornerRadius="6" Background="#1F21E6C1" BorderBrush="#4021E6C1" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock Text="AI" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8,8,8,2" Padding="10,8" MaxWidth="200">
                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" LineHeight="15" TextWrapping="Wrap" />
                          </Border>
                        </StackPanel>
                        <!-- User message -->
                        <Border IsVisible="{Binding IsUser}" HorizontalAlignment="Right" Background="#1721E6C1" BorderBrush="#3321E6C1"
                                BorderThickness="1" CornerRadius="8,8,2,8" Padding="10,6" MaxWidth="200">
                          <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" LineHeight="14" TextWrapping="Wrap" />
                        </Border>
                        <!-- Typing indicator -->
                        <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding IsTyping}" HorizontalAlignment="Left">
                          <Border Width="22" Height="22" CornerRadius="6" Background="#1F21E6C1" BorderBrush="#4021E6C1" BorderThickness="1">
                            <TextBlock Text="AI" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8,8,8,2" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" />
                              <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Opacity="0.6" />
                              <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Opacity="0.3" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Quick suggestions -->
              <StackPanel Grid.Row="1" IsVisible="{Binding ShowSuggestions}" Margin="0,10,0,8" Spacing="5">
                <TextBlock Text="QUICK QUESTIONS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding Suggestions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AiSignalSuggestionViewModel">
                      <Button Content="{Binding Label}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" Foreground="{DynamicResource TextDim}"
                              FontSize="{DynamicResource FsMicro}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4"
                              Command="{Binding Command}" CommandParameter="{Binding CommandParameter}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Input row -->
              <Border Grid.Row="2" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="10,4,4,4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding ChatInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{Binding ChatPlaceholder}"
                           Background="Transparent" BorderThickness="0" Padding="0" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                      <!-- KeyBinding is not a StyledElement either: same reason as ColumnDefinition,
                           this one binding stays on reflection so Enter keeps sending. -->
                      <KeyBinding Gesture="Enter" Command="{ReflectionBinding SendChatCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="1" Width="28" Height="28" CornerRadius="6" Padding="0"
                          Background="{Binding ChatSendBg, Converter={StaticResource StringToBrush}}" Foreground="{Binding ChatSendFg, Converter={StaticResource StringToBrush}}" BorderThickness="0"
                          Content="↑" FontSize="{DynamicResource FsSubhead}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          ToolTip.Tip="Send" AutomationProperties.Name="Send chat message"
                          Command="{Binding SendChatCommand}" />
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

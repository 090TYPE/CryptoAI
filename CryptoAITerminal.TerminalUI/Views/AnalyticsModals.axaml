<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CryptoAITerminal.TerminalUI.Views.AnalyticsModals"
             x:CompileBindings="False"
             FontFamily="{StaticResource FontDisplay}">
  <Panel>
    <Grid IsVisible="{Binding ModalPanel}" Background="#8C020610" ZIndex="92">
      <Button Classes="FlatChrome" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Width="430" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1,0,0,0" BoxShadow="-20 0 60 0 #99000000">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="14,14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding PanelTitle}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PanelSub}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
              </StackPanel>
              <Button Classes="FlatChrome" Grid.Column="1" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" Content="✕" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSubhead}" VerticalAlignment="Top" ToolTip.Tip="Close" AutomationProperties.Name="Close panel" />
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface0}" Padding="14,12">
            <Button Classes="FlatChrome" Command="{Binding CloseModalCommand}" Height="29" HorizontalAlignment="Stretch" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Content="CLOSE" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding PanelRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Margin="0,12,0,0" Padding="10" CornerRadius="8" Background="#061615" BorderBrush="#14302e" BorderThickness="1">
                <TextBlock Text="{Binding PanelNote}" FontSize="{DynamicResource FsCaption}" LineHeight="17" Foreground="#a9c2d8" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Border IsVisible="{Binding HasToast}" ZIndex="99" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
            Padding="14,8" CornerRadius="8" Background="{DynamicResource Surface1}" BorderThickness="1" BoxShadow="0 16 40 0 #99000000" BorderBrush="{Binding ToastBorder, Converter={StaticResource StringToBrush}}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding ToastIcon}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding ToastColor, Converter={StaticResource StringToBrush}}" />
        <TextBlock Text="{Binding ToastMsg}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding ToastMeta}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
      </StackPanel>
    </Border>
  </Panel>
</UserControl>

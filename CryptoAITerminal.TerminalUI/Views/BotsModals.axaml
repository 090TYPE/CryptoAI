<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CryptoAITerminal.TerminalUI.Converters"
             x:Class="CryptoAITerminal.TerminalUI.Views.BotsModals"
             x:CompileBindings="False"
             FontFamily="{StaticResource FontDisplay}"
             IsHitTestVisible="True">

  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand" /><Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="0" /><Setter Property="CaretBrush" Value="#21e6c1" /><Setter Property="Foreground" Value="#d0e4f4" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="0" /><Setter Property="Foreground" Value="#d0e4f4" /><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Slider"><Setter Property="Foreground" Value="#21e6c1" /><Setter Property="MinHeight" Value="0" /></Style>
  </UserControl.Styles>

  <Panel>

    <!-- ═══════════ COLUMNS MODAL ═══════════ -->
    <Grid IsVisible="{Binding ModalColumns}" Background="#B3020610" ZIndex="90">
      <Button Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Background="#07101a" BorderBrush="#152233" BorderThickness="1" ClipToBounds="True" BoxShadow="0 30 80 0 #B3000000">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="15,13">
            <TextBlock Text="Columns &amp; row actions" FontSize="13" FontWeight="SemiBold" Foreground="#e8f4ff" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" Content="✕" Foreground="{DynamicResource TextDim}" FontSize="15" ToolTip.Tip="Close" AutomationProperties.Name="Close panel" />
          </Grid>
          <Border BorderBrush="#0d1b27" BorderThickness="0,1,0,0" Padding="15,14">
            <StackPanel>
              <TextBlock Text="VISIBLE METRICS" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" Margin="0,0,0,9" />
              <ItemsControl ItemsSource="{Binding ColumnToggles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding Command}" Margin="0,0,5,5" Padding="8,7" CornerRadius="6" BorderThickness="1" HorizontalContentAlignment="Left"
                            Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3" BorderThickness="1" Background="{Binding BoxBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BoxBorder, Converter={StaticResource StringToBrush}}">
                          <TextBlock Text="{Binding Mark}" Foreground="#04101a" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="INLINE ACTIONS · UP TO 4 PER ROW" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" Margin="0,16,0,9" />
              <ItemsControl ItemsSource="{Binding ActionToggles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding Command}" Margin="0,0,5,5" Padding="8,7" CornerRadius="6" BorderThickness="1" HorizontalContentAlignment="Left"
                            Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Width="16" Text="{Binding Icon}" TextAlignment="Center" Foreground="{Binding IcColor, Converter={StaticResource StringToBrush}}" />
                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border BorderBrush="#0d1b27" BorderThickness="0,1,0,0" Background="#060d14" Padding="15,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Command="{Binding ResetLayoutCommand}" Background="Transparent" BorderThickness="0" Content="RESET TO DEFAULT" Foreground="{DynamicResource TextDim}" FontSize="10" FontWeight="Bold" />
              <Button Grid.Column="2" Command="{Binding CloseModalCommand}" Height="28" Padding="14,0" CornerRadius="6" Background="#0e2a2a" BorderBrush="#21e6c1" BorderThickness="1" Content="DONE" Foreground="#21e6c1" FontSize="10" FontWeight="Bold" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ═══════════ WIZARD MODAL ═══════════ -->
    <Grid IsVisible="{Binding ModalWizard}" Background="#B3020610" ZIndex="90">
      <Button Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Width="900" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Background="#07101a" BorderBrush="#152233" BorderThickness="1" ClipToBounds="True" BoxShadow="0 30 80 0 #B3000000">
        <DockPanel LastChildFill="True">
          <!-- header -->
          <Border DockPanel.Dock="Top" BorderBrush="#0d1b27" BorderThickness="0,0,0,1" Padding="16,13">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="13">
              <TextBlock Text="New bot" FontSize="13" FontWeight="SemiBold" Foreground="#e8f4ff" VerticalAlignment="Center" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding WizardSteps}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding Command}" Height="23" Padding="10,0" CornerRadius="11" BorderThickness="1"
                            Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding N}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                        <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Grid.Column="3" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" Content="✕" Foreground="{DynamicResource TextDim}" FontSize="15" ToolTip.Tip="Close" AutomationProperties.Name="Close panel" />
            </Grid>
          </Border>
          <!-- footer -->
          <Border DockPanel.Dock="Bottom" BorderBrush="#0d1b27" BorderThickness="0,1,0,0" Background="#060d14" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9">
              <Button Command="{Binding WizBackCommand}" Height="29" Padding="12,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="{Binding WizBackLabel}" Foreground="#8fa3b8" FontSize="10" FontWeight="Bold" />
              <TextBlock Grid.Column="2" Text="{Binding WizHint}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,9,0" />
              <Button Grid.Column="3" Command="{Binding WizNextCommand}" Height="29" Padding="15,0" CornerRadius="6" Background="#0e2a2a" BorderBrush="#21e6c1" BorderThickness="1" Content="{Binding WizNextLabel}" Foreground="#21e6c1" FontSize="10" FontWeight="Bold" />
            </Grid>
          </Border>
          <!-- body -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,15">
            <Panel>
              <!-- step 1 -->
              <ItemsControl IsVisible="{Binding WizStep1}" ItemsSource="{Binding Templates}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding Pick}" Margin="4" Padding="12" CornerRadius="10" BorderThickness="1" HorizontalContentAlignment="Stretch"
                            Background="{Binding PickBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding PickBorder, Converter={StaticResource StringToBrush}}">
                      <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                          <Border CornerRadius="4" Padding="6,0" Height="17" BorderThickness="1" HorizontalAlignment="Left"
                                  Background="{Binding BadgeBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BadgeBorder, Converter={StaticResource StringToBrush}}">
                            <TextBlock Text="{Binding Type}" Foreground="{Binding Accent, Converter={StaticResource StringToBrush}}" FontFamily="{StaticResource FontMono}" FontSize="9" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Risk}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="#e8f4ff" />
                        <TextBlock Text="{Binding Desc}" FontSize="10.5" LineHeight="16" Foreground="#4a6a82" TextWrapping="Wrap" />
                        <Border BorderBrush="#0a1520" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,2,0,0">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Backtest}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{DynamicResource TextDim}" />
                            <TextBlock Grid.Column="1" Text="{Binding Apr}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#3ddc84" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- step 2 -->
              <Grid IsVisible="{Binding WizStep2}" ColumnDefinitions="1.2*,14,1*">
                <StackPanel Grid.Column="0" Spacing="12">
                  <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,10,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                      <TextBlock Text="BOT NAME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBox Text="{Binding WizName, Mode=TwoWay}" Height="30" Padding="9,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontSize="11.5" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                      <TextBlock Text="VENUE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <ComboBox ItemsSource="{Binding WizVenues}" SelectedItem="{Binding WizVenue, Mode=TwoWay}" Height="30" Padding="7,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                      <TextBlock Text="MARKET" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <ComboBox ItemsSource="{Binding WizMarkets}" SelectedItem="{Binding WizMarket, Mode=TwoWay}" Height="30" Padding="7,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                      <TextBlock Text="BUDGET USDT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBox Text="{Binding WizCapital, Mode=TwoWay}" Height="30" Padding="9,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11.5" />
                    </StackPanel>
                  </Grid>
                  <Border Padding="12" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#060d14">
                    <StackPanel>
                      <TextBlock Text="{Binding WizParamsTitle}" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" Margin="0,0,0,11" />
                      <ItemsControl ItemsSource="{Binding WizParams}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,0,0,13" Spacing="6">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#8fa3b8" />
                                <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#21e6c1" />
                              </Grid>
                              <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="10">
                  <Border Padding="12" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#060d14">
                    <StackPanel>
                      <TextBlock Text="PROJECTED · 90D WALK-FORWARD" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" Margin="0,0,0,10" />
                      <ItemsControl ItemsSource="{Binding WizProjection}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Spacing="3" Margin="0,0,0,11">
                              <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource TextDim}" />
                              <TextBlock Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="14" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Command="{Binding WizBacktestCommand}" Margin="0,2,0,0" Height="27" HorizontalAlignment="Stretch" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="RUN WALK-FORWARD + MONTE-CARLO" Foreground="#8fa3b8" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                  </Border>
                  <Border Padding="12" BorderBrush="#14302e" BorderThickness="1" CornerRadius="10" Background="#061615">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,8" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="#21e6c1" />
                        <TextBlock Text="AI REVIEW OF THIS CONFIG" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                      </StackPanel>
                      <TextBlock Text="{Binding WizAiNote}" Foreground="#a9c2d8" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" />
                      <Button Command="{Binding WizAiTuneCommand}" Margin="0,11,0,0" Height="26" Padding="10,0" HorizontalAlignment="Left" CornerRadius="5" Background="#0e2a2a" BorderBrush="#21e6c1" BorderThickness="1" Content="LET AI TUNE PARAMETERS" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- step 3 -->
              <Grid IsVisible="{Binding WizStep3}" ColumnDefinitions="*,14,*">
                <StackPanel Grid.Column="0" Spacing="10">
                  <Border Padding="12" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#060d14">
                    <StackPanel>
                      <TextBlock Text="EXECUTION MODE" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" Margin="0,0,0,10" />
                      <ItemsControl ItemsSource="{Binding WizModes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Command="{Binding Command}" Margin="0,0,8,0" Padding="11" CornerRadius="8" BorderThickness="1" HorizontalContentAlignment="Left"
                                    Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}">
                              <StackPanel Spacing="5">
                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                                <TextBlock Text="{Binding Hint}" FontSize="10.5" LineHeight="15" Foreground="#4a6a82" TextWrapping="Wrap" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border IsVisible="{Binding WizLiveWarning}" Margin="0,10,0,0" Padding="10,9" CornerRadius="7" Background="#150f04" BorderBrush="#3a2a12" BorderThickness="1">
                        <TextBlock Text="LIVE needs paper-only OFF, a RiskManager pre-trade pass and typed consent — LiveGate blocks the first order otherwise." FontSize="11" LineHeight="16" Foreground="#f4b860" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Padding="12" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#060d14">
                    <StackPanel>
                      <TextBlock Text="GUARDS" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" Margin="0,0,0,8" />
                      <ItemsControl ItemsSource="{Binding WizGuards}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Command="{Binding Command}" Background="Transparent" BorderThickness="0" Padding="8,7" CornerRadius="6" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                  <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#d0e4f4" />
                                  <TextBlock Text="{Binding Hint}" FontSize="9" Foreground="{DynamicResource TextDim}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="28" Height="15" CornerRadius="8" VerticalAlignment="Center" Background="{Binding TrackBg, Converter={StaticResource StringToBrush}}">
                                  <Canvas><Border Width="11" Height="11" CornerRadius="6" Canvas.Top="2" Canvas.Left="{Binding KnobLeft}" Background="{Binding Knob, Converter={StaticResource StringToBrush}}" /></Canvas>
                                </Border>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <Border Grid.Column="2" Padding="13" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#060d14">
                  <StackPanel>
                    <TextBlock Text="REVIEW" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" Margin="0,0,0,11" />
                    <ItemsControl ItemsSource="{Binding WizReview}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#0a1520" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextDim}" />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ═══════════ CONFIRM MODAL ═══════════ -->
    <Grid IsVisible="{Binding ModalConfirm}" Background="#BD020610" ZIndex="95">
      <Button Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Background="#07101a" BorderThickness="1" ClipToBounds="True" BoxShadow="0 30 80 0 #BF000000"
              BorderBrush="{Binding ConfirmAccent, Converter={StaticResource StringToBrush}}">
        <StackPanel>
          <StackPanel Margin="17,15">
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,10" VerticalAlignment="Center">
              <TextBlock Text="{Binding ConfirmIcon}" FontSize="14" Foreground="{Binding ConfirmIconColor, Converter={StaticResource StringToBrush}}" />
              <TextBlock Text="{Binding ConfirmTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#e8f4ff" />
            </StackPanel>
            <TextBlock Text="{Binding ConfirmBody}" FontSize="11.5" LineHeight="18" Foreground="#8fa3b8" TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding ConfirmHasChecks}" ItemsSource="{Binding ConfirmChecks}" Margin="0,12,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding Command}" Padding="9,8" CornerRadius="6" Background="#060d14" BorderBrush="#0d1b27" BorderThickness="1" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <Border Width="13" Height="13" CornerRadius="3" BorderThickness="1" Margin="0,1,0,0" VerticalAlignment="Top" Background="{Binding BoxBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BoxBorder, Converter={StaticResource StringToBrush}}">
                        <TextBlock Text="{Binding Mark}" Foreground="#04101a" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Label}" FontSize="11" LineHeight="15" Foreground="#a9c2d8" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel IsVisible="{Binding ConfirmHasType}" Margin="0,12,0,0" Spacing="6">
              <TextBlock FontSize="10" Foreground="#4a6a82">
                <Run Text="type " /><Run Text="{Binding ConfirmTypeWord}" FontFamily="{StaticResource FontMono}" Foreground="#f4b860" /><Run Text=" to confirm" />
              </TextBlock>
              <TextBox Text="{Binding ConfirmTyped, Mode=TwoWay}" PlaceholderText="{Binding ConfirmTypeWord}" Height="30" Padding="9,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11.5" />
            </StackPanel>
          </StackPanel>
          <Border BorderBrush="#0d1b27" BorderThickness="0,1,0,0" Background="#060d14" Padding="17,12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <Button Grid.Column="1" Command="{Binding CloseModalCommand}" Height="28" Padding="12,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="CANCEL" Foreground="#8fa3b8" FontSize="10" FontWeight="Bold" />
              <Button Grid.Column="2" Command="{Binding ConfirmRunCommand}" Height="28" Padding="14,0" CornerRadius="6" BorderThickness="1" FontSize="10" FontWeight="Bold"
                      Background="{Binding ConfirmBtnBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding ConfirmBtnBorder, Converter={StaticResource StringToBrush}}"
                      Content="{Binding ConfirmCta}" Foreground="{Binding ConfirmBtnFg, Converter={StaticResource StringToBrush}}" Opacity="{Binding ConfirmBtnOpacity}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ═══════════ SIDE PANEL ═══════════ -->
    <Grid IsVisible="{Binding ModalPanel}" Background="#8C020610" ZIndex="92">
      <Button Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Width="420" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#07101a" BorderBrush="#152233" BorderThickness="1,0,0,0" BoxShadow="-20 0 60 0 #99000000">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" BorderBrush="#0d1b27" BorderThickness="0,0,0,1" Padding="15,14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding PanelTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#e8f4ff" />
                <TextBlock Text="{Binding PanelSub}" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{DynamicResource TextDim}" />
              </StackPanel>
              <Button Grid.Column="1" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" Content="✕" Foreground="{DynamicResource TextDim}" FontSize="15" ToolTip.Tip="Close" AutomationProperties.Name="Close panel" />
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="#0d1b27" BorderThickness="0,1,0,0" Background="#060d14" Padding="15,12">
            <Button Command="{Binding CloseModalCommand}" Height="29" HorizontalAlignment="Stretch" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="CLOSE" Foreground="#8fa3b8" FontSize="10" FontWeight="Bold" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15,14">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding PanelRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#0a1520" BorderThickness="0,0,0,1" Padding="0,9">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#8fa3b8" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Margin="0,13,0,0" Padding="11" CornerRadius="8" Background="#061615" BorderBrush="#14302e" BorderThickness="1">
                <TextBlock Text="{Binding PanelNote}" FontSize="11" LineHeight="17" Foreground="#a9c2d8" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ═══════════ TOAST ═══════════ -->
    <Border IsVisible="{Binding HasToast}" ZIndex="99" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
            Padding="14,9" CornerRadius="8" Background="#07101a" BorderThickness="1" BoxShadow="0 16 40 0 #99000000"
            BorderBrush="{Binding ToastBorder, Converter={StaticResource StringToBrush}}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding ToastIcon}" FontSize="11" Foreground="{Binding ToastColor, Converter={StaticResource StringToBrush}}" />
        <TextBlock Text="{Binding ToastMsg}" FontSize="11.5" Foreground="#e8f4ff" />
        <TextBlock Text="{Binding ToastMeta}" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{DynamicResource TextDim}" />
      </StackPanel>
    </Border>
  </Panel>
</UserControl>

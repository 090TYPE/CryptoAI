<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CryptoAITerminal.TerminalUI.Converters"
             xmlns:bd="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels.BotsDesk"
             x:Class="CryptoAITerminal.TerminalUI.Views.BotsModals"
             x:DataType="bd:BotsDeskViewModel"
             x:CompileBindings="True"
             FontFamily="{StaticResource FontDisplay}"
             IsHitTestVisible="True">

  <UserControl.Styles>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="0" /><Setter Property="CaretBrush" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="0" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="FontSize" Value="{DynamicResource FsCaption}" /></Style>
    <Style Selector="Slider"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="MinHeight" Value="0" /></Style>
  </UserControl.Styles>

  <!-- Hosted by BotsView inside its <Grid DataContext="{Binding BotsDesk}">, so the context inherited
       here is the desk, not MainWindowViewModel — hence x:DataType="bd:BotsDeskViewModel" on the root. -->
  <Panel>

    <!-- ═══════════ COLUMNS MODAL ═══════════ -->
    <Grid IsVisible="{Binding ModalColumns}" Background="#B3020610" ZIndex="90">
      <Button Classes="FlatChrome" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" ClipToBounds="True" BoxShadow="0 30 80 0 #B3000000">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="14,12">
            <TextBlock Text="Columns &amp; row actions" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            <Button Classes="FlatChrome" Grid.Column="1" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" Content="✕" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSubhead}" ToolTip.Tip="Close" AutomationProperties.Name="Close panel" />
          </Grid>
          <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Padding="14,14">
            <StackPanel>
              <TextBlock Text="VISIBLE METRICS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding ColumnToggles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bd:ColumnToggle">
                    <Button Classes="FlatChrome" Command="{Binding Command}" Margin="0,0,4,4" Padding="8,6" CornerRadius="6" BorderThickness="1" HorizontalContentAlignment="Left"
                            Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3" BorderThickness="1" Background="{Binding BoxBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BoxBorder, Converter={StaticResource StringToBrush}}">
                          <TextBlock Text="{Binding Mark}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsMicro}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="INLINE ACTIONS · UP TO 4 PER ROW" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,16,0,8" />
              <ItemsControl ItemsSource="{Binding ActionToggles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bd:ActionToggle">
                    <Button Classes="FlatChrome" Command="{Binding Command}" Margin="0,0,4,4" Padding="8,6" CornerRadius="6" BorderThickness="1" HorizontalContentAlignment="Left"
                            Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Width="16" Text="{Binding Icon}" TextAlignment="Center" Foreground="{Binding IcColor, Converter={StaticResource StringToBrush}}" />
                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface0}" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Classes="FlatChrome" Command="{Binding ResetLayoutCommand}" Background="Transparent" BorderThickness="0" Content="RESET TO DEFAULT" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
              <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding CloseModalCommand}" Height="28" Padding="14,0" CornerRadius="6" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Content="DONE" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ═══════════ WIZARD MODAL ═══════════ -->
    <Grid IsVisible="{Binding ModalWizard}" Background="#B3020610" ZIndex="90">
      <Button Classes="FlatChrome" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Width="900" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" ClipToBounds="True" BoxShadow="0 30 80 0 #B3000000">
        <DockPanel LastChildFill="True">
          <!-- header -->
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="13">
              <TextBlock Text="New bot" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding WizardSteps}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bd:WizardStep">
                    <Button Classes="FlatChrome" Command="{Binding Command}" Height="23" Padding="10,0" CornerRadius="11" BorderThickness="1"
                            Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding N}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="FlatChrome" Grid.Column="3" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" Content="✕" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSubhead}" ToolTip.Tip="Close" AutomationProperties.Name="Close panel" />
            </Grid>
          </Border>
          <!-- footer -->
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface0}" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9">
              <Button Classes="FlatChrome" Command="{Binding WizBackCommand}" Height="29" Padding="12,0" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Content="{Binding WizBackLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
              <TextBlock Grid.Column="2" Text="{Binding WizHint}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Classes="FlatChrome" Grid.Column="3" Command="{Binding WizNextCommand}" Height="29" Padding="14,0" CornerRadius="6" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Content="{Binding WizNextLabel}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
            </Grid>
          </Border>
          <!-- body -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
            <Panel>
              <!-- step 1 -->
              <ItemsControl IsVisible="{Binding WizStep1}" ItemsSource="{Binding Templates}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bd:TemplateCard">
                    <Button Classes="FlatChrome" Command="{Binding Pick}" Margin="4" Padding="12" CornerRadius="10" BorderThickness="1" HorizontalContentAlignment="Stretch"
                            Background="{Binding PickBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding PickBorder, Converter={StaticResource StringToBrush}}">
                      <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                          <Border CornerRadius="4" Padding="6,0" Height="17" BorderThickness="1" HorizontalAlignment="Left"
                                  Background="{Binding BadgeBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BadgeBorder, Converter={StaticResource StringToBrush}}">
                            <TextBlock Text="{Binding Type}" Foreground="{Binding Accent, Converter={StaticResource StringToBrush}}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Risk}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FsSmall}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding Desc}" FontSize="{DynamicResource FsMicro}" LineHeight="16" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />
                        <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,2,0,0">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Backtest}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                            <TextBlock Grid.Column="1" Text="{Binding Apr}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource Positive}" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- step 2 -->
              <Grid IsVisible="{Binding WizStep2}" ColumnDefinitions="1.2*,14,1*">
                <StackPanel Grid.Column="0" Spacing="12">
                  <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,10,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                      <TextBlock Text="BOT NAME" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBox Text="{Binding WizName, Mode=TwoWay}" Height="30" Padding="8,0" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" FontSize="{DynamicResource FsCaption}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                      <TextBlock Text="VENUE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <ComboBox ItemsSource="{Binding WizVenues}" SelectedItem="{Binding WizVenue, Mode=TwoWay}" Height="30" Padding="6,0" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                      <TextBlock Text="MARKET" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <ComboBox ItemsSource="{Binding WizMarkets}" SelectedItem="{Binding WizMarket, Mode=TwoWay}" Height="30" Padding="6,0" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                      <TextBlock Text="BUDGET USDT" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBox Text="{Binding WizCapital, Mode=TwoWay}" Height="30" Padding="8,0" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" />
                    </StackPanel>
                  </Grid>
                  <Border Padding="12" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface0}">
                    <StackPanel>
                      <TextBlock Text="{Binding WizParamsTitle}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,0,0,10" />
                      <ItemsControl ItemsSource="{Binding WizParams}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="bd:WizParamViewModel">
                            <StackPanel Margin="0,0,0,12" Spacing="6">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource Accent}" />
                              </Grid>
                              <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="10">
                  <Border Padding="12" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface0}">
                    <StackPanel>
                      <TextBlock Text="PROJECTED · 90D WALK-FORWARD" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,0,0,10" />
                      <ItemsControl ItemsSource="{Binding WizProjection}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="bd:KvRow">
                            <StackPanel Spacing="3" Margin="0,0,0,10">
                              <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                              <TextBlock Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSubhead}" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="FlatChrome" Command="{Binding WizBacktestCommand}" Margin="0,2,0,0" Height="27" HorizontalAlignment="Stretch" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Content="RUN WALK-FORWARD + MONTE-CARLO" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </StackPanel>
                  </Border>
                  <Border Padding="12" BorderBrush="{DynamicResource AccentTintStroke}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource AccentTint}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,8" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" />
                        <TextBlock Text="AI REVIEW OF THIS CONFIG" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      </StackPanel>
                      <TextBlock Text="{Binding WizAiNote}" Foreground="{DynamicResource TextNote}" FontSize="{DynamicResource FsCaption}" LineHeight="18" TextWrapping="Wrap" />
                      <Button Classes="FlatChrome" Command="{Binding WizAiTuneCommand}" Margin="0,10,0,0" Height="26" Padding="10,0" HorizontalAlignment="Left" CornerRadius="5" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Content="LET AI TUNE PARAMETERS" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- step 3 -->
              <Grid IsVisible="{Binding WizStep3}" ColumnDefinitions="*,14,*">
                <StackPanel Grid.Column="0" Spacing="10">
                  <Border Padding="12" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface0}">
                    <StackPanel>
                      <TextBlock Text="EXECUTION MODE" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,0,0,10" />
                      <ItemsControl ItemsSource="{Binding WizModes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="bd:WizardMode">
                            <Button Classes="FlatChrome" Command="{Binding Command}" Margin="0,0,8,0" Padding="10" CornerRadius="8" BorderThickness="1" HorizontalContentAlignment="Left"
                                    Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}">
                              <StackPanel Spacing="5">
                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                                <TextBlock Text="{Binding Hint}" FontSize="{DynamicResource FsMicro}" LineHeight="15" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border IsVisible="{Binding WizLiveWarning}" Margin="0,10,0,0" Padding="10,8" CornerRadius="7" Background="{DynamicResource WarningTint}" BorderBrush="{DynamicResource WarningTintStroke}" BorderThickness="1">
                        <TextBlock Text="LIVE needs paper-only OFF, a RiskManager pre-trade pass and typed consent — LiveGate blocks the first order otherwise." FontSize="{DynamicResource FsCaption}" LineHeight="16" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Padding="12" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface0}">
                    <StackPanel>
                      <TextBlock Text="GUARDS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,0,0,8" />
                      <ItemsControl ItemsSource="{Binding WizGuards}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="bd:GuardToggle">
                            <Button Classes="FlatChrome" Command="{Binding Command}" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="6" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" />
                                  <TextBlock Text="{Binding Hint}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="28" Height="15" CornerRadius="8" VerticalAlignment="Center" Background="{Binding TrackBg, Converter={StaticResource StringToBrush}}">
                                  <Canvas><Border Width="11" Height="11" CornerRadius="6" Canvas.Top="2" Canvas.Left="{Binding KnobLeft}" Background="{Binding Knob, Converter={StaticResource StringToBrush}}" /></Canvas>
                                </Border>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <Border Grid.Column="2" Padding="12" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface0}">
                  <StackPanel>
                    <TextBlock Text="REVIEW" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding WizReview}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bd:KvRow">
                          <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextDim}" />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ═══════════ CONFIRM MODAL ═══════════ -->
    <Grid IsVisible="{Binding ModalConfirm}" Background="#BD020610" ZIndex="95">
      <Button Classes="FlatChrome" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Background="{DynamicResource Surface1}" BorderThickness="1" ClipToBounds="True" BoxShadow="0 30 80 0 #BF000000"
              BorderBrush="{Binding ConfirmAccent, Converter={StaticResource StringToBrush}}">
        <StackPanel>
          <StackPanel Margin="16,14">
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,10" VerticalAlignment="Center">
              <TextBlock Text="{Binding ConfirmIcon}" FontSize="{DynamicResource FsSubhead}" Foreground="{Binding ConfirmIconColor, Converter={StaticResource StringToBrush}}" />
              <TextBlock Text="{Binding ConfirmTitle}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>
            <TextBlock Text="{Binding ConfirmBody}" FontSize="{DynamicResource FsCaption}" LineHeight="18" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding ConfirmHasChecks}" ItemsSource="{Binding ConfirmChecks}" Margin="0,12,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="bd:ConfirmCheck">
                  <Button Classes="FlatChrome" Command="{Binding Command}" Padding="8,8" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <Border Width="13" Height="13" CornerRadius="3" BorderThickness="1" Margin="0,1,0,0" VerticalAlignment="Top" Background="{Binding BoxBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BoxBorder, Converter={StaticResource StringToBrush}}">
                        <TextBlock Text="{Binding Mark}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsMicro}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" LineHeight="15" Foreground="{DynamicResource TextNote}" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel IsVisible="{Binding ConfirmHasType}" Margin="0,12,0,0" Spacing="6">
              <TextBlock FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}">
                <Run Text="type " /><Run Text="{Binding ConfirmTypeWord}" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource Warning}" /><Run Text=" to confirm" />
              </TextBlock>
              <TextBox Text="{Binding ConfirmTyped, Mode=TwoWay}" PlaceholderText="{Binding ConfirmTypeWord}" Height="30" Padding="8,0" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" />
            </StackPanel>
          </StackPanel>
          <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface0}" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <Button Classes="FlatChrome" Grid.Column="1" Command="{Binding CloseModalCommand}" Height="28" Padding="12,0" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Content="CANCEL" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
              <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding ConfirmRunCommand}" Height="28" Padding="14,0" CornerRadius="6" BorderThickness="1" FontSize="{DynamicResource FsMicro}" FontWeight="Bold"
                      Background="{Binding ConfirmBtnBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding ConfirmBtnBorder, Converter={StaticResource StringToBrush}}"
                      Content="{Binding ConfirmCta}" Foreground="{Binding ConfirmBtnFg, Converter={StaticResource StringToBrush}}" Opacity="{Binding ConfirmBtnOpacity}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ═══════════ SIDE PANEL ═══════════ -->
    <Grid IsVisible="{Binding ModalPanel}" Background="{DynamicResource ModalScrim}" ZIndex="92">
      <Button Classes="FlatChrome" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Width="420" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1,0,0,0" BoxShadow="-20 0 60 0 #99000000">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="14,14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding PanelTitle}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding PanelSub}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
              </StackPanel>
              <Button Classes="FlatChrome" Grid.Column="1" Command="{Binding CloseModalCommand}" Background="Transparent" BorderThickness="0" Content="✕" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSubhead}" ToolTip.Tip="Close" AutomationProperties.Name="Close panel" />
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface0}" Padding="14,12">
            <Button Classes="FlatChrome" Command="{Binding CloseModalCommand}" Height="29" HorizontalAlignment="Stretch" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Content="CLOSE" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding PanelRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bd:KvRow">
                    <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Margin="0,12,0,0" Padding="10" CornerRadius="8" Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource AccentTintStroke}" BorderThickness="1">
                <TextBlock Text="{Binding PanelNote}" FontSize="{DynamicResource FsCaption}" LineHeight="17" Foreground="{DynamicResource TextNote}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ═══════════ TOAST ═══════════ -->
    <Border IsVisible="{Binding HasToast}" ZIndex="99" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
            Padding="14,8" CornerRadius="8" Background="{DynamicResource Surface1}" BorderThickness="1" BoxShadow="0 16 40 0 #99000000"
            BorderBrush="{Binding ToastBorder, Converter={StaticResource StringToBrush}}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding ToastIcon}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding ToastColor, Converter={StaticResource StringToBrush}}" />
        <TextBlock Text="{Binding ToastMsg}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding ToastMeta}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
      </StackPanel>
    </Border>
  </Panel>
</UserControl>

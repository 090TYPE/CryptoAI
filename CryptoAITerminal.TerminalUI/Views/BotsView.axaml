<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CryptoAITerminal.TerminalUI.Converters"
             xmlns:views="clr-namespace:CryptoAITerminal.TerminalUI.Views"
             x:Class="CryptoAITerminal.TerminalUI.Views.BotsView"
             x:CompileBindings="False"
             FontFamily="{StaticResource FontDisplay}">

  <UserControl.Resources>
    <conv:RatioToStarConverter x:Key="RatioStar" />
    <SolidColorBrush x:Key="DeskBg" Color="#040b12" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Flat, mock-faithful buttons: honour Background/Border/Corner/Padding only. -->
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand" /><Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Opacity" Value="0.86" />
    </Style>

    <!-- Compact inputs -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CaretBrush" Value="#21e6c1" />
      <Setter Property="SelectionBrush" Value="#14302e" />
      <Setter Property="Foreground" Value="#d0e4f4" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Compact selects -->
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="#d0e4f4" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Accent sliders -->
    <Style Selector="Slider">
      <Setter Property="Foreground" Value="#21e6c1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <!-- Gate on the section, full-viewport height so the desk reads like the mock -->
  <Border IsVisible="{Binding IsBotsSectionVisible}"
          MinHeight="760"
          Height="{Binding $parent[ScrollViewer].Bounds.Height}">
    <Grid DataContext="{Binding BotsDesk}" Background="{StaticResource DeskBg}" ClipToBounds="True">

      <!-- ═══════════════ MAIN LAYER (header · body · footer) ═══════════════ -->
      <DockPanel LastChildFill="True">

        <!-- ───────── header (54) ───────── -->
        <Border DockPanel.Dock="Top" Height="54" Background="#050c14" BorderBrush="#0d1b27" BorderThickness="0,0,0,1" Padding="14,0">
          <DockPanel LastChildFill="True">

            <!-- right-side controls -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                        Margin="14,0,0,0">
              <Border Width="1" Background="#0d1b27" Margin="0,10" />
              <Button Command="{Binding RefreshCommand}" Background="#060d14" BorderBrush="#152233" BorderThickness="1"
                      CornerRadius="5" Padding="9,5" Content="↻ REFRESH" Foreground="#5a7a94" FontSize="9" FontWeight="Bold" />
              <Button Command="{Binding TogglePaperOnlyCommand}" CornerRadius="10" Padding="11,5"
                      Background="{Binding PaperBg, Converter={StaticResource StringToBrush}}"
                      BorderBrush="{Binding PaperBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{Binding PaperColor, Converter={StaticResource StringToBrush}}" />
                  <TextBlock Text="{Binding PaperLabel}" Foreground="{Binding PaperColor, Converter={StaticResource StringToBrush}}" FontSize="10" FontWeight="Bold" />
                </StackPanel>
              </Button>
              <Button Command="{Binding KillAllCommand}" Background="#14060a" BorderBrush="#3a1620" BorderThickness="1"
                      CornerRadius="5" Padding="10,5" Content="⛔ KILL ALL" Foreground="#ff6b6b" FontSize="9" FontWeight="Bold" />
              <Button Command="{Binding NewBotCommand}" Background="#0e2a2a" BorderBrush="#21e6c1" BorderThickness="1"
                      CornerRadius="5" Padding="12,6" Content="+ NEW BOT" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
            </StackPanel>

            <!-- left-side segments -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Border Padding="0,0,16,0" BorderBrush="#0d1b27" BorderThickness="0,0,1,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="/" Foreground="#1e3048" FontSize="16" FontWeight="Light" />
                  <TextBlock Text="Bots" Foreground="#21e6c1" FontSize="13" FontWeight="Bold" />
                </StackPanel>
              </Border>
              <Border Padding="14,0" BorderBrush="#0d1b27" BorderThickness="0,0,1,0">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <TextBlock Text="ENGINES" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                  <Border CornerRadius="5" Padding="9,3" BorderThickness="1"
                          Background="{Binding EngineBadgeBg, Converter={StaticResource StringToBrush}}"
                          BorderBrush="{Binding EngineBadgeBorder, Converter={StaticResource StringToBrush}}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="{Binding EngineBadgeColor, Converter={StaticResource StringToBrush}}" />
                      <TextBlock Text="{Binding EngineBadgeLabel}" Foreground="{Binding EngineBadgeColor, Converter={StaticResource StringToBrush}}" FontSize="10" FontWeight="ExtraBold" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <Border Padding="14,0" BorderBrush="#0d1b27" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="PnL 24H · ALL BOTS" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding HdrPnl}" FontFamily="{StaticResource FontMono}" FontSize="16"
                               Foreground="{Binding HdrPnlColor, Converter={StaticResource StringToBrush}}" />
                    <TextBlock Text="{Binding HdrPnlSub}" Foreground="#3d5a72" FontSize="9" Margin="0,0,0,2" VerticalAlignment="Bottom" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Padding="14,0" BorderBrush="#0d1b27" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="BUDGET DEPLOYED" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding HdrAlloc}" FontFamily="{StaticResource FontMono}" FontSize="16" Foreground="#e8f4ff" />
                    <TextBlock Text="{Binding HdrAllocSub}" Foreground="#3d5a72" FontSize="9" Margin="0,0,0,2" VerticalAlignment="Bottom" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Button Command="{Binding OpenDailyCapCommand}" Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="#0d1b27"
                      Padding="14,0" HorizontalContentAlignment="Left">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="DAILY LOSS CAP" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HdrCapLabel}" FontFamily="{StaticResource FontMono}" FontSize="12"
                               Foreground="{Binding HdrCapColor, Converter={StaticResource StringToBrush}}" />
                    <Border Width="54" Height="3" CornerRadius="2" Background="#0a1520" ClipToBounds="True" VerticalAlignment="Center">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding HdrCapRatio, Converter={StaticResource RatioStar}}" />
                          <ColumnDefinition Width="{Binding HdrCapRatio, Converter={StaticResource RatioStar}, ConverterParameter=rest}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding HdrCapColor, Converter={StaticResource StringToBrush}}" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- ticker (fills) -->
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="14,0">
              <ItemsControl ItemsSource="{Binding Ticker}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="24" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Tag}" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                      <TextBlock Text="{Binding Text}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8fa3b8" />
                      <TextBlock Text="{Binding Val}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- ───────── footer (26) ───────── -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="#050c14" BorderBrush="#0d1b27" BorderThickness="0,1,0,0" Padding="14,0">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="{Binding FooterSync}" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#2d4a5e" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{Binding FooterEngineColor, Converter={StaticResource StringToBrush}}"
                         Text="{Binding FooterEngine, StringFormat='● executor {0}'}" />
              <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#2d4a5e" Text="{Binding FooterMode}" />
              <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#2d4a5e" Text="{Binding FooterGateways, StringFormat='gateways {0}'}" />
              <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#2d4a5e" Text="{Binding FooterWs, StringFormat='ws {0}'}" />
              <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#2d4a5e" Text="{Binding FooterOpm, StringFormat='orders/min {0}'}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- ───────── body (left column + rail) ───────── -->
        <Grid ColumnDefinitions="*,8,322" Margin="8">

          <!-- ═════════ LEFT COLUMN ═════════ -->
          <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">

            <!-- Daily AI briefing -->
            <Border Grid.Row="0" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="11" Background="#07101a" ClipToBounds="True">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Margin="13,10" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="DAILY AI BRIEFING" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                    <Border CornerRadius="4" Padding="7,2" BorderThickness="1"
                            Background="{Binding BriefSignalBg, Converter={StaticResource StringToBrush}}"
                            BorderBrush="{Binding BriefSignalBorder, Converter={StaticResource StringToBrush}}">
                      <TextBlock Text="{Binding BriefSignal}" Foreground="{Binding BriefSignalColor, Converter={StaticResource StringToBrush}}" FontSize="8" FontWeight="ExtraBold" />
                    </Border>
                    <TextBlock Text="{Binding BriefMeta}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#26405a" />
                  </StackPanel>
                  <TextBlock Text="{Binding BriefSummary}" Foreground="#a9c2d8" FontSize="11.5" LineHeight="17" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Bullets}" Margin="0,2,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,18,0">
                          <Ellipse Width="4" Height="4" Fill="#21e6c1" />
                          <TextBlock Text="{Binding}" FontSize="10" Foreground="#4a6a82" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Border Grid.Column="1" Background="#060d14" BorderBrush="#0a1520" BorderThickness="1,0,0,0" Padding="13,10">
                  <StackPanel Spacing="6" VerticalAlignment="Center">
                    <Button Command="{Binding BriefGenerateCommand}" Background="#060d14" BorderBrush="#152233" BorderThickness="1"
                            CornerRadius="5" Padding="10,5" FontSize="9" FontWeight="Bold"
                            Content="{Binding BriefBtnLabel}" Foreground="{Binding BriefBtnColor, Converter={StaticResource StringToBrush}}" />
                    <Button Command="{Binding BriefToggleAutoCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="5">
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Border Width="26" Height="14" CornerRadius="8" Background="{Binding BriefTrackBg, Converter={StaticResource StringToBrush}}">
                          <Canvas><Border Width="10" Height="10" CornerRadius="5" Canvas.Top="2" Canvas.Left="{Binding BriefKnobLeft}" Background="{Binding BriefKnob, Converter={StaticResource StringToBrush}}" /></Canvas>
                        </Border>
                        <TextBlock Text="{Binding BriefAutoLabel}" FontSize="9" Foreground="#4a6a82" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- toolbar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7">
              <Border Height="28" Padding="9,0" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="7" Background="#07101a">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="⌕" Foreground="#2d4a5e" FontSize="11" VerticalAlignment="Center" />
                  <TextBox Text="{Binding Search, Mode=TwoWay}" Watermark="filter bots, symbol, venue…" Width="168"
                           Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Padding="2" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="7" Background="#060d14">
                <ItemsControl ItemsSource="{Binding TypeChips}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding Command}" Height="22" Padding="8,0" CornerRadius="5" BorderThickness="0"
                              Background="{Binding Bg, Converter={StaticResource StringToBrush}}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" />
                          <TextBlock Text="{Binding Count}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{Binding CountColor, Converter={StaticResource StringToBrush}}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusOption, Mode=TwoWay}"
                        Height="28" Padding="7,0" CornerRadius="7" Background="#07101a" BorderBrush="#0d1b27" BorderThickness="1" FontSize="10" Foreground="#8fa3b8" />
              <ComboBox ItemsSource="{Binding VenueOptions}" SelectedItem="{Binding VenueOption, Mode=TwoWay}"
                        Height="28" Padding="7,0" CornerRadius="7" Background="#07101a" BorderBrush="#0d1b27" BorderThickness="1" FontSize="10" Foreground="#8fa3b8" MinWidth="120" />
              <Border Width="1" />
              <Button Command="{Binding OpenColumnsCommand}" Height="28" Padding="10,0" CornerRadius="7" Background="#07101a" BorderBrush="#0d1b27" BorderThickness="1"
                      Content="⚙ COLUMNS · ACTIONS" Foreground="#5a7a94" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
              <Button Command="{Binding ToggleDensityCommand}" Height="28" Padding="10,0" CornerRadius="7" Background="#07101a" BorderBrush="#0d1b27" BorderThickness="1"
                      Content="{Binding DensityLabel}" Foreground="#5a7a94" FontSize="9" FontWeight="Bold" />
            </StackPanel>

            <!-- selection bar -->
            <Border Grid.Row="2" IsVisible="{Binding HasSelection}" Padding="11,7" CornerRadius="7" Background="#07141c"
                    BorderBrush="#152233" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="2" Background="#21e6c1" />
                <TextBlock Text="{Binding SelectionLabel}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#21e6c1" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding BulkActions}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="9" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding Command}" Height="22" Padding="9,0" CornerRadius="5" Background="#060d14" BorderBrush="#152233" BorderThickness="1"
                              Content="{Binding Label}" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" FontSize="9" FontWeight="Bold" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Command="{Binding ClearSelectionCommand}" Background="Transparent" BorderThickness="0" Content="CLEAR" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
              </StackPanel>
            </Border>

            <!-- table -->
            <Border Grid.Row="3" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="11" Background="#07101a" ClipToBounds="True">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DockPanel LastChildFill="True" MinWidth="1040">

                  <!-- sticky header row -->
                  <Border DockPanel.Dock="Top" Height="30" Background="#060d14" BorderBrush="#0a1520" BorderThickness="0,0,0,1" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="24">
                        <Button Command="{Binding ToggleSelectAllCommand}" Width="12" Height="12" Padding="0" CornerRadius="3" BorderThickness="1"
                                Background="{Binding AllBoxBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding AllBoxBorder, Converter={StaticResource StringToBrush}}"
                                Content="{Binding AllBoxMark}" Foreground="#04101a" FontSize="8" HorizontalAlignment="Left" />
                      </Border>
                      <TextBlock Width="232" Text="BOT · STRATEGY" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                      <TextBlock Width="138" Text="VENUE · MARKET" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" IsVisible="{Binding ColVenue}" />
                      <TextBlock Width="64" Text="MODE" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" IsVisible="{Binding ColMode}" />
                      <TextBlock Width="94" Text="STATUS" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" IsVisible="{Binding ColStatus}" />
                      <Button Width="96" Command="{Binding SortPnl24Command}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Right"
                              Content="{Binding SortArrowPnl24}" Foreground="{Binding SortColorPnl24, Converter={StaticResource StringToBrush}}" FontSize="8" FontWeight="Bold" IsVisible="{Binding ColPnl24}" />
                      <Button Width="104" Command="{Binding SortPnlTotalCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Right"
                              Content="{Binding SortArrowPnlTotal}" Foreground="{Binding SortColorPnlTotal, Converter={StaticResource StringToBrush}}" FontSize="8" FontWeight="Bold" IsVisible="{Binding ColPnlTotal}" />
                      <TextBlock Width="84" Text="EQUITY 7D" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ColSpark}" />
                      <TextBlock Width="92" Text="FILLS · WR" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding ColTrades}" />
                      <Button Width="118" Command="{Binding SortAllocCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Right"
                              Content="{Binding SortArrowAlloc}" Foreground="{Binding SortColorAlloc, Converter={StaticResource StringToBrush}}" FontSize="8" FontWeight="Bold" IsVisible="{Binding ColAlloc}" />
                      <TextBlock Width="76" Text="MAX DD" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding ColDd}" />
                      <TextBlock Width="72" Text="UPTIME" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding ColUptime}" />
                      <TextBlock Width="140" Text="ACTIONS" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <!-- rows (vertical scroll) -->
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <ItemsControl ItemsSource="{Binding VisibleBots}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="#0a1520" BorderThickness="0,0,0,1" Background="{Binding RowBg, Converter={StaticResource StringToBrush}}">
                              <StackPanel>

                                <!-- row line (click = expand) -->
                                <Grid>
                                  <Button Command="{Binding ExpandCommand}" Background="Transparent" BorderThickness="0" Padding="10,0"
                                          Height="{Binding Desk.RowHeight}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                      <Border Width="24">
                                        <Button Command="{Binding SelectCommand}" Width="12" Height="12" Padding="0" CornerRadius="3" BorderThickness="1"
                                                Background="{Binding BoxBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BoxBorder, Converter={StaticResource StringToBrush}}"
                                                Content="{Binding BoxMark}" Foreground="#04101a" FontSize="8" HorizontalAlignment="Left" />
                                      </Border>
                                      <StackPanel Width="232" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="▶" Foreground="#1e3048" FontSize="8" Width="10" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                          <TextBlock.RenderTransform><RotateTransform Angle="{Binding Caret}" /></TextBlock.RenderTransform>
                                        </TextBlock>
                                        <Border CornerRadius="4" Padding="6,0" Height="17" BorderThickness="1" VerticalAlignment="Center"
                                                Background="{Binding TypeBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding TypeBorder, Converter={StaticResource StringToBrush}}">
                                          <TextBlock Text="{Binding TypeLabel}" Foreground="{Binding TypeFg, Converter={StaticResource StringToBrush}}" FontFamily="{StaticResource FontMono}" FontSize="9" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="#e8f4ff" TextTrimming="CharacterEllipsis" />
                                          <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="#2d4a5e" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                      </StackPanel>
                                      <StackPanel Width="138" VerticalAlignment="Center" Spacing="1" IsVisible="{Binding Desk.ColVenue}">
                                        <TextBlock Text="{Binding Venue}" FontSize="11" Foreground="#8fa3b8" />
                                        <TextBlock Text="{Binding Market}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#2d4a5e" />
                                      </StackPanel>
                                      <Border Width="64" IsVisible="{Binding Desk.ColMode}" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="6,2" BorderThickness="1" HorizontalAlignment="Left"
                                                Background="{Binding ModeBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding ModeBorder, Converter={StaticResource StringToBrush}}">
                                          <TextBlock Text="{Binding ModeLabel}" Foreground="{Binding ModeFg, Converter={StaticResource StringToBrush}}" FontSize="8" FontWeight="ExtraBold" />
                                        </Border>
                                      </Border>
                                      <StackPanel Width="94" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding Desk.ColStatus}">
                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                                      </StackPanel>
                                      <StackPanel Width="96" VerticalAlignment="Center" IsVisible="{Binding Desk.ColPnl24}">
                                        <TextBlock Text="{Binding Pnl24Pct}" FontFamily="{StaticResource FontMono}" FontSize="12" TextAlignment="Right" Foreground="{Binding Pnl24Color, Converter={StaticResource StringToBrush}}" />
                                        <TextBlock Text="{Binding Pnl24Abs}" FontFamily="{StaticResource FontMono}" FontSize="9" TextAlignment="Right" Foreground="#2d4a5e" />
                                      </StackPanel>
                                      <StackPanel Width="104" VerticalAlignment="Center" IsVisible="{Binding Desk.ColPnlTotal}">
                                        <TextBlock Text="{Binding PnlTotalAbs}" FontFamily="{StaticResource FontMono}" FontSize="12" TextAlignment="Right" Foreground="{Binding PnlTotalColor, Converter={StaticResource StringToBrush}}" />
                                        <TextBlock Text="{Binding PnlTotalPct}" FontFamily="{StaticResource FontMono}" FontSize="9" TextAlignment="Right" Foreground="#2d4a5e" />
                                      </StackPanel>
                                      <Border Width="84" IsVisible="{Binding Desk.ColSpark}" VerticalAlignment="Center">
                                        <Canvas Width="70" Height="22" HorizontalAlignment="Center">
                                          <Polyline Points="{Binding Spark}" Stroke="{Binding PnlTotalColor, Converter={StaticResource StringToBrush}}" StrokeThickness="1.3" StrokeJoin="Round" />
                                        </Canvas>
                                      </Border>
                                      <StackPanel Width="92" VerticalAlignment="Center" IsVisible="{Binding Desk.ColTrades}">
                                        <TextBlock Text="{Binding Trades}" FontFamily="{StaticResource FontMono}" FontSize="12" TextAlignment="Right" Foreground="#c8dcef" />
                                        <TextBlock Text="{Binding Winrate, StringFormat='wr {0}'}" FontFamily="{StaticResource FontMono}" FontSize="9" TextAlignment="Right" Foreground="#2d4a5e" />
                                      </StackPanel>
                                      <StackPanel Width="118" VerticalAlignment="Center" Margin="14,0,0,0" IsVisible="{Binding Desk.ColAlloc}">
                                        <Grid ColumnDefinitions="*,Auto">
                                          <TextBlock Grid.Column="0" Text="{Binding AllocUsedPct}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#2d4a5e" />
                                          <TextBlock Grid.Column="1" Text="{Binding AllocStr}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#c8dcef" />
                                        </Grid>
                                        <Border Height="3" CornerRadius="2" Background="#0a1520" Margin="0,4,0,0" ClipToBounds="True">
                                          <Grid>
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="{Binding AllocRatio, Converter={StaticResource RatioStar}}" />
                                              <ColumnDefinition Width="{Binding AllocRatio, Converter={StaticResource RatioStar}, ConverterParameter=rest}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding AllocBarColor, Converter={StaticResource StringToBrush}}" />
                                          </Grid>
                                        </Border>
                                      </StackPanel>
                                      <TextBlock Width="76" Text="{Binding Dd_}" FontFamily="{StaticResource FontMono}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{Binding DdColor, Converter={StaticResource StringToBrush}}" IsVisible="{Binding Desk.ColDd}" />
                                      <TextBlock Width="72" Text="{Binding UptimeStr}" FontFamily="{StaticResource FontMono}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="#4a6a82" IsVisible="{Binding Desk.ColUptime}" />
                                      <StackPanel Width="140" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Actions}">
                                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <Button Command="{Binding Command}" ToolTip.Tip="{Binding Title}" Width="24" Height="24" Padding="0" CornerRadius="5"
                                                      Background="#060d14" BorderBrush="#152233" BorderThickness="1"
                                                      Content="{Binding Icon}" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" FontSize="10" />
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Command="{Binding MenuCommand}" ToolTip.Tip="More" Width="24" Height="24" Padding="0" CornerRadius="5"
                                                Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="⋯" Foreground="#5a7a94" FontSize="12" />
                                      </StackPanel>
                                    </StackPanel>
                                  </Button>

                                  <!-- context menu -->
                                  <Border IsVisible="{Binding MenuOpen}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,10,0"
                                          Width="218" Padding="4" CornerRadius="8" Background="#071019" BorderBrush="#152233" BorderThickness="1" ZIndex="40" BoxShadow="0 18 40 0 #B3000000">
                                    <ItemsControl ItemsSource="{Binding MenuItems}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Button Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,7" CornerRadius="5">
                                            <Grid ColumnDefinitions="*,Auto">
                                              <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" FontSize="11" />
                                              <TextBlock Grid.Column="1" Text="{Binding Hint}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#1e3048" />
                                            </Grid>
                                          </Button>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </Border>
                                </Grid>

                                <!-- expanded detail -->
                                <ContentControl IsVisible="{Binding Expanded}">
                                  <Border Background="#050c14" BorderBrush="#0a1520" BorderThickness="0,1,0,0" Padding="34,0,10,12">
                                    <StackPanel>
                                      <!-- detail tabs -->
                                      <Grid ColumnDefinitions="*,Auto" Margin="0,9,0,11">
                                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Desk.DetailTabs}">
                                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <Button Command="{Binding Command}" Height="24" Padding="11,0" CornerRadius="5" BorderThickness="1"
                                                      Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                                                      Content="{Binding Label}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" FontSize="9" FontWeight="Bold" />
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="1" Text="{Binding Desk.DetailEngineLine}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#26405a" VerticalAlignment="Center" />
                                      </Grid>

                                      <ContentControl Content="{Binding Desk}">
                                        <ContentControl.ContentTemplate>
                                          <DataTemplate>
                                            <Panel>
                                              <!-- OVERVIEW -->
                                              <Grid IsVisible="{Binding IsOverview}" ColumnDefinitions="1.15*,8,0.85*">
                                                <Border Grid.Column="0" Padding="12" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#07101a">
                                                  <StackPanel>
                                                    <TextBlock Text="PERFORMANCE" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" Margin="0,0,0,11" />
                                                    <ItemsControl ItemsSource="{Binding DetailStats}">
                                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                      <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                          <StackPanel Spacing="3" Margin="0,0,10,12">
                                                            <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#2d4a5e" />
                                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                                                          </StackPanel>
                                                        </DataTemplate>
                                                      </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border BorderBrush="#0a1520" BorderThickness="0,1,0,0" Margin="0,2,0,0" Padding="0,11,0,0">
                                                      <StackPanel>
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                          <TextBlock Grid.Column="0" Text="{Binding GridTitle}" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                                                          <TextBlock Grid.Column="1" Text="{Binding GridMeta}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#4a6a82" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding DetailLevels}">
                                                          <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                              <Grid ColumnDefinitions="66,8,*,8,66" Margin="0,1.5">
                                                                <TextBlock Grid.Column="0" Text="{Binding Price}" FontFamily="{StaticResource FontMono}" FontSize="10" TextAlignment="Right" Foreground="#4a6a82" VerticalAlignment="Center" />
                                                                <Border Grid.Column="2" Height="11" CornerRadius="3" Background="#0a1520" ClipToBounds="True">
                                                                  <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                      <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource RatioStar}}" />
                                                                      <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource RatioStar}, ConverterParameter=rest}" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Opacity="{Binding Opacity}" Background="{Binding Color, Converter={StaticResource StringToBrush}}" />
                                                                  </Grid>
                                                                </Border>
                                                                <TextBlock Grid.Column="4" Text="{Binding Tag}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{Binding TagColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                                              </Grid>
                                                            </DataTemplate>
                                                          </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                      </StackPanel>
                                                    </Border>
                                                  </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="2" Spacing="8">
                                                  <Border Padding="12" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#07101a">
                                                    <StackPanel>
                                                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                                        <TextBlock Grid.Column="0" Text="OPEN POSITION" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PosMeta}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#26405a" />
                                                      </Grid>
                                                      <ItemsControl ItemsSource="{Binding DetailPosition}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                          <DataTemplate>
                                                            <StackPanel Spacing="3" Margin="0,0,10,10">
                                                              <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#2d4a5e" />
                                                              <TextBlock Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                                                            </StackPanel>
                                                          </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                      </ItemsControl>
                                                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                        <Button Command="{Binding ClosePositionCommand}" Height="26" Padding="10,0" CornerRadius="5" Background="#14060a" BorderBrush="#3a1620" BorderThickness="1" Content="CLOSE AT MARKET" Foreground="#ff6b6b" FontSize="9" FontWeight="Bold" />
                                                        <Button Command="{Binding HedgeCommand}" Height="26" Padding="10,0" CornerRadius="5" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="{Binding HedgeVenue, StringFormat='HEDGE · {0}'}" Foreground="#8fa3b8" FontSize="9" FontWeight="Bold" />
                                                      </StackPanel>
                                                    </StackPanel>
                                                  </Border>
                                                  <Border Padding="12" BorderBrush="#14302e" BorderThickness="1" CornerRadius="10" Background="#061615">
                                                    <StackPanel>
                                                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,8" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="#21e6c1" />
                                                        <TextBlock Text="AI PARAMETER REVIEW" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding AiSource}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#2d6b64" />
                                                      </StackPanel>
                                                      <TextBlock Text="{Binding AiNote}" Foreground="#a9c2d8" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" />
                                                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,11,0,0">
                                                        <Button Command="{Binding ApplyAiCommand}" Height="25" Padding="10,0" CornerRadius="5" Background="#0e2a2a" BorderBrush="#21e6c1" BorderThickness="1" Content="APPLY SUGGESTION" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                                                        <Button Command="{Binding AskAiCommand}" Height="25" Padding="10,0" CornerRadius="5" Background="Transparent" BorderBrush="#152233" BorderThickness="1" Content="ASK WHY" Foreground="#5a7a94" FontSize="9" FontWeight="Bold" />
                                                      </StackPanel>
                                                    </StackPanel>
                                                  </Border>
                                                </StackPanel>
                                              </Grid>

                                              <!-- PARAMETERS -->
                                              <Border IsVisible="{Binding IsParams}" Padding="13" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#07101a">
                                                <StackPanel>
                                                  <ItemsControl ItemsSource="{Binding DetailParams}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                      <DataTemplate>
                                                        <StackPanel Spacing="4" Margin="0,0,14,12">
                                                          <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="#2d4a5e" />
                                                          <ComboBox IsVisible="{Binding IsSelect}" ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}"
                                                                    Height="28" Padding="7,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontSize="11" HorizontalAlignment="Stretch" />
                                                          <Border IsVisible="{Binding IsText}" Height="28" Padding="8,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                              <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" FontFamily="{StaticResource FontMono}" FontSize="11.5" VerticalAlignment="Center" />
                                                              <TextBlock Grid.Column="1" Text="{Binding Unit}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#26405a" VerticalAlignment="Center" />
                                                            </Grid>
                                                          </Border>
                                                        </StackPanel>
                                                      </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                  </ItemsControl>

                                                  <!-- DCA basket -->
                                                  <Border IsVisible="{Binding HasCoins}" BorderBrush="#0a1520" BorderThickness="0,1,0,0" Margin="0,2,0,0" Padding="0,12,0,0">
                                                    <StackPanel>
                                                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                        <TextBlock Grid.Column="0" Text="DCA BASKET" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding WeightSum}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{Binding WeightColor, Converter={StaticResource StringToBrush}}" />
                                                      </Grid>
                                                      <ItemsControl ItemsSource="{Binding Coins}">
                                                        <ItemsControl.ItemTemplate>
                                                          <DataTemplate>
                                                            <Grid ColumnDefinitions="116,88,116,*,30" Height="30">
                                                              <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="11" FontWeight="Medium" Foreground="#e8f4ff" VerticalAlignment="Center" />
                                                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border Width="40" Height="22" Padding="5,0" CornerRadius="5" Background="#060d14" BorderBrush="#152233" BorderThickness="1">
                                                                  <TextBox Text="{Binding Weight, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Text="%" FontSize="9" Foreground="#26405a" VerticalAlignment="Center" />
                                                              </StackPanel>
                                                              <Button Grid.Column="2" Command="{Binding ToggleMaCommand}" HorizontalAlignment="Left" Padding="6,3" CornerRadius="5" BorderThickness="1"
                                                                      Background="{Binding MaBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding MaBorder, Converter={StaticResource StringToBrush}}"
                                                                      Content="{Binding MaLabel}" Foreground="{Binding MaColor, Converter={StaticResource StringToBrush}}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                                              <TextBlock Grid.Column="3" Text="{Binding Stats}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#4a6a82" VerticalAlignment="Center" />
                                                              <Button Grid.Column="4" Command="{Binding RemoveCommand}" Width="20" Height="20" Padding="0" CornerRadius="4" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="✕" Foreground="#4a6a82" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                          </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                      </ItemsControl>
                                                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,9,0,0">
                                                        <Border Width="110" Height="24" Padding="7,0" CornerRadius="5" Background="#060d14" BorderBrush="#152233" BorderThickness="1">
                                                          <TextBox Text="{Binding NewCoin, Mode=TwoWay}" Watermark="SOLUSDT" Background="Transparent" BorderThickness="0" Padding="0" FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Button Command="{Binding AddCoinCommand}" Height="24" Padding="10,0" CornerRadius="5" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="+ ADD COIN" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                                                      </StackPanel>
                                                    </StackPanel>
                                                  </Border>

                                                  <Border BorderBrush="#0a1520" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                      <Button Command="{Binding SaveParamsCommand}" Height="28" Padding="13,0" CornerRadius="6" Background="#0e2a2a" BorderBrush="#21e6c1" BorderThickness="1" Content="SAVE &amp; RESTART" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                                                      <Button Command="{Binding AiSuggestParamsCommand}" Height="28" Padding="11,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="🧠 AI SUGGEST PARAMS" Foreground="#8fa3b8" FontSize="9" FontWeight="Bold" />
                                                      <Button Command="{Binding DryRunCommand}" Height="28" Padding="11,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="DRY-RUN 30D" Foreground="#8fa3b8" FontSize="9" FontWeight="Bold" />
                                                      <Button Command="{Binding ResetParamsCommand}" Height="28" Padding="9,0" Background="Transparent" BorderThickness="0" Content="RESET" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                                                      <TextBlock Text="{Binding DirtyLabel}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{Binding DirtyColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                  </Border>
                                                </StackPanel>
                                              </Border>

                                              <!-- TP / SL -->
                                              <Grid IsVisible="{Binding IsTpSl}" ColumnDefinitions="*,8,296">
                                                <Border Grid.Column="0" Padding="13" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#07101a">
                                                  <StackPanel>
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                                      <TextBlock Grid.Column="0" Text="TAKE PROFIT / STOP LOSS" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                                                      <TextBlock Grid.Column="1" Text="{Binding TpSummary}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#21e6c1" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Tpsl}">
                                                      <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                          <Grid ColumnDefinitions="Auto,146,92,*" ColumnSpacing="10" Margin="0,1.5" Background="{Binding RowBg, Converter={StaticResource StringToBrush}}">
                                                            <Button Grid.Column="0" Command="{Binding ToggleCommand}" Width="13" Height="13" Padding="0" CornerRadius="3" BorderThickness="1"
                                                                    Background="{Binding BoxBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BoxBorder, Converter={StaticResource StringToBrush}}"
                                                                    Content="{Binding Mark}" Foreground="#04101a" FontSize="8" VerticalAlignment="Center" Margin="6,6,0,6" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                                            <Border Grid.Column="2" Height="26" Padding="8,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Opacity="{Binding InputOpacity}" VerticalAlignment="Center">
                                                              <Grid ColumnDefinitions="*,Auto">
                                                                <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" FontFamily="{StaticResource FontMono}" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Unit}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#26405a" VerticalAlignment="Center" />
                                                              </Grid>
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding Hint}" FontSize="10" Foreground="#2d4a5e" VerticalAlignment="Center" />
                                                          </Grid>
                                                        </DataTemplate>
                                                      </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,13,0,0">
                                                      <Button Command="{Binding SaveTpSlCommand}" Height="27" Padding="12,0" CornerRadius="6" Background="#0e2a2a" BorderBrush="#21e6c1" BorderThickness="1" Content="APPLY TP / SL" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                                                      <Button Command="{Binding AiTpSlCommand}" Height="27" Padding="11,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="🧠 AI SUGGEST TP/SL" Foreground="#8fa3b8" FontSize="9" FontWeight="Bold" />
                                                    </StackPanel>
                                                  </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Padding="13" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#07101a">
                                                  <StackPanel>
                                                    <TextBlock Text="ORDER PLACEMENT" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" Margin="0,0,0,10" />
                                                    <TextBlock Text="{Binding TpNote}" FontSize="11" LineHeight="17" Foreground="#4a6a82" TextWrapping="Wrap" />
                                                    <Border BorderBrush="#0a1520" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,11,0,0">
                                                      <ItemsControl ItemsSource="{Binding TpPreview}">
                                                        <ItemsControl.ItemTemplate>
                                                          <DataTemplate>
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                              <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10" Foreground="#4a6a82" />
                                                              <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                                                            </Grid>
                                                          </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                      </ItemsControl>
                                                    </Border>
                                                  </StackPanel>
                                                </Border>
                                              </Grid>

                                              <!-- FILLS -->
                                              <Border IsVisible="{Binding IsTrades}" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#07101a" ClipToBounds="True">
                                                <StackPanel>
                                                  <Border Height="26" Padding="12,0" Background="#060d14">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                      <TextBlock Width="74" Text="TIME" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" />
                                                      <TextBlock Width="90" Text="SYMBOL" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" />
                                                      <TextBlock Width="56" Text="SIDE" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" />
                                                      <TextBlock Width="96" Text="PRICE" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Right" />
                                                      <TextBlock Width="90" Text="QTY" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Right" />
                                                      <TextBlock Width="96" Text="TOTAL USDT" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Right" />
                                                      <TextBlock Width="96" Text="REALIZED" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Right" />
                                                      <TextBlock Width="160" Text="STATUS · ROUTE" Foreground="#2d4a5e" FontSize="8" FontWeight="Bold" TextAlignment="Right" />
                                                    </StackPanel>
                                                  </Border>
                                                  <ItemsControl ItemsSource="{Binding DetailTrades}">
                                                    <ItemsControl.ItemTemplate>
                                                      <DataTemplate>
                                                        <Border Height="28" Padding="12,0" BorderBrush="#0a1520" BorderThickness="0,1,0,0">
                                                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Width="74" Text="{Binding Time}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#4a6a82" />
                                                            <TextBlock Width="90" Text="{Binding Symbol}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#c8dcef" />
                                                            <TextBlock Width="56" Text="{Binding Side}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{Binding SideColor, Converter={StaticResource StringToBrush}}" />
                                                            <TextBlock Width="96" Text="{Binding Price}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#c8dcef" TextAlignment="Right" />
                                                            <TextBlock Width="90" Text="{Binding Qty}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8fa3b8" TextAlignment="Right" />
                                                            <TextBlock Width="96" Text="{Binding Total}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8fa3b8" TextAlignment="Right" />
                                                            <TextBlock Width="96" Text="{Binding Pnl}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{Binding PnlColor, Converter={StaticResource StringToBrush}}" TextAlignment="Right" />
                                                            <TextBlock Width="160" Text="{Binding Route}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#2d4a5e" TextAlignment="Right" />
                                                          </StackPanel>
                                                        </Border>
                                                      </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                  </ItemsControl>
                                                  <Border Padding="12,9" BorderBrush="#0a1520" BorderThickness="0,1,0,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                      <Button Command="{Binding ExportCsvCommand}" Height="25" Padding="10,0" CornerRadius="5" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="EXPORT CSV" Foreground="#8fa3b8" FontSize="9" FontWeight="Bold" />
                                                      <Button Command="{Binding TaxReportCommand}" Height="25" Padding="10,0" CornerRadius="5" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="FIFO TAX REPORT" Foreground="#8fa3b8" FontSize="9" FontWeight="Bold" />
                                                      <Button Command="{Binding JournalCommand}" Height="25" Padding="10,0" CornerRadius="5" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="🧠 AI JOURNAL COACH" Foreground="#8fa3b8" FontSize="9" FontWeight="Bold" />
                                                      <TextBlock Text="{Binding TradesMeta}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#26405a" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                  </Border>
                                                </StackPanel>
                                              </Border>

                                              <!-- LOGS -->
                                              <Border IsVisible="{Binding IsLogs}" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#04101a" ClipToBounds="True">
                                                <StackPanel>
                                                  <Border Padding="11,7" Background="#07101a" BorderBrush="#0a1520" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                      <ItemsControl Grid.Column="0" ItemsSource="{Binding DetailLogFilters}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                          <DataTemplate>
                                                            <Button Command="{Binding Command}" Height="21" Padding="8,0" CornerRadius="4" BorderThickness="1"
                                                                    Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                                                                    Content="{Binding Label}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" FontFamily="{StaticResource FontMono}" FontSize="9" />
                                                          </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                      </ItemsControl>
                                                      <Button Grid.Column="1" Command="{Binding CopyLogsCommand}" Background="Transparent" BorderThickness="0" Content="COPY BUFFER" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                                                    </Grid>
                                                  </Border>
                                                  <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding DetailLogs}" Padding="11,8">
                                                      <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                          <StackPanel Orientation="Horizontal" Spacing="11">
                                                            <TextBlock Text="{Binding Time}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#1e3048" />
                                                            <TextBlock Text="{Binding Level}" Width="42" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                                                            <TextBlock Text="{Binding Msg}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8fa3b8" TextWrapping="Wrap" />
                                                          </StackPanel>
                                                        </DataTemplate>
                                                      </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                  </ScrollViewer>
                                                </StackPanel>
                                              </Border>

                                              <!-- RISK -->
                                              <Grid IsVisible="{Binding IsRisk}" ColumnDefinitions="*,8,*">
                                                <Border Grid.Column="0" Padding="13" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#07101a">
                                                  <StackPanel Spacing="14">
                                                    <TextBlock Text="RISK LIMITS · ENFORCED IN PAPER AND LIVE" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" />
                                                    <StackPanel Spacing="6">
                                                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Max order $" FontSize="11" Foreground="#8fa3b8" /><TextBlock Grid.Column="1" Text="{Binding RiskOrderLabel}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#21e6c1" /></Grid>
                                                      <Slider Minimum="100" Maximum="10000" Value="{Binding RiskOrder, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="6">
                                                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Max total exposure $" FontSize="11" Foreground="#8fa3b8" /><TextBlock Grid.Column="1" Text="{Binding RiskExposureLabel}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#21e6c1" /></Grid>
                                                      <Slider Minimum="1000" Maximum="100000" Value="{Binding RiskExposure, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="6">
                                                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Max open positions" FontSize="11" Foreground="#8fa3b8" /><TextBlock Grid.Column="1" Text="{Binding RiskPositionsLabel}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#e8f4ff" /></Grid>
                                                      <Slider Minimum="1" Maximum="20" Value="{Binding RiskPositions, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="6">
                                                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Max daily loss $" FontSize="11" Foreground="#8fa3b8" /><TextBlock Grid.Column="1" Text="{Binding RiskDailyLabel}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#ff6b6b" /></Grid>
                                                      <Slider Minimum="50" Maximum="5000" Value="{Binding RiskDaily, Mode=TwoWay}" />
                                                    </StackPanel>
                                                  </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Padding="13" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="10" Background="#07101a">
                                                  <StackPanel>
                                                    <TextBlock Text="GATES &amp; GUARDS" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" Margin="0,0,0,10" />
                                                    <ItemsControl ItemsSource="{Binding GuardsRisk}">
                                                      <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                          <Button Command="{Binding Command}" Background="Transparent" BorderThickness="0" Padding="8,7" CornerRadius="6" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                              <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#d0e4f4" />
                                                                <TextBlock Text="{Binding Hint}" FontSize="9" Foreground="#2d4a5e" />
                                                              </StackPanel>
                                                              <Border Grid.Column="1" Width="28" Height="15" CornerRadius="8" VerticalAlignment="Center" Background="{Binding TrackBg, Converter={StaticResource StringToBrush}}">
                                                                <Canvas><Border Width="11" Height="11" CornerRadius="6" Canvas.Top="2" Canvas.Left="{Binding KnobLeft}" Background="{Binding Knob, Converter={StaticResource StringToBrush}}" /></Canvas>
                                                              </Border>
                                                            </Grid>
                                                          </Button>
                                                        </DataTemplate>
                                                      </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border BorderBrush="#0a1520" BorderThickness="0,1,0,0" Margin="0,11,0,0" Padding="0,10,0,0">
                                                      <StackPanel>
                                                        <TextBlock Text="SYMBOL ALLOWLIST" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" Margin="0,0,0,6" />
                                                        <TextBox Text="{Binding Allowlist, Mode=TwoWay}" Watermark="any (e.g. BTCUSDT, ETHUSDT)" Height="28" Padding="9,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11" />
                                                      </StackPanel>
                                                    </Border>
                                                  </StackPanel>
                                                </Border>
                                              </Grid>
                                            </Panel>
                                          </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                      </ContentControl>
                                    </StackPanel>
                                  </Border>
                                </ContentControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- empty state -->
                      <StackPanel IsVisible="{Binding ShowEmpty}" Margin="20,24,20,28">
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20" Spacing="5">
                          <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#e8f4ff" HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding EmptySub}" FontSize="11.5" Foreground="#4a6a82" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Templates}" MaxWidth="1080" HorizontalAlignment="Center">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Command="{Binding QuickCreate}" Margin="4" Padding="12" CornerRadius="10" Background="#060d14" BorderBrush="#0d1b27" BorderThickness="1" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="7">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <Border CornerRadius="4" Padding="6,0" Height="17" BorderThickness="1" HorizontalAlignment="Left"
                                            Background="{Binding BadgeBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding BadgeBorder, Converter={StaticResource StringToBrush}}">
                                      <TextBlock Text="{Binding Type}" Foreground="{Binding Accent, Converter={StaticResource StringToBrush}}" FontFamily="{StaticResource FontMono}" FontSize="9" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Risk}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#2d4a5e" VerticalAlignment="Center" />
                                  </Grid>
                                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="#e8f4ff" />
                                  <TextBlock Text="{Binding Desc}" FontSize="10.5" LineHeight="16" Foreground="#4a6a82" TextWrapping="Wrap" />
                                  <Border BorderBrush="#0a1520" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,2,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock Text="{Binding Backtest}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#2d4a5e" />
                                      <TextBlock Grid.Column="1" Text="{Binding Apr}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#3ddc84" />
                                    </Grid>
                                  </Border>
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding NewBotCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" Height="30" Padding="14,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="OR CONFIGURE FROM SCRATCH →" Foreground="#8fa3b8" FontSize="10" FontWeight="Bold" />
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- ═════════ RIGHT RAIL ═════════ -->
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                <TextBlock Text="AI DESK · BOTS" Foreground="#2d4a5e" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Grid.Column="1" CornerRadius="9" Padding="8,3" Background="#060d14" BorderBrush="#1a3030" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="#21e6c1" />
                    <TextBlock Text="{Binding AiProvider}" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- AI RISK CHECK -->
              <Border CornerRadius="11" Background="#07101a" BorderThickness="1" ClipToBounds="True" BorderBrush="{Binding RailRiskBorder, Converter={StaticResource StringToBrush}}">
                <StackPanel>
                  <Button Command="{Binding RailRiskToggle}" Background="Transparent" BorderThickness="0" Padding="12,10" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="🛡 AI RISK CHECK" FontSize="9" FontWeight="Bold" Foreground="{Binding RailRiskTitle, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding RiskVerdictShort}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{Binding RiskVerdictColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding RailRiskCaret}" Foreground="#1e3048" FontSize="9" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <StackPanel IsVisible="{Binding RailRiskOpen}" Margin="12,0,12,12">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Text="SYMBOL" FontSize="9" Foreground="#2d4a5e" FontWeight="Bold" />
                        <TextBox Text="{Binding RcSymbol, Mode=TwoWay}" Height="26" Padding="8,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11" />
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                        <TextBlock Text="SIDE" FontSize="9" Foreground="#2d4a5e" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding Sides}" SelectedItem="{Binding RcSide, Mode=TwoWay}" Height="26" Padding="6,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontSize="11" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                        <TextBlock Text="ORDER $" FontSize="9" Foreground="#2d4a5e" FontWeight="Bold" />
                        <TextBox Text="{Binding RcUsd, Mode=TwoWay}" Height="26" Padding="8,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock Text="LEVERAGE" FontSize="9" Foreground="#2d4a5e" FontWeight="Bold" />
                        <TextBox Text="{Binding RcLev, Mode=TwoWay}" Height="26" Padding="8,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11" />
                      </StackPanel>
                    </Grid>
                    <Button Command="{Binding RiskCheckCommand}" Margin="0,9,0,0" Height="27" HorizontalAlignment="Stretch" CornerRadius="6" Background="#0e2a2a" BorderBrush="#21e6c1" BorderThickness="1" Content="RUN PRE-TRADE CHECK" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                    <StackPanel IsVisible="{Binding RiskHasVerdict}" Margin="0,10,0,0">
                      <Border BorderBrush="#0a1520" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,8" VerticalAlignment="Center">
                            <Border CornerRadius="5" Padding="10,4" BorderThickness="1" Background="{Binding RiskVerdictBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding RiskVerdictBorder, Converter={StaticResource StringToBrush}}">
                              <TextBlock Text="{Binding RiskVerdict}" Foreground="{Binding RiskVerdictColor, Converter={StaticResource StringToBrush}}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding RiskScore, StringFormat='risk {0}'}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8fa3b8" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="{Binding RiskRationale}" FontSize="11" LineHeight="17" Foreground="#a9c2d8" TextWrapping="Wrap" />
                          <ItemsControl ItemsSource="{Binding RiskReasons}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,4">
                                  <TextBlock Text="•" Foreground="#f4b860" FontSize="10" />
                                  <TextBlock Text="{Binding}" FontSize="10" LineHeight="15" Foreground="#4a6a82" TextWrapping="Wrap" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- CORRELATION INSIGHT -->
              <Border CornerRadius="11" Background="#07101a" BorderThickness="1" ClipToBounds="True" BorderBrush="{Binding RailCorrBorder, Converter={StaticResource StringToBrush}}">
                <StackPanel>
                  <Button Command="{Binding RailCorrToggle}" Background="Transparent" BorderThickness="0" Padding="12,10" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="🔗 CORRELATION INSIGHT" FontSize="9" FontWeight="Bold" Foreground="{Binding RailCorrTitle, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding CorrBadge}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{Binding CorrBadgeColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding RailCorrCaret}" Foreground="#1e3048" FontSize="9" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <StackPanel IsVisible="{Binding RailCorrOpen}" Margin="12,0,12,12">
                    <TextBox Text="{Binding CorrSymbols, Mode=TwoWay}" Watermark="BTCUSDT, ETHUSDT, SOLUSDT…" Height="27" Padding="9,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11" />
                    <Button Command="{Binding CorrAnalyzeCommand}" Margin="0,8,0,0" Height="27" HorizontalAlignment="Stretch" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="ANALYZE BOOK" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                    <StackPanel IsVisible="{Binding CorrHasResult}" Margin="0,10,0,0">
                      <Border BorderBrush="#0a1520" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel>
                          <TextBlock Text="{Binding CorrSummary}" FontSize="11" LineHeight="17" Foreground="#a9c2d8" TextWrapping="Wrap" />
                          <ItemsControl ItemsSource="{Binding CorrBullets}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,4">
                                  <TextBlock Text="•" Foreground="#21e6c1" FontSize="10" />
                                  <TextBlock Text="{Binding}" FontSize="10" LineHeight="15" Foreground="#4a6a82" TextWrapping="Wrap" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- OPTIONS ADVISOR -->
              <Border CornerRadius="11" Background="#07101a" BorderThickness="1" ClipToBounds="True" BorderBrush="{Binding RailOptsBorder, Converter={StaticResource StringToBrush}}">
                <StackPanel>
                  <Button Command="{Binding RailOptsToggle}" Background="Transparent" BorderThickness="0" Padding="12,10" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="📐 OPTIONS ADVISOR" FontSize="9" FontWeight="Bold" Foreground="{Binding RailOptsTitle, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding OptsBadge}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#2d4a5e" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding RailOptsCaret}" Foreground="#1e3048" FontSize="9" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <StackPanel IsVisible="{Binding RailOptsOpen}" Margin="12,0,12,12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="ASSET" FontSize="9" Foreground="#2d4a5e" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding OptAssets}" SelectedItem="{Binding OptAsset, Mode=TwoWay}" Height="26" Padding="6,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontSize="11" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="VIEW" FontSize="9" Foreground="#2d4a5e" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding OptViews}" SelectedItem="{Binding OptView, Mode=TwoWay}" Height="26" Padding="6,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontSize="11" HorizontalAlignment="Stretch" />
                      </StackPanel>
                    </Grid>
                    <Button Command="{Binding OptsSuggestCommand}" Margin="0,9,0,0" Height="27" HorizontalAlignment="Stretch" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="SUGGEST STRATEGY" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                    <StackPanel IsVisible="{Binding OptsHasResult}" Margin="0,10,0,0">
                      <Border BorderBrush="#0a1520" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,8" VerticalAlignment="Center">
                            <Border CornerRadius="5" Padding="9,4" Background="#04101a"><TextBlock Text="{Binding OptsStrategy}" Foreground="#e8f4ff" FontSize="11" FontWeight="Bold" /></Border>
                            <TextBlock Text="{Binding OptsIv}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding OptsIvColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="{Binding OptsRationale}" FontSize="11" LineHeight="17" Foreground="#a9c2d8" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- AI COPILOT -->
              <Border CornerRadius="11" Background="#07101a" BorderThickness="1" ClipToBounds="True" BorderBrush="{Binding RailCopilotBorder, Converter={StaticResource StringToBrush}}">
                <StackPanel>
                  <Button Command="{Binding RailCopilotToggle}" Background="Transparent" BorderThickness="0" Padding="12,10" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="💬 AI COPILOT" FontSize="9" FontWeight="Bold" Foreground="{Binding RailCopilotTitle, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding CopilotMode}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{Binding CopilotModeColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding RailCopilotCaret}" Foreground="#1e3048" FontSize="9" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <StackPanel IsVisible="{Binding RailCopilotOpen}" Margin="12,0,12,12">
                    <Border CornerRadius="7" Background="#04101a" Padding="9" MaxHeight="186">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CopilotMsgs}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="9" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Spacing="3" HorizontalAlignment="{Binding Align}">
                                <TextBlock Text="{Binding Role}" FontSize="9" FontWeight="Bold" Foreground="{Binding RoleColor, Converter={StaticResource StringToBrush}}" />
                                <Border MaxWidth="244" Padding="9,7" CornerRadius="7" Background="{Binding Bg, Converter={StaticResource StringToBrush}}">
                                  <TextBlock Text="{Binding Text}" FontSize="11" LineHeight="16" Foreground="#d0e4f4" TextWrapping="Wrap" />
                                </Border>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                    <ItemsControl ItemsSource="{Binding CopilotChips}" Margin="0,8,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding Command}" Margin="0,0,5,5" Padding="8,4" CornerRadius="5" Background="#060d14" BorderBrush="#152233" BorderThickness="1" Content="{Binding Label}" Foreground="#5a7a94" FontSize="9.5" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,8,0,0">
                      <TextBox Grid.Column="0" Text="{Binding CopilotQ, Mode=TwoWay}" Watermark="ask about your bots…" Height="27" Padding="9,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontSize="11" />
                      <Button Grid.Column="1" Command="{Binding CopilotAskCommand}" Height="27" Padding="11,0" CornerRadius="6" Background="#0e2a2a" BorderBrush="#21e6c1" BorderThickness="1" Content="ASK" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                    </Grid>
                    <Button Command="{Binding CopilotToggleAutoCommand}" Margin="0,8,0,0" Padding="8,7" CornerRadius="6" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="1"
                            Background="{Binding CopilotAutoBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding CopilotAutoBorder, Converter={StaticResource StringToBrush}}">
                      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Border Width="28" Height="15" CornerRadius="8" Background="{Binding CopilotTrackBg, Converter={StaticResource StringToBrush}}">
                          <Canvas><Border Width="11" Height="11" CornerRadius="6" Canvas.Top="2" Canvas.Left="{Binding CopilotKnobLeft}" Background="{Binding CopilotKnob, Converter={StaticResource StringToBrush}}" /></Canvas>
                        </Border>
                        <TextBlock Text="{Binding CopilotAutoLabel}" FontSize="10" Foreground="{Binding CopilotAutoColor, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- AUTONOMOUS AGENT -->
              <Border CornerRadius="11" Background="#07101a" BorderThickness="1" ClipToBounds="True" BorderBrush="{Binding RailAgentBorder, Converter={StaticResource StringToBrush}}">
                <StackPanel>
                  <Button Command="{Binding RailAgentToggle}" Background="Transparent" BorderThickness="0" Padding="12,10" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="🤖 AUTONOMOUS AGENT" FontSize="9" FontWeight="Bold" Foreground="{Binding RailAgentTitle, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding AgentBadge}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{Binding AgentBadgeColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding RailAgentCaret}" Foreground="#1e3048" FontSize="9" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <StackPanel IsVisible="{Binding RailAgentOpen}" Margin="12,0,12,12">
                    <TextBlock Text="OBJECTIVE" FontSize="9" FontWeight="Bold" Foreground="#2d4a5e" Margin="0,0,0,5" />
                    <TextBox Text="{Binding AgentObjective, Mode=TwoWay}" Height="56" Padding="9,8" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding AgentCaps}" Margin="0,9,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Spacing="4" Margin="0,0,7,0">
                            <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#2d4a5e" FontWeight="Bold" />
                            <TextBox Text="{Binding Value, Mode=TwoWay}" Height="26" Padding="7,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="SYMBOL ALLOWLIST" FontSize="9" FontWeight="Bold" Foreground="#2d4a5e" Margin="0,9,0,5" />
                    <TextBox Text="{Binding Allowlist, Mode=TwoWay}" Watermark="any (e.g. BTCUSDT, ETHUSDT)" Height="26" Padding="9,0" CornerRadius="6" Background="#060d14" BorderBrush="#152233" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,10,0,0">
                      <Button Grid.Column="0" Command="{Binding AgentToggleLiveCommand}" Height="27" CornerRadius="6" BorderThickness="1" FontSize="9" FontWeight="Bold"
                              Background="{Binding AgentLiveBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding AgentLiveBorder, Converter={StaticResource StringToBrush}}"
                              Content="{Binding AgentLiveLabel}" Foreground="{Binding AgentLiveColor, Converter={StaticResource StringToBrush}}" />
                      <Button Grid.Column="1" Command="{Binding AgentArmCommand}" Height="27" CornerRadius="6" BorderThickness="1" FontSize="9" FontWeight="Bold"
                              Background="{Binding AgentArmBg, Converter={StaticResource StringToBrush}}" BorderBrush="{Binding AgentArmBorder, Converter={StaticResource StringToBrush}}"
                              Content="{Binding AgentArmLabel}" Foreground="{Binding AgentArmColor, Converter={StaticResource StringToBrush}}" />
                    </Grid>
                    <Border Margin="0,10,0,0" Padding="9,8" CornerRadius="7" Background="#04101a" MaxHeight="106">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AgentLog}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#1e3048" />
                                <TextBlock Text="{Binding Msg}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DockPanel>

      <!-- ═══════════════ OVERLAYS (modals · toast) ═══════════════ -->
      <views:BotsModals />
    </Grid>
  </Border>
</UserControl>

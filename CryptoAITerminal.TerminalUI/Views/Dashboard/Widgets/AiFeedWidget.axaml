<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.AiFeedWidget"
             x:DataType="vm:AiFeedViewModel"
             x:CompileBindings="True">
  <StackPanel Spacing="8">

    <!-- Status + unread badge + actions -->
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
      <TextBlock Grid.Column="0" Text="{Binding StatusLabel}"
                 Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Border Grid.Column="1" IsVisible="{Binding HasUnread}"
              Background="{DynamicResource Negative}" CornerRadius="8" Padding="4,1" VerticalAlignment="Center">
        <TextBlock Text="{Binding UnreadBadge, StringFormat='{}{0} new'}"
                   Foreground="White" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
      </Border>
      <Button Grid.Column="2" Content="↻" FontSize="{DynamicResource FsMicro}" Padding="6,1"
              ToolTip.Tip="Refresh feed" AutomationProperties.Name="Refresh AI feed"
              Command="{Binding RefreshCommand}" />
    </Grid>

    <TextBlock IsVisible="{Binding IsLoading}" Text="Loading server feed…"
               Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsCaption}" />

    <!-- Your events (alerts, AI anomalies, bots) -->
    <StackPanel Spacing="3" IsVisible="{Binding HasInbox}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="YOUR EVENTS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
        <Button Grid.Column="1" Content="mark all read" FontSize="{DynamicResource FsMicro}" Padding="4,0"
                Background="Transparent" Foreground="{DynamicResource TextSoft}"
                Command="{Binding MarkAllReadCommand}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Inbox}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InboxRowVM">
            <Border Background="{DynamicResource Surface0}" CornerRadius="3" Padding="8,4" Margin="0,1"
                    BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Background="{DynamicResource Surface3}" CornerRadius="3" Padding="4,2" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Kind}" Foreground="#5AC8FA" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}"
                             TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Top">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource Negative}" HorizontalAlignment="Right"
                           IsVisible="{Binding IsUnread}" />
                  <TextBlock Text="{Binding AgeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Latest AI output (server computes once, everyone reads) -->
    <TextBlock Text="LATEST AI OUTPUT" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,4,0,0" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
      <ItemsControl ItemsSource="{Binding Digests}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AiDigestRowVM">
            <Border Background="{DynamicResource Surface0}" CornerRadius="3" Padding="8,6" Margin="0,1"
                    BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Border Grid.Column="0" CornerRadius="3" Padding="4,2">
                    <Border.Background>
                      <SolidColorBrush Color="#5AC8FA" Opacity="0.15" />
                    </Border.Background>
                    <TextBlock Text="{Binding Kind}" Foreground="#5AC8FA" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="{DynamicResource FsCaption}" FontWeight="Bold" TextWrapping="Wrap" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding AgeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Cadence}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}"
                               HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Body}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}"
                           TextWrapping="Wrap" MaxLines="4" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Every AI function the server runs, with its cadence and last publish -->
    <TextBlock Text="ALL AI FUNCTIONS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="0,4,0,0" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
      <ItemsControl ItemsSource="{Binding Streams}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AiStreamRowVM">
            <Border Background="{DynamicResource Surface0}" CornerRadius="3" Padding="8,4" Margin="0,1"
                    BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Background="{DynamicResource Surface3}" CornerRadius="3" Padding="4,2" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Group}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}"
                             TextWrapping="Wrap" MaxLines="1" />
                  <TextBlock Text="{Binding LatestTitle}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}"
                             TextWrapping="Wrap" MaxLines="1" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Cadence}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}"
                             HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding AgeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}"
                             HorizontalAlignment="Right" IsVisible="{Binding HasLatest}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.AiFeedWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <StackPanel Spacing="8">

    <!-- Status + unread badge + actions -->
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
      <TextBlock Grid.Column="0" Text="{Binding AiFeedVM.StatusLabel}"
                 Foreground="{DynamicResource TextSoft}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Border Grid.Column="1" IsVisible="{Binding AiFeedVM.HasUnread}"
              Background="#FF6B6B" CornerRadius="8" Padding="5,1" VerticalAlignment="Center">
        <TextBlock Text="{Binding AiFeedVM.UnreadBadge, StringFormat='{}{0} new'}"
                   Foreground="White" FontSize="9" FontWeight="Bold" />
      </Border>
      <Button Grid.Column="2" Content="↻" FontSize="10" Padding="6,1"
              ToolTip.Tip="Refresh feed" AutomationProperties.Name="Refresh AI feed"
              Command="{Binding AiFeedVM.RefreshCommand}" />
    </Grid>

    <TextBlock IsVisible="{Binding AiFeedVM.IsLoading}" Text="Loading server feed…"
               Foreground="{DynamicResource TextSoft}" FontSize="11" />

    <!-- Your events (alerts, AI anomalies, bots) -->
    <StackPanel Spacing="3" IsVisible="{Binding AiFeedVM.HasInbox}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="YOUR EVENTS" Foreground="#2D4A5A" FontSize="9" FontWeight="Bold" />
        <Button Grid.Column="1" Content="mark all read" FontSize="9" Padding="4,0"
                Background="Transparent" Foreground="{DynamicResource TextSoft}"
                Command="{Binding AiFeedVM.MarkAllReadCommand}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding AiFeedVM.Inbox}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:InboxRowVM}">
            <Border Background="#060D14" CornerRadius="3" Padding="8,5" Margin="0,1"
                    BorderBrush="#17263A" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Background="#111C28" CornerRadius="3" Padding="5,2" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Kind}" Foreground="#5AC8FA" FontSize="9" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Title}" Foreground="#C8D8E8" FontSize="11" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Message}" Foreground="#7A93A8" FontSize="10"
                             TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Top">
                  <Ellipse Width="6" Height="6" Fill="#FF6B6B" HorizontalAlignment="Right"
                           IsVisible="{Binding IsUnread}" />
                  <TextBlock Text="{Binding AgeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="9" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Latest AI output (server computes once, everyone reads) -->
    <TextBlock Text="LATEST AI OUTPUT" Foreground="#2D4A5A" FontSize="9" FontWeight="Bold" Margin="0,4,0,0" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
      <ItemsControl ItemsSource="{Binding AiFeedVM.Digests}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:AiDigestRowVM}">
            <Border Background="#060D14" CornerRadius="3" Padding="8,6" Margin="0,1"
                    BorderBrush="#17263A" BorderThickness="0,0,0,1">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Border Grid.Column="0" CornerRadius="3" Padding="5,2">
                    <Border.Background>
                      <SolidColorBrush Color="#5AC8FA" Opacity="0.15" />
                    </Border.Background>
                    <TextBlock Text="{Binding Kind}" Foreground="#5AC8FA" FontSize="9" FontWeight="Bold" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#C8D8E8"
                             FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding AgeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="9"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Cadence}" Foreground="#2D4A5A" FontSize="9"
                               HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Body}" Foreground="#7A93A8" FontSize="10"
                           TextWrapping="Wrap" MaxLines="4" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Every AI function the server runs, with its cadence and last publish -->
    <TextBlock Text="ALL AI FUNCTIONS" Foreground="#2D4A5A" FontSize="9" FontWeight="Bold" Margin="0,4,0,0" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
      <ItemsControl ItemsSource="{Binding AiFeedVM.Streams}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:AiStreamRowVM}">
            <Border Background="#060D14" CornerRadius="3" Padding="8,5" Margin="0,1"
                    BorderBrush="#17263A" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Background="#111C28" CornerRadius="3" Padding="4,2" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Group}" Foreground="{DynamicResource TextSoft}" FontSize="9" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Name}" Foreground="#C8D8E8" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSoft}" FontSize="9"
                             TextWrapping="Wrap" MaxLines="1" />
                  <TextBlock Text="{Binding LatestTitle}" Foreground="#7A93A8" FontSize="9"
                             TextWrapping="Wrap" MaxLines="1" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Cadence}" Foreground="#2D4A5A" FontSize="9"
                             HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding AgeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="9"
                             HorizontalAlignment="Right" IsVisible="{Binding HasLatest}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </StackPanel>
</UserControl>

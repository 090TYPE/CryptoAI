<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.AnalyticsWidget"
             x:DataType="vm:PnlDashboardViewModel"
             x:CompileBindings="True">
  <StackPanel Spacing="8">

    <!-- KPI cards. WrapPanel + MinWidth: six equal grid columns squeezed each tile below the
         width of its own label ("DRAWDOWN") and value, so both were clipped. Tiles now keep a
         readable width and wrap to a second row when the widget is narrow — nothing is hidden. -->
    <WrapPanel Orientation="Horizontal">
      <Border MinWidth="92" Margin="0,0,6,6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock Text="P&amp;L" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding TotalPnlLabel}"
                     Foreground="{Binding TotalPnlBrush, Converter={StaticResource StringToBrush}}"
                     FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border MinWidth="92" Margin="0,0,6,6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock Text="WIN RATE" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WinRateLabel}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding TradeCountLabel}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border MinWidth="92" Margin="0,0,6,6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock Text="AVG WIN" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AvgWinLabel}" Foreground="{DynamicResource Positive}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border MinWidth="92" Margin="0,0,6,6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock Text="AVG LOSS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AvgLossLabel}" Foreground="{DynamicResource Negative}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border MinWidth="92" Margin="0,0,6,6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock Text="DRAWDOWN" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MaxDrawdownLabel}" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border MinWidth="92" Margin="0,0,6,6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock Text="PROFIT FACTOR" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ProfitFactorLabel}" Foreground="{DynamicResource AccentPurple}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </WrapPanel>

    <!-- Equity curve mini canvas -->
    <Border Background="{DynamicResource Surface0}" CornerRadius="4" Height="80"
            IsVisible="{Binding EquityCurveHasData}">
      <Canvas Width="560" Height="70" VerticalAlignment="Center" HorizontalAlignment="Left">
        <Path Fill="#33FF5D73" Stroke="Transparent"
              Data="{Binding DrawdownPathData}" />
        <Line StartPoint="0,0" EndPoint="560,0"
              Stroke="{DynamicResource PanelStroke}" StrokeThickness="1" StrokeDashArray="4,4">
          <Line.RenderTransform>
            <TranslateTransform Y="{Binding ZeroLineY}" />
          </Line.RenderTransform>
        </Line>
        <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Fill="Transparent"
              Data="{Binding EquityCurvePathData}" />
      </Canvas>
    </Border>
    <Border Background="{DynamicResource Surface0}" CornerRadius="4" Height="40"
            IsVisible="{Binding EquityCurveIsEmpty}">
      <TextBlock Text="No trade data yet."
                 Foreground="#2A3D4F" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FsCaption}" />
    </Border>

    <!-- Recent trade history -->
    <Grid ColumnDefinitions="100,*,60,50,70,70" ColumnSpacing="6" Margin="0,2,0,0">
      <TextBlock Grid.Column="0" Text="DATE"   Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
      <TextBlock Grid.Column="1" Text="SYMBOL" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
      <TextBlock Grid.Column="2" Text="SIDE"   Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
      <TextBlock Grid.Column="3" Text="P&amp;L"   Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
      <TextBlock Grid.Column="4" Text="P&amp;L %"  Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
      <TextBlock Grid.Column="5" Text="EXIT"   Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
    </Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding TradeRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TradeRowViewModel">
            <Border Padding="2,4" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="100,*,60,50,70,70" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="{Binding DateLabel}"  Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Symbol}"     Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Direction}"  Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding PnlLabel}"   Foreground="{Binding PnlBrush, Converter={StaticResource StringToBrush}}" FontWeight="SemiBold" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding PnlPctLabel}" Foreground="{Binding PnlBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding ExitReason}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </StackPanel>
</UserControl>

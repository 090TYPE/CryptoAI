<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.FundingWidget"
             x:DataType="vm:FundingRateViewModel"
             x:CompileBindings="True">
  <!-- Grid, not StackPanel: a StackPanel measures its children with infinite height, so the
       ScrollViewer below got a viewport as tall as its content, never showed a scrollbar and
       spilled out of the widget cell. The star row gives it a real height to scroll inside. -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="8">

    <!-- Summary KPI strip -->
    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="AVG RATE" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
        <TextBlock Text="{Binding AvgRateLabel}"
                   FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Text="EXTREMES" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
        <TextBlock Text="{Binding ExtremeCount}"
                   FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource Warning}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="2">
        <TextBlock Text="BEST SHORT" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
        <TextBlock Text="{Binding TopBearishLabel}"
                   FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" Foreground="{DynamicResource Negative}" />
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="2">
        <TextBlock Text="BEST LONG" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
        <TextBlock Text="{Binding TopBullishLabel}"
                   FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" Foreground="{DynamicResource Positive}" />
      </StackPanel>
    </Grid>

    <!-- Table header. Proportional, not fixed: 310px of fixed columns plus spacing did not fit
         the widget's own width at 1366 and collapsed SYMBOL to nothing. -->
    <Grid ColumnSpacing="6" Margin="0,2,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.4*" MinWidth="70" />
        <ColumnDefinition Width="0.9*" MinWidth="52" />
        <ColumnDefinition Width="0.9*" MinWidth="52" />
        <ColumnDefinition Width="0.8*" MinWidth="48" />
        <ColumnDefinition Width="0.9*" MinWidth="52" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="SYMBOL"  Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
      <TextBlock Grid.Column="1" Text="RATE"    Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="2" Text="ANNL."   Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="3" Text="MARK $"  Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="4" Text="NEXT"    Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Right" />
    </Grid>
    </StackPanel>

    <!-- Rates list -->

    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding DisplayRates}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FundingRateRowViewModel">
            <Border Padding="0,4" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.4*" MinWidth="70" />
                  <ColumnDefinition Width="0.9*" MinWidth="52" />
                  <ColumnDefinition Width="0.9*" MinWidth="52" />
                  <ColumnDefinition Width="0.8*" MinWidth="48" />
                  <ColumnDefinition Width="0.9*" MinWidth="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Symbol}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontSize="{DynamicResource FsCaption}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FundingRatePct}" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding RateColor, Converter={StaticResource StringToBrush}}" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FsCaption}" />
                <TextBlock Grid.Column="2" Text="{Binding AnnualizedLabel}" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding RateColor, Converter={StaticResource StringToBrush}}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FsMicro}" />
                <TextBlock Grid.Column="3" Text="{Binding MarkPriceLabel}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FsMicro}" />
                <TextBlock Grid.Column="4" Text="{Binding NextFundingLabel}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextDim}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FsMicro}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Classes="WidgetEmpty"
               IsVisible="{Binding !DisplayRates.Count}"
               Text="No funding rates loaded yet. Refresh the Funding desk to pull perpetual rates." />

  </Grid>
</UserControl>

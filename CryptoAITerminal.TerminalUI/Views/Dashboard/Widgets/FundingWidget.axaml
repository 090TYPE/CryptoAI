<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.FundingWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <!-- Grid, not StackPanel: a StackPanel measures its children with infinite height, so the
       ScrollViewer below got a viewport as tall as its content, never showed a scrollbar and
       spilled out of the widget cell. The star row gives it a real height to scroll inside. -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="8">

    <!-- Summary KPI strip -->
    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="AVG RATE" Foreground="#5A7A90" FontSize="9" />
        <TextBlock Text="{Binding FundingRateVM.AvgRateLabel}"
                   FontSize="14" FontWeight="Bold" Foreground="#8B949E" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Text="EXTREMES" Foreground="#5A7A90" FontSize="9" />
        <TextBlock Text="{Binding FundingRateVM.ExtremeCount}"
                   FontSize="14" FontWeight="Bold" Foreground="#F4B860" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="2">
        <TextBlock Text="BEST SHORT" Foreground="#5A7A90" FontSize="9" />
        <TextBlock Text="{Binding FundingRateVM.TopBearishLabel}"
                   FontSize="11" FontWeight="SemiBold" Foreground="#FF5D73" />
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="2">
        <TextBlock Text="BEST LONG" Foreground="#5A7A90" FontSize="9" />
        <TextBlock Text="{Binding FundingRateVM.TopBullishLabel}"
                   FontSize="11" FontWeight="SemiBold" Foreground="#3DDC84" />
      </StackPanel>
    </Grid>

    <!-- Table header. Proportional, not fixed: 310px of fixed columns plus spacing did not fit
         the widget's own width at 1366 and collapsed SYMBOL to nothing. -->
    <Grid ColumnSpacing="6" Margin="0,2,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.4*" MinWidth="70" />
        <ColumnDefinition Width="0.9*" MinWidth="52" />
        <ColumnDefinition Width="0.9*" MinWidth="52" />
        <ColumnDefinition Width="0.8*" MinWidth="48" />
        <ColumnDefinition Width="0.9*" MinWidth="52" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="SYMBOL"  Foreground="#5A7A90" FontSize="9" FontWeight="Bold" />
      <TextBlock Grid.Column="1" Text="RATE"    Foreground="#5A7A90" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="2" Text="ANNL."   Foreground="#5A7A90" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="3" Text="MARK $"  Foreground="#5A7A90" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="4" Text="NEXT"    Foreground="#5A7A90" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
    </Grid>
    </StackPanel>

    <!-- Rates list -->

    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding FundingRateVM.DisplayRates}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FundingRateRowViewModel">
            <Border Padding="0,4" BorderBrush="#12283A" BorderThickness="0,0,0,1">
              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.4*" MinWidth="70" />
                  <ColumnDefinition Width="0.9*" MinWidth="52" />
                  <ColumnDefinition Width="0.9*" MinWidth="52" />
                  <ColumnDefinition Width="0.8*" MinWidth="48" />
                  <ColumnDefinition Width="0.9*" MinWidth="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Symbol}" TextTrimming="CharacterEllipsis"
                           Foreground="#C8D8E8" FontWeight="SemiBold" FontSize="11"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FundingRatePct}" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding RateColor}" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                <TextBlock Grid.Column="2" Text="{Binding AnnualizedLabel}" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding RateColor}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
                <TextBlock Grid.Column="3" Text="{Binding MarkPriceLabel}" TextTrimming="CharacterEllipsis"
                           Foreground="#8B949E"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
                <TextBlock Grid.Column="4" Text="{Binding NextFundingLabel}" TextTrimming="CharacterEllipsis"
                           Foreground="#5A7080"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Classes="WidgetEmpty"
               IsVisible="{Binding !FundingRateVM.DisplayRates.Count}"
               Text="No funding rates loaded yet. Refresh the Funding desk to pull perpetual rates." />

  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.GasWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <StackPanel Spacing="8">

    <!-- Explains the "–" placeholders in the cards below while the first snapshot is in flight -->
    <TextBlock Classes="WidgetEmpty" Margin="0"
               IsVisible="{Binding GasMonitorVM.IsLoading}"
               Text="Fetching gas prices…" />

    <!-- Three-column gas cards -->
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

      <!-- Ethereum -->
      <Border Grid.Column="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="10,8">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Ξ" FontSize="{DynamicResource FsSubhead}" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="Ethereum" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="3">
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Slow"     Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
            <TextBlock Grid.Column="1" Grid.Row="0" Text="Std"      Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
            <TextBlock Grid.Column="2" Grid.Row="0" Text="Fast"     Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
            <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding GasMonitorVM.EthSlowLabel}"
                       Foreground="{Binding GasMonitorVM.EthSlowColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding GasMonitorVM.EthStdLabel}"
                       Foreground="{Binding GasMonitorVM.EthStdColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding GasMonitorVM.EthFastLabel}"
                       Foreground="{Binding GasMonitorVM.EthFastColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" />
            <TextBlock Grid.Column="0" Grid.Row="2" Text="{Binding GasMonitorVM.EthSlowTimeLabel}"
                       Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
            <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding GasMonitorVM.EthStdTimeLabel}"
                       Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
            <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding GasMonitorVM.EthFastTimeLabel}"
                       Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- BSC -->
      <Border Grid.Column="1" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="10,8">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="⬡" FontSize="{DynamicResource FsSmall}" Foreground="#F0B90B" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="BNB Chain" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="3">
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Slow"     Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
            <TextBlock Grid.Column="1" Grid.Row="0" Text="Std"      Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
            <TextBlock Grid.Column="2" Grid.Row="0" Text="Fast"     Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
            <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding GasMonitorVM.BscSlowLabel}"
                       Foreground="{Binding GasMonitorVM.BscSlowColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding GasMonitorVM.BscStdLabel}"
                       Foreground="{Binding GasMonitorVM.BscStdColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding GasMonitorVM.BscFastLabel}"
                       Foreground="{Binding GasMonitorVM.BscFastColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Solana -->
      <Border Grid.Column="2" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="10,8">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="◎" FontSize="{DynamicResource FsSubhead}" Foreground="#9B59B6" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="Solana" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="TPS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
            <TextBlock Text="{Binding GasMonitorVM.SolanaTpsLabel}"
                       Foreground="{Binding GasMonitorVM.SolanaColor, Converter={StaticResource StringToBrush}}"
                       FontSize="{DynamicResource FsTitle}" FontWeight="Bold" />
          </StackPanel>
        </StackPanel>
      </Border>

    </Grid>

    <!-- Last updated -->
    <TextBlock Text="{Binding GasMonitorVM.LastUpdatedLabel}"
               Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" HorizontalAlignment="Right" />

  </StackPanel>
</UserControl>

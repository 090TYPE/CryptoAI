<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.NewsWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <StackPanel Spacing="8">

    <!-- AI Market Pulse summary -->
    <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1"
            CornerRadius="6" Padding="10,8">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
        <Border Grid.Column="0" Background="{Binding NewsFeedVM.PulseBrush, Converter={StaticResource StringToBrush}}" CornerRadius="3" Padding="6,2">
          <TextBlock Text="{Binding NewsFeedVM.PulseLabel}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding NewsFeedVM.AiDigest}"
                   Foreground="{Binding NewsFeedVM.AiDigestBrush, Converter={StaticResource StringToBrush}}"
                   FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" Margin="8,0,0,0" MaxLines="2" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Refreshing AI digest…"
                   IsVisible="{Binding NewsFeedVM.AiDigestRunning}"
                   Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" Margin="0,4,0,0" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NewsFeedVM.AiDigestSource}"
                   IsVisible="{Binding !NewsFeedVM.AiDigestRunning}"
                   Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </Grid>
    </Border>

    <!-- Status + unread badge -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding NewsFeedVM.StatusLabel}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
      <Border IsVisible="{Binding NewsFeedVM.HasUnread}"
              Background="{DynamicResource Negative}" CornerRadius="8" Padding="4,1">
        <TextBlock Text="{Binding NewsFeedVM.UnreadBadge, StringFormat='{}{0} new'}"
                   Foreground="White" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
      </Border>
    </StackPanel>

    <!-- Loading state -->
    <TextBlock IsVisible="{Binding NewsFeedVM.IsLoading}"
               Text="Fetching news…"
               Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsCaption}" />

    <!-- News rows -->
    <ScrollViewer IsVisible="{Binding !NewsFeedVM.IsLoading}"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding NewsFeedVM.Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:NewsItemRowVM}">
            <Border Background="{Binding SentimentBackground, Converter={StaticResource StringToBrush}}"
                    CornerRadius="3" Padding="8,4" Margin="0,1"
                    BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <!-- Sentiment badge -->
                <Border Grid.Column="0" CornerRadius="3" Padding="4,2" VerticalAlignment="Top" Margin="0,1,0,0">
                  <Border.Background>
                    <SolidColorBrush Color="{Binding SentimentBrush}" Opacity="0.15" />
                  </Border.Background>
                  <TextBlock Text="{Binding SentimentLabel}"
                             Foreground="{Binding SentimentBrush, Converter={StaticResource StringToBrush}}"
                             FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                </Border>
                <!-- Title + meta -->
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
                    <TextBlock Text="·" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                    <TextBlock Text="{Binding AgeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
                  </StackPanel>
                </StackPanel>
                <!-- Votes -->
                <TextBlock Grid.Column="2" Text="{Binding VotesLabel}"
                           Foreground="{Binding VotesBrush, Converter={StaticResource StringToBrush}}"
                           FontSize="{DynamicResource FsMicro}" FontWeight="Bold"
                           VerticalAlignment="Top" Margin="0,1,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </StackPanel>
</UserControl>

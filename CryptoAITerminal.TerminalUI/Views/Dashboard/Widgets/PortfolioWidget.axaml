<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.PortfolioWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <!-- Grid, not StackPanel: StackPanel measures with infinite height, so the asset ScrollViewer
       two levels down never got a bounded viewport — no scrollbar, and the list spilled out of the
       widget cell. The Portfolio Lens row is the star one so the list scrolls inside it. -->
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Active session + live route KPIs -->
    <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="10">
      <Border Grid.Column="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1"
              CornerRadius="6" Padding="10,8">
        <StackPanel Spacing="4">
          <TextBlock Text="Active Session" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
          <TextBlock Text="{Binding WalletVM.ActiveWalletBanner}"
                     Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WalletVM.WalletReadinessLabel}"
                     Foreground="{Binding WalletVM.WalletReadinessBrush, Converter={StaticResource StringToBrush}}"
                     FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1"
              CornerRadius="6" Padding="10,8">
        <StackPanel Spacing="4">
          <TextBlock Text="Native Balance" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
          <TextBlock Text="{Binding WalletVM.NativeBalanceLabel}"
                     Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" />
          <TextBlock Text="{Binding WalletVM.RouteReadinessLabel}"
                     Foreground="{Binding WalletVM.RouteReadinessBrush, Converter={StaticResource StringToBrush}}"
                     FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Portfolio Lens assets -->
    <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <TextBlock Grid.Row="0" Text="Portfolio Lens" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding WalletVM.Assets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WalletAssetViewModel">
                <Border Background="{DynamicResource Surface1}"
                        BorderBrush="#30363D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Width="180"
                        Margin="0,0,8,8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
                    <TextBlock Text="{Binding Value}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Classes="WidgetEmpty"
                   IsVisible="{Binding !WalletVM.Assets.Count}"
                   Text="No wallet assets yet. Connect or select a wallet on the Portfolio desk to fill the lens." />
      </Grid>
    </Border>

    <!-- Status -->
    <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding WalletVM.StatusMessage}"
               Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />

  </Grid>
</UserControl>

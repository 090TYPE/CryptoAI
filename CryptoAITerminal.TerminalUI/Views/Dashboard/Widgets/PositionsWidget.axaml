<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.PositionsWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <StackPanel Spacing="8">

    <!-- Totals summary -->
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="{Binding AllPositionsVM.TotalPnlLabel}"
                 Foreground="{Binding AllPositionsVM.TotalPnlBrush, Converter={StaticResource StringToBrush}}"
                 FontSize="{DynamicResource FsTitle}" FontWeight="Bold" />
      <TextBlock Text="{Binding AllPositionsVM.TotalSizeLabel}"
                 Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Bottom" />
      <TextBlock Text="{Binding AllPositionsVM.StatusLabel}"
                 Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Bottom" />
    </StackPanel>

    <!-- Table header -->
    <Grid ColumnDefinitions="90,70,50,70,70,70,*" ColumnSpacing="6" Margin="0,2,0,0">
      <TextBlock Grid.Column="0" Text="EXCHANGE" Classes="Overline" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="SYMBOL"   Classes="Overline" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="SIDE"     Classes="Overline" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="3" Text="ENTRY"    Classes="Overline" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="4" Text="SIZE"     Classes="Overline" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="5" Text="LEV/LIQ"  Classes="Overline" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="6" Text="PNL"      Classes="Overline" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
    </Grid>
    <Border Height="1" Background="#17263A" />

    <!-- Empty state -->
    <Border IsVisible="{Binding AllPositionsVM.HasNoPositions}"
            Background="{DynamicResource Surface0}" CornerRadius="4" Padding="12,10">
      <TextBlock Text="No open futures positions"
                 Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsSmall}" HorizontalAlignment="Center" />
    </Border>

    <!-- Positions list -->
    <ScrollViewer IsVisible="{Binding AllPositionsVM.HasPositions}"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding AllPositionsVM.Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:UnifiedPositionRowVM}">
            <Border Background="{DynamicResource Surface0}" CornerRadius="3" Padding="6,4" Margin="0,1">
              <Grid ColumnDefinitions="90,70,50,70,70,70,*" ColumnSpacing="6">
                <!-- Exchange badge -->
                <Border Grid.Column="0" Background="{DynamicResource Surface2}" CornerRadius="3" Padding="4,1"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Exchange}"
                             Foreground="{Binding ExchangeBrush, Converter={StaticResource StringToBrush}}"
                             FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" />
                </Border>
                <!-- Symbol -->
                <TextBlock Grid.Column="1" Text="{Binding Symbol}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <!-- Side -->
                <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="3" Padding="4,1"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Side}"
                             Foreground="{Binding SideBrush, Converter={StaticResource StringToBrush}}"
                             FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                </Border>
                <!-- Entry price -->
                <TextBlock Grid.Column="3" Text="{Binding EntryPriceLabel}"
                           Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                <!-- Size -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsCaption}" />
                  <TextBlock Text="{Binding NotionalLabel}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
                </StackPanel>
                <!-- Leverage / Liq -->
                <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding LeverageLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
                  <TextBlock Text="{Binding LiqLabel}" Foreground="{DynamicResource Negative}" FontSize="{DynamicResource FsMicro}" />
                </StackPanel>
                <!-- PnL -->
                <TextBlock Grid.Column="6" Text="{Binding PnlLabel}"
                           Foreground="{Binding PnlBrush, Converter={StaticResource StringToBrush}}"
                           FontSize="{DynamicResource FsSmall}" FontWeight="Bold"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </StackPanel>
</UserControl>

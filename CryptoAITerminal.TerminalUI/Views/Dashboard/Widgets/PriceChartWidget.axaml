<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:ctrl="clr-namespace:CryptoAITerminal.TerminalUI.Controls"
             xmlns:conv="clr-namespace:CryptoAITerminal.TerminalUI.Converters"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.PriceChartWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True">
  <UserControl.Resources>
    <conv:StringEqualsConverter x:Key="StrEq" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

    <!-- Symbol + timeframe toolbar -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding MarketFeedVM.SelectedMarket.DisplaySymbol}" Foreground="{DynamicResource TextPrimary}"
                   FontWeight="Bold" FontSize="{DynamicResource FsSubhead}" />
        <TextBlock Classes="Mono" Text="{Binding MarketFeedVM.SelectedMarket.LastPrice, StringFormat='{}{0:N2}'}"
                   Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding MarketFeedVM.SelectedMarket.ChangePercentLabel}"
                   Foreground="{Binding MarketFeedVM.SelectedMarket.ChangeBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSmall}"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
        <!-- Same mechanism as the trading desk: the .active class carries the accent, so the
             widget no longer needs a dozen hard-coded hex chip properties on the shell. -->
        <Button Classes="TfButton" Content="1m"  Command="{Binding ChartPanelVM.SelectTradeTimeframeCommand}" CommandParameter="1M"
                Classes.active="{Binding ChartPanelVM.SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=1M}" />
        <Button Classes="TfButton" Content="5m"  Command="{Binding ChartPanelVM.SelectTradeTimeframeCommand}" CommandParameter="5M"
                Classes.active="{Binding ChartPanelVM.SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=5M}" />
        <Button Classes="TfButton" Content="15m" Command="{Binding ChartPanelVM.SelectTradeTimeframeCommand}" CommandParameter="15M"
                Classes.active="{Binding ChartPanelVM.SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=15M}" />
        <Button Classes="TfButton" Content="1H"  Command="{Binding ChartPanelVM.SelectTradeTimeframeCommand}" CommandParameter="1H"
                Classes.active="{Binding ChartPanelVM.SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=1H}" />
        <Button Classes="TfButton" Content="4H"  Command="{Binding ChartPanelVM.SelectTradeTimeframeCommand}" CommandParameter="4H"
                Classes.active="{Binding ChartPanelVM.SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=4H}" />
        <Button Classes="TfButton" Content="1D"  Command="{Binding ChartPanelVM.SelectTradeTimeframeCommand}" CommandParameter="1D"
                Classes.active="{Binding ChartPanelVM.SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=1D}" />
      </StackPanel>
    </Grid>

    <!-- Chart -->
    <Border Grid.Row="1" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1"
            CornerRadius="10" Padding="6">
      <ctrl:CexPriceChart HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Points="{Binding MarketFeedVM.SelectedMarket.ChartPoints}"
                          IsPositiveTrend="{Binding MarketFeedVM.SelectedMarket.IsPositiveTrend}" />
    </Border>

    <!-- Metric chips -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
      <Border Classes="StatCell" Grid.Column="0" Padding="10,6">
        <StackPanel Spacing="1">
          <TextBlock Classes="StatLabel" Text="24H HIGH" />
          <TextBlock Classes="Mono" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Positive}"
                     Text="{Binding ChartPanelVM.ChartHighLabel}" />
        </StackPanel>
      </Border>
      <Border Classes="StatCell" Grid.Column="1" Padding="10,6">
        <StackPanel Spacing="1">
          <TextBlock Classes="StatLabel" Text="24H LOW" />
          <TextBlock Classes="Mono" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Negative}"
                     Text="{Binding ChartPanelVM.ChartLowLabel}" />
        </StackPanel>
      </Border>
      <Border Classes="StatCell" Grid.Column="2" Padding="10,6">
        <StackPanel Spacing="1">
          <TextBlock Classes="StatLabel" Text="VOLUME" />
          <TextBlock Classes="Mono" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"
                     Text="{Binding ChartPanelVM.ChartVolumeLabel}" />
        </StackPanel>
      </Border>
      <Border Classes="StatCell" Grid.Column="3" Padding="10,6">
        <StackPanel Spacing="1">
          <TextBlock Classes="StatLabel" Text="LAST TICK" />
          <TextBlock Classes="Mono" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"
                     Text="{Binding MarketFeedVM.SelectedMarket.UpdatedLabel}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

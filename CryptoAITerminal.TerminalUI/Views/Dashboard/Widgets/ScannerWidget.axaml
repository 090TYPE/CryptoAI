<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.ScannerWidget"
             x:DataType="vm:MarketScannerViewModel"
             x:CompileBindings="True">
  <!-- Grid, not StackPanel: a StackPanel measures its children with infinite height, so the
       ScrollViewer below got a viewport as tall as its content, never showed a scrollbar and
       spilled out of the widget cell. The star row gives it a real height to scroll inside. -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="8">

    <!-- KPI strip -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Border Background="{DynamicResource Surface3}" CornerRadius="6" Padding="10,4">
        <StackPanel Spacing="1" HorizontalAlignment="Center">
          <TextBlock Text="Total" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding TotalSymbols}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold"
                     Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource PositiveTint}" CornerRadius="6" Padding="10,4">
        <StackPanel Spacing="1" HorizontalAlignment="Center">
          <TextBlock Text="Hot" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding HotCount}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold"
                     Foreground="#FF6B00" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Background="#0A1F0A" CornerRadius="6" Padding="10,4">
        <StackPanel Spacing="1" HorizontalAlignment="Center">
          <TextBlock Text="Gainers" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding GainersCount}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold"
                     Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource NegativeFill}" CornerRadius="6" Padding="10,4">
        <StackPanel Spacing="1" HorizontalAlignment="Center">
          <TextBlock Text="Losers" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LosersCount}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold"
                     Foreground="#FF5555" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Table header -->
    <Grid ColumnDefinitions="20,*,80,70,80,60">
      <TextBlock Grid.Column="0" Text="" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
      <TextBlock Grid.Column="1" Text="SYMBOL"  Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
      <TextBlock Grid.Column="2" Text="PRICE"   Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="3" Text="24h %"   Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="4" Text="VOLUME"  Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="5" Text="RSI"     Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" HorizontalAlignment="Right" />
    </Grid>
    <Rectangle Height="1" Fill="#1E3A5F" />
    </StackPanel>

    <!-- Scanner rows -->

    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ScanRowVM">
            <Border Background="{Binding RowBackground}" Margin="0,1" Padding="0">
              <Grid ColumnDefinitions="20,*,80,70,80,60" Margin="2,4">
                <TextBlock Grid.Column="0" Text="{Binding HotBadgeText}"
                           FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Symbol}" FontSize="{DynamicResource FsCaption}"
                             FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock Text="{Binding Exchange}" FontSize="{DynamicResource FsMicro}"
                             Foreground="{DynamicResource TextDim}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding PriceLabel}"
                           FontFamily="Consolas" FontSize="{DynamicResource FsMicro}"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding ChangeLabel}"
                           FontFamily="Consolas" FontSize="{DynamicResource FsCaption}"
                           FontWeight="SemiBold"
                           Foreground="{Binding ChangeBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding VolumeLabel}"
                           FontFamily="Consolas" FontSize="{DynamicResource FsMicro}"
                           Foreground="{DynamicResource TextDim}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding RsiLabel}"
                           FontFamily="Consolas" FontSize="{DynamicResource FsCaption}"
                           FontWeight="SemiBold"
                           Foreground="{Binding RsiBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Classes="WidgetEmpty"
               IsVisible="{Binding !Rows.Count}"
               Text="Scanner has no results yet. Run a scan on the Scanner desk or relax its filters." />

  </Grid>
</UserControl>

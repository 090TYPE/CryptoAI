<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.TapeWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <!-- Grid, not StackPanel: a StackPanel measures its children with infinite height, so the
       ScrollViewer below got a viewport as tall as its content, never showed a scrollbar and
       spilled out of the widget cell. The star row gives it a real height to scroll inside. -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="8">

    <!-- Pressure + status summary -->
    <StackPanel Spacing="3">
      <TextBlock Text="{Binding MarketTapeVM.PressureLabel}" FontWeight="SemiBold"
                 Foreground="{Binding MarketTapeVM.PressureBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSmall}" />
      <TextBlock Text="{Binding MarketTapeVM.StatusLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
    </StackPanel>

    <!-- Column headers. Proportional, not fixed: the old 328px of fixed columns exceeded the
         widget's own width at 1366 and squeezed the star columns to nothing. -->
    <Grid Margin="0,0,0,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.5*"  MinWidth="24" />
        <ColumnDefinition Width="1*"    MinWidth="46" />
        <ColumnDefinition Width="0.55*" MinWidth="28" />
        <ColumnDefinition Width="1.1*"  MinWidth="48" />
        <ColumnDefinition Width="1*"    MinWidth="40" />
        <ColumnDefinition Width="0.9*"  MinWidth="40" />
        <ColumnDefinition Width="1.05*" MinWidth="40" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Src"    Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
      <TextBlock Grid.Column="1" Text="Time"   Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
      <TextBlock Grid.Column="2" Text="Side"   Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
      <TextBlock Grid.Column="3" Text="Price"  Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
      <TextBlock Grid.Column="4" Text="Qty"    Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
      <TextBlock Grid.Column="5" Text="USD"    Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="6" Text="Wallet" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
    </Grid>
    </StackPanel>

    <!-- Trade tape -->

    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding MarketTapeVM.Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{Binding RowBrush, Converter={StaticResource StringToBrush}}" CornerRadius="2" Padding="2,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.5*"  MinWidth="24" />
                  <ColumnDefinition Width="1*"    MinWidth="46" />
                  <ColumnDefinition Width="0.55*" MinWidth="28" />
                  <ColumnDefinition Width="1.1*"  MinWidth="48" />
                  <ColumnDefinition Width="1*"    MinWidth="40" />
                  <ColumnDefinition Width="0.9*"  MinWidth="40" />
                  <ColumnDefinition Width="1.05*" MinWidth="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding VenueLabel}" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding VenueBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" TextTrimming="CharacterEllipsis"
                           FontFamily="Cascadia Code,Consolas,monospace" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" />
                <TextBlock Grid.Column="2" Text="{Binding Side}" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding SideBrush, Converter={StaticResource StringToBrush}}" FontWeight="{Binding Weight}" FontSize="{DynamicResource FsCaption}" />
                <TextBlock Grid.Column="3" Text="{Binding PriceLabel}" TextTrimming="CharacterEllipsis"
                           FontFamily="Cascadia Code,Consolas,monospace" FontWeight="{Binding Weight}" FontSize="{DynamicResource FsCaption}" />
                <TextBlock Grid.Column="4" Text="{Binding QtyLabel}" TextTrimming="CharacterEllipsis"
                           FontFamily="Cascadia Code,Consolas,monospace" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="5" Text="{Binding QuoteLabel}" TextTrimming="CharacterEllipsis"
                           FontFamily="Cascadia Code,Consolas,monospace" FontWeight="{Binding Weight}" FontSize="{DynamicResource FsCaption}"
                           HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="6" Text="{Binding TraderLabel}" TextTrimming="CharacterEllipsis"
                           FontFamily="Cascadia Code,Consolas,monospace" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Classes="WidgetEmpty"
               IsVisible="{Binding !MarketTapeVM.Rows.Count}"
               Text="No prints on the tape yet. Open the Tape desk and start the feed for the selected market." />

  </Grid>
</UserControl>

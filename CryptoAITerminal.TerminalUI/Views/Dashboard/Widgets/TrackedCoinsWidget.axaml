<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:ctrl="clr-namespace:CryptoAITerminal.TerminalUI.Controls"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.TrackedCoinsWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">

    <!-- Count badge + loading -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="Loading markets…" Classes="StatLabel"
                 VerticalAlignment="Center" IsVisible="{Binding IsMarketLoading}" />
      <Border Grid.Column="1" Classes="CountBadge">
        <TextBlock Text="{Binding Markets.Count, StringFormat='{}{0} coins'}"
                   Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <!-- Column headers -->
    <Grid Grid.Row="1" ColumnDefinitions="34,*,66,Auto" ColumnSpacing="8" Margin="2,0,4,0">
      <TextBlock Grid.Column="1" Text="SYMBOL" Classes="StatLabel" />
      <TextBlock Grid.Column="2" Text="TREND" Classes="StatLabel" HorizontalAlignment="Center" />
      <TextBlock Grid.Column="3" Text="PRICE / 24H" Classes="StatLabel"
                 HorizontalAlignment="Right" MinWidth="92" TextAlignment="Right" />
    </Grid>

    <!-- Rows -->
    <ScrollViewer Grid.Row="2" Classes="PageScroll">
      <ListBox ItemsSource="{Binding Markets}"
               SelectedItem="{Binding SelectedMarket}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CexMarketItemViewModel">
            <Grid ColumnDefinitions="34,*,66,Auto" ColumnSpacing="8" VerticalAlignment="Center">
              <!-- Icon -->
              <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                      Background="{Binding LogoBackground, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center">
                <TextBlock Text="{Binding LogoText}" Foreground="{Binding LogoForeground, Converter={StaticResource StringToBrush}}"
                           FontWeight="Bold" FontSize="{DynamicResource FsBody}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <!-- Pair + exchange -->
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplaySymbol}" Foreground="{DynamicResource TextPrimary}"
                           FontWeight="Bold" FontSize="{DynamicResource FsSmall}" />
                <TextBlock Text="{Binding Exchange}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
              </StackPanel>
              <!-- Sparkline -->
              <ctrl:CexPriceChart Grid.Column="2" Height="26" Width="60"
                                  VerticalAlignment="Center"
                                  Points="{Binding ChartPoints}"
                                  IsPositiveTrend="{Binding IsPositiveTrend}" />
              <!-- Price + change. MinWidth guarantees the number never gets squeezed by the
                   symbol column and clipped; the right margin keeps it clear of the
                   auto-hiding scrollbar that overlays this list. -->
              <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center"
                          HorizontalAlignment="Right" MinWidth="92" Margin="0,0,6,0">
                <TextBlock Classes="Mono" Text="{Binding LastPrice, StringFormat='{}{0:N2}'}"
                           Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ChangePercentLabel}"
                           Foreground="{Binding ChangeBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Classes="WidgetEmpty"
               IsVisible="{Binding !Markets.Count}"
               Text="No markets tracked yet. Add pairs on the Markets desk to watch them here." />
  </Grid>
</UserControl>

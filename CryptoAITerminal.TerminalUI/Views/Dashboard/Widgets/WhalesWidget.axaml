<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:wt="clr-namespace:CryptoAITerminal.WhaleTracker.Models;assembly=CryptoAITerminal.WhaleTracker"
             x:Class="CryptoAITerminal.TerminalUI.Views.Dashboard.Widgets.WhalesWidget"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <!-- Grid, not StackPanel: a StackPanel measures its children with infinite height, so the
       ScrollViewer below got a viewport as tall as its content, never showed a scrollbar and
       spilled out of the widget cell. The star row gives it a real height to scroll inside. -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="8">

    <!-- Stats row -->
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
      <Border Grid.Column="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock Text="Min Transfer" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
          <TextBlock Text="{Binding WhaleTrackerVM.MinUsdValue, StringFormat='${0:N0}'}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock Text="Alerts" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
          <TextBlock Text="{Binding WhaleTrackerVM.TotalAlertsCount}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock Text="Labeled" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
          <TextBlock Text="{Binding WhaleTrackerVM.LabeledAlertsCount}" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding WhaleTrackerVM.KnownWalletCount, StringFormat='{}{0} wallets tracked'}"
                 Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
    </StackPanel>
    </StackPanel>

    <!-- Live whale alerts list -->

    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding WhaleTrackerVM.RecentAlerts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WhaleAlertViewModel">
            <Border Padding="8,6" Margin="0,1" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <!-- Chain badge -->
                <Border Grid.Column="0" CornerRadius="3" Padding="4,1" Background="{DynamicResource Surface3}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ChainBadge}" Foreground="{Binding ChainBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                </Border>
                <!-- Alert type -->
                <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Background="{DynamicResource Surface3}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AlertBadge}" Foreground="{Binding AlertBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                </Border>
                <!-- Amount + description -->
                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding AmountLabel}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="{DynamicResource FsSmall}" />
                    <TextBlock Text="{Binding TokenSymbol}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" />
                  <TextBlock Text="{Binding ActiveWalletLabel}" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsMicro}" IsVisible="{Binding HasLabel}" />
                </StackPanel>
                <!-- Time -->
                <TextBlock Grid.Column="3" Text="{Binding TimeLabel}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Classes="WidgetEmpty"
               IsVisible="{Binding !WhaleTrackerVM.RecentAlerts.Count}"
               Text="No whale transfers yet. Start tracking on the Whale Tracker desk — transfers above the minimum show up here." />

  </Grid>
</UserControl>

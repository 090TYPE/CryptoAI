<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.DexPortfolioView"
             x:DataType="vm:DexTradingViewModel"
             FontFamily="{StaticResource FontDisplay}">
  <UserControl.Styles>
    <StyleInclude Source="avares://CryptoAITerminal.TerminalUI/Styles/TradingDeskStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="10" Margin="0,12,0,0">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="TdLabel" Text="PORTFOLIO VALUE" />
        <TextBlock Classes="TdNum" Text="{Binding PortfolioTotalLabel}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="{DynamicResource FsTitle}" />
      </StackPanel>
      <Button Grid.Column="1" Content="↻ Refresh" Classes="TdSeg dex" Padding="10,4" VerticalAlignment="Center" Command="{Binding RefreshPortfolioCommand}" />
    </Grid>

    <Border Classes="TdCard">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Native balance" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding PortfolioNativeLabel}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="{DynamicResource FsSmall}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <StackPanel Spacing="3">
      <TextBlock Classes="TdLabel" Text="COVALENT (GOLDRUSH) API KEY — OPTIONAL" />
      <TextBox Text="{Binding PortfolioApiKey}" PlaceholderText="paste key for cross-chain holdings + USD value"
               PasswordChar="•" FontSize="{DynamicResource FsMicro}" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource PanelStrokeBright}" Foreground="{DynamicResource TextSecondary}" />
      <TextBlock Text="{Binding PortfolioModeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10" Margin="2,0">
      <TextBlock Classes="TdLabel" Text="TOKEN" />
      <TextBlock Grid.Column="1" Classes="TdLabel" Text="BALANCE" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="2" Classes="TdLabel" Text="VALUE" HorizontalAlignment="Right" />
    </Grid>
    <ItemsControl ItemsSource="{Binding PortfolioHoldings}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DexHoldingViewModel">
          <Border Classes="TdCardTight" Margin="0,0,0,4">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
              <TextBlock Text="{Binding Symbol}" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding BalanceLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding ValueLabel}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="{DynamicResource FsCaption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="No tracked holdings on the wallet's active network yet. Add tokens to the watchlist and connect a wallet — balances are read live for the current chain."
               Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" IsVisible="{Binding ShowPortfolioPlaceholder}" />
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.DexTokenProfileView"
             x:DataType="vm:DexTradingViewModel"
             FontFamily="{StaticResource FontDisplay}">
  <UserControl.Styles>
    <StyleInclude Source="avares://CryptoAITerminal.TerminalUI/Styles/TradingDeskStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
    <StackPanel Spacing="10" Margin="0,12,0,0">

      <!-- Header / banner image -->
      <Border CornerRadius="8" ClipToBounds="True" Height="86" Background="#07111a" IsVisible="{Binding TokenMeta.HasBanner}">
        <Image Source="{Binding TokenMeta.Banner}" Stretch="UniformToFill" />
      </Border>

      <!-- Identity -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Border Width="46" Height="46" CornerRadius="10" ClipToBounds="True" Background="#150a20" BorderBrush="#3a1f6e" BorderThickness="1">
          <Panel>
            <TextBlock Text="◈" Foreground="#a855f7" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !TokenMeta.HasLogo}" />
            <Image Source="{Binding TokenMeta.Logo}" Stretch="UniformToFill" IsVisible="{Binding TokenMeta.HasLogo}" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding TokenMeta.Name}" Foreground="#e8f4ff" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TokenMeta.Symbol}" Foreground="#a855f7" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
            <Border Background="#07221a" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding TokenMeta.IsVerified}">
              <TextBlock Text="✔ VERIFIED" Foreground="#3ddc84" FontSize="8" FontWeight="Bold" />
            </Border>
          </StackPanel>
          <TextBlock Classes="TdSub" Text="{Binding TokenMeta.CategoriesLabel}" FontSize="10" IsVisible="{Binding TokenMeta.HasCategories}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="2" Background="#0a1622" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="{Binding TokenMeta.HoneypotLabel}" Foreground="{Binding TokenMeta.HoneypotBrush}" FontWeight="Bold" FontSize="9" />
        </Border>
      </Grid>

      <!-- Price + changes -->
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel Spacing="1">
          <TextBlock Classes="TdLabel" Text="PRICE USD" />
          <TextBlock Classes="TdNum" Text="{Binding DexPriceUsdLabel}" Foreground="#a855f7" FontWeight="Bold" FontSize="15" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
          <TextBlock Classes="TdLabel" Text="5M" HorizontalAlignment="Right" />
          <TextBlock Classes="TdNum" Text="{Binding DexChange5mLabel}" Foreground="{Binding DexChange5mBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right">
          <TextBlock Classes="TdLabel" Text="1H" HorizontalAlignment="Right" />
          <TextBlock Classes="TdNum" Text="{Binding DexChange1hLabel}" Foreground="{Binding DexChange1hBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel Grid.Column="3" Spacing="1" HorizontalAlignment="Right">
          <TextBlock Classes="TdLabel" Text="24H" HorizontalAlignment="Right" />
          <TextBlock Classes="TdNum" Text="{Binding DexChange24hLabel}" Foreground="{Binding DexChange24hBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>

      <!-- Contract -->
      <Border Classes="TdCard">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <TextBlock Text="CONTRACT" Classes="TdLabel" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding TokenMeta.ContractAddress}" IsReadOnly="True" Classes="TdInput" Foreground="#c8dcef" FontSize="11" VerticalContentAlignment="Center" />
          <Button Grid.Column="2" Content="Explorer ↗" Classes="TdSeg dex" Padding="8,4" Command="{Binding TokenMeta.OpenExplorerCommand}" />
        </Grid>
      </Border>

      <!-- Community / socials -->
      <WrapPanel>
        <Button Content="🌐 Website"   Classes="TdSeg" Padding="9,4" Margin="0,0,6,6" Command="{Binding TokenMeta.OpenWebsiteCommand}"   IsVisible="{Binding TokenMeta.HasWebsite}" />
        <Button Content="𝕏 Twitter"    Classes="TdSeg" Padding="9,4" Margin="0,0,6,6" Command="{Binding TokenMeta.OpenTwitterCommand}"   IsVisible="{Binding TokenMeta.HasTwitter}" />
        <Button Content="✈ Telegram"   Classes="TdSeg" Padding="9,4" Margin="0,0,6,6" Command="{Binding TokenMeta.OpenTelegramCommand}"  IsVisible="{Binding TokenMeta.HasTelegram}" />
        <Button Content="💬 Discord"   Classes="TdSeg" Padding="9,4" Margin="0,0,6,6" Command="{Binding TokenMeta.OpenDiscordCommand}"   IsVisible="{Binding TokenMeta.HasDiscord}" />
        <Button Content="🦎 CoinGecko" Classes="TdSeg" Padding="9,4" Margin="0,0,6,6" Command="{Binding TokenMeta.OpenCoingeckoCommand}" IsVisible="{Binding TokenMeta.HasCoingecko}" />
      </WrapPanel>

      <!-- Market stats -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
        <Border Classes="TdCard"><StackPanel Spacing="2"><TextBlock Classes="TdLabel" Text="LIQUIDITY" /><TextBlock Classes="TdNum" Text="{Binding DexLiquidityLabel}" Foreground="#21e6c1" FontWeight="Bold" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="TdCard"><StackPanel Spacing="2"><TextBlock Classes="TdLabel" Text="MKT CAP" /><TextBlock Classes="TdNum" Text="{Binding DexMarketCapLabel}" Foreground="#c8dcef" FontWeight="Bold" /></StackPanel></Border>
        <Border Grid.Column="2" Classes="TdCard"><StackPanel Spacing="2"><TextBlock Classes="TdLabel" Text="VOL 24H" /><TextBlock Classes="TdNum" Text="{Binding DexVolume24hLabel}" Foreground="#c8dcef" FontWeight="Bold" /></StackPanel></Border>
        <Border Grid.Row="1" Classes="TdCard"><StackPanel Spacing="2"><TextBlock Classes="TdLabel" Text="HOLDERS" /><TextBlock Classes="TdNum" Text="{Binding TokenMeta.HoldersLabel}" Foreground="#c8dcef" FontWeight="Bold" /></StackPanel></Border>
        <Border Grid.Row="1" Grid.Column="1" Classes="TdCard"><StackPanel Spacing="2"><TextBlock Classes="TdLabel" Text="GT SCORE" /><TextBlock Classes="TdNum" Text="{Binding TokenMeta.GtScoreLabel}" Foreground="#a855f7" FontWeight="Bold" /></StackPanel></Border>
        <Border Grid.Row="1" Grid.Column="2" Classes="TdCard"><StackPanel Spacing="2"><TextBlock Classes="TdLabel" Text="PAIR" /><TextBlock Classes="TdNum" Text="{Binding DexPairLabel}" Foreground="#c8dcef" FontWeight="Bold" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
      </Grid>

      <!-- Security -->
      <Border Classes="TdCard" IsVisible="{Binding TokenMeta.HasSecurity}">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <StackPanel Spacing="2">
            <TextBlock Classes="TdLabel" Text="DEV HOLD" />
            <TextBlock Classes="TdNum" Text="{Binding TokenMeta.DeveloperHoldingLabel}" Foreground="{Binding TokenMeta.DeveloperHoldingBrush}" FontWeight="Bold" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="TdLabel" Text="MINT AUTH" />
            <TextBlock Classes="TdNum" Text="{Binding TokenMeta.MintAuthorityLabel}" Foreground="{Binding TokenMeta.MintAuthorityBrush}" FontWeight="Bold" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Classes="TdLabel" Text="FREEZE AUTH" />
            <TextBlock Classes="TdNum" Text="{Binding TokenMeta.FreezeAuthorityLabel}" Foreground="{Binding TokenMeta.FreezeAuthorityBrush}" FontWeight="Bold" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Description -->
      <TextBlock Text="{Binding TokenMeta.Description}" Foreground="#8fa3b8" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

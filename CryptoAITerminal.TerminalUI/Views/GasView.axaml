<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:ctrl="clr-namespace:CryptoAITerminal.TerminalUI.Controls"
             x:Class="CryptoAITerminal.TerminalUI.Views.GasView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
          <StackPanel Spacing="16" IsVisible="{Binding IsGasSectionVisible}">

            <!-- Alert banner -->
            <Border IsVisible="{Binding GasMonitorVM.AlertMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="#1A2D1A" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,1" Padding="14,10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="⚡" FontSize="{DynamicResource FsSubhead}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GasMonitorVM.AlertMessage}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Three-column gas cards row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

              <!-- Ethereum -->
              <Border Grid.Column="0" Background="{DynamicResource Surface2}" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Ξ" FontSize="{DynamicResource FsTitle}" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="Ethereum" Classes="H2" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding GasMonitorVM.IsEthAlertActive}"
                            Background="#163020" CornerRadius="3" Padding="6,2">
                      <TextBlock Text="LOW ⚡" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </Border>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Slow" Classes="Overline" />
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Standard" Classes="Overline" />
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="Fast" Classes="Overline" />
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding GasMonitorVM.EthSlowLabel}"
                               Foreground="{Binding GasMonitorVM.EthSlowColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding GasMonitorVM.EthStdLabel}"
                               Foreground="{Binding GasMonitorVM.EthStdColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding GasMonitorVM.EthFastLabel}"
                               Foreground="{Binding GasMonitorVM.EthFastColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" />
                    <TextBlock Grid.Column="0" Grid.Row="2" Text="{Binding GasMonitorVM.EthSlowTimeLabel}"
                               Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding GasMonitorVM.EthStdTimeLabel}"
                               Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding GasMonitorVM.EthFastTimeLabel}"
                               Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" />
                  </Grid>
                  <!-- ETH alert threshold -->
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <TextBlock Text="Alert below:" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding GasMonitorVM.EthAlertGwei}"
                                  Minimum="1" Maximum="200" Increment="1"
                                  FormatString="N0"
                                  Width="80" Height="26" FontSize="{DynamicResource FsCaption}"
                                  Background="{DynamicResource Surface1}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="gwei" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- BSC -->
              <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⬡" FontSize="{DynamicResource FsSubhead}" Foreground="#F0B90B" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="BNB Chain" Classes="H2" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding GasMonitorVM.IsBscAlertActive}"
                            Background="#163020" CornerRadius="3" Padding="6,2">
                      <TextBlock Text="LOW ⚡" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </Border>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Slow" Classes="Overline" />
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Standard" Classes="Overline" />
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="Fast" Classes="Overline" />
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding GasMonitorVM.BscSlowLabel}"
                               Foreground="{Binding GasMonitorVM.BscSlowColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding GasMonitorVM.BscStdLabel}"
                               Foreground="{Binding GasMonitorVM.BscStdColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding GasMonitorVM.BscFastLabel}"
                               Foreground="{Binding GasMonitorVM.BscFastColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" />
                  </Grid>
                  <!-- BSC alert threshold -->
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <TextBlock Text="Alert below:" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding GasMonitorVM.BscAlertGwei}"
                                  Minimum="1" Maximum="50" Increment="1"
                                  FormatString="N0"
                                  Width="80" Height="26" FontSize="{DynamicResource FsCaption}"
                                  Background="{DynamicResource Surface1}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="gwei" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Solana -->
              <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="◎" FontSize="{DynamicResource FsSubhead}" Foreground="#9B59B6" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="Solana" Classes="H2" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="TPS (avg last 4 samples)" Classes="Overline" />
                    <TextBlock Text="{Binding GasMonitorVM.SolanaTpsLabel}"
                               Foreground="{Binding GasMonitorVM.SolanaColor, Converter={StaticResource StringToBrush}}"
                               FontSize="{DynamicResource FsH2}" FontWeight="Bold" />
                    <TextBlock Text="Solana has no gas — congestion is measured by TPS."
                               Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>

            </Grid>

            <!-- Last updated / Refresh row -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
              <TextBlock Text="{Binding GasMonitorVM.LastUpdatedLabel}"
                         Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
              <Button Content="↻  Refresh" Classes="SecondaryAction"
                      Command="{Binding GasMonitorVM.RefreshCommand}"
                      IsEnabled="{Binding !GasMonitorVM.IsLoading}"
                      Padding="12,4" FontSize="{DynamicResource FsSmall}" />
            </StackPanel>

            <!-- Info note -->
            <Border Background="{DynamicResource Surface1}" CornerRadius="4" Padding="12,8">
              <TextBlock Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap">
                <Run Text="ℹ " />
                <Run Text="Gas prices update every 30 seconds. Powered by Etherscan · BSCScan · Solana RPC.  " />
                <Run Text="Set ETHERSCAN_API_KEY / BSCSCAN_API_KEY environment variables for higher rate limits."
                     Foreground="{DynamicResource TextDim}" />
              </TextBlock>
            </Border>

          </StackPanel>
</UserControl>

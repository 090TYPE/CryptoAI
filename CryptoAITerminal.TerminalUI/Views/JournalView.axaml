<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:ctrl="clr-namespace:CryptoAITerminal.TerminalUI.Controls"
             x:Class="CryptoAITerminal.TerminalUI.Views.JournalView"
             x:DataType="vm:TradeJournalViewModel"
             x:CompileBindings="True">
          <StackPanel Spacing="16">

            <!-- ── Header ── -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
              <!-- No H1 here: the shell already renders the section title (CurrentSectionTitle),
                   so repeating "Trade Journal" showed the heading twice in a row. -->
              <Button Grid.Column="1" Content="⟳ Refresh"
                      Command="{Binding RefreshCommand}"
                      Classes="GhostButton" FontSize="{DynamicResource FsCaption}" />
              <Button Grid.Column="2" Content="⬇ Export CSV"
                      Command="{Binding ExportCsvCommand}"
                      Classes="GhostButton" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource Accent}" />
            </Grid>
            <TextBlock Text="{Binding ExportStatus}"
                       Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsCaption}"
                       IsVisible="{Binding ExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- ── AI Coach (#4) ── -->
            <Border Classes="SurfaceCard" Padding="14,12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="🧠 AI Coach" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsBody}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding CoachSource}"
                             Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <Button Grid.Column="2" Content="Coach with AI"
                          Command="{Binding ReviewWithAiCommand}"
                          IsEnabled="{Binding !CoachRunning}" Foreground="{DynamicResource Accent}" />
                </Grid>
                <StackPanel Spacing="6" IsVisible="{Binding HasCoachReview}">
                  <TextBlock Text="{Binding CoachSummary}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CoachStrengths}" Foreground="{DynamicResource Positive}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap"
                             IsVisible="{Binding CoachStrengths, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding CoachLeaks}" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap"
                             IsVisible="{Binding CoachLeaks, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding CoachSuggestions}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap"
                             IsVisible="{Binding CoachSuggestions, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ── Filters ── -->
            <Border Classes="SurfaceCard">
              <Grid ColumnDefinitions="Auto,160,Auto,160,*" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="Tag" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding TagOptions}"
                          SelectedItem="{Binding FilterTag}"
                          FontSize="{DynamicResource FsCaption}" />
                <TextBlock Grid.Column="2" Text="Period" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding PeriodOptions}"
                          SelectedItem="{Binding FilterPeriod}"
                          FontSize="{DynamicResource FsCaption}" />
                <TextBox Grid.Column="4"
                         Text="{Binding SearchText}"
                         PlaceholderText="Search symbol / notes…"
                         FontSize="{DynamicResource FsCaption}" />
              </Grid>
            </Border>

            <!-- ── Summary ── -->
            <TextBlock Text="{Binding SummaryLabel}"
                       Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />

            <!-- ── Tag statistics ── -->
            <Border Classes="SurfaceCard">
              <StackPanel Spacing="6">
                <TextBlock Text="BY TAG" Classes="Overline" />
                <ItemsControl ItemsSource="{Binding TagStats}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagStatRow">
                      <Grid ColumnDefinitions="110,50,50,80,80" ColumnSpacing="10" Margin="0,2">
                        <Border Grid.Column="0" CornerRadius="3" Padding="6,2"
                                Background="{DynamicResource Surface2}">
                          <TextBlock Text="{Binding TagLabel}"
                                     Foreground="{Binding TagBrush, Converter={StaticResource StringToBrush}}"
                                     FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Trades}"
                                   Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding WinRateLabel}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding PnlLabel}"
                                   Foreground="{Binding PnlBrush, Converter={StaticResource StringToBrush}}"
                                   FontSize="{DynamicResource FsSmall}" FontWeight="Bold" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- ── Trade rows ── -->
            <Border Classes="SurfaceCard">
              <StackPanel Spacing="0">
                <Grid ColumnDefinitions="90,60,40,70,80,70,*,80" ColumnSpacing="8" Margin="0,0,0,6">
                  <TextBlock Grid.Column="0" Text="DATE" Classes="Overline" />
                  <TextBlock Grid.Column="1" Text="SYMBOL" Classes="Overline" />
                  <TextBlock Grid.Column="2" Text="DIR" Classes="Overline" />
                  <TextBlock Grid.Column="3" Text="P&amp;L USD" Classes="Overline" />
                  <TextBlock Grid.Column="4" Text="P&amp;L %" Classes="Overline" />
                  <TextBlock Grid.Column="5" Text="EXCHANGE" Classes="Overline" />
                  <TextBlock Grid.Column="6" Text="NOTES" Classes="Overline" />
                  <TextBlock Grid.Column="7" Text="TAG" Classes="Overline" />
                </Grid>

                <TextBlock Text="No trades match the current filter."
                           Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsSmall}" Margin="0,16"
                           IsVisible="{Binding HasNoRows}" />

                <ScrollViewer MaxHeight="480">
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:JournalEntryRowVM">
                        <Border Padding="0,4" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1">
                          <StackPanel Spacing="4">
                            <!-- Main row -->
                            <Grid ColumnDefinitions="90,60,40,70,80,70,*,80" ColumnSpacing="8">
                              <TextBlock Grid.Column="0" Text="{Binding DateLabel}"
                                         Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding SymbolLabel}"
                                         Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding DirectionLabel}"
                                         Foreground="{Binding DirectionBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3" Text="{Binding PnlLabel}"
                                         Foreground="{Binding PnlBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="4" Text="{Binding PnlPctLabel}"
                                         Foreground="{Binding PnlBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="5" Text="{Binding ExchangeLabel}"
                                         Foreground="#4A7090" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                              <!-- Notes (editable on click) -->
                              <Panel Grid.Column="6">
                                <TextBlock Text="{Binding Notes}"
                                           Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsEditing}" />
                                <TextBox Text="{Binding Notes}"
                                         FontSize="{DynamicResource FsMicro}"
                                         Background="{DynamicResource Surface1}"
                                         IsVisible="{Binding IsEditing}" />
                              </Panel>
                              <!-- Tag ComboBox -->
                              <ComboBox Grid.Column="7"
                                        ItemsSource="{Binding $parent[ItemsControl].((vm:TradeJournalViewModel)DataContext).AllTags}"
                                        SelectedItem="{Binding Tag}"
                                        FontSize="{DynamicResource FsMicro}"
                                        Background="{DynamicResource Surface2}" />
                            </Grid>
                            <!-- Edit / Done button -->
                            <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsEditing}">
                              <Button Grid.Column="1" Content="✓ Done"
                                      Command="{Binding DoneCommand}"
                                      Classes="GhostButton" FontSize="{DynamicResource FsMicro}"
                                      Foreground="{DynamicResource Accent}" />
                            </Grid>
                            <!-- Edit link (shown when not editing) -->
                            <Button Content="✎ Add note"
                                    Command="{Binding EditCommand}"
                                    Classes="GhostButton"
                                    FontSize="{DynamicResource FsMicro}" Padding="0"
                                    Foreground="{DynamicResource TextSoft}"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsEditing}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>

          </StackPanel>
</UserControl>

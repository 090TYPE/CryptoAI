<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             x:Class="CryptoAITerminal.TerminalUI.Views.MarketTapeView"
             x:DataType="vm:MarketTapeViewModel"
             x:CompileBindings="True">
  <StackPanel Spacing="16">

    <Border Classes="Panel">
      <StackPanel Spacing="10">
        <TextBlock Classes="H2" Text="Live Tape (public market trades)" />
        <TextBlock Text="Other participants' trades on a venue. CEX = a symbol's anonymous fills (no identity). DEX = a pool's on-chain swaps, including the originating wallet. Large prints are highlighted."
                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />

        <!-- venue toggle -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="CEX" Width="80"
                  Background="{Binding CexTabBrush, Converter={StaticResource StringToBrush}}" Foreground="{Binding CexTabFg, Converter={StaticResource StringToBrush}}"
                  Command="{Binding SelectCexCommand}" />
          <Button Content="DEX" Width="80"
                  Background="{Binding DexTabBrush, Converter={StaticResource StringToBrush}}" Foreground="{Binding DexTabFg, Converter={StaticResource StringToBrush}}"
                  Command="{Binding SelectDexCommand}" />
        </StackPanel>

        <!-- CEX input -->
        <Grid ColumnDefinitions="Auto,160,Auto,160,Auto" ColumnSpacing="12"
              IsVisible="{Binding IsCex}">
          <TextBlock Grid.Column="0" Text="Symbol" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Symbol}" PlaceholderText="BTCUSDT" />
          <TextBlock Grid.Column="2" Text="Large print ≥ (USDT)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="3" Minimum="0" Increment="10000"
                         Value="{Binding LargePrintThreshold}" />
          <Button Grid.Column="4" Classes="GhostButton" Content="Apply"
                  VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- DEX input -->
        <StackPanel Spacing="8" IsVisible="{Binding IsDex}">
          <Grid ColumnDefinitions="Auto,120,Auto,*" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="Network" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Network}" PlaceholderText="eth" />
            <TextBlock Grid.Column="2" Text="Pool address" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" Text="{Binding PoolAddress}" PlaceholderText="0x…" />
          </Grid>
          <Grid ColumnDefinitions="Auto,160,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="Large print ≥ (USD)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Minimum="0" Increment="10000"
                           Value="{Binding LargePrintThreshold}" />
            <Button Grid.Column="2" Classes="GhostButton" Content="Apply"
                    VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
          </Grid>
          <TextBlock Text="Network ids: eth, bsc, solana, base, arbitrum, polygon_pos. Pool = the pair/pool address on that chain."
                     Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="{Binding PressureLabel}" FontWeight="SemiBold"
                   Foreground="{Binding PressureBrush, Converter={StaticResource StringToBrush}}" />
        <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
      </StackPanel>
    </Border>

    <Border Classes="Panel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="44,90,60,*,*,80,110" Margin="0,0,0,2">
          <TextBlock Grid.Column="0" Text="Src"    Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
          <TextBlock Grid.Column="1" Text="Time"   Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
          <TextBlock Grid.Column="2" Text="Side"   Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
          <TextBlock Grid.Column="3" Text="Price"  Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
          <TextBlock Grid.Column="4" Text="Qty"    Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
          <TextBlock Grid.Column="5" Text="USD"    Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="6" Text="Wallet" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TapeRowVM">
              <Border Background="{Binding RowBrush, Converter={StaticResource StringToBrush}}" CornerRadius="3" Padding="2,1">
                <Grid ColumnDefinitions="44,90,60,*,*,80,110">
                  <TextBlock Grid.Column="0" Text="{Binding VenueLabel}"
                             Foreground="{Binding VenueBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding TimeLabel}"
                             FontFamily="Cascadia Code,Consolas,monospace" FontSize="{DynamicResource FsSmall}" Foreground="{DynamicResource TextMuted}" />
                  <TextBlock Grid.Column="2" Text="{Binding Side}"
                             Foreground="{Binding SideBrush, Converter={StaticResource StringToBrush}}" FontWeight="{Binding Weight}" FontSize="{DynamicResource FsSmall}" />
                  <TextBlock Grid.Column="3" Text="{Binding PriceLabel}"
                             FontFamily="Cascadia Code,Consolas,monospace" FontWeight="{Binding Weight}" FontSize="{DynamicResource FsSmall}" />
                  <TextBlock Grid.Column="4" Text="{Binding QtyLabel}"
                             FontFamily="Cascadia Code,Consolas,monospace" FontSize="{DynamicResource FsSmall}" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Grid.Column="5" Text="{Binding QuoteLabel}"
                             FontFamily="Cascadia Code,Consolas,monospace" FontWeight="{Binding Weight}" FontSize="{DynamicResource FsSmall}"
                             HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Grid.Column="6" Text="{Binding TraderLabel}"
                             FontFamily="Cascadia Code,Consolas,monospace" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>

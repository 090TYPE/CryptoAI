<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:pd="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels.PortfolioDesk"
             x:Class="CryptoAITerminal.TerminalUI.Views.PortfolioView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">

  <UserControl.Styles>
    <!-- Плоский шаблон кнопки переехал в AppStyles (Button.FlatChrome). Здесь остаётся только
         высота: кнопки этой страницы верстались под общий MinHeight 36, а класс задаёт 0. -->
    <Style Selector="Button.FlatChrome">
      <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- Flat clickable row/button (whole-row hit target) -->
    <Style Selector="Button.Flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Dark inputs to match the mock (kill the grey Fluent chrome) -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBright}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
      <Setter Property="SelectionBrush" Value="#1F21E6C1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBright}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="#26405e" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBright}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBright}" />
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBright}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="TextBlock.Mono">
      <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    </Style>
  </UserControl.Styles>

  <!-- Root: everything on a Panel so the modal can overlay -->
  <Panel Background="{DynamicResource Surface0}" DataContext="{Binding PortfolioDeskVM}">
    <Grid RowDefinitions="54,*">

      <!-- ══════════ HEADER ══════════ -->
      <Border Grid.Row="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0">

          <!-- Logo + title -->
          <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0" Padding="10,0" MinWidth="230">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PositiveTint}" BorderBrush="{DynamicResource PositiveTintStroke}" BorderThickness="1">
                <TextBlock Text="◈" FontSize="{DynamicResource FsSubhead}" FontWeight="Black" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PORTFOLIO" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontDisplay}" />
                <TextBlock Text="Multi-wallet manager" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Total equity -->
          <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0" Padding="16,0">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="TOTAL EQUITY" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding TotalEquity}" FontSize="{DynamicResource FsTitle}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" />
                <TextBlock Text="{Binding EquityChg}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" FontFamily="{StaticResource FontMono}"
                           Foreground="{Binding EquityChgColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Bottom" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Quick stats -->
          <ItemsControl ItemsSource="{Binding HeaderStats}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pd:PfHeaderStat">
                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0" Padding="14,0">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <TextBlock Text="{Binding Value}" FontSize="{DynamicResource FsBody}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}"
                               Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" Margin="6,0" />
          <Border Width="0" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>

      <!-- Add wallet + guard, pinned right on the header -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
        <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1,0,1,0" Padding="12,0">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="FlatChrome" Content="+ ADD WALLET" Command="{Binding OpenModalCommand}"
                    Padding="14,6" CornerRadius="7" BorderBrush="{DynamicResource PositiveTintStroke}" BorderThickness="1" Background="{DynamicResource PositiveTint}"
                    Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsCaption}" FontWeight="ExtraBold" FontFamily="{StaticResource FontDisplay}" />
            <Button Classes="FlatChrome" Content="DIAGNOSTICS" Command="{Binding OpenStudioCommand}"
                    Padding="14,6" CornerRadius="7" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Background="{DynamicResource Surface1}"
                    Foreground="{DynamicResource AccentBlue}" FontSize="{DynamicResource FsCaption}" FontWeight="ExtraBold" FontFamily="{StaticResource FontDisplay}" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="2,0">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource Positive}" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="GUARD" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
            <TextBlock Text="SECURE" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" Foreground="{DynamicResource Positive}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- ══════════ BODY ══════════ -->
      <Grid Grid.Row="1" ColumnDefinitions="280,*,380">

        <!-- ═══ LEFT: WALLET BROWSER ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Search -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,10">
              <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="⌕" FontSize="{DynamicResource FsSmall}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                  <TextBox Text="{Binding SearchText}" PlaceholderText="Search wallets…" BorderThickness="0" Background="Transparent"
                           Padding="0" MinHeight="0" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Width="200" />
                </StackPanel>
              </Border>
            </Border>

            <!-- Type filter chips -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
              <StackPanel Spacing="7">
                <TextBlock Text="WALLET TYPE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                <ItemsControl ItemsSource="{Binding TypeFilters}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pd:PfTypeFilter">
                      <Button Classes="FlatChrome" Command="{Binding Command}" Margin="0,0,4,4" Padding="10,4" CornerRadius="20"
                              BorderThickness="1" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                              Background="{Binding Bg, Converter={StaticResource StringToBrush}}"
                              Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"
                              FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Content="{Binding Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Wallet list -->
            <ScrollViewer Grid.Row="2" Padding="0,8">
              <StackPanel>
                <TextBlock Text="No wallets yet. Click + ADD WALLET." IsVisible="{Binding WalletsEmpty}"
                           Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" Margin="14,20" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Wallets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pd:PfWalletCard">
                      <Button Classes="Flat FlatChrome" Command="{Binding SelectCommand}" CommandParameter="{Binding}">
                        <Border Background="{Binding RowBg, Converter={StaticResource StringToBrush}}"
                                BorderBrush="{Binding Accent, Converter={StaticResource StringToBrush}}" BorderThickness="3,0,0,0"
                                Padding="12,10">
                          <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="30,*,Auto">
                              <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                      Background="{Binding IconBg, Converter={StaticResource StringToBrush}}"
                                      BorderBrush="{Binding IconBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1">
                                <TextBlock Text="{Binding Icon}" FontSize="{DynamicResource FsCaption}" FontWeight="Black"
                                           Foreground="{Binding IconColor, Converter={StaticResource StringToBrush}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                  <Border Background="{Binding TypeBadgeBg, Converter={StaticResource StringToBrush}}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Type}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding TypeBadgeColor, Converter={StaticResource StringToBrush}}" />
                                  </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding AddrShort}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Balance}" FontSize="{DynamicResource FsSmall}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding Pnl24h}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontMono}" HorizontalAlignment="Right"
                                           Foreground="{Binding PnlColor, Converter={StaticResource StringToBrush}}" />
                              </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto">
                              <Border Grid.Column="0" Height="3" Background="{DynamicResource Surface2}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,4,0" ClipToBounds="True">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding HealthPct, Converter={StaticResource PercentToStar}}" />
                                    <ColumnDefinition Width="{Binding HealthPct, Converter={StaticResource PercentToStar}, ConverterParameter=rest}" />
                                  </Grid.ColumnDefinitions>
                                  <Border Grid.Column="0" Height="3" CornerRadius="2" Background="{Binding HealthColor, Converter={StaticResource StringToBrush}}" />
                                </Grid>
                              </Border>
                              <Ellipse Grid.Column="1" Width="5" Height="5" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Fill="{Binding StatusDot, Converter={StaticResource StringToBrush}}" />
                              <TextBlock Grid.Column="2" Text="{Binding Chain}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- Bottom totals -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface0}" Padding="12,10">
              <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="WALLETS" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                  <TextBlock Text="{Binding WalletCount}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="CHAINS" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding ChainCount}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource FontMono}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- ═══ CENTER ═══ -->
        <Grid Grid.Column="1" Background="{DynamicResource Surface0}" RowDefinitions="Auto,Auto,36,*">

          <!-- Summary cards -->
          <Border Grid.Row="0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12">
            <ItemsControl ItemsSource="{Binding SummaryCards}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pd:PfSummaryCard">
                  <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="{DynamicResource FsSubhead}" Opacity="0.4" />
                      </Grid>
                      <TextBlock Text="{Binding Value}" FontSize="{DynamicResource FsH2}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}"
                                 Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Sub}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontMono}"
                                   Foreground="{Binding SubColor, Converter={StaticResource StringToBrush}}" />
                        <TextBlock Text="{Binding SubLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Allocation + top assets -->
          <Border Grid.Row="1" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,0,12,12">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

              <!-- Allocation by type -->
              <Border Grid.Column="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                <StackPanel Spacing="7">
                  <TextBlock Text="ALLOCATION BY WALLET TYPE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                  <TextBlock Text="No holdings loaded." IsVisible="{Binding !AllocationBars.Count}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                  <ItemsControl ItemsSource="{Binding AllocationBars}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pd:PfAllocBar">
                        <StackPanel Spacing="4" Margin="0,0,0,2">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                              <Border Width="6" Height="6" CornerRadius="2" Background="{Binding Color, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Amount}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" />
                              <TextBlock Text="{Binding Pct}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}" MinWidth="34" TextAlignment="Right" />
                            </StackPanel>
                          </Grid>
                          <Border Height="4" Background="{DynamicResource Surface2}" CornerRadius="2" ClipToBounds="True">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Width, Converter={StaticResource PercentToStar}}" />
                                <ColumnDefinition Width="{Binding Width, Converter={StaticResource PercentToStar}, ConverterParameter=rest}" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{Binding Color, Converter={StaticResource StringToBrush}}" />
                            </Grid>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Top assets -->
              <Border Grid.Column="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="TOP ASSETS" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <TextBlock Grid.Column="1" Text="across all wallets" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                  </Grid>
                  <TextBlock Text="No holdings loaded." IsVisible="{Binding !TopAssets.Count}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                  <ItemsControl ItemsSource="{Binding TopAssets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pd:PfTopAsset">
                        <Grid ColumnDefinitions="22,*" Margin="0,0,0,4">
                          <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                                  Background="{Binding IconBg, Converter={StaticResource StringToBrush}}"
                                  BorderBrush="{Binding IconBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1">
                            <TextBlock Text="{Binding Sym}" FontSize="{DynamicResource FsMicro}" FontWeight="Black" Foreground="{Binding IconColor, Converter={StaticResource StringToBrush}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{DynamicResource FsCaption}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Grid.Column="0" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}">
                                <Run Text="{Binding Qty}" /><Run Text=" · " /><Run Text="{Binding Price}" />
                              </TextBlock>
                              <TextBlock Grid.Column="1" Text="{Binding Chg}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontMono}"
                                         Foreground="{Binding ChgColor, Converter={StaticResource StringToBrush}}" />
                            </Grid>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Blotter tabs -->
          <Border Grid.Row="2" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ItemsControl Grid.Column="0" ItemsSource="{Binding BlotterTabs}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pd:PfBlotterTab">
                    <Button Classes="FlatChrome" Command="{Binding Command}" Padding="16,0" Background="Transparent" BorderThickness="0,0,0,2"
                            BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                            Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"
                            FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Content="{Binding Label}"
                            VerticalAlignment="Stretch" CornerRadius="0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Grid.Column="2" ItemsSource="{Binding BlotterTotals}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pd:PfBlotterTotal">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBlock Text="{Binding Value}" FontSize="{DynamicResource FsCaption}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}"
                                 Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <!-- Blotter body -->
          <Grid Grid.Row="3">

            <!-- ASSETS. The fixed columns need ~610px but the centre column is ~446px at 1366:
                 scroll sideways instead of letting the right-hand columns fall off the panel. -->
            <ScrollViewer IsVisible="{Binding ShowAllAssets}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,*" MinWidth="620">
              <Border Grid.Row="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid ColumnDefinitions="40,*,90,110,100,100,90,80">
                  <TextBlock Grid.Column="1" Text="ASSET" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                  <TextBlock Grid.Column="2" Text="QTY" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="VALUE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="PRICE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="PNL" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                  <TextBlock Grid.Column="6" Text="24H" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                  <TextBlock Grid.Column="7" Text="TYPE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1">
                <StackPanel>
                  <TextBlock Text="No holdings. Load the rebalancer or connect a wallet." IsVisible="{Binding AssetsEmpty}"
                             Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" Margin="14,20" />
                  <ItemsControl ItemsSource="{Binding AssetRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pd:PfAssetRow">
                        <Border BorderBrush="{DynamicResource Surface1}" BorderThickness="0,0,0,1" Padding="12,6">
                          <Grid ColumnDefinitions="40,*,90,110,100,100,90,80" VerticalAlignment="Center">
                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" HorizontalAlignment="Left"
                                    Background="{Binding IconBg, Converter={StaticResource StringToBrush}}"
                                    BorderBrush="{Binding IconBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1">
                              <TextBlock Text="{Binding Sym}" FontSize="{DynamicResource FsMicro}" FontWeight="Black" Foreground="{Binding IconColor, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                              <TextBlock Text="{Binding Wallet}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Qty}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" FontFamily="{StaticResource FontMono}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding Value}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding Price}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontMono}" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{Binding Pnl}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" FontFamily="{StaticResource FontMono}" TextAlignment="Right"
                                       Foreground="{Binding PnlColor, Converter={StaticResource StringToBrush}}" />
                            <TextBlock Grid.Column="6" Text="{Binding Chg}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontMono}" TextAlignment="Right"
                                       Foreground="{Binding ChgColor, Converter={StaticResource StringToBrush}}" />
                            <Border Grid.Column="7" HorizontalAlignment="Right" CornerRadius="3" Padding="6,2"
                                    Background="{Binding TagBg, Converter={StaticResource StringToBrush}}">
                              <TextBlock Text="{Binding Tag}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding TagColor, Converter={StaticResource StringToBrush}}" />
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
            </ScrollViewer>

            <!-- REBALANCE (reuses the real PortfolioRebalanceVM) -->
            <ContentControl IsVisible="{Binding ShowRebalance}">
            <Grid RowDefinitions="Auto,Auto,*,Auto"
                  DataContext="{Binding Rebalance}" x:DataType="vm:PortfolioRebalanceViewModel">
              <!-- Top bar -->
              <Border Grid.Row="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalValueLabel}" FontSize="{DynamicResource FsBody}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" />
                    <TextBlock Text="total portfolio" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                  </StackPanel>
                  <Border IsVisible="{Binding HasAlerts}" Background="#1AF97316" CornerRadius="5" Padding="10,2" BorderBrush="#4DF97316" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Width="5" Height="5" Fill="#f97316" VerticalAlignment="Center" />
                      <TextBlock Text="DRIFT DETECTED" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="#f97316" />
                    </StackPanel>
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Alert when deviation ≥" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding GlobalAlertThresholdPct}" Minimum="0.5" Maximum="50" Increment="0.5" Width="110" FontSize="{DynamicResource FsSmall}" />
                    <TextBlock Text="%" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                  </StackPanel>
                  <Border Background="#0F21E6C1" BorderBrush="#2621E6C1" BorderThickness="1" CornerRadius="5" Padding="10,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TargetSumLabel}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" FontFamily="{StaticResource FontMono}"
                               Foreground="{Binding TargetSumBrush}" />
                  </Border>
                  <Border Width="0" HorizontalAlignment="Stretch" />
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="🤖 AI weights" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBright}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding AvailableRiskProfiles}" SelectedItem="{Binding SelectedRiskProfile}" MinWidth="120" FontSize="{DynamicResource FsCaption}" />
                    <Button Classes="FlatChrome" Content="SUGGEST" Command="{Binding SuggestWithAiCommand}" IsEnabled="{Binding !AiRunning}"
                            Padding="14,4" CornerRadius="7" BorderBrush="{DynamicResource PurpleTintStroke}" BorderThickness="1" Background="#1AA855F7"
                            Foreground="{DynamicResource AccentPurpleBright}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" FontFamily="{StaticResource FontDisplay}" />
                  </StackPanel>
                  <Button Classes="FlatChrome" Content="↺ REFRESH" Command="{Binding RefreshCommand}"
                          Padding="14,4" CornerRadius="7" BorderBrush="{DynamicResource PanelStrokeBright}" BorderThickness="1" Background="{DynamicResource Surface1}"
                          Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <!-- AI commentary + alert strip -->
              <StackPanel Grid.Row="1">
                <Border Background="#160a05" BorderBrush="#3d1a00" BorderThickness="0,0,0,1" Padding="14,8" IsVisible="{Binding HasAlerts}">
                  <TextBlock Text="{Binding AlertSummary}" Foreground="#ff8888" FontSize="{DynamicResource FsCaption}" FontFamily="{StaticResource FontMono}" TextWrapping="Wrap" />
                </Border>
                <Border Background="#1a1005" BorderBrush="#3d2a00" BorderThickness="0,0,0,1" Padding="14,8" IsVisible="{Binding AiError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding AiError}" Foreground="#ffaa33" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
                </Border>
                <Border Background="{DynamicResource Surface3}" Padding="14,8" IsVisible="{Binding AiCommentary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding AiSource}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" IsVisible="{Binding AiSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding AiCommentary}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <!-- Rows. 692px of fixed columns against a ~446px centre column: scroll sideways
                   so REBALANCE ORDER keeps its width instead of collapsing to zero. -->
              <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
                <StackPanel MinWidth="780">
                  <!-- header -->
                  <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="32,90,100,80,110,110,90,*,80">
                      <TextBlock Grid.Column="1" Text="ASSET" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBlock Grid.Column="2" Text="BALANCE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="PRICE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="VALUE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                      <TextBlock Grid.Column="5" Text="TARGET %" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBlock Grid.Column="6" Text="ACTUAL" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBlock Grid.Column="7" Text="REBALANCE ORDER" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Allocations}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PortfolioAllocationRowViewModel">
                        <Border BorderBrush="{DynamicResource Surface1}" BorderThickness="0,0,0,1" Padding="12,8">
                          <Grid ColumnDefinitions="32,90,100,80,110,110,90,*,80" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" Foreground="{Binding StatusBrush}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Symbol}" FontSize="{DynamicResource FsSmall}" FontWeight="ExtraBold" Foreground="{DynamicResource TextSecondary}" />
                              <TextBlock Text="{Binding SourcesLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding BalanceLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding PriceLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding ValueLabel}" FontSize="{DynamicResource FsSmall}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" TextAlignment="Right" />
                            <NumericUpDown Grid.Column="5" Value="{Binding TargetPct}" Minimum="0" Maximum="100" Increment="1" FormatString="F1" FontSize="{DynamicResource FsCaption}" Width="104" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="6" VerticalAlignment="Center">
                              <TextBlock Text="{Binding ActualPctLabel}" FontSize="{DynamicResource FsCaption}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" />
                              <TextBlock Text="{Binding DeviationLabel}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontMono}" Foreground="{Binding DeviationBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="7" Text="{Binding RebalanceOrderLabel}" Foreground="{Binding RebalanceOrderBrush}" FontSize="{DynamicResource FsCaption}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" />
                            <Button Classes="FlatChrome" Grid.Column="8" Content="×" HorizontalAlignment="Right" Width="22" Height="22" Padding="0" FontSize="{DynamicResource FsSmall}"
                                    ToolTip.Tip="Remove asset" AutomationProperties.Name="Remove asset from rebalance"
                                    Background="#0FFF6B6B" BorderBrush="{DynamicResource NegativeFillStroke}" BorderThickness="1" Foreground="{DynamicResource Negative}" CornerRadius="4"
                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveAssetCommand}" CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <!-- Add asset + footer -->
              <Border Grid.Row="3" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="ADD ASSET:" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                  <TextBox Text="{Binding NewAssetSymbol}" PlaceholderText="BTC" Width="80" FontSize="{DynamicResource FsCaption}" FontFamily="{StaticResource FontMono}" />
                  <NumericUpDown Value="{Binding NewAssetTargetPct}" Minimum="0.1" Maximum="100" Increment="1" FormatString="F1" Width="110" FontSize="{DynamicResource FsCaption}" />
                  <TextBlock Text="%" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                  <Button Classes="FlatChrome" Content="+ ADD" Command="{Binding AddAssetCommand}"
                          Padding="14,4" CornerRadius="6" BorderBrush="{DynamicResource PositiveTintStroke}" BorderThickness="1" Background="#1421E6C1"
                          Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" FontFamily="{StaticResource FontDisplay}" />
                  <Border Width="0" HorizontalAlignment="Stretch" />
                  <TextBlock Text="{Binding StatusLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
            </ContentControl>

            <!-- ACTIVITY / MEME / STAKING placeholders (1:1 structure, live source pending) -->
            <Grid IsVisible="{Binding ShowActivity}">
              <TextBlock Text="No activity feed connected for the selected wallets yet."
                         Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSmall}" Margin="16,24" TextWrapping="Wrap" />
            </Grid>
            <ContentControl IsVisible="{Binding ShowMeme}">
              <Grid RowDefinitions="Auto,Auto,*" DataContext="{Binding $parent[Window].DataContext.DexTrendingVM}" x:DataType="vm:DexTrendingViewModel">
                <!-- Live-scan strip -->
                <Border Grid.Row="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <Ellipse Grid.Column="0" Width="5" Height="5" Fill="#f97316" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="MEME RADAR — LIVE SCAN" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="#f97316" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding TotalCount, StringFormat='{}{0} tokens'}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Classes="FlatChrome" Grid.Column="4" Content="↻ SCAN" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}"
                            Padding="12,4" CornerRadius="6" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeBright}" BorderThickness="1" Foreground="#f97316" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  </Grid>
                </Border>
                <!-- Header -->
                <Border Grid.Row="1" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,6">
                  <Grid ColumnDefinitions="28,*,90,70,90,90,70,80,56">
                    <TextBlock Grid.Column="1" Text="TOKEN" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <TextBlock Grid.Column="2" Text="PRICE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="24H" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="MCAP" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="LIQUIDITY" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="SECURITY" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="SIGNAL" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" TextAlignment="Right" />
                  </Grid>
                </Border>
                <!-- Rows -->
                <ScrollViewer Grid.Row="2">
                  <StackPanel>
                    <TextBlock Text="No trending tokens yet — hit SCAN." IsVisible="{Binding HasNoFilteredTokens}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSmall}" Margin="16,20" />
                    <ItemsControl ItemsSource="{Binding FilteredTokens}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DexTokenRowViewModel">
                          <Border BorderBrush="{DynamicResource Surface1}" BorderThickness="0,0,0,1" Padding="12,6">
                            <Grid ColumnDefinitions="28,*,90,70,90,90,70,80,56" VerticalAlignment="Center">
                              <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1">
                                <TextBlock Text="{Binding ChainIcon}" FontSize="{DynamicResource FsCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Symbol}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding PriceLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" TextAlignment="Right" />
                              <TextBlock Grid.Column="3" Text="{Binding PriceChangeLabel}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding PriceChangeBrush}" FontFamily="{StaticResource FontMono}" TextAlignment="Right" />
                              <TextBlock Grid.Column="4" Text="{Binding MarketCapLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontMono}" TextAlignment="Right" />
                              <TextBlock Grid.Column="5" Text="{Binding LiquidityLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" FontFamily="{StaticResource FontMono}" TextAlignment="Right" />
                              <TextBlock Grid.Column="6" Text="{Binding SecurityScore}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource FontMono}" TextAlignment="Center" />
                              <TextBlock Grid.Column="7" Text="{Binding SecurityBadge}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource Warning}" TextAlignment="Right" VerticalAlignment="Center" />
                              <Button Classes="FlatChrome" Grid.Column="8" Content="OPEN" Command="{Binding $parent[ItemsControl].DataContext.OpenInSniperCommand}" CommandParameter="{Binding}"
                                      Padding="8,2" CornerRadius="5" Background="{DynamicResource PositiveTint}" BorderBrush="{DynamicResource PositiveTintStroke}" BorderThickness="1" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </ContentControl>
            <Grid IsVisible="{Binding ShowStaking}">
              <TextBlock Text="No staking positions detected for the connected wallets yet."
                         Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSmall}" Margin="16,24" TextWrapping="Wrap" />
            </Grid>
          </Grid>
        </Grid>

        <!-- ═══ RIGHT: WALLET DETAIL + CHECKS ═══ -->
        <Border Grid.Column="2" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1,0,0,0">
          <ScrollViewer>
            <StackPanel>

              <!-- Selected wallet header -->
              <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="14,14,14,10">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="38,*,Auto">
                    <Panel Grid.Column="0" Width="38" Height="38">
                      <Border Width="38" Height="38" CornerRadius="10"
                              Background="{Binding SelWalletIconBg, Converter={StaticResource StringToBrush}}"
                              BorderBrush="{Binding SelWalletIconBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1">
                        <TextBlock Text="{Binding SelWalletIcon}" FontSize="{DynamicResource FsSubhead}" FontWeight="Black" Foreground="{Binding SelWalletIconColor, Converter={StaticResource StringToBrush}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Fill="{Binding SelWalletDot, Converter={StaticResource StringToBrush}}" Stroke="{DynamicResource AppBg}" StrokeThickness="2" />
                    </Panel>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SelWalletName}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" />
                        <Border Background="{Binding SelWalletTypeBadgeBg, Converter={StaticResource StringToBrush}}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SelWalletType}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding SelWalletTypeBadgeColor, Converter={StaticResource StringToBrush}}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding SelWalletAddr}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                      <Button Classes="FlatChrome" Content="COPY" Command="{Binding CopyAddrCommand}" Padding="10,4" CornerRadius="5" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Background="{DynamicResource Surface1}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      <Button Classes="FlatChrome" Content="EXPLORER ↗" Command="{Binding ExplorerCommand}" Padding="10,4" CornerRadius="5" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" Background="{DynamicResource Surface1}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </StackPanel>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding WalletStats}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pd:PfWalletStat">
                        <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                          <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Value}" FontSize="{DynamicResource FsBody}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}"
                                       Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Arm the selected wallet as the active trading session (WalletVM) -->
              <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="14,10"
                      DataContext="{Binding $parent[Window].DataContext.WalletVM}">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="ACTIVE TRADING SESSION" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource Surface3}" CornerRadius="4" Padding="8,2">
                      <TextBlock Text="{Binding WalletModeLabel}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
                  <TextBox Text="{Binding PrivateKeyInput}" PasswordChar="•" PlaceholderText="Private key to arm trading (memory-only this session)" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="FlatChrome" Content="ARM TRADING" Command="{Binding ImportPrivateKeyCommand}" Padding="12,6" CornerRadius="6" Background="{DynamicResource PositiveFill}" BorderBrush="{DynamicResource PositiveFillStroke}" BorderThickness="1" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                    <Button Classes="FlatChrome" Content="WATCH ONLY" Command="{Binding ConnectWatchCommand}" Padding="12,6" CornerRadius="6" Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource PanelStrokeBright}" BorderThickness="1" Foreground="{DynamicResource AccentBlue}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    <Button Classes="FlatChrome" Content="DISCONNECT" Command="{Binding DisconnectWalletCommand}" Padding="12,6" CornerRadius="6" Background="{DynamicResource NegativeFill}" BorderBrush="{DynamicResource NegativeFillStroke}" BorderThickness="1" Foreground="{DynamicResource Negative}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Right panel tabs -->
              <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Height="34">
                <ItemsControl ItemsSource="{Binding RightTabs}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pd:PfRightTab">
                      <Button Classes="FlatChrome" Command="{Binding Command}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="0"
                              Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderThickness="0,0,0,2"
                              BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                              Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"
                              FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Content="{Binding Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <!-- CHECKS -->
              <StackPanel IsVisible="{Binding ShowChecks}" Margin="12" Spacing="10">
                <!-- Overall score -->
                <Border Background="{Binding OverallBg, Converter={StaticResource StringToBrush}}"
                        BorderBrush="{Binding OverallBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                  <Grid ColumnDefinitions="48,*,Auto">
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" BorderThickness="3"
                            BorderBrush="{Binding OverallColor, Converter={StaticResource StringToBrush}}">
                      <TextBlock Text="{Binding OverallScore}" FontSize="{DynamicResource FsSubhead}" FontWeight="Black" FontFamily="{StaticResource FontMono}"
                                 Foreground="{Binding OverallColor, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding OverallLabel}" FontSize="{DynamicResource FsSmall}" FontWeight="ExtraBold" Foreground="{Binding OverallColor, Converter={StaticResource StringToBrush}}" />
                      <TextBlock Text="{Binding OverallDesc}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Classes="FlatChrome" Grid.Column="2" Content="{Binding RescanLabel}" Command="{Binding RescanCommand}" VerticalAlignment="Center"
                            Padding="12,4" CornerRadius="6" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Background="{DynamicResource Surface1}"
                            Foreground="{Binding RescanColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" FontFamily="{StaticResource FontDisplay}" />
                  </Grid>
                </Border>
                <!-- Check groups -->
                <ItemsControl ItemsSource="{Binding CheckGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pd:PfCheckGroup">
                      <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                              <TextBlock Text="{Binding Icon}" FontSize="{DynamicResource FsSubhead}" Opacity="0.7" />
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}" CornerRadius="4" Padding="8,2">
                              <TextBlock Text="{Binding Status}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                            </Border>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="pd:PfCheckItem">
                                <Grid ColumnDefinitions="14,*,Auto" Margin="0,0,0,4">
                                  <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7" BorderThickness="1"
                                          BorderBrush="{Binding DotBorder, Converter={StaticResource StringToBrush}}"
                                          Background="{Binding DotBg, Converter={StaticResource StringToBrush}}">
                                    <Ellipse Width="6" Height="6" Fill="{Binding Dot, Converter={StaticResource StringToBrush}}" />
                                  </Border>
                                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="8,0" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}"
                                             Foreground="{Binding ValueColor, Converter={StaticResource StringToBrush}}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Approvals -->
                <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="🔓" FontSize="{DynamicResource FsSubhead}" Opacity="0.7" />
                        <TextBlock Text="TOKEN APPROVALS" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#1AF4B860" CornerRadius="4" Padding="8,2">
                        <TextBlock Text="{Binding ApprovalCount, StringFormat='{}{0} ACTIVE'}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource Warning}" />
                      </Border>
                    </Grid>
                    <TextBlock Text="No token approvals found (or no Covalent API key set in Settings)." IsVisible="{Binding ApprovalsEmpty}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Approvals}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pd:PfApproval">
                          <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Ellipse Grid.Column="0" Width="5" Height="5" VerticalAlignment="Center" Fill="{Binding RiskDot, Converter={StaticResource StringToBrush}}" />
                              <StackPanel Grid.Column="1" Margin="6,0">
                                <TextBlock Text="{Binding Protocol}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}">
                                  <Run Text="{Binding Token}" /><Run Text=" · " /><Run Text="{Binding Amount}" />
                                </TextBlock>
                              </StackPanel>
                              <Button Classes="FlatChrome" Grid.Column="2" Content="REVOKE" Command="{Binding RevokeCommand}" CommandParameter="{Binding}"
                                      Padding="8,2" CornerRadius="4" BorderThickness="1"
                                      BorderBrush="{Binding RevokeBorder, Converter={StaticResource StringToBrush}}"
                                      Background="{Binding RevokeBg, Converter={StaticResource StringToBrush}}"
                                      Foreground="{Binding RevokeColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- TOKENS -->
              <StackPanel IsVisible="{Binding ShowTokens}" Margin="12" Spacing="6">
                <TextBlock Text="No tokens to show." IsVisible="{Binding TokensEmpty}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" />
                <ItemsControl ItemsSource="{Binding WalletTokens}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pd:PfToken">
                      <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="32,*">
                          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                  Background="{Binding IconBg, Converter={StaticResource StringToBrush}}"
                                  BorderBrush="{Binding IconBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1">
                            <TextBlock Text="{Binding Sym}" FontSize="{DynamicResource FsMicro}" FontWeight="Black" Foreground="{Binding IconColor, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{DynamicResource FsSmall}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMono}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                              <TextBlock Grid.Column="0" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}">
                                <Run Text="{Binding Qty}" /><Run Text=" @ " /><Run Text="{Binding Price}" />
                              </TextBlock>
                              <TextBlock Grid.Column="1" Text="{Binding Chg}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" FontFamily="{StaticResource FontMono}"
                                         Foreground="{Binding ChgColor, Converter={StaticResource StringToBrush}}" />
                            </Grid>
                            <Border Height="3" Background="{DynamicResource Surface2}" CornerRadius="2" Margin="0,4,0,0" ClipToBounds="True">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="{Binding AllocPct, Converter={StaticResource PercentToStar}}" />
                                  <ColumnDefinition Width="{Binding AllocPct, Converter={StaticResource PercentToStar}, ConverterParameter=rest}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="3" CornerRadius="2" Background="{Binding AllocColor, Converter={StaticResource StringToBrush}}" />
                              </Grid>
                            </Border>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- TX HISTORY (real, per-wallet via Etherscan/TronGrid) -->
              <StackPanel IsVisible="{Binding ShowTxHistory}" Margin="12" Spacing="4">
                <TextBlock Text="No transactions found for this wallet (or no explorer API key set in Settings)."
                           IsVisible="{Binding TxEmpty}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding TxRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pd:PfTxRow">
                      <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="28,*">
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{Binding IconBg, Converter={StaticResource StringToBrush}}">
                            <TextBlock Text="{Binding Emoji}" FontSize="{DynamicResource FsSmall}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding Action}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                              <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="{DynamicResource FsCaption}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}"
                                         Foreground="{Binding AmountColor, Converter={StaticResource StringToBrush}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                              <TextBlock Grid.Column="0" Text="{Binding Hash}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding Fee}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}" />
                                <Border Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}" CornerRadius="3" Padding="4,1">
                                  <TextBlock Text="{Binding Status}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                                </Border>
                                <TextBlock Text="{Binding Time}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}" />
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- ANALYTICS (real realized-PnL from PnlDashboardVM) -->
              <ContentControl IsVisible="{Binding ShowAnalytics}">
                <StackPanel Margin="12" Spacing="8" DataContext="{Binding $parent[Window].DataContext.PnlDashboardVM}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="REALIZED PERFORMANCE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    <Button Classes="FlatChrome" Grid.Column="1" Content="↻ REFRESH" Command="{Binding RefreshCommand}" Padding="10,4" CornerRadius="6" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeBright}" BorderThickness="1" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  </Grid>
                  <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" IsVisible="{Binding !HasData}" />

                  <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                    <StackPanel Spacing="4">
                      <TextBlock Text="TOTAL REALIZED PNL" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBlock Text="{Binding TotalPnlLabel}" FontSize="{DynamicResource FsH2}" FontWeight="ExtraBold" FontFamily="{StaticResource FontMono}"
                                 Foreground="{Binding TotalPnlBrush, Converter={StaticResource StringToBrush}}" />
                      <TextBlock Text="{Binding TradeCountLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}" />
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="WIN RATE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <TextBlock Text="{Binding WinRateLabel}" FontSize="{DynamicResource FsTitle}" FontWeight="ExtraBold" Foreground="{DynamicResource Positive}" FontFamily="{StaticResource FontMono}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="PROFIT FACTOR" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <TextBlock Text="{Binding ProfitFactorLabel}" FontSize="{DynamicResource FsTitle}" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource FontMono}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="AVG WIN" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <TextBlock Text="{Binding AvgWinLabel}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" Foreground="{DynamicResource Positive}" FontFamily="{StaticResource FontMono}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="AVG LOSS" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <TextBlock Text="{Binding AvgLossLabel}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" Foreground="{DynamicResource Negative}" FontFamily="{StaticResource FontMono}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="MAX DRAWDOWN" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                      <TextBlock Text="{Binding MaxDrawdownLabel}" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" Foreground="{DynamicResource Warning}" FontFamily="{StaticResource FontMono}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ContentControl>

            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- ══════════ ADD WALLET MODAL ══════════ -->
    <Border IsVisible="{Binding ShowModal}" Background="#D9040b12" ZIndex="200">
      <Border Width="580" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PositiveTintStroke}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Modal header -->
          <Border Grid.Row="0" Background="{DynamicResource PositiveTint}" BorderBrush="{DynamicResource PositiveTintStroke}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid ColumnDefinitions="34,*,Auto,Auto">
              <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource PositiveFill}" BorderBrush="{DynamicResource PositiveFillStroke}" BorderThickness="1">
                <TextBlock Text="+" FontSize="{DynamicResource FsSubhead}" FontWeight="Black" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="ADD WALLET" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding ModalStepLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
              </StackPanel>
              <ItemsControl Grid.Column="2" ItemsSource="{Binding ModalStepDots}" VerticalAlignment="Center" Margin="0,0,8,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pd:PfStepDot">
                    <Border Height="6" CornerRadius="3" Width="{Binding Width}" Background="{Binding Color, Converter={StaticResource StringToBrush}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="FlatChrome" Grid.Column="3" Content="×" Command="{Binding CloseModalCommand}" Width="28" Height="28" Padding="0" FontSize="{DynamicResource FsTitle}"
                      ToolTip.Tip="Close" AutomationProperties.Name="Close panel"
                      CornerRadius="7" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Background="{DynamicResource Surface1}" Foreground="{DynamicResource TextDim}" />
            </Grid>
          </Border>

          <!-- Modal body -->
          <ScrollViewer Grid.Row="1">
            <Grid Margin="20">
              <!-- STEP 1 -->
              <StackPanel IsVisible="{Binding ModalIsStep1}" Spacing="14">
                <TextBlock Text="SELECT WALLET TYPE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                <ItemsControl ItemsSource="{Binding ModalWalletTypes}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pd:PfModalWalletType">
                      <Button Classes="Flat FlatChrome" Command="{Binding Command}" Margin="0,0,8,8">
                        <Border BorderThickness="1" CornerRadius="10" Padding="14"
                                BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                                Background="{Binding Bg, Converter={StaticResource StringToBrush}}">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="{Binding IconBg, Converter={StaticResource StringToBrush}}"
                                    BorderBrush="{Binding IconBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1">
                              <TextBlock Text="{Binding Emoji}" FontSize="{DynamicResource FsTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Width="150">
                              <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsSmall}" FontWeight="ExtraBold" Foreground="{Binding LabelColor, Converter={StaticResource StringToBrush}}" />
                              <TextBlock Text="{Binding Desc}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />
                              <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="pd:PfModalTag">
                                    <Border Background="{Binding Bg, Converter={StaticResource StringToBrush}}" CornerRadius="3" Padding="4,1" Margin="0,0,2,2">
                                      <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- STEP 2 -->
              <StackPanel IsVisible="{Binding ModalIsStep2}" Spacing="14">
                <!-- Selected badge -->
                <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ModalSelEmoji}" FontSize="{DynamicResource FsH2}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ModalSelName}" FontSize="{DynamicResource FsSmall}" FontWeight="ExtraBold" Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="{Binding ModalSelDesc}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                    </StackPanel>
                    <Button Classes="FlatChrome" Grid.Column="2" Content="← BACK" Command="{Binding ModalBackCommand}" Padding="10,4" CornerRadius="5"
                            BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Background="Transparent" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  </Grid>
                </Border>
                <!-- Nickname -->
                <StackPanel Spacing="6">
                  <TextBlock Text="WALLET NICKNAME" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                  <TextBox Text="{Binding NewWalletName}" PlaceholderText="e.g. My Main ETH" FontSize="{DynamicResource FsBody}" />
                </StackPanel>
                <!-- CEX -->
                <StackPanel IsVisible="{Binding ModalIsCex}" Spacing="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="EXCHANGE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <ItemsControl ItemsSource="{Binding CexOptions}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pd:PfCexOption">
                          <Button Classes="FlatChrome" Command="{Binding Command}" Margin="0,0,6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  BorderThickness="1" CornerRadius="8" Padding="4,10"
                                  BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                                  Background="{Binding Bg, Converter={StaticResource StringToBrush}}">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Logo}" FontSize="{DynamicResource FsTitle}" HorizontalAlignment="Center" />
                              <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding LabelColor, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="API KEY" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <TextBox Text="{Binding NewApiKey}" PlaceholderText="Paste API key…" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSmall}" />
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="API SECRET" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <TextBox Text="{Binding NewApiSecret}" PasswordChar="•" PlaceholderText="Paste API secret…" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSmall}" />
                  </StackPanel>
                  <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🔒" FontSize="{DynamicResource FsSubhead}" />
                      <TextBlock Text="Keys are stored locally and encrypted. Read-only permissions recommended. Never enable withdrawal rights." FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Width="440" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <!-- DEX / MEME / NFT -->
                <StackPanel IsVisible="{Binding ModalIsDex}" Spacing="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="CHAIN" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <ItemsControl ItemsSource="{Binding ChainOptions}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pd:PfChainOption">
                          <Button Classes="FlatChrome" Command="{Binding Command}" Margin="0,0,6,6" Padding="14,6" CornerRadius="20" BorderThickness="1"
                                  BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                                  Background="{Binding Bg, Converter={StaticResource StringToBrush}}"
                                  Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"
                                  FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Content="{Binding Label}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="WALLET ADDRESS" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <TextBox Text="{Binding NewWalletAddress}" PlaceholderText="{Binding AddrPlaceholder}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" />
                  </StackPanel>
                  <Border IsVisible="{Binding ModalIsMeme}" Background="{DynamicResource NegativeFill}" BorderBrush="{DynamicResource NegativeFillStroke}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="⚠️" FontSize="{DynamicResource FsSubhead}" />
                      <StackPanel Width="440">
                        <TextBlock Text="HIGH RISK WALLET TYPE" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource Negative}" />
                        <TextBlock Text="Meme wallets are monitored with extra rug-pull and honeypot checks. Use only funds you can afford to lose." FontSize="{DynamicResource FsMicro}" Foreground="#8a5a5a" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <!-- STAKE -->
                <StackPanel IsVisible="{Binding ModalIsStake}" Spacing="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="STAKING PROTOCOL" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <ItemsControl ItemsSource="{Binding StakeProtocols}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pd:PfStakeProtocol">
                          <Button Classes="Flat FlatChrome" Command="{Binding Command}" Margin="0,0,6,6">
                            <Border BorderThickness="1" CornerRadius="8" Padding="10"
                                    BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                                    Background="{Binding Bg, Converter={StaticResource StringToBrush}}">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Logo}" FontSize="{DynamicResource FsSubhead}" VerticalAlignment="Center" />
                                <StackPanel>
                                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{Binding LabelColor, Converter={StaticResource StringToBrush}}" />
                                  <TextBlock Text="{Binding Apy}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource FontMono}" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="WALLET ADDRESS" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <TextBox Text="{Binding NewWalletAddress}" PlaceholderText="0x… or validator address" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" />
                  </StackPanel>
                </StackPanel>
                <!-- PERP -->
                <StackPanel IsVisible="{Binding ModalIsPerp}" Spacing="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="EXCHANGE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <ItemsControl ItemsSource="{Binding PerpOptions}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pd:PfPerpOption">
                          <Button Classes="FlatChrome" Command="{Binding Command}" Margin="0,0,6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  BorderThickness="1" CornerRadius="8" Padding="6,10"
                                  BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}"
                                  Background="{Binding Bg, Converter={StaticResource StringToBrush}}">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Logo}" FontSize="{DynamicResource FsTitle}" HorizontalAlignment="Center" />
                              <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding LabelColor, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="API KEY" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                    <TextBox Text="{Binding NewApiKey}" PlaceholderText="Paste API key…" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSmall}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- STEP 3 -->
              <StackPanel IsVisible="{Binding ModalIsStep3}" Spacing="10">
                <TextBlock Text="RUNNING SECURITY SCAN…" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                <ItemsControl ItemsSource="{Binding ModalChecks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pd:PfModalCheck">
                      <Border Background="{DynamicResource Surface1}" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,8"
                              BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}">
                        <Grid ColumnDefinitions="28,*,Auto">
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="{Binding IconBg, Converter={StaticResource StringToBrush}}">
                            <TextBlock Text="{Binding Icon}" FontSize="{DynamicResource FsBody}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding Desc}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border Grid.Column="2" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}" CornerRadius="5" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{Binding ModalResultBg, Converter={StaticResource StringToBrush}}"
                        BorderBrush="{Binding ModalResultBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="10" Padding="14">
                  <Grid ColumnDefinitions="44,*">
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" BorderThickness="3"
                            BorderBrush="{Binding ModalResultColor, Converter={StaticResource StringToBrush}}">
                      <TextBlock Text="{Binding ModalResultIcon}" FontSize="{DynamicResource FsTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ModalResultLabel}" FontSize="{DynamicResource FsBody}" FontWeight="ExtraBold" Foreground="{Binding ModalResultColor, Converter={StaticResource StringToBrush}}" />
                      <TextBlock Text="{Binding ModalResultDesc}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <!-- Modal footer -->
          <Border Grid.Row="2" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
              <!-- step2 footer -->
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ModalIsStep2}" HorizontalAlignment="Stretch">
                <Button Classes="FlatChrome" Content="BACK" Command="{Binding ModalBackCommand}" Padding="20,10" CornerRadius="8" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Background="{DynamicResource Surface1}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" />
                <Button Classes="FlatChrome" Content="CONTINUE →" Command="{Binding ModalNextCommand}" HorizontalAlignment="Stretch" Width="420" Padding="10" CornerRadius="8" Background="{DynamicResource PositiveFill}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsBody}" FontWeight="ExtraBold" HorizontalContentAlignment="Center" />
              </StackPanel>
              <!-- step3 footer -->
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ModalIsStep3}">
                <Button Classes="FlatChrome" Content="BACK" Command="{Binding ModalBackCommand}" Padding="20,10" CornerRadius="8" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Background="{DynamicResource Surface1}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" />
                <Button Classes="FlatChrome" Content="✓ ADD WALLET" Command="{Binding ModalConfirmCommand}" HorizontalAlignment="Stretch" Width="420" Padding="10" CornerRadius="8"
                        Background="{Binding ConfirmBtnBg, Converter={StaticResource StringToBrush}}"
                        Foreground="{Binding ConfirmBtnColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsBody}" FontWeight="ExtraBold" HorizontalContentAlignment="Center" />
              </StackPanel>
              <!-- step1 footer: just a hint -->
              <TextBlock Text="Choose a wallet type to continue" IsVisible="{Binding ModalIsStep1}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" HorizontalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Border>

    <!-- ══════════ CONNECTION STUDIO (advanced connect + diagnostics) ══════════ -->
    <Border IsVisible="{Binding ConnectionStudioVisible}" Background="#D9040b12" ZIndex="210">
      <Border Width="640" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource InfoTintStroke}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

          <!-- Header (desk context: close command) -->
          <Border Grid.Row="0" Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource InfoTintStroke}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid ColumnDefinitions="34,*,Auto">
              <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="#0d2a40" BorderBrush="#12395c" BorderThickness="1">
                <TextBlock Text="🔑" FontSize="{DynamicResource FsSubhead}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="DIAGNOSTICS &amp; TOOLS" FontSize="{DynamicResource FsSubhead}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Self-tests &amp; Tron TRC20 payments for the active session" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
              </StackPanel>
              <Button Classes="FlatChrome" Grid.Column="2" Content="×" Command="{Binding CloseStudioCommand}" Width="28" Height="28" Padding="0" FontSize="{DynamicResource FsTitle}"
                      ToolTip.Tip="Close" AutomationProperties.Name="Close diagnostics"
                      CornerRadius="7" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Background="{DynamicResource Surface1}" Foreground="{DynamicResource TextDim}" />
            </Grid>
          </Border>

          <!-- Content bound to the real WalletVM -->
          <ScrollViewer Grid.Row="1" DataContext="{Binding $parent[Window].DataContext.WalletVM}">
            <StackPanel Margin="20" Spacing="14">

              <!-- Target network for the diagnostics below -->
              <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel Spacing="8">
                  <TextBlock Text="TARGET NETWORK" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                  <ComboBox ItemsSource="{Binding AvailableNetworks}" SelectedItem="{Binding SelectedNetwork}" HorizontalAlignment="Stretch" />
                  <TextBlock Text="Add wallets with + ADD WALLET, then click a wallet in the list to make it the active session and arm trading from its panel. These tools run against that session."
                             Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- Diagnostics: Solana -->
              <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel Spacing="8">
                  <TextBlock Text="SOLANA SELF-TEST" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                  <TextBlock Text="Safe end-to-end probe: wallet, RPC, blockhash, signing, memo simulation, Jupiter quote &amp; signed swap simulation." Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
                  <Button Classes="FlatChrome" Content="RUN SOLANA SELF-TEST" Command="{Binding RunSolanaDiagnosticsCommand}" IsEnabled="{Binding CanRunSolanaDiagnostics}"
                          HorizontalAlignment="Left" Padding="14,6" CornerRadius="7" Background="{DynamicResource PositiveFill}" BorderBrush="{DynamicResource PositiveFillStroke}" BorderThickness="1" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                  <TextBlock Text="{Binding SolanaDiagnosticsSummary}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <ScrollViewer MaxHeight="150">
                    <ItemsControl ItemsSource="{Binding SolanaDiagnosticSteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding .}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" TextWrapping="Wrap" Margin="0,0,0,2" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>

              <!-- Diagnostics: Tron (only when Tron selected) -->
              <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding IsTronNetworkSelected}">
                <StackPanel Spacing="8">
                  <TextBlock Text="TRON SELF-TEST" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                  <TextBlock Text="Safe Tron smoke-check: wallet, RPC, TRC20 metadata, SunSwap quote &amp; unsigned swap preview (no broadcast)." Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
                  <Button Classes="FlatChrome" Content="RUN TRON SELF-TEST" Command="{Binding RunTronDiagnosticsCommand}" IsEnabled="{Binding CanRunTronDiagnostics}"
                          HorizontalAlignment="Left" Padding="14,6" CornerRadius="7" Background="{DynamicResource PositiveFill}" BorderBrush="{DynamicResource PositiveFillStroke}" BorderThickness="1" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                  <TextBlock Text="{Binding TronDiagnosticsSummary}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <ScrollViewer MaxHeight="150">
                    <ItemsControl ItemsSource="{Binding TronDiagnosticSteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding .}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontFamily="{StaticResource FontMono}" TextWrapping="Wrap" Margin="0,0,0,2" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>

              <!-- Tron TRC20 payments (only when Tron selected) -->
              <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding IsTronNetworkSelected}">
                <StackPanel Spacing="10">
                  <TextBlock Text="TRON TRC20 PAYMENTS" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                  <TextBlock Text="Send a real TRC20 transfer from the armed Tron session — built, signed locally, broadcast via Tron RPC." Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="FlatChrome" Content="USE USDC" Command="{Binding ApplyTronTokenPresetCommand}" CommandParameter="USDC"
                            Background="{Binding TronUsdcPresetBackground, Converter={StaticResource StringToBrush}}" Foreground="{Binding TronUsdcPresetForeground, Converter={StaticResource StringToBrush}}"
                            Padding="14,6" CornerRadius="7" BorderBrush="{DynamicResource PanelStrokeBright}" BorderThickness="1" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    <Button Classes="FlatChrome" Content="USE USDT" Command="{Binding ApplyTronTokenPresetCommand}" CommandParameter="USDT"
                            Background="{Binding TronUsdtPresetBackground, Converter={StaticResource StringToBrush}}" Foreground="{Binding TronUsdtPresetForeground, Converter={StaticResource StringToBrush}}"
                            Padding="14,6" CornerRadius="7" BorderBrush="{DynamicResource PanelStrokeBright}" BorderThickness="1" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  </StackPanel>
                  <TextBlock Text="{Binding TronTrc20BalanceLabel, StringFormat='Tracked token balance: {0}'}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbol" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TronTrc20Symbol}" PlaceholderText="USDT" FontSize="{DynamicResource FsCaption}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Contract" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TronTrc20ContractAddress}" PlaceholderText="TRC20 contract address" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Recipient" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TronPaymentRecipient}" PlaceholderText="Recipient Tron address" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Amount" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding TronTrc20Amount}" Increment="0.1" Minimum="0" FormatString="0.######" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Fee (TRX)" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding TronFeeLimitTrx}" Increment="1" Minimum="1" FormatString="0.##" />
                  </Grid>
                  <Button Classes="FlatChrome" Content="SEND TRC20" Command="{Binding SendTronPaymentCommand}" IsEnabled="{Binding CanSendTronPaymentLive}"
                          ToolTip.Tip="{Binding TronPaymentBlockedReason}" HorizontalAlignment="Left"
                          Padding="16,6" CornerRadius="7" Background="{DynamicResource PositiveFill}" BorderBrush="{DynamicResource PositiveFillStroke}" BorderThickness="1" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                  <TextBlock Text="{Binding TronPaymentBlockedReason}" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" IsVisible="{Binding !CanSendTronPaymentLive}" />
                  <TextBlock Text="{Binding TronPaymentStatus}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>
  </Panel>
</UserControl>

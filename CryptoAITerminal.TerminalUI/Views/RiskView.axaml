<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:ctrl="clr-namespace:CryptoAITerminal.TerminalUI.Controls"
             x:Class="CryptoAITerminal.TerminalUI.Views.RiskView"
             x:DataType="vm:RiskScreenViewModel"
             x:CompileBindings="True">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
              <Border Grid.Column="0" Classes="SurfaceCard">
                <StackPanel Spacing="6">
                  <TextBlock Classes="Overline" Text="Execution Guard" />
                  <TextBlock Classes="Metric" Text="{Binding Wallet.GlobalExecutionModeLabel}" />
                  <TextBlock Text="{Binding Wallet.GlobalExecutionGuardStatusLabel}"
                             Foreground="{Binding RiskRuntimeStatusBrush, Converter={StaticResource StringToBrush}}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="SurfaceCard">
                <StackPanel Spacing="6">
                  <TextBlock Classes="Overline" Text="Risk Budget" />
                  <TextBlock Text="{Binding RiskRuntimeSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RiskCexExposureSummary}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="SurfaceCard">
                <StackPanel Spacing="6">
                  <TextBlock Classes="Overline" Text="Sniper Safety" />
                  <TextBlock Text="{Binding RiskSniperGuardSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Sniper.StatusMessage}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- ── Live risk metrics ── -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
              <Border Grid.Column="0" Classes="SurfaceCard">
                <StackPanel Spacing="4">
                  <TextBlock Classes="Overline" Text="Realized P&amp;L" />
                  <TextBlock Classes="Metric" Text="{Binding Pnl.TotalPnlLabel}"
                             Foreground="{Binding Pnl.TotalPnlBrush, Converter={StaticResource StringToBrush}}" />
                  <TextBlock Text="{Binding Pnl.TradeCountLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="SurfaceCard">
                <StackPanel Spacing="4">
                  <TextBlock Classes="Overline" Text="Open P&amp;L (unrealized)" />
                  <TextBlock Classes="Metric" Text="{Binding Positions.TotalPnlLabel}"
                             Foreground="{Binding Positions.TotalPnlBrush, Converter={StaticResource StringToBrush}}" />
                  <TextBlock Text="{Binding Positions.StatusLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="SurfaceCard">
                <StackPanel Spacing="4">
                  <TextBlock Classes="Overline" Text="Open Positions" />
                  <TextBlock Classes="Metric" Text="{Binding Positions.PositionCount}" />
                  <TextBlock Text="{Binding Positions.TotalSizeLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="SurfaceCard">
                <StackPanel Spacing="4">
                  <TextBlock Classes="Overline" Text="Win Rate / PF" />
                  <TextBlock Classes="Metric" Text="{Binding Pnl.WinRateLabel}" />
                  <TextBlock Text="{Binding Pnl.ProfitFactorLabel, StringFormat='PF {0}'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
                  <TextBlock Text="{Binding Pnl.MaxDrawdownLabel, StringFormat='Max DD {0}'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- ── CEX order-guard limits (RiskManager) ── -->
            <Border Classes="Panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="H2" Text="Risk Limits (CEX order guard)" />
                <TextBlock Text="Hard caps enforced on every CEX order before it is placed."
                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,160,Auto,160,Auto" ColumnSpacing="12" RowSpacing="8">
                  <TextBlock Grid.Column="0" Text="Max position / exposure (USDT)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Minimum="0" Increment="50"
                                 Value="{Binding RiskLimitPositionInput}" />
                  <TextBlock Grid.Column="2" Text="Max daily loss (USDT)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="3" Minimum="0" Increment="25"
                                 Value="{Binding RiskLimitDailyLossInput}" />
                  <Button Grid.Column="4" Classes="GhostButton" Content="Apply Limits"
                          VerticalAlignment="Center"
                          Command="{Binding ApplyRiskLimitsCommand}" />
                </Grid>
                <TextBlock Text="{Binding RiskBudgetPositionCapLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RiskBudgetDailyLossLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RiskBudgetRemainingLabel}" Foreground="{DynamicResource TextMuted}" />
                <TextBlock Text="{Binding RiskBudgetWarningLabel}" FontWeight="SemiBold"
                           Foreground="{Binding RiskBudgetWarningBrush, Converter={StaticResource StringToBrush}}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RiskBudgetBlockReason}"
                           Foreground="{Binding RiskBudgetBlockBrush, Converter={StaticResource StringToBrush}}" TextWrapping="Wrap" />
                <Button Classes="GhostButton" Content="Reset Daily Loss"
                        HorizontalAlignment="Left"
                        Command="{Binding ResetDailyRiskCommand}" />
              </StackPanel>
            </Border>

            <!-- ── Daily-loss trajectory + blocked-order log ── -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <Border Grid.Column="0" Classes="Panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="H2" Text="Daily Loss Trajectory" />
                  <TextBlock Text="Cumulative realized loss today vs the daily cap."
                             Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="8" Height="64"
                          IsVisible="{Binding HasRiskDailyLossSparkline}">
                    <Polyline Points="{Binding RiskDailyLossSparkline}"
                              Stroke="{Binding RiskBudgetWarningBrush, Converter={StaticResource StringToBrush}}" StrokeThickness="2"
                              StrokeJoin="Round" />
                  </Border>
                  <TextBlock Text="No realized losses recorded today."
                             Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsSmall}"
                             IsVisible="{Binding !HasRiskDailyLossSparkline}" />
                  <TextBlock Text="{Binding RiskBudgetRemainingLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsSmall}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="Panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="H2" Text="Blocked Orders" />
                  <TextBlock Text="{Binding RiskBlockHistoryEmptyLabel}"
                             Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                             IsVisible="{Binding !HasRiskBlockHistory}" />
                  <ItemsControl ItemsSource="{Binding RiskBlockHistoryLines}"
                                IsVisible="{Binding HasRiskBlockHistory}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Warning}"
                                   FontSize="{DynamicResource FsSmall}" FontFamily="Cascadia Code,Consolas,monospace"
                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <Border Grid.Column="0" Classes="Panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="H2" Text="Quick Controls" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="GhostButton"
                            Content="Paper Mode"
                            Margin="0,0,10,10"
                            Command="{Binding Wallet.ApplyGlobalExecutionModeCommand}"
                            CommandParameter="PAPER" />
                    <!-- Two-step: first click arms and turns the label red, second click applies. -->
                    <Button Classes="GhostButton"
                            Content="{Binding Wallet.GlobalLiveButtonLabel}"
                            Foreground="{Binding Wallet.GlobalLiveButtonForeground, Converter={StaticResource StringToBrush}}"
                            ToolTip.Tip="Drops the global paper-only guard for Trading, DEX, Sniper and TRON. Click twice to confirm."
                            Margin="0,0,10,10"
                            Command="{Binding Wallet.ApplyGlobalExecutionModeCommand}"
                            CommandParameter="LIVE" />
                    <Button Classes="GhostButton"
                            Content="Refresh Wallet"
                            Margin="0,0,10,10"
                            Command="{Binding Wallet.RefreshWalletCommand}" />
                    <Button Classes="GhostButton"
                            Content="Open Logs"
                            Margin="0,0,10,10"
                            Command="{Binding SelectMainTabCommand}"
                            CommandParameter="logs" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="Panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="H2" Text="Readiness Notes" />
                  <TextBlock Text="{Binding Wallet.GlobalExecutionSummary}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Wallet.GlobalQuoteAssetSummary}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding FuturesPrivateApiStatusLabel}" Foreground="{Binding FuturesPrivateApiStatusBrush, Converter={StaticResource StringToBrush}}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
</UserControl>

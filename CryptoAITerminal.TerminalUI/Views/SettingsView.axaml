<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CryptoAITerminal.TerminalUI.Converters"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:sd="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels.SettingsDesk"
             xmlns:bd="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels.BotsDesk"
             x:Class="CryptoAITerminal.TerminalUI.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True"
             FontFamily="{StaticResource FontDisplay}">

  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="0" /><Setter Property="CaretBrush" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement"><Setter Property="MinHeight" Value="0" /></Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="0" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="FontSize" Value="{DynamicResource FsCaption}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- No fixed 760px floor: on a 1280x720 screen it forced an outer scroll over the desk's own
       scrollers and pushed the pinned footer past the bottom edge. -->
  <Border IsVisible="{Binding IsSettingsSectionVisible}" MinHeight="460">
    <!-- x:DataType cannot sit on this Grid: it would also retype the Grid's own
         {Binding SettingsDesk}, which has to resolve against MainWindowViewModel. The desk type
         is therefore declared on the Grid's three children (DockPanel, modal, toast). -->
    <Grid DataContext="{Binding SettingsDesk}" Background="{DynamicResource AppBg}" ClipToBounds="True">
      <DockPanel LastChildFill="True" x:DataType="sd:SettingsDeskViewModel">

        <!-- ═══ header ═══ -->
        <Border DockPanel.Dock="Top" Height="54" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="14,0">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="14,0,0,0">
              <Button Classes="FlatChrome" Command="{Binding RevertCommand}" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="5" Padding="8,4" Content="REVERT" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
              <Button Classes="FlatChrome" Command="{Binding ExportProfileCommand}" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="5" Padding="8,4" Content="↑ EXPORT PROFILE" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
              <Button Classes="FlatChrome" Command="{Binding SaveAllCommand}" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="5" Padding="12,6" Content="SAVE ALL" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Border Padding="0,0,16,0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="/" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSubhead}" FontWeight="Light" />
                  <TextBlock Text="Settings" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" />
                </StackPanel>
              </Border>
              <Border Padding="14,0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <TextBlock Text="LICENSE" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" VerticalAlignment="Center" />
                  <Border BorderBrush="{Binding LicBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="5" Background="{Binding LicBg, Converter={StaticResource StringToBrush}}" Padding="8,2">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <Border Width="6" Height="6" CornerRadius="3" Background="{Binding LicColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding LicBadge}" Foreground="{Binding LicColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <Border Padding="14,0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="EXCHANGE KEYS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding HdrKeys}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSubhead}" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding HdrKeysSub}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" Margin="0,0,0,2" VerticalAlignment="Bottom" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Padding="14,0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="DATA KEYS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding HdrData}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSubhead}" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding HdrDataSub}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" Margin="0,0,0,2" VerticalAlignment="Bottom" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Padding="14,0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="ALERT CHANNELS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding HdrChannels}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSubhead}" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="{Binding HdrChannelsSub}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" Margin="0,0,0,2" VerticalAlignment="Bottom" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Padding="14,0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="ACTIVE ALERTS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding HdrAlerts}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSubhead}" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding HdrAlertsSub}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" Margin="0,0,0,2" VerticalAlignment="Bottom" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Padding="14,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DirtyLabel}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding DirtyColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- ═══ footer ═══ -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Padding="14,0">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="{Binding FooterSaved}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <TextBlock Text="{Binding FooterState, StringFormat='● config {0}'}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding FooterColor, Converter={StaticResource StringToBrush}}" />
              <TextBlock Text="{Binding FooterStore}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
              <TextBlock Text="{Binding FooterEncryption}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
              <TextBlock Text="{Binding FooterProfile}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- ═══ body: nav + content ═══ -->
        <Grid Margin="8" ColumnDefinitions="218,8,*">

          <!-- left nav -->
          <Border Grid.Column="0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" ClipToBounds="True">
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Top" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="10,8">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="⌕" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                  <TextBox Text="{Binding NavSearch, Mode=TwoWay}" PlaceholderText="find a setting…" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" Width="170" />
                </StackPanel>
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NavGroups}" Margin="6">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sd:NavGroup">
                      <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Padding="6,6,6,4" />
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sd:NavItem">
                              <Button Classes="FlatChrome" Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderThickness="0" CornerRadius="6" Padding="8,6" Margin="0,1">
                                <Grid ColumnDefinitions="2,8,*,Auto">
                                  <Border Grid.Column="0" Width="2" Height="14" CornerRadius="1" Background="{Binding Mark, Converter={StaticResource StringToBrush}}" />
                                  <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="3" Text="{Binding Badge}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding BadgeColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <!-- content -->
          <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
            <StackPanel Spacing="7">

              <!-- ══════════ AI PROVIDER ══════════ -->
              <StackPanel Spacing="7" IsVisible="{Binding IsAi}">
                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,4">
                      <TextBlock Text="AI assistant" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <Border BorderBrush="{DynamicResource AccentTintStroke}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource AccentTint}" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AiActiveBadge}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                      </Border>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" FontSize="{DynamicResource FsCaption}" LineHeight="18" Foreground="{DynamicResource TextDim}"
                               Text="Powers every assistant in the terminal — copilot, daily briefing, pre-trade risk, alert builder, scanner ranking, options advisor. Keys are stored encrypted on this PC (DPAPI) and only leave it in calls to the provider you pick." />
                    <ItemsControl ItemsSource="{Binding Providers}" Margin="0,12,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:ProviderCard">
                          <Button Classes="FlatChrome" Command="{Binding Command}" Margin="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="9" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" Padding="12">
                            <StackPanel>
                              <Grid ColumnDefinitions="Auto,8,Auto,*,Auto" Margin="0,0,0,4">
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" BorderBrush="{Binding DotBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" Background="{Binding DotBg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Status}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                              </Grid>
                              <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="{DynamicResource FsMicro}" LineHeight="15" Foreground="{DynamicResource TextDim}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="1.6*,10,1*" Margin="0,12,0,0">
                      <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="{Binding AiKeyLabel}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Border Width="330" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                            <TextBox Text="{Binding AiKey, Mode=TwoWay}" PasswordChar="{Binding AiKeyChar}" PlaceholderText="{Binding AiKeyPlaceholder}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                          </Border>
                          <Button Classes="FlatChrome" Command="{Binding RevealCommand}" Width="44" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Content="{Binding AiRevealIcon}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                          <Button Classes="FlatChrome" Command="{Binding AiConsoleCommand}" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="GET KEY" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5">
                        <TextBlock Text="MODEL" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <Border Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                          <TextBox Text="{Binding AiModel, Mode=TwoWay}" PlaceholderText="{Binding AiModelPlaceholder}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                        </Border>
                      </StackPanel>
                    </Grid>
                    <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                      <Grid ColumnDefinitions="Auto,8,Auto,*,Auto">
                        <Button Classes="FlatChrome" Grid.Column="0" Command="{Binding AiSaveCommand}" Height="29" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="12,0" Content="SAVE PROVIDER" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                        <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding AiTestCommand}" Height="29" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="TEST CONNECTION" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                        <TextBlock Grid.Column="4" Text="{Binding AiStatusText}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding AiStatusColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <!-- CryptoAI server. Without this the only way to bind a terminal was to create
                         server_url.txt by hand, so for a customer every server feature stayed off
                         and looked identical to being broken. -->
                    <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="Auto,8,Auto">
                          <TextBlock Grid.Column="0" Text="CRYPTOAI SERVER" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                          <Border Grid.Column="2" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="8" Padding="8,2">
                            <TextBlock Text="{Binding ServerBadge}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold"
                                       Foreground="{Binding ServerStatusColor, Converter={StaticResource StringToBrush}}" />
                          </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Border Width="330" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                            <TextBox Text="{Binding ServerUrl, Mode=TwoWay}" PlaceholderText="{Binding ServerUrlPlaceholder}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                          </Border>
                          <Button Classes="FlatChrome" Command="{Binding ServerSaveCommand}" Height="30" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="12,0" Content="CONNECT" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{Binding ServerStatusText}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap"
                                   Foreground="{Binding ServerStatusColor, Converter={StaticResource StringToBrush}}" />
                        <TextBlock Text="Leave empty to disconnect and run fully locally." FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14" IsVisible="{Binding HasFeatures}">
                  <StackPanel>
                    <TextBlock Text="Where AI is used" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Features}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bd:GuardToggle">
                          <Button Classes="FlatChrome" Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" CornerRadius="6" Background="Transparent" Padding="8,8">
                            <Grid ColumnDefinitions="*,12,Auto">
                              <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Hint}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Border Grid.Column="2" Width="28" Height="15" CornerRadius="8" Background="{Binding TrackBg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center">
                                <Canvas><Border Canvas.Left="{Binding KnobLeft}" Canvas.Top="2" Width="11" Height="11" CornerRadius="6" Background="{Binding Knob, Converter={StaticResource StringToBrush}}" /></Canvas>
                              </Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ══════════ LICENSE & PROFILES ══════════ -->
              <StackPanel Spacing="7" IsVisible="{Binding IsLicense}">
                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,9,Auto,*,Auto" Margin="0,0,0,12">
                      <TextBlock Grid.Column="0" Text="License &amp; activation" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <Border Grid.Column="2" BorderBrush="{Binding LicBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="4" Background="{Binding LicBg, Converter={StaticResource StringToBrush}}" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LicBadge}" Foreground="{Binding LicColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                      </Border>
                      <TextBlock Grid.Column="4" Text="{Binding LicDetail}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="MACHINE ID — SEND THIS TO THE BOT BEFORE PAYING" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Border Width="620" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                        <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                      </Border>
                      <Button Classes="FlatChrome" Command="{Binding LicCopyCommand}" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="COPY" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="ACTIVATION KEY" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,10,0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Border Width="620" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                        <TextBox Text="{Binding LicKey, Mode=TwoWay}" PlaceholderText="Paste your license key here" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                      </Border>
                      <Button Classes="FlatChrome" Command="{Binding LicActivateCommand}" Height="30" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="14,0" Content="ACTIVATE" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="{Binding LicStatus}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding LicStatusColor, Converter={StaticResource StringToBrush}}" Margin="0,8,0,0" />
                    <Border Margin="0,12,0,0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Surface0}" Padding="10">
                      <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FsMicro}" LineHeight="16" Foreground="{DynamicResource TextDim}"
                                 Text="Buy a key in the Telegram bot. Without a valid license only Demo (paper) mode is available after the trial — bots still run, but every order is simulated." />
                    </Border>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                      <TextBlock Grid.Column="0" Text="Configuration profiles" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding ProfStatus}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}" LineHeight="16" Foreground="{DynamicResource TextDim}" Margin="0,0,0,10"
                               Text="Saves every bot / sniper / grid / risk setting as a named profile. API keys are never included, so a profile is safe to share." />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Border Width="560" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                        <TextBox Text="{Binding ProfileName, Mode=TwoWay}" PlaceholderText="Profile name" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
                      </Border>
                      <Button Classes="FlatChrome" Command="{Binding ProfSaveCommand}" Height="30" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="12,0" Content="SAVE" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      <Button Classes="FlatChrome" Command="{Binding ProfImportCommand}" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="↓ IMPORT" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,10,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:ProfileCard">
                          <Border BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="7" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" Padding="8,8" Margin="0,0,0,2">
                            <Grid ColumnDefinitions="*,Auto,9,Auto,5,Auto,5,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Meta}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                              <Button Classes="FlatChrome" Grid.Column="3" Command="{Binding LoadCommand}" Height="22" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource Surface0}" Padding="8,0" Content="LOAD" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                              <Button Classes="FlatChrome" Grid.Column="5" Command="{Binding ExportCommand}" Height="22" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource Surface0}" Padding="8,0" Content="EXPORT" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                              <Button Classes="FlatChrome" Grid.Column="7" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete preset" Width="22" Height="22" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource Surface0}" Padding="0" Content="✕" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ══════════ EXCHANGE KEYS ══════════ -->
              <StackPanel Spacing="7" IsVisible="{Binding IsKeys}">
                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Text="Exchange API keys" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding ExToggleHelpCommand}" ToolTip.Tip="Show help" AutomationProperties.Name="Toggle API key help" Width="26" Height="26" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="0" Content="?" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" />
                    </Grid>
                    <Border IsVisible="{Binding HasTestnetBanner}" Margin="0,10,0,0" BorderBrush="{DynamicResource WarningTintStroke}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource WarningTint}" Padding="10">
                      <TextBlock Text="{Binding TestnetBanner}" TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}" LineHeight="16" Foreground="#f0b90b" />
                    </Border>
                    <Border IsVisible="{Binding ExHelp}" Margin="0,10,0,0" BorderBrush="#2a3a12" BorderThickness="1" CornerRadius="8" Background="#0d1004" Padding="12">
                      <StackPanel Spacing="5">
                        <TextBlock Text="How to create keys" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="#f0b90b" Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{Binding HelpSteps}">
                          <ItemsControl.ItemTemplate>
                            <!-- HelpSteps is (string n, string text)[]: a ValueTuple cannot be named in
                                 x:DataType, so these two rows stay reflection-bound. -->
                            <DataTemplate>
                              <Grid ColumnDefinitions="Auto,8,*" Margin="0,0,0,2">
                                <TextBlock Grid.Column="0" Text="{ReflectionBinding Item1}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="#f0b90b" />
                                <TextBlock Grid.Column="2" Text="{ReflectionBinding Item2}" TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}" LineHeight="16" Foreground="{DynamicResource TextNote}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding HelpPath}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" LineHeight="16" Foreground="{DynamicResource TextDim}" Margin="0,4,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Surface0}" Padding="2">
                      <ItemsControl ItemsSource="{Binding ExTabs}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sd:ExTabVM">
                            <Button Classes="FlatChrome" Command="{Binding Command}" Height="30" BorderThickness="0" CornerRadius="6" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" Margin="1,0" HorizontalAlignment="Stretch">
                              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{Binding Dot, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding State}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding StateColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <Border Margin="0,12,0,0" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Background="{DynamicResource Surface0}" Padding="12">
                      <StackPanel>
                        <Grid ColumnDefinitions="Auto,9,Auto,9,Auto,*,Auto" Margin="0,0,0,10">
                          <TextBlock Grid.Column="0" Text="{Binding ExCurName}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                          <Border Grid.Column="2" BorderBrush="{Binding ExSrcBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="4" Background="{Binding ExSrcBg, Converter={StaticResource StringToBrush}}" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ExSrcLabel}" Foreground="{Binding ExSrcColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                          </Border>
                          <TextBlock Grid.Column="4" Text="{Binding ExMask}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="#f0b90b" VerticalAlignment="Center" />
                          <Button Classes="FlatChrome" Grid.Column="6" Command="{Binding TestnetCommand}" BorderBrush="{Binding TnBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="6" Background="{Binding TnBg, Converter={StaticResource StringToBrush}}" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                              <Border Width="24" Height="13" CornerRadius="7" Background="{Binding TnTrack, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center">
                                <Canvas><Border Canvas.Left="{Binding TnKnobLeft}" Canvas.Top="2" Width="9" Height="9" CornerRadius="5" Background="{Binding TnKnob, Converter={StaticResource StringToBrush}}" /></Canvas>
                              </Border>
                              <TextBlock Text="TESTNET" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding TnColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </Grid>
                        <TextBlock Text="{Binding TnNote}" TextWrapping="Wrap" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" LineHeight="15" Foreground="{Binding TnNoteColor, Converter={StaticResource StringToBrush}}" Margin="0,-4,0,10" />
                        <ItemsControl ItemsSource="{Binding ExFields}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sd:SetField">
                              <StackPanel Spacing="5" Margin="4">
                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                                <Border Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                                  <TextBox Text="{Binding Value, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}" PlaceholderText="{Binding Placeholder}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                                </Border>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,12,0,0" VerticalAlignment="Center" IsVisible="{Binding HasPerms}">
                          <TextBlock Text="PERMISSIONS" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,0,2,0" VerticalAlignment="Center" />
                          <ItemsControl ItemsSource="{Binding Perms}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="sd:PermToggle">
                                <Button Classes="FlatChrome" Command="{Binding Command}" Height="22" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="5" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" Padding="8,0" Content="{Binding Label}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                          <Grid ColumnDefinitions="Auto,7,Auto,7,Auto,*,Auto">
                            <Button Classes="FlatChrome" Grid.Column="0" Command="{Binding ExSaveCommand}" Height="28" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="12,0" Content="SAVE KEYS" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                            <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding ExTestCommand}" Height="28" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="TEST CONNECTION" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                            <Button Classes="FlatChrome" Grid.Column="4" Command="{Binding ExClearCommand}" Height="28" BorderBrush="{DynamicResource NegativeTintStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource NegativeTint}" Padding="10,0" Content="REMOVE KEYS" Foreground="{DynamicResource Negative}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                            <TextBlock Grid.Column="6" Text="{Binding ExStatus}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding ExStatusColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <TextBlock Text="Affiliate / referral links" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}" LineHeight="16" Foreground="{DynamicResource TextDim}" Margin="0,0,0,10"
                               Text="Used by the “open account” buttons around the terminal. Leave blank to use the plain exchange URL." />
                    <ItemsControl ItemsSource="{Binding AffFields}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:SetField">
                          <StackPanel Spacing="5" Margin="4">
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                            <Border Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                              <TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,9,Auto,*,Auto" Margin="0,0,0,10">
                      <TextBlock Grid.Column="0" Text="Wallet session" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <Border Grid.Column="2" BorderBrush="{Binding WalletBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="4" Background="{Binding WalletBg, Converter={StaticResource StringToBrush}}" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WalletBadge}" Foreground="{Binding WalletColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                      </Border>
                      <TextBlock Grid.Column="4" Text="{Binding WalletDetail}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Address" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                        <TextBlock Text="{Binding WalletAddr}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSmall}" Foreground="{Binding WalletAddrColor, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="Session expires" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                        <TextBlock Text="{Binding WalletExpires}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSmall}" Foreground="{Binding WalletExpiresColor, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="Status" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                        <TextBlock Text="{Binding WalletBadge}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsSmall}" Foreground="{Binding WalletColor, Converter={StaticResource StringToBrush}}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,12,0,0">
                      <Button Classes="FlatChrome" Command="{Binding WalletCommand}" Height="28" BorderBrush="{Binding WalletBtnBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="6" Background="{Binding WalletBtnBg, Converter={StaticResource StringToBrush}}" Padding="12,0" Content="{Binding WalletBtnLabel}" Foreground="{Binding WalletBtnColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      <Button Classes="FlatChrome" Command="{Binding WalletRotateCommand}" Height="28" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="ROTATE SESSION KEY" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ══════════ DEX & NETWORKS ══════════ -->
              <StackPanel Spacing="7" IsVisible="{Binding IsDex}">
                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,9,Auto,*,Auto" Margin="0,0,0,4">
                      <TextBlock Grid.Column="0" Text="DEX execution" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <Border Grid.Column="2" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource Surface0}" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DexRpcCount, StringFormat='{}{0} custom endpoints'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                      </Border>
                      <Button Classes="FlatChrome" Grid.Column="4" Command="{Binding DexResetRpcCommand}" Height="26" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="RESET ENDPOINTS" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" FontSize="{DynamicResource FsCaption}" LineHeight="18" Foreground="{DynamicResource TextDim}"
                               Text="The DEX venues on the market desk are public data and need no keys. A DEX connection here is your imported wallet plus the endpoint it talks to — leave a field blank to keep the built-in public node, or paste a paid endpoint (Alchemy, Helius, QuickNode) when the free one starts rate-limiting." />
                    <ItemsControl ItemsSource="{Binding RpcFields}" Margin="0,12,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:SetField">
                          <StackPanel Spacing="5" Margin="4">
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                            <Border Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                              <TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                      <TextBlock Grid.Column="0" Text="MEV protection" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding DexStatus}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding DexStatusColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" FontSize="{DynamicResource FsCaption}" LineHeight="18" Foreground="{DynamicResource TextDim}"
                               Text="Where a swap is submitted. On the public mempool a large trade can be sandwiched before it confirms; a private relay hides it until it lands. The mode is picked up when a wallet session is armed, so re-import the wallet after changing it." />

                    <TextBlock Text="EVM (Ethereum · BSC · Base · Polygon · Arbitrum)" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,12,0,6" />
                    <ItemsControl ItemsSource="{Binding EvmMevModes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:DexModeChip">
                          <Button Classes="FlatChrome" Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="9" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" Padding="12" Margin="0,0,0,4">
                            <StackPanel>
                              <Grid ColumnDefinitions="Auto,9,Auto,*">
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" BorderBrush="{Binding DotBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" Background="{Binding DotBg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                              </Grid>
                              <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="{DynamicResource FsMicro}" LineHeight="15" Foreground="{DynamicResource TextDim}" Margin="20,4,0,0" />
                              <TextBlock IsVisible="{Binding HasWarn}" Text="{Binding Warn}" TextWrapping="Wrap" FontSize="{DynamicResource FsMicro}" LineHeight="14" Foreground="#f0b90b" Margin="20,4,0,0" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="SOLANA" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding SolMevModes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:DexModeChip">
                          <Button Classes="FlatChrome" Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="9" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" Padding="12" Margin="0,0,0,4">
                            <StackPanel>
                              <Grid ColumnDefinitions="Auto,9,Auto,*">
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" BorderBrush="{Binding DotBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" Background="{Binding DotBg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                              </Grid>
                              <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="{DynamicResource FsMicro}" LineHeight="15" Foreground="{DynamicResource TextDim}" Margin="20,4,0,0" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding ShowJitoTip}" Margin="0,8,0,0">
                      <TextBlock Text="{Binding JitoTipLabel}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,0,0,6" />
                      <ItemsControl ItemsSource="{Binding JitoTips}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sd:DexModeChip">
                            <Button Classes="FlatChrome" Command="{Binding Command}" Height="26" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="6" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" Padding="10,0" Content="{Binding Label}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <TextBlock Text="Swap defaults &amp; live venues" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding DexSwapFields}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:SetField">
                          <StackPanel Spacing="5" Margin="4">
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                            <Border Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Unit}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding DexFlags}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bd:GuardToggle">
                          <Button Classes="FlatChrome" Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" CornerRadius="6" Background="Transparent" Padding="8,8">
                            <Grid ColumnDefinitions="*,12,Auto">
                              <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Hint}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Border Grid.Column="2" Width="28" Height="15" CornerRadius="8" Background="{Binding TrackBg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center">
                                <Canvas><Border Canvas.Left="{Binding KnobLeft}" Canvas.Top="2" Width="11" Height="11" CornerRadius="6" Background="{Binding Knob, Converter={StaticResource StringToBrush}}" /></Canvas>
                              </Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border IsVisible="{Binding DexHlDanger}" Margin="0,8,0,0" BorderBrush="{DynamicResource NegativeTintStroke}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource NegativeTint}" Padding="10">
                      <TextBlock Text="{Binding DexHlWarning}" TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}" LineHeight="16" Foreground="{DynamicResource Negative}" />
                    </Border>
                    <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Classes="FlatChrome" Grid.Column="0" Command="{Binding DexSaveCommand}" Height="29" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="12,0" Content="SAVE DEX SETTINGS" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="{Binding DexStorePath}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" MaxWidth="620" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ══════════ DATA PROVIDERS ══════════ -->
              <StackPanel Spacing="7" IsVisible="{Binding IsData}">
                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,9,Auto,*,Auto" Margin="0,0,0,4">
                      <TextBlock Grid.Column="0" Text="Data providers &amp; integrations" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <Border Grid.Column="2" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource Surface0}" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IntStatus}" Foreground="{Binding IntStatusColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                      </Border>
                      <Button Classes="FlatChrome" Grid.Column="4" Command="{Binding IntRevealCommand}" Height="26" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="{Binding IntRevealIcon}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" FontSize="{DynamicResource FsCaption}" LineHeight="18" Foreground="{DynamicResource TextDim}"
                               Text="Optional keys for everything the terminal reads outside the exchanges — wallet history, on-chain metrics, liquidations, news, DEX quotes. The terminal runs without them; a desk whose key is missing simply stays empty. Keys are encrypted with DPAPI on this PC and are never written into a configuration profile." />
                    <ItemsControl ItemsSource="{Binding IntGroups}" Margin="0,12,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:IntegrationGroupVM">
                          <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Items}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sd:IntegrationRowVM">
                                  <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="9" Background="{DynamicResource Surface0}" Padding="12" Margin="0,0,0,4">
                                    <StackPanel>
                                      <Grid ColumnDefinitions="Auto,9,Auto,9,Auto,*,Auto" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" BorderBrush="{Binding SrcBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="4" Background="{Binding SrcBg, Converter={StaticResource StringToBrush}}" Padding="6,2" VerticalAlignment="Center">
                                          <TextBlock Text="{Binding SrcLabel}" Foreground="{Binding SrcColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding EnvVar}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                        <Button Classes="FlatChrome" Grid.Column="6" IsVisible="{Binding HasConsole}" Command="{Binding ConsoleCommand}" Height="24" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource Surface0}" Padding="10,0" Content="GET KEY" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                                      </Grid>
                                      <Border Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                                        <TextBox Text="{Binding Value, Mode=TwoWay}" PasswordChar="{Binding Mask}" PlaceholderText="{Binding Placeholder}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                                      </Border>
                                      <TextBlock Text="{Binding Powers}" TextWrapping="Wrap" FontSize="{DynamicResource FsMicro}" LineHeight="16" Foreground="{DynamicResource TextDim}" Margin="0,6,0,0" />
                                      <TextBlock Text="{Binding Applies}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0" />
                                      <TextBlock IsVisible="{Binding EnvWins}" Text="An environment variable of the same name is set on this machine — it wins over anything typed here." TextWrapping="Wrap" FontSize="{DynamicResource FsMicro}" LineHeight="14" Foreground="#f0b90b" Margin="0,4,0,0" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,12,0,0">
                      <Grid ColumnDefinitions="Auto,7,Auto,*,Auto">
                        <Button Classes="FlatChrome" Grid.Column="0" Command="{Binding IntSaveCommand}" Height="29" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="12,0" Content="SAVE PROVIDER KEYS" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                        <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding IntClearCommand}" Height="29" BorderBrush="{DynamicResource NegativeTintStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource NegativeTint}" Padding="10,0" Content="REMOVE ALL KEYS" Foreground="{DynamicResource Negative}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                        <TextBlock Grid.Column="4" Text="{Binding IntStorePath}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ══════════ NOTIFICATIONS ══════════ -->
              <StackPanel Spacing="7" IsVisible="{Binding IsNotify}">
                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                      <TextBlock Grid.Column="0" Text="Notification channels" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
                        <Button Classes="FlatChrome" Command="{Binding NtTestAllCommand}" Height="26" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="TEST ALL CHANNELS" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                        <Button Classes="FlatChrome" Command="{Binding NtSaveAllCommand}" Height="26" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="10,0" Content="SAVE ALL CHANNELS" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding NtChannels}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:NtChannelVM">
                          <Border BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="9" Background="{DynamicResource Surface0}" Margin="0,0,0,6" ClipToBounds="True">
                            <StackPanel>
                              <Button Classes="FlatChrome" Command="{Binding ToggleOpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,9,Auto,9,Auto,*,Auto,9,Auto">
                                  <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4" Background="{Binding Dot, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="4" Text="{Binding Status}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="6" Text="{Binding Summary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="8" Text="{Binding Caret}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" VerticalAlignment="Center" />
                                </Grid>
                              </Button>
                              <StackPanel IsVisible="{Binding Open}" Margin="12,0,12,12">
                                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="{DynamicResource FsMicro}" LineHeight="16" Foreground="{DynamicResource TextDim}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Fields}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid x:DataType="sd:NtChannelVM" Columns="{Binding Cols}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sd:SetField">
                                      <StackPanel Spacing="5" Margin="4">
                                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                                        <Border Height="29" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                                          <TextBox Text="{Binding Value, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}" PlaceholderText="{Binding Placeholder}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                                        </Border>
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="FlatChrome" IsVisible="{Binding HasSsl}" Command="{Binding SslCommand}" HorizontalAlignment="Left" BorderThickness="0" CornerRadius="6" Background="Transparent" Padding="8,6" Margin="0,10,0,0">
                                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="13" Height="13" BorderBrush="{Binding SslBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="3" Background="{Binding SslBg, Converter={StaticResource StringToBrush}}">
                                      <TextBlock Text="{Binding SslMark}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsMicro}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Use STARTTLS (required by Gmail)" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Button>
                                <Grid ColumnDefinitions="Auto,7,Auto,*,Auto" Margin="0,12,0,0">
                                  <Button Classes="FlatChrome" Grid.Column="0" Command="{Binding TestCommand}" Height="27" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="SEND TEST" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                                  <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding EnableCommand}" Height="27" BorderBrush="{Binding EnBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="6" Background="{Binding EnBg, Converter={StaticResource StringToBrush}}" Padding="10,0" Content="{Binding EnLabel}" Foreground="{Binding EnColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                                  <TextBlock Grid.Column="4" Text="{Binding Last}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                </Grid>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,4">
                      <TextBlock Text="Telegram account &amp; inline signals" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <Border BorderBrush="{Binding TgBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="4" Background="{Binding TgBg, Converter={StaticResource StringToBrush}}" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TgBadge}" Foreground="{Binding TgColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold" />
                      </Border>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}" LineHeight="16" Foreground="{DynamicResource TextDim}" Margin="0,0,0,10"
                               Text="Signing in with your own Telegram account lets you talk to the bot from inside the app. With inline signals on, every alert arrives with Accept / Skip buttons — Accept places a market order through the terminal." />
                    <Grid ColumnDefinitions="Auto,10,Auto,*,Auto" VerticalAlignment="Bottom">
                      <StackPanel Grid.Column="0" Spacing="5" Width="170">
                        <TextBlock Text="PHONE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <Border Height="29" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                          <TextBox Text="{Binding TgPhone, Mode=TwoWay}" PlaceholderText="+1 234 567 8900" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5" Width="120" IsVisible="{Binding TgNeedCode}">
                        <TextBlock Text="LOGIN CODE" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <Border Height="29" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                          <TextBox Text="{Binding TgCode, Mode=TwoWay}" PlaceholderText="12345" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                        </Border>
                      </StackPanel>
                      <Button Classes="FlatChrome" Grid.Column="3" Command="{Binding TgConnectCommand}" HorizontalAlignment="Left" Height="29" BorderBrush="{Binding TgBtnBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="6" Background="{Binding TgBtnBg, Converter={StaticResource StringToBrush}}" Padding="12,0" Content="{Binding TgBtnLabel}" Foreground="{Binding TgBtnColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Margin="10,0,0,0" />
                      <TextBlock Grid.Column="4" Text="{Binding TgStatus}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding TgStatusColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </Grid>
                    <Button Classes="FlatChrome" Command="{Binding TgToggleInlineCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,12,0,0" BorderBrush="{Binding TgInlineBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="7" Background="{Binding TgInlineBg, Converter={StaticResource StringToBrush}}" Padding="10,8">
                      <Grid ColumnDefinitions="*,12,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="Inline-button signals" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" />
                          <TextBlock Text="Accept executes a market order · Skip discards the signal" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="28" Height="15" CornerRadius="8" Background="{Binding TgInlineTrack, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center">
                          <Canvas><Border Canvas.Left="{Binding TgInlineKnobLeft}" Canvas.Top="2" Width="11" Height="11" CornerRadius="6" Background="{Binding TgInlineKnob, Converter={StaticResource StringToBrush}}" /></Canvas>
                        </Border>
                      </Grid>
                    </Button>
                    <StackPanel IsVisible="{Binding TgHasPending}" Margin="0,10,0,0">
                      <TextBlock Text="PENDING SIGNALS" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,0,0,6" />
                      <ItemsControl ItemsSource="{Binding Pending}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sd:PendingSignalVM">
                            <Border BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource Surface0}" Padding="10,8" Margin="0,0,0,4">
                              <Grid ColumnDefinitions="*,9,Auto,5,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" Foreground="{Binding SideColor, Converter={StaticResource StringToBrush}}" />
                                  <TextBlock Text="{Binding Desc}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                                </StackPanel>
                                <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding AcceptCommand}" Height="24" BorderBrush="{DynamicResource AccentTintStroke}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource AccentTint}" Padding="10,0" Content="✓ ACCEPT" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                                <Button Classes="FlatChrome" Grid.Column="4" Command="{Binding SkipCommand}" Height="24" BorderBrush="{DynamicResource NegativeTintStroke}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource NegativeTint}" Padding="10,0" Content="✕ SKIP" Foreground="{DynamicResource Negative}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <Border IsVisible="{Binding TgNoPending}" Margin="0,10,0,0" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="7" Padding="10">
                      <TextBlock Text="No pending signals." FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ══════════ ALERTS ══════════ -->
              <StackPanel Spacing="7" IsVisible="{Binding IsAlerts}">
                <Border BorderBrush="{DynamicResource AccentTintStroke}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource AccentTint}" Padding="12">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" VerticalAlignment="Center">
                      <Border Width="5" Height="5" CornerRadius="3" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                      <TextBlock Text="DESCRIBE AN ALERT" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding NlStatus}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="#2d6b64" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Border Width="560" Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0">
                        <TextBox Text="{Binding NlPrompt, Mode=TwoWay}" PlaceholderText="ping me when BTC breaks 75k" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
                      </Border>
                      <Button Classes="FlatChrome" Command="{Binding NlGenerateCommand}" Height="30" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="12,0" Content="{Binding NlBtn}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Examples}" Margin="0,8,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:ExampleChip">
                          <Button Classes="FlatChrome" Command="{Binding Command}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource Surface0}" Padding="8,4" Content="{Binding Label}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" Margin="0,0,6,0" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <TextBlock Text="Add alert" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                      <StackPanel Spacing="5" Width="120">
                        <TextBlock Text="SYMBOL" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <Border Height="29" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                          <TextBox Text="{Binding NaSym, Mode=TwoWay}" PlaceholderText="BTCUSDT" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                        </Border>
                      </StackPanel>
                      <StackPanel Spacing="5" Width="176">
                        <TextBlock Text="CONDITION" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding NaCond, Mode=TwoWay}" Height="29" Padding="6,0" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Spacing="5" Width="120">
                        <TextBlock Text="THRESHOLD" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <Border Height="29" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                          <TextBox Text="{Binding NaThr, Mode=TwoWay}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                        </Border>
                      </StackPanel>
                      <StackPanel Spacing="5">
                        <TextBlock Text="SEND TO" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <ItemsControl ItemsSource="{Binding NewChannels}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sd:ChannelChip">
                              <Button Classes="FlatChrome" Command="{Binding Command}" Height="29" BorderBrush="{Binding Border, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="6" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" Padding="10,0" Content="{Binding Label}" Foreground="{Binding Fg, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel Spacing="5">
                        <TextBlock Text="REPEAT" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                        <Button Classes="FlatChrome" Command="{Binding RepeatCommand}" Height="29" BorderBrush="{Binding RepeatBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="6" Background="{Binding RepeatBg, Converter={StaticResource StringToBrush}}" Padding="10,0">
                          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border Width="13" Height="13" BorderBrush="{Binding RepeatBoxBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="3" Background="{Binding RepeatBoxBg, Converter={StaticResource StringToBrush}}">
                              <TextBlock Text="{Binding RepeatMark}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsMicro}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding RepeatLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding RepeatColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                      <StackPanel Spacing="5">
                        <TextBlock Text=" " FontSize="{DynamicResource FsMicro}" />
                        <Button Classes="FlatChrome" Command="{Binding AlAddCommand}" Height="29" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="14,0" Content="+ ADD ALERT" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Classes="FlatChrome" Command="{Binding SoundCommand}" BorderThickness="0" Background="Transparent" Padding="0">
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="13" Height="13" BorderBrush="{Binding SoundBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="3" Background="{Binding SoundBg, Converter={StaticResource StringToBrush}}">
                              <TextBlock Text="{Binding SoundMark}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsMicro}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Sound on alert" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding AlNote}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" ClipToBounds="True">
                  <StackPanel>
                    <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
                      <Grid ColumnDefinitions="Auto,8,Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="ACTIVE ALERTS" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding ActiveMeta}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                        <Button Classes="FlatChrome" Grid.Column="4" Command="{Binding ClearTriggeredCommand}" BorderThickness="0" Background="Transparent" Padding="0" Content="CLEAR TRIGGERED" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Alerts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:AlertRowVM">
                          <Border Background="{Binding Bg, Converter={StaticResource StringToBrush}}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid ColumnDefinitions="7,10,104,*,Auto,10,Auto,10,62,10,Auto,5,Auto">
                              <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4" Background="{Binding Dot, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding Symbol}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3" Text="{Binding Rule}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextNote}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="4" Text="{Binding Distance}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{Binding DistColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                              <ItemsControl Grid.Column="6" ItemsSource="{Binding Channels}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="x:String">
                                    <Border BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource Surface0}" Padding="6,2">
                                      <TextBlock Text="{Binding}" Foreground="{DynamicResource TextSoft}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Grid.Column="8" Text="{Binding Repeat}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <Button Classes="FlatChrome" Grid.Column="10" Command="{Binding ToggleCommand}" Height="22" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource Surface0}" Padding="8,0" Content="{Binding ToggleLabel}" Foreground="{Binding ToggleColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                              <Button Classes="FlatChrome" Grid.Column="12" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete schedule" Width="22" Height="22" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource Surface0}" Padding="0" Content="✕" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock IsVisible="{Binding NoActive}" Text="No alerts yet — describe one above or fill the form." Padding="20" HorizontalAlignment="Center" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextDim}" />
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" ClipToBounds="True">
                  <StackPanel>
                    <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="ALERT HISTORY" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding ClearHistoryCommand}" BorderThickness="0" Background="Transparent" Padding="0" Content="CLEAR" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                      </Grid>
                    </Border>
                    <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto" Padding="12,8">
                      <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sd:HistoryRow">
                            <Grid ColumnDefinitions="Auto,11,78,*" Margin="0,0,0,2">
                              <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextDim}" />
                              <TextBlock Grid.Column="2" Text="{Binding Channel}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding Color, Converter={StaticResource StringToBrush}}" />
                              <TextBlock Grid.Column="3" Text="{Binding Msg}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ══════════ EXECUTION & HOTKEYS ══════════ -->
              <StackPanel Spacing="7" IsVisible="{Binding IsExec}">
                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <TextBlock Text="Execution defaults" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}" LineHeight="16" Foreground="{DynamicResource TextDim}" Margin="0,0,0,12"
                               Text="Applied to every new order unless a bot overrides them. Changes take effect on the next order, not on open ones." />
                    <ItemsControl ItemsSource="{Binding ExecFields}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:SetField">
                          <StackPanel Spacing="5" Margin="6">
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource TextDim}" />
                            <ComboBox IsVisible="{Binding IsSelect}" ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}" Height="29" Padding="6,0" CornerRadius="6" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" HorizontalAlignment="Stretch" />
                            <Border IsVisible="{Binding IsText}" Height="29" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                              <Grid ColumnDefinitions="*,6,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Unit}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                      <ItemsControl ItemsSource="{Binding ExecFlags}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="bd:GuardToggle">
                            <Button Classes="FlatChrome" Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" CornerRadius="6" Background="Transparent" Padding="8,8">
                              <Grid ColumnDefinitions="*,12,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" />
                                  <TextBlock Text="{Binding Hint}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                                </StackPanel>
                                <Border Grid.Column="2" Width="28" Height="15" CornerRadius="8" Background="{Binding TrackBg, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center">
                                  <Canvas><Border Canvas.Left="{Binding KnobLeft}" Canvas.Top="2" Width="11" Height="11" CornerRadius="6" Background="{Binding Knob, Converter={StaticResource StringToBrush}}" /></Canvas>
                                </Border>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Surface1}" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                      <TextBlock Grid.Column="0" Text="Trading hotkeys" FontSize="{DynamicResource FsSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <Button Classes="FlatChrome" Grid.Column="2" Command="{Binding HkResetCommand}" Height="24" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="10,0" Content="RESET DEFAULTS" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}" LineHeight="16" Foreground="{DynamicResource TextDim}" Margin="0,0,0,10"
                               Text="Single-key shortcuts, active only when no input field is focused. Changes apply immediately." />
                    <ItemsControl ItemsSource="{Binding Hotkeys}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sd:HotkeyRowVM">
                          <Border CornerRadius="6" Background="{Binding Bg, Converter={StaticResource StringToBrush}}" Padding="8,6" Margin="0,0,0,2">
                            <Grid ColumnDefinitions="*,10,52,10,112,10,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                              <Border Grid.Column="2" CornerRadius="5" Background="{DynamicResource Surface0}" Padding="0,2">
                                <TextBlock Text="{Binding Display}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" Foreground="{Binding KeyColor, Converter={StaticResource StringToBrush}}" HorizontalAlignment="Center" />
                              </Border>
                              <Border Grid.Column="4" Height="26" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                                <TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                              </Border>
                              <Button Classes="FlatChrome" Grid.Column="6" Command="{Binding CaptureCommand}" Height="26" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0" Content="{Binding CaptureLabel}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DockPanel>

      <!-- ═══ confirm modal ═══ -->
      <Border IsVisible="{Binding ModalConfirm}" Background="#BC02060A" ZIndex="95" x:DataType="sd:SettingsDeskViewModel">
        <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{Binding ConfirmAccent, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource Surface1}" ClipToBounds="True">
          <StackPanel>
            <StackPanel Margin="16,14,16,14">
              <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,10" VerticalAlignment="Center">
                <TextBlock Text="{Binding ConfirmIcon}" FontSize="{DynamicResource FsSubhead}" Foreground="{Binding ConfirmIconColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ConfirmTitle}" FontSize="{DynamicResource FsBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding ConfirmBody}" TextWrapping="Wrap" FontSize="{DynamicResource FsCaption}" LineHeight="18" Foreground="{DynamicResource TextMuted}" />
              <StackPanel IsVisible="{Binding ConfirmHasType}" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
                  <TextBlock Text="type" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                  <TextBlock Text="{Binding ConfirmTypeWord}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource Warning}" />
                  <TextBlock Text="to confirm" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                </StackPanel>
                <Border Height="30" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="8,0">
                  <TextBox Text="{Binding ConfirmTyped, Mode=TwoWay}" PlaceholderText="{Binding ConfirmTypeWord}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
                </Border>
              </StackPanel>
            </StackPanel>
            <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,1,0,0" Padding="16,12">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="FlatChrome" Command="{Binding CloseModalCommand}" Height="28" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface0}" Padding="12,0" Content="CANCEL" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                <Button Classes="FlatChrome" Command="{Binding ConfirmRunCommand}" Height="28" BorderBrush="{Binding ConfirmBtnBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="6" Background="{Binding ConfirmBtnBg, Converter={StaticResource StringToBrush}}" Padding="14,0" Content="{Binding ConfirmCta}" Foreground="{Binding ConfirmBtnFg, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Opacity="{Binding ConfirmBtnOpacity}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Border>

      <!-- ═══ toast ═══ -->
      <Border x:DataType="sd:SettingsDeskViewModel" IsVisible="{Binding HasToast}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" ZIndex="99"
              BorderBrush="{Binding ToastBorder, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Surface1}" Padding="14,8">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding ToastIcon}" Foreground="{Binding ToastColor, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ToastMsg}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ToastMeta}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

    </Grid>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:ctrl="clr-namespace:CryptoAITerminal.TerminalUI.Controls"
             x:Class="CryptoAITerminal.TerminalUI.Views.SniperView"
             x:DataType="vm:SniperScreenViewModel"
             x:CompileBindings="True">

  <UserControl.Styles>
    <!-- Section overline -->
    <Style Selector="TextBlock.secLabel">
      <Setter Property="FontSize" Value="{DynamicResource FsMicro}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <!-- Stat strip label / value -->
    <Style Selector="TextBlock.stripLabel">
      <Setter Property="FontSize" Value="{DynamicResource FsMicro}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.stripValue">
      <Setter Property="FontFamily" Value="Consolas, 'SF Mono', monospace" />
      <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <!-- Wrap instead of trimming: each chip is MaxWidth-constrained, so ellipsis was hiding
           the tail of real values ("Balanced preset | B…", "BSC, Ethereum, Base, …"). Wrapping
           keeps the same width and shows the whole value on a second line. -->
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Terminal card -->
    <Style Selector="Border.tcard">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <!-- Centre tab buttons -->
    <Style Selector="Button.sniperTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="{DynamicResource FsCaption}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.sniperTab.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <!-- Timeframe buttons -->
    <Style Selector="Button.tf">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="{DynamicResource FsMicro}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.tf.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <!-- Compact numeric / textbox in the control rail -->
    <Style Selector="NumericUpDown.rail">
      <Setter Property="FontSize" Value="{DynamicResource FsCaption}" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style Selector="TextBlock.fieldName">
      <Setter Property="FontSize" Value="{DynamicResource FsCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- Header row is Auto (was a hard 52px): once the strip values wrap instead of being
       ellipsed, a fixed height clipped the last line of long values like SAFETY. -->
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource Surface0}">

    <!-- ═══════════════ TOP STATS STRIP ═══════════════ -->
    <Border Grid.Row="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1"
            MinHeight="52">
      <Grid ColumnDefinitions="*,Auto" Margin="16,6">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="26" VerticalAlignment="Center">
          <StackPanel Spacing="1">
            <TextBlock Classes="stripLabel" Text="MODE" />
            <TextBlock Classes="stripValue" Text="{Binding SniperVM.ExecutionModeLabel}" MaxWidth="120" />
          </StackPanel>
          <StackPanel Spacing="1">
            <TextBlock Classes="stripLabel" Text="PRESET" />
            <TextBlock Classes="stripValue" Text="{Binding SniperVM.PresetSummary}" MaxWidth="150" />
          </StackPanel>
          <StackPanel Spacing="1">
            <TextBlock Classes="stripLabel" Text="EXECUTION" />
            <TextBlock Classes="stripValue" Foreground="{DynamicResource Positive}" Text="{Binding SniperVM.AutoModeLabel}" MaxWidth="120" />
          </StackPanel>
          <StackPanel Spacing="1">
            <TextBlock Classes="stripLabel" Text="CHAINS" />
            <TextBlock Classes="stripValue" Foreground="{DynamicResource TextSecondary}" Text="{Binding SniperVM.EnabledChainsSummary}" MaxWidth="160" />
          </StackPanel>
          <StackPanel Spacing="1">
            <TextBlock Classes="stripLabel" Text="LAST SCAN" />
            <TextBlock Classes="stripValue" Foreground="{DynamicResource TextSecondary}" Text="{Binding SniperVM.LastScanLocal, StringFormat={}{0:HH:mm:ss}}" />
          </StackPanel>
          <StackPanel Spacing="1">
            <TextBlock Classes="stripLabel" Text="COOLDOWN" />
            <TextBlock Classes="stripValue" Foreground="{DynamicResource Positive}" Text="{Binding SniperVM.CooldownStatus}" MaxWidth="140" />
          </StackPanel>
          <StackPanel Spacing="1">
            <TextBlock Classes="stripLabel" Text="SAFETY" />
            <TextBlock Classes="stripValue" Foreground="{DynamicResource Positive}" Text="{Binding SniperVM.SafetySummary}" MaxWidth="150" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Command="{Binding SniperVM.ToggleArmCommand}"
                  Background="{DynamicResource Surface1}"
                  BorderBrush="{Binding SniperVM.ArmBorderHex, Converter={StaticResource StringToBrush}}"
                  BorderThickness="1"
                  CornerRadius="999"
                  Padding="14,6">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="{Binding SniperVM.ArmDotHex, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SniperVM.ArmStatusLabel}"
                         FontSize="{DynamicResource FsMicro}" FontWeight="Bold"
                         Foreground="{Binding SniperVM.ArmDotHex, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Background="{DynamicResource AccentTint}" CornerRadius="999" Padding="12,6">
            <TextBlock Text="AI ON" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══════════════ 3-COLUMN BODY ═══════════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*,380">

      <!-- ─────────── LEFT: SNIPER CONTROLS ─────────── -->
      <Border Grid.Column="0" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14" Spacing="14">

            <!-- Header -->
            <StackPanel Spacing="3">
              <TextBlock Text="Sniper" FontSize="{DynamicResource FsTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
              <TextBlock FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextDim}">
                <Run Text="{Binding SniperVM.OpenPositionCount}" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <Run Text=" open · " />
                <Run Text="{Binding SniperVM.AcceptedPairs.Count}" Foreground="{DynamicResource Warning}" FontWeight="Bold" />
                <Run Text=" queued" />
              </TextBlock>
            </StackPanel>

            <!-- Scanner mode -->
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="SCANNER MODE" />
              <ComboBox HorizontalAlignment="Stretch" FontSize="{DynamicResource FsSmall}"
                        ItemsSource="{Binding SniperVM.SniperVenueOptions}"
                        SelectedItem="{Binding SniperVM.SelectedScanVenue}" />
              <ComboBox HorizontalAlignment="Stretch" FontSize="{DynamicResource FsSmall}"
                        ItemsSource="{Binding SniperVM.TradingProfileOptions}"
                        SelectedItem="{Binding SniperVM.SelectedTradingProfile}" />
              <StackPanel Spacing="6" IsVisible="{Binding SniperVM.IsScalpProfile}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                  <Button Grid.Column="0" Classes="tf" Content="TIGHT" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding SniperVM.ApplyScalpPresetCommand}" CommandParameter="Tight" />
                  <Button Grid.Column="1" Classes="tf active" Content="STANDARD" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding SniperVM.ApplyScalpPresetCommand}" CommandParameter="Standard" />
                  <Button Grid.Column="2" Classes="tf" Content="AGGRO" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding SniperVM.ApplyScalpPresetCommand}" CommandParameter="Aggro" />
                </Grid>
                <TextBlock Text="{Binding SniperVM.ScalpPresetSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Text="{Binding SniperVM.VenueSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SniperVM.TradingProfileSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
              <Expander Header="Advanced — futures" IsVisible="{Binding SniperVM.IsFuturesVenue}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,6,0,0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldName" Text="Leverage" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.FuturesLeverage}" Increment="1" Minimum="1" Maximum="50" FormatString="0" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldName" Text="Bias" />
                  <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" FontSize="{DynamicResource FsCaption}"
                            ItemsSource="{Binding SniperVM.FuturesBiasOptions}" SelectedItem="{Binding SniperVM.SelectedFuturesBias}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SniperVM.FuturesExecutionSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
                </Grid>
              </Expander>
            </StackPanel>

            <!-- Preset studio -->
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="PRESET STUDIO" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Classes="tf" Content="SAFE" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SniperVM.ApplySafePresetCommand}" />
                <Button Grid.Column="1" Classes="tf active" Content="BALANCED" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SniperVM.ApplyBalancedPresetCommand}" />
                <Button Grid.Column="2" Classes="tf" Content="AGGRO" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SniperVM.ApplyAggressivePresetCommand}" />
              </Grid>
              <TextBlock Text="{Binding SniperVM.PresetSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Execution mode -->
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="secLabel" Text="EXECUTION MODE" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{Binding SniperVM.PaperPillHex, Converter={StaticResource StringToBrush}}" CornerRadius="999" Padding="10,2">
                  <TextBlock Text="{Binding SniperVM.PaperPillLabel}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                </Border>
              </Grid>
              <CheckBox FontSize="{DynamicResource FsCaption}" Content="Enable full auto-buy on accepted pairs" IsChecked="{Binding SniperVM.AutoBuyEnabled}" />
              <CheckBox FontSize="{DynamicResource FsCaption}" Content="Use paper sniper instead of real execution" IsChecked="{Binding SniperVM.PaperTradingEnabled}" />
              <CheckBox FontSize="{DynamicResource FsCaption}" Content="Auto-sell with take-profit" IsChecked="{Binding SniperVM.AutoTakeProfitEnabled}" />
              <CheckBox FontSize="{DynamicResource FsCaption}" Content="Cut position with stop-loss" IsChecked="{Binding SniperVM.AutoStopLossEnabled}" />
              <CheckBox FontSize="{DynamicResource FsCaption}" Content="Protect profit with trailing stop" IsChecked="{Binding SniperVM.AutoTrailingStopEnabled}" />
              <CheckBox FontSize="{DynamicResource FsCaption}" Content="Require native/wrapped-native quote" IsChecked="{Binding SniperVM.RequireBnbQuote}" IsVisible="{Binding SniperVM.IsDexVenue}" />
              <CheckBox FontSize="{DynamicResource FsCaption}" Content="Enable execution guard before buy" IsChecked="{Binding SniperVM.EnableExecutionGuard}" />
              <CheckBox FontSize="{DynamicResource FsCaption}" Content="Block suspected honeypots" IsChecked="{Binding SniperVM.BlockSuspectedHoneypots}" IsVisible="{Binding SniperVM.IsDexVenue}" />
              <CheckBox FontSize="{DynamicResource FsCaption}" Content="Deep security scan (GoPlus + RugCheck)" IsChecked="{Binding SniperVM.EnableExternalSecurityScan}" IsVisible="{Binding SniperVM.IsDexVenue}" />
              <Expander Header="Advanced — quote routing" IsVisible="{Binding SniperVM.IsDexVenue}">
                <StackPanel Spacing="8" Margin="0,6,0,0">
                  <CheckBox FontSize="{DynamicResource FsCaption}" Content="Stable-first quote routing" IsChecked="{Binding SniperVM.PreferStableQuote}" />
                  <TextBlock Text="{Binding SniperVM.StableQuoteSpendableLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SniperVM.StableQuoteAvailabilityMessage}" Foreground="{Binding SniperVM.StableQuoteAvailabilityBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SniperVM.QuoteRoutingSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SniperVM.SupportedQuoteRoutesSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
            </StackPanel>

            <!-- Chain compatibility -->
            <StackPanel Spacing="8" IsVisible="{Binding SniperVM.IsDexVenue}">
              <TextBlock Classes="secLabel" Text="CHAIN COMPATIBILITY" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Classes="tf" Content="ALL CHAINS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SniperVM.ApplyAllChainsCommand}" />
                <Button Grid.Column="1" Classes="tf" Content="EVM ONLY" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SniperVM.ApplyEvmChainsCommand}" />
              </Grid>
              <TextBlock Text="{Binding SniperVM.ChainCoverageSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SniperVM.TokenFilterSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Buy amount -->
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="{Binding SniperVM.BuyAmountLabel}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <NumericUpDown Grid.Column="0" Classes="rail" HorizontalAlignment="Stretch"
                               Value="{Binding SniperVM.BuyAmountBnb}" Increment="0.001" Minimum="0" FormatString="0.0000" />
                <Button Grid.Column="1" Classes="tf" Content="MAX" Command="{Binding SniperVM.UseMaxBuyAmountCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Classes="tf" Content="25%" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ApplyBuyBalancePresetCommand}" CommandParameter="25" />
                <Button Grid.Column="1" Classes="tf" Content="50%" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ApplyBuyBalancePresetCommand}" CommandParameter="50" />
                <Button Grid.Column="2" Classes="tf" Content="75%" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ApplyBuyBalancePresetCommand}" CommandParameter="75" />
                <Button Grid.Column="3" Classes="tf" Content="100%" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ApplyBuyBalancePresetCommand}" CommandParameter="100" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="fieldName" Text="Slippage" />
                <NumericUpDown Grid.Column="2" Classes="rail" Value="{Binding SniperVM.SlippagePercent}" Increment="0.5" Minimum="0.1" Maximum="50" FormatString="0.#" />
              </Grid>
            </StackPanel>

            <!-- Token filters -->
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="TOKEN FILTERS" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldName" Text="Min Liquidity" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MinLiquidityUsd}" Increment="1000" Minimum="0" FormatString="0" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldName" Text="Max Liquidity" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxLiquidityUsd}" Increment="5000" Minimum="0" FormatString="0" />
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldName" Text="Min Volume 24h" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MinVolume24hUsd}" Increment="10000" Minimum="0" FormatString="0" />
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldName" Text="Min 5m %" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MinMomentum5m}" Increment="1" Minimum="-100" FormatString="0.##" />
                <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldName" Text="Max MCap" />
                <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxMarketCapUsd}" Increment="100000" Minimum="0" FormatString="0" />
                <TextBlock Grid.Row="5" Grid.Column="0" Classes="fieldName" Text="Max Vol/Liq" />
                <NumericUpDown Grid.Row="5" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxVolumeToLiquidityRatio}" Increment="1" Minimum="0" FormatString="0.##" />
              </Grid>
              <Expander Header="Advanced — strategy &amp; taxes">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,6,0,0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldName" Text="Strategy Mode" />
                  <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" FontSize="{DynamicResource FsCaption}"
                            ItemsSource="{Binding SniperVM.StrategyModeOptions}" SelectedItem="{Binding SniperVM.SelectedStrategyMode}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldName" Text="Max MCap/Liq" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.MaxMarketCapToLiquidityRatio}" Increment="1" Minimum="0" FormatString="0.##" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldName" Text="Max Buy Tax %" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.MaxSimulatedBuyTaxPercent}" Increment="1" Minimum="0" FormatString="0.##" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldName" Text="Max Sell Tax %" />
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.MaxSimulatedSellTaxPercent}" Increment="1" Minimum="0" FormatString="0.##" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldName" Text="Min Pair Age (min)" />
                  <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.MinPairAgeMinutes}" Increment="1" Minimum="0" FormatString="0.#" />
                  <TextBlock Grid.Row="5" Grid.Column="0" Classes="fieldName" Text="Max Pair Age (min)" />
                  <NumericUpDown Grid.Row="5" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.MaxPairAgeMinutes}" Increment="5" Minimum="0" FormatString="0.#" />
                  <TextBlock Grid.Row="6" Grid.Column="0" Classes="fieldName" Text="Launch Max Age (min)" />
                  <NumericUpDown Grid.Row="6" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.LaunchMaxPairAgeMinutes}" Increment="1" Minimum="1" FormatString="0.#" />
                  <TextBlock Grid.Row="7" Grid.Column="0" Classes="fieldName" Text="Warm Pair Age (min)" />
                  <NumericUpDown Grid.Row="7" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.WarmPairMinAgeMinutes}" Increment="1" Minimum="0" FormatString="0.#" />
                </Grid>
              </Expander>
            </StackPanel>

            <!-- Safety limits -->
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="SAFETY LIMITS" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldName" Text="Cooldown (sec)" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.CooldownSeconds}" Increment="15" Minimum="0" FormatString="0" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldName" Text="Max Open Positions" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxSimultaneousPositions}" Increment="1" Minimum="1" FormatString="0" />
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldName" Text="Max Buys / Session" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxBuysPerSession}" Increment="1" Minimum="1" FormatString="0" />
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldName" Text="Max Risk Score" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxRiskScore}" Increment="5" Minimum="0" FormatString="0" />
                <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldName" Text="Take Profit %" />
                <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.TakeProfitPercent}" Increment="5" Minimum="1" FormatString="0.##" />
                <TextBlock Grid.Row="5" Grid.Column="0" Classes="fieldName" Text="Stop Loss %" />
                <NumericUpDown Grid.Row="5" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.StopLossPercent}" Increment="2" Minimum="1" FormatString="0.##" />
                <TextBlock Grid.Row="6" Grid.Column="0" Classes="fieldName" Text="Trailing Stop %" />
                <NumericUpDown Grid.Row="6" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.TrailingStopPercent}" Increment="2" Minimum="1" FormatString="0.##" />
                <TextBlock Grid.Row="7" Grid.Column="0" Classes="fieldName" Text="Break-even Arm %" />
                <NumericUpDown Grid.Row="7" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.BreakEvenTriggerPercent}" Increment="2" Minimum="1" FormatString="0.##" />
              </Grid>
              <Expander Header="Advanced — runners &amp; break-even">
                <StackPanel Spacing="8" Margin="0,6,0,0">
                  <CheckBox FontSize="{DynamicResource FsCaption}" Content="Enable partial take-profit runner" IsChecked="{Binding SniperVM.PartialTakeProfitEnabled}" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldName" Text="Partial TP Trigger %" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.PartialTakeProfitTriggerPercent}" Increment="2" Minimum="1" FormatString="0.##" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldName" Text="Partial TP Sell %" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="rail" Value="{Binding SniperVM.PartialTakeProfitSellPercent}" Increment="5" Minimum="1" Maximum="99" FormatString="0.##" />
                  </Grid>
                  <CheckBox FontSize="{DynamicResource FsCaption}" Content="Arm break-even after a green move" IsChecked="{Binding SniperVM.BreakEvenEnabled}" />
                  <TextBlock Text="{Binding SniperVM.ExitEngineSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
            </StackPanel>

            <!-- Live risk caps -->
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="LIVE RISK CAPS" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldName" Text="Max Daily Live Loss" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxDailyLiveLossNative}" Increment="0.001" Minimum="0" FormatString="0.0000" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldName" Text="Max Chain Exposure" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxExposurePerChainNative}" Increment="0.001" Minimum="0" FormatString="0.0000" />
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldName" Text="Max Wallet Exposure" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxExposurePerWalletNative}" Increment="0.001" Minimum="0" FormatString="0.0000" />
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldName" Text="Hard Cap Exposure" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.HardCapTotalLiveExposureNative}" Increment="0.001" Minimum="0" FormatString="0.0000" />
                <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldName" Text="Max Losing Trades" />
                <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.MaxConsecutiveLiveLosses}" Increment="1" Minimum="0" FormatString="0" />
              </Grid>
              <Expander Header="Advanced — dry-run cap">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,6,0,0">
                  <TextBlock Grid.Column="0" Classes="fieldName" Text="Tiny Dry-Run Cap" />
                  <NumericUpDown Grid.Column="1" Classes="rail" Value="{Binding SniperVM.TinyDryRunCapNative}" Increment="0.001" Minimum="0" FormatString="0.0000" />
                </Grid>
              </Expander>
              <TextBlock Text="{Binding SniperVM.LiveRiskSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Word lists -->
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="ENABLED CHAINS" />
              <TextBox FontSize="{DynamicResource FsCaption}" Text="{Binding SniperVM.EnabledChainsText}" PlaceholderText="bsc,ethereum,base,solana" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="WHITELIST FRAGMENTS" />
              <TextBox FontSize="{DynamicResource FsCaption}" Text="{Binding SniperVM.WhitelistText}" PlaceholderText="bnbx,pepe,ai" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="WATCHLIST PRIORITY" />
              <TextBox FontSize="{DynamicResource FsCaption}" Text="{Binding SniperVM.WatchlistText}" PlaceholderText="pepe,ai,cat — priority, not a hard block" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="secLabel" Text="BLACKLIST FRAGMENTS" />
              <TextBox FontSize="{DynamicResource FsCaption}" Text="{Binding SniperVM.BlacklistText}" PlaceholderText="inu,elon,test,wrapped" />
            </StackPanel>

            <!-- Manual snipe -->
            <Border Classes="tcard" Padding="12" IsVisible="{Binding SniperVM.IsDexVenue}">
              <StackPanel Spacing="8">
                <TextBlock Classes="secLabel" Text="MANUAL SNIPE — CONTRACT ADDRESS" />
                <TextBox FontSize="{DynamicResource FsCaption}" Text="{Binding SniperVM.ManualSnipeAddress, Mode=TwoWay}" PlaceholderText="0x… or Solana address" />
                <TextBlock Text="{Binding SniperVM.ManualSnipeInfoLabel}" Foreground="{Binding SniperVM.ManualSnipeInfoBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap"
                           IsVisible="{Binding SniperVM.ManualSnipeInfoLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding SniperVM.ManualSnipeQuoteLabel}" Foreground="{Binding SniperVM.ManualSnipeQuoteBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold"
                           IsVisible="{Binding SniperVM.ManualSnipeQuoteLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="Sell amount" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" />
                <NumericUpDown Classes="rail" HorizontalAlignment="Stretch" Value="{Binding SniperVM.ManualSnipeSellAmount}" Increment="1000" Minimum="0" FormatString="0.########" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
                  <Button Grid.Column="0" Classes="tf" Content="25%" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ApplyManualSnipeSellPresetCommand}" CommandParameter="25" />
                  <Button Grid.Column="1" Classes="tf" Content="50%" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ApplyManualSnipeSellPresetCommand}" CommandParameter="50" />
                  <Button Grid.Column="2" Classes="tf" Content="75%" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ApplyManualSnipeSellPresetCommand}" CommandParameter="75" />
                  <Button Grid.Column="3" Classes="tf" Content="100%" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ApplyManualSnipeSellPresetCommand}" CommandParameter="100" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                  <Button Grid.Column="0" Content="BUY" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" CornerRadius="6"
                          Command="{Binding SniperVM.ManualSnipeBuyCommand}" />
                  <Button Grid.Column="1" Classes="tf" Content="SELL" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ManualSnipeSellCommand}" />
                  <Button Grid.Column="2" Classes="tf" Content="PROBE" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SniperVM.ManualSnipeProbeCommand}" />
                </Grid>
                <TextBlock Text="{Binding SniperVM.ManualSnipeStatusMessage}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                           IsVisible="{Binding SniperVM.ManualSnipeStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <!-- Guard status -->
            <Border Background="{DynamicResource PositiveTint}" BorderBrush="{Binding SniperVM.SniperGuardStatusBrush, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="10" Padding="12,10">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SniperVM.SniperGuardStatusLabel}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding SniperVM.SniperGuardStatusBrush, Converter={StaticResource StringToBrush}}" />
                <TextBlock Text="{Binding SniperVM.SniperGuardSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SniperVM.SniperGuardDetail}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Action row -->
            <StackPanel Spacing="6">
              <Button Content="{Binding SniperVM.ArmToggleLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Background="{Binding SniperVM.ArmFillHex, Converter={StaticResource StringToBrush}}" Foreground="{Binding SniperVM.ArmTextHex, Converter={StaticResource StringToBrush}}"
                      BorderBrush="{Binding SniperVM.ArmBorderHex, Converter={StaticResource StringToBrush}}" BorderThickness="1" CornerRadius="8"
                      FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Padding="0,10"
                      Command="{Binding SniperVM.ToggleArmCommand}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Classes="tf" Content="SCAN NOW" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8" Command="{Binding SniperVM.ScanNowCommand}" />
                <Button Grid.Column="1" Classes="tf" Content="STOP" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8" Command="{Binding SniperVM.StopCommand}" />
              </Grid>
              <Button Content="RESET SAFETY" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Background="Transparent" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Foreground="{DynamicResource TextSoft}"
                      CornerRadius="8" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Padding="0,8"
                      Command="{Binding SniperVM.ResetSafetyCommand}" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ─────────── CENTER: TABS + CONTENT ─────────── -->
      <Grid Grid.Column="1" RowDefinitions="48,*" Background="{DynamicResource Surface0}">

        <!-- Tab bar -->
        <Border Grid.Row="0" Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto" Margin="14,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Classes="sniperTab" Classes.active="{Binding SniperVM.IsTrendingTab}" Command="{Binding SniperVM.SelectSniperTabCommand}" CommandParameter="trending">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="DEX Trending" VerticalAlignment="Center" />
                  <Border Background="#1A2C3A" CornerRadius="999" Padding="6,1"><TextBlock Text="{Binding DexTrendingVM.TotalCount}" FontSize="{DynamicResource FsMicro}" /></Border>
                </StackPanel>
              </Button>
              <Button Classes="sniperTab" Classes.active="{Binding SniperVM.IsFreshTab}" Command="{Binding SniperVM.SelectSniperTabCommand}" CommandParameter="fresh">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Fresh Pairs" VerticalAlignment="Center" />
                  <Border Background="#1A2C3A" CornerRadius="999" Padding="6,1"><TextBlock Text="{Binding SniperVM.FreshPairs.Count}" FontSize="{DynamicResource FsMicro}" /></Border>
                </StackPanel>
              </Button>
              <Button Classes="sniperTab" Classes.active="{Binding SniperVM.IsAcceptedTab}" Command="{Binding SniperVM.SelectSniperTabCommand}" CommandParameter="accepted">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Accepted Queue" VerticalAlignment="Center" />
                  <Border Background="#1A2C3A" CornerRadius="999" Padding="6,1"><TextBlock Text="{Binding SniperVM.AcceptedPairs.Count}" FontSize="{DynamicResource FsMicro}" /></Border>
                </StackPanel>
              </Button>
              <Button Classes="sniperTab" Classes.active="{Binding SniperVM.IsPositionsTab}" Command="{Binding SniperVM.SelectSniperTabCommand}" CommandParameter="positions">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Open Positions" VerticalAlignment="Center" />
                  <Border Background="#1A2C3A" CornerRadius="999" Padding="6,1"><TextBlock Text="{Binding SniperVM.OpenPositions.Count}" FontSize="{DynamicResource FsMicro}" /></Border>
                </StackPanel>
              </Button>
              <Button Classes="sniperTab" Classes.active="{Binding SniperVM.IsPaperTab}" Command="{Binding SniperVM.SelectSniperTabCommand}" CommandParameter="paper">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Paper Positions" VerticalAlignment="Center" />
                  <Border Background="#1A2C3A" CornerRadius="999" Padding="6,1"><TextBlock Text="{Binding SniperVM.PaperPositions.Count}" FontSize="{DynamicResource FsMicro}" /></Border>
                </StackPanel>
              </Button>
              <Button Classes="sniperTab" Classes.active="{Binding SniperVM.IsAnalyticsTab}" Content="Analytics" Command="{Binding SniperVM.SelectSniperTabCommand}" CommandParameter="analytics" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding SniperVM.IsTrendingTab}">
              <Button Classes="tf" Classes.active="{Binding DexTrendingVM.IsTf5m}"  Content="5m"  Command="{Binding DexTrendingVM.SetTimeframeCommand}" CommandParameter="5m" />
              <Button Classes="tf" Classes.active="{Binding DexTrendingVM.IsTf15m}" Content="15m" Command="{Binding DexTrendingVM.SetTimeframeCommand}" CommandParameter="15m" />
              <Button Classes="tf" Classes.active="{Binding DexTrendingVM.IsTf1h}"  Content="1h"  Command="{Binding DexTrendingVM.SetTimeframeCommand}" CommandParameter="1h" />
              <Button Classes="tf" Classes.active="{Binding DexTrendingVM.IsTf6h}"  Content="6h"  Command="{Binding DexTrendingVM.SetTimeframeCommand}" CommandParameter="6h" />
              <Button Classes="tf" Classes.active="{Binding DexTrendingVM.IsTf24h}" Content="24h" Command="{Binding DexTrendingVM.SetTimeframeCommand}" CommandParameter="24h" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ── DEX Trending tab ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding SniperVM.IsTrendingTab}">
          <StackPanel Margin="14" Spacing="12">
            <!-- filter row -->
            <WrapPanel Orientation="Horizontal">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6" VerticalAlignment="Center">
                <TextBlock Text="Min Liq $" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                <NumericUpDown Width="130" FontSize="{DynamicResource FsCaption}" Value="{Binding DexTrendingVM.MinLiquidityUsd}" Minimum="0" Maximum="10000000" Increment="5000" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6" VerticalAlignment="Center">
                <TextBlock Text="Age ≤" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                <NumericUpDown Width="110" FontSize="{DynamicResource FsCaption}" Value="{Binding DexTrendingVM.MaxPoolAgeHours}" Minimum="1" Maximum="8760" Increment="24" />
                <TextBlock Text="h" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6" VerticalAlignment="Center">
                <TextBlock Text="Score ≥" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                <NumericUpDown Width="100" FontSize="{DynamicResource FsCaption}" Value="{Binding DexTrendingVM.MinSecurityScore}" Minimum="0" Maximum="100" Increment="10" />
              </StackPanel>
              <TextBox Width="130" FontSize="{DynamicResource FsCaption}" Margin="0,0,14,6" Text="{Binding DexTrendingVM.SearchQuery}" PlaceholderText="symbol / name…" />
              <Button Classes="tf" Content="⟳ Refresh" Margin="0,0,14,6" Command="{Binding DexTrendingVM.RefreshCommand}" />
              <TextBlock Text="{Binding DexTrendingVM.StatusLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>

            <!-- AI picks -->
            <Border Background="{DynamicResource Surface3}" CornerRadius="10" Padding="12,10">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="AI Trending Picks — momentum vs rug risk" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding DexTrendingVM.AiSource}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <Button Grid.Column="2" Classes="tf active" Content="Rank with AI" Command="{Binding DexTrendingVM.RankWithAiCommand}" IsEnabled="{Binding !DexTrendingVM.AiRunning}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding DexTrendingVM.AiPicks}" IsVisible="{Binding DexTrendingVM.HasAiPicks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AiPickVM">
                      <Border Background="{DynamicResource Surface1}" CornerRadius="8" Padding="8,6" Margin="0,0,8,8" Width="250">
                        <!-- Вердикт красится смыслом, а не всегда янтарным: раньше AVOID и
                             MOMENTUM выглядели одинаково, а по этому списку решают, что покупать. -->
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                          <Border CornerRadius="6" Padding="8,4" VerticalAlignment="Center" BorderThickness="1"
                                  Background="{Binding BiasTint, Converter={StaticResource StringToBrush}}"
                                  BorderBrush="{Binding BiasStroke, Converter={StaticResource StringToBrush}}">
                            <TextBlock Text="{Binding ScoreLabel}" FontWeight="Bold" FontSize="{DynamicResource FsBody}"
                                       Foreground="{Binding ScoreBrush, Converter={StaticResource StringToBrush}}" />
                          </Border>
                          <StackPanel Spacing="2" VerticalAlignment="Center" MinWidth="60">
                            <TextBlock Text="{Binding Symbol}" FontWeight="Bold" FontSize="{DynamicResource FsSmall}" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding Bias}" FontSize="{DynamicResource FsMicro}" FontWeight="ExtraBold"
                                       Foreground="{Binding BiasBrush, Converter={StaticResource StringToBrush}}" />
                            <Border Width="60" Height="3" CornerRadius="2" Background="{DynamicResource Surface0}" HorizontalAlignment="Left">
                              <Border Width="{Binding ScoreBarWidth}" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                                      Background="{Binding ScoreBrush, Converter={StaticResource StringToBrush}}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Reason}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="130" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- table -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel MinWidth="860" Spacing="4">
                <Grid ColumnDefinitions="26,90,96,66,96,78,78,78,48,86,96" Margin="8,0">
                  <TextBlock Grid.Column="1" Text="TOKEN"  Classes="secLabel" />
                  <TextBlock Grid.Column="2" Text="PRICE"  Classes="secLabel" />
                  <TextBlock Grid.Column="3" Text="CHANGE" Classes="secLabel" />
                  <TextBlock Grid.Column="4" Text="TREND"  Classes="secLabel" />
                  <TextBlock Grid.Column="5" Text="VOLUME" Classes="secLabel" />
                  <TextBlock Grid.Column="6" Text="LIQ"    Classes="secLabel" />
                  <TextBlock Grid.Column="7" Text="MCAP"   Classes="secLabel" />
                  <TextBlock Grid.Column="8" Text="AGE"    Classes="secLabel" />
                  <TextBlock Grid.Column="10" Text="SCORE" Classes="secLabel" />
                </Grid>
                <TextBlock Text="Loading trending tokens…" IsVisible="{Binding DexTrendingVM.IsLoading}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsSmall}" HorizontalAlignment="Center" Margin="0,8" />
                <ItemsControl ItemsSource="{Binding DexTrendingVM.FilteredTokens}" IsVisible="{Binding !DexTrendingVM.IsLoading}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DexTokenRowViewModel">
                      <Border Background="{DynamicResource Surface1}" CornerRadius="8" Padding="8,8" Margin="0,0,0,1">
                        <Grid ColumnDefinitions="26,90,96,66,96,78,78,78,48,86,96" VerticalAlignment="Center">
                          <TextBlock Grid.Column="0" Text="{Binding ChainIcon}" FontSize="{DynamicResource FsBody}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Symbol}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                            <TextBlock Text="{Binding DexId}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding PriceLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                          <Border Grid.Column="3" Background="{DynamicResource Surface2}" CornerRadius="5" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding PriceChangeLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{Binding PriceChangeBrush}" />
                          </Border>
                          <Border Grid.Column="4" Width="90" Height="20" VerticalAlignment="Center" ClipToBounds="True">
                            <Polyline Points="{Binding SparkPoints}" Stroke="{Binding PriceChangeBrush}" StrokeThickness="1.4" />
                          </Border>
                          <TextBlock Grid.Column="5" Text="{Binding VolumeLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="6" Text="{Binding LiquidityLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="7" Text="{Binding MarketCapLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="8" Text="{Binding AgeLabel}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center" />
                          <Button Grid.Column="9" Content="▶ Snipe" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                  Background="#0A1E1C" BorderBrush="#1A3A3A" BorderThickness="1" CornerRadius="6" Padding="8,4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Command="{Binding $parent[ItemsControl].((vm:SniperScreenViewModel)DataContext).DexTrendingVM.OpenInSniperCommand}" CommandParameter="{Binding}" />
                          <Grid Grid.Column="10" ColumnDefinitions="44,*" VerticalAlignment="Center">
                            <Border Grid.Column="0" Height="5" CornerRadius="3" Background="{DynamicResource PanelStroke}" ClipToBounds="True" VerticalAlignment="Center">
                              <Border HorizontalAlignment="Left" CornerRadius="3" Background="{Binding ScoreColorHex, Converter={StaticResource StringToBrush}}" Width="{Binding ScoreBarWidth}" />
                            </Border>
                            <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding SecurityScore}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding ScoreColorHex, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </ScrollViewer>

        <!-- ── Candidate tabs (fresh / accepted / positions / paper) ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding SniperVM.IsCandidateTab}">
          <ItemsControl ItemsSource="{Binding SniperVM.CurrentCandidates}" Margin="14">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SniperCandidateViewModel">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,10"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding $parent[ItemsControl].((vm:SniperScreenViewModel)DataContext).SniperVM.SelectSniperCandidateCommand}" CommandParameter="{Binding}">
                  <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="10" Padding="12,12">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding PaperPnlLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Foreground="{Binding PnlAccentHex, Converter={StaticResource StringToBrush}}" />
                      </Grid>
                      <TextBlock Text="{Binding PairLabel}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextDim}" />
                      <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RiskBadgeText}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{Binding RiskAccentHex, Converter={StaticResource StringToBrush}}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Reason}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="520" />
                      </WrapPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SecurityScanComplete}">
                        <Border Background="{Binding SecurityVerdictColor, Converter={StaticResource StringToBrush}}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SecurityVerdict}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <TextBlock Text="{Binding SecurityChecksSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="BUY NOW" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" CornerRadius="6" Padding="16,6"
                                IsVisible="{Binding !$parent[ItemsControl].((vm:SniperScreenViewModel)DataContext).SniperVM.IsPositionsTab}"
                                Command="{Binding $parent[ItemsControl].((vm:SniperScreenViewModel)DataContext).SniperVM.BuyCandidateCommand}" CommandParameter="{Binding}" />
                        <Button Content="EMERGENCY CLOSE" Background="{DynamicResource Negative}" Foreground="{DynamicResource OnAccentText}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" CornerRadius="6" Padding="16,6"
                                IsVisible="{Binding $parent[ItemsControl].((vm:SniperScreenViewModel)DataContext).SniperVM.IsPositionsTab}"
                                Command="{Binding $parent[ItemsControl].((vm:SniperScreenViewModel)DataContext).SniperVM.EmergencyClosePositionCommand}" CommandParameter="{Binding}" />
                        <Button Content="CLEAR" Classes="tf" Padding="16,6"
                                Command="{Binding $parent[ItemsControl].((vm:SniperScreenViewModel)DataContext).SniperVM.ClearPositionCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- ── Analytics tab ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding SniperVM.IsAnalyticsTab}">
          <StackPanel Margin="14" Spacing="14">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="COMBINED WIN RATE" Classes="secLabel" />
                  <TextBlock Text="{Binding SniperVM.CombinedWinRateLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource Positive}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="NET CLOSED PNL" Classes="secLabel" />
                  <TextBlock Text="{Binding SniperVM.NetClosedPnlLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource Positive}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="PAPER TRADES" Classes="secLabel" />
                  <TextBlock Text="{Binding SniperVM.PaperTradeCount}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="LIVE WIN RATE" Classes="secLabel" />
                  <TextBlock Text="{Binding SniperVM.LiveWinRateLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource Positive}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Background="{DynamicResource Surface1}" CornerRadius="10" Padding="14">
              <StackPanel Spacing="10">
                <TextBlock Text="Performance Curve" FontSize="{DynamicResource FsBody}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <ctrl:CexPriceChart Height="160" Points="{Binding SniperVM.PerformanceCurvePoints}" IsPositiveTrend="{Binding SniperVM.IsPerformancePositive}" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="8">
              <TextBlock Text="Execution Audit Trail" FontSize="{DynamicResource FsBody}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
              <ItemsControl ItemsSource="{Binding SniperVM.ExecutionAuditTrail}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SniperExecutionAuditRecordViewModel">
                    <Border Background="{DynamicResource Surface1}" CornerRadius="8" Padding="10,10" Margin="0,0,0,8">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding AuditTitle}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                          <TextBlock Grid.Column="1" Text="{Binding TxLine}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextSoft}" />
                        </Grid>
                        <TextBlock Text="{Binding MetaLine}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ─────────── RIGHT: DETAIL PANEL ─────────── -->
      <Border Grid.Column="2" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource PanelStrokeSubtle}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <!-- Empty state -->
            <TextBlock Text="Select a token to inspect it here." Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSmall}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                       IsVisible="{Binding !SniperVM.HasSelectedCandidate}" />

            <StackPanel Margin="14" Spacing="12" IsVisible="{Binding SniperVM.HasSelectedCandidate}">
              <!-- Header -->
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoft}">
                  <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.IconText}" FontWeight="Bold" FontSize="{DynamicResource FsSmall}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.DetailSymbol}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.DetailPairChainLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="7" Padding="10,6" VerticalAlignment="Center">
                  <TextBlock Text="☆ Watch" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="{DynamicResource Warning}" />
                </Border>
              </Grid>

              <!-- Price card -->
              <Border Background="{DynamicResource Surface1}" CornerRadius="12" Padding="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.DetailPriceLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsH2}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.DetailChangeLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Foreground="{Binding SniperVM.SelectedSniperCandidate.DetailChangeHex, Converter={StaticResource StringToBrush}}" />
                    <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.MarketTickLabel}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Stat grid -->
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="3"><TextBlock Text="RISK SCORE" Classes="secLabel" /><TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.RiskScoreLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsBody}" FontWeight="Bold" Foreground="{Binding SniperVM.SelectedSniperCandidate.RiskAccentHex, Converter={StaticResource StringToBrush}}" /></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="3"><TextBlock Text="SECURITY" Classes="secLabel" /><TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.SecurityVerdict}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsBody}" FontWeight="Bold" Foreground="{Binding SniperVM.SelectedSniperCandidate.SecurityVerdictColor, Converter={StaticResource StringToBrush}}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="3"><TextBlock Text="LIQUIDITY" Classes="secLabel" /><TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.LiquidityLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsBody}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="3"><TextBlock Text="VOLUME 24H" Classes="secLabel" /><TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.Volume24hLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsBody}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" /></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="3"><TextBlock Text="MARKET CAP" Classes="secLabel" /><TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.MarketCapLabel}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsBody}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" /></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Surface1}" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="3"><TextBlock Text="BUY / SELL TAX" Classes="secLabel" /><TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.TaxSummary}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" /></StackPanel>
                </Border>
              </Grid>

              <!-- Micro trend -->
              <Border Background="{DynamicResource Surface1}" CornerRadius="10" Padding="10">
                <StackPanel Spacing="6">
                  <TextBlock Text="MICRO TREND" Classes="secLabel" />
                  <Viewbox Height="90" Stretch="Fill" HorizontalAlignment="Stretch">
                    <Polyline Points="{Binding SniperVM.SelectedSniperCandidate.MicroTrendPoints}" Stroke="{Binding SniperVM.SelectedSniperCandidate.DetailChangeHex, Converter={StaticResource StringToBrush}}" StrokeThickness="1.6" />
                  </Viewbox>
                </StackPanel>
              </Border>

              <!-- Security scan -->
              <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource PanelStrokeBright}" BorderThickness="1" CornerRadius="10" Padding="10,10">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" Background="{Binding SniperVM.SelectedSniperCandidate.SecurityVerdictColor, Converter={StaticResource StringToBrush}}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.SecurityVerdict}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding SniperVM.SelectedSniperCandidate.SecurityScoreLabel}" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{Binding SniperVM.SelectedSniperCandidate.SecurityVerdictColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="GoPlus + RugCheck" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.SecurityChecksSummary}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- AI verdict -->
              <Border Background="{DynamicResource PositiveTint}" BorderBrush="#1F5C4A" BorderThickness="1" CornerRadius="12" Padding="12,12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Ellipse Width="8" Height="8" Fill="{Binding SniperVM.SelectedSniperCandidate.AiAccentHex, Converter={StaticResource StringToBrush}}" VerticalAlignment="Top" Margin="0,4,0,0" />
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="AI SIGNAL" Classes="secLabel" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.AiVerdictLabel}" FontSize="{DynamicResource FsBody}" FontWeight="Bold" Foreground="{Binding SniperVM.SelectedSniperCandidate.AiAccentHex, Converter={StaticResource StringToBrush}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SniperVM.SelectedSniperCandidate.AiReason}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="320" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Structure guard (session) -->
              <Border Background="{DynamicResource Surface1}" CornerRadius="10" Padding="10,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="STRUCTURE GUARD" Classes="secLabel" />
                  <TextBlock Text="{Binding SniperVM.LatestStructureVerdict}" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Foreground="{Binding SniperVM.LatestStructureAccentHex, Converter={StaticResource StringToBrush}}" />
                  <TextBlock Text="{Binding SniperVM.LatestStructureNarrative}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- Buy -->
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Background="Transparent" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Foreground="{DynamicResource Accent}"
                      CornerRadius="10" FontSize="{DynamicResource FsSmall}" FontWeight="Bold" Padding="0,12"
                      Content="{Binding SniperVM.SelectedSniperCandidate.DetailSymbol, StringFormat=BUY {0} →}"
                      Command="{Binding SniperVM.BuyCandidateCommand}" CommandParameter="{Binding SniperVM.SelectedSniperCandidate}" />

              <!-- Decision log -->
              <StackPanel Spacing="6">
                <TextBlock Text="DECISION LOG" Classes="secLabel" />
                <ItemsControl ItemsSource="{Binding SniperVM.DecisionLog}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SniperLogEntryViewModel">
                      <Border Background="{DynamicResource Surface1}" CornerRadius="8" Padding="8,8" Margin="0,0,0,6">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding LocalTime, StringFormat={}{0:HH:mm:ss}}" FontFamily="Consolas, monospace" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Text="{Binding Message}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap"
                                     Foreground="{Binding IsPositive, Converter={StaticResource BoolToColorConverter}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Session guard (extra, folded) -->
              <Expander Header="Session guard details">
                <StackPanel Spacing="10" Margin="0,6,0,0">
                  <Border Background="{DynamicResource Surface1}" CornerRadius="9" Padding="10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="OPEN SLOTS" Classes="secLabel" />
                      <TextBlock Text="{Binding SniperVM.OpenPositionCount}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                      <TextBlock Text="{Binding SniperVM.RemainingPositionSlots, StringFormat=Remaining slots: {0}}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource Surface1}" CornerRadius="9" Padding="10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="SESSION BUYS" Classes="secLabel" />
                      <TextBlock Text="{Binding SniperVM.SessionBuyCount}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                      <TextBlock Text="{Binding SniperVM.RemainingSessionBuys, StringFormat=Remaining buys: {0}}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource Surface1}" CornerRadius="9" Padding="10" BorderBrush="{Binding SniperVM.LatestRiskAccentHex, Converter={StaticResource StringToBrush}}" BorderThickness="1">
                    <StackPanel Spacing="4">
                      <TextBlock Text="RISK VERDICT" Classes="secLabel" />
                      <TextBlock Text="{Binding SniperVM.LatestRiskVerdictTitle}" FontSize="{DynamicResource FsSubhead}" FontWeight="Bold" Foreground="{Binding SniperVM.LatestRiskAccentHex, Converter={StaticResource StringToBrush}}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SniperVM.LatestRiskNarrative}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Expander>

            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>

    </Grid>
  </Grid>
</UserControl>

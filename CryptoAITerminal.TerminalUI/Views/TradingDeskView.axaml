<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:ctrl="clr-namespace:CryptoAITerminal.TerminalUI.Controls"
             xmlns:conv="clr-namespace:CryptoAITerminal.TerminalUI.Converters"
             xmlns:views="clr-namespace:CryptoAITerminal.TerminalUI.Views"
             x:Class="CryptoAITerminal.TerminalUI.Views.TradingDeskView"
             x:DataType="vm:MainWindowViewModel"
             FontFamily="{StaticResource FontDisplay}">
  <UserControl.Resources>
    <conv:StringEqualsConverter x:Key="StrEq" />
    <conv:DecimalFieldConverter x:Key="DecField" />
  </UserControl.Resources>
  <UserControl.Styles>
    <StyleInclude Source="avares://CryptoAITerminal.TerminalUI/Styles/TradingDeskStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="12">

    <!-- ═══════════════════════════ CEX TERMINAL ═══════════════════════════ -->
    <Border Classes="TdPanel" Padding="0" ClipToBounds="True" IsVisible="{Binding IsCexTradingMode}">
      <Grid RowDefinitions="Auto,*">

      <!-- ── TOP STATUS BAR ── -->
      <Border Grid.Row="0" BorderBrush="#0d1b27" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="26">

          <!-- Identity -->
          <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
            <Border Width="42" Height="42"
                    Background="{Binding SelectedMarket.LogoBackground}"
                    BorderBrush="#1e3248" BorderThickness="1" CornerRadius="10"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedMarket.LogoText}"
                         Foreground="{Binding SelectedMarket.LogoForeground}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="20" FontWeight="Bold" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding SelectedMarket.DisplaySymbol}" Foreground="#e8f4ff" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Background="#0e2840" BorderBrush="#1e3a50" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="PERP" Foreground="#5bc0ff" FontSize="9" FontWeight="Bold" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding SelectedSpotExchange, StringFormat={}{0} · CEX}" Foreground="{DynamicResource TextSoft}" FontSize="10" LetterSpacing="0.5" />
            </StackPanel>
          </Grid>

          <!-- Live price + quick stats -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
            <StackPanel Spacing="3">
              <TextBlock Classes="TdLabel" Text="LAST PRICE" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.LastPriceDisplay}" Foreground="#21e6c1" FontWeight="Bold" FontSize="16" />
                <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.ChangePercentLabel}" Foreground="{Binding SelectedMarket.ChangeBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="TdLabel" Text="24H HIGH" />
              <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.High24hLabel}" Foreground="#4ff1c9" FontSize="14" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="TdLabel" Text="24H LOW" />
              <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.Low24hLabel}" Foreground="#ff7b7b" FontSize="14" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="TdLabel" Text="24H VOL" />
              <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.Volume24hLabel}" Foreground="#8fa3b8" FontSize="14" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="TdLabel" Text="FUNDING" />
              <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.FundingRateLabel}" Foreground="#f4b860" FontSize="14" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="TdLabel" Text="OI" />
              <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.OpenInterestLabel}" Foreground="#8fa3b8" FontSize="14" />
            </StackPanel>
          </StackPanel>

          <!-- Account / venue -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Width="120">
              <Button Grid.Column="0" Content="CEX" Classes="TdSeg" Classes.active="{Binding IsCexTradingMode}" Command="{Binding SelectTradingVenueCommand}" CommandParameter="CEX" />
              <Button Grid.Column="1" Content="DEX" Classes="TdSeg" Classes.active="{Binding IsDexTradingMode}" Command="{Binding SelectTradingVenueCommand}" CommandParameter="DEX" />
            </Grid>
            <StackPanel Spacing="3">
              <TextBlock Classes="TdLabel" Text="EQUITY" />
              <TextBlock Classes="TdNum" Text="{Binding AccountEquityLabel}" Foreground="#e8f4ff" FontWeight="Bold" FontSize="15" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="TdLabel" Text="SESSION PNL" />
              <TextBlock Classes="TdNum" Text="{Binding SessionPnlLabel}" Foreground="{Binding SessionPnlBrush}" FontWeight="Bold" FontSize="15" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="{Binding TradingGuardStatusBrush}" VerticalAlignment="Center" />
              <StackPanel Spacing="3">
                <TextBlock Classes="TdLabel" Text="GUARD" />
                <TextBlock Text="{Binding TradingGuardStatusLabel}" Foreground="{Binding TradingGuardStatusBrush}" FontWeight="Bold" FontSize="12" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── 3-ZONE BODY (seamless, thin dividers) ── -->
      <Grid Grid.Row="1" ColumnDefinitions="280,1,*,1,420">

        <!-- ══ LEFT: ORDER ENTRY ══ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" Spacing="10">

            <!-- BUY / SELL (seamless segmented) -->
            <Border BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
              <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" Content="BUY / LONG" Classes="TdSide buy"
                        Classes.active="{Binding SelectedOrderSide, Converter={StaticResource StrEq}, ConverterParameter=BUY}"
                        Command="{Binding SelectOrderSideCommand}" CommandParameter="BUY" />
                <Button Grid.Column="1" Content="SELL / SHORT" Classes="TdSide sell"
                        Classes.active="{Binding SelectedOrderSide, Converter={StaticResource StrEq}, ConverterParameter=SELL}"
                        Command="{Binding SelectOrderSideCommand}" CommandParameter="SELL" />
              </Grid>
            </Border>

            <!-- Symbol chips -->
            <StackPanel Spacing="5">
              <TextBlock Classes="TdLabel" Text="SYMBOL" />
              <ItemsControl ItemsSource="{Binding Markets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CexMarketItemViewModel">
                    <Button Classes="TdSeg" Classes.active="{Binding IsActive}"
                            Command="{Binding $parent[ItemsControl].DataContext.FocusMarketCommand}"
                            CommandParameter="{Binding}"
                            Padding="10,4" CornerRadius="6" Margin="0,0,4,4" HorizontalAlignment="Left"
                            ToolTip.Tip="{Binding DisplaySymbol}">
                      <TextBlock Text="{Binding BaseAssetSymbol}" FontSize="10" FontWeight="Bold" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Order type + market mode (vertical stacks) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Classes="TdLabel" Text="ORDER TYPE" />
                <StackPanel Spacing="3">
                  <Button Content="MARKET" Classes="TdSeg left" Command="{Binding SelectOrderTypeCommand}" CommandParameter="Market"
                          Classes.active="{Binding SelectedOrderType, Converter={StaticResource StrEq}, ConverterParameter=Market}" />
                  <Button Content="LIMIT" Classes="TdSeg left" Command="{Binding SelectOrderTypeCommand}" CommandParameter="Limit"
                          Classes.active="{Binding SelectedOrderType, Converter={StaticResource StrEq}, ConverterParameter=Limit}" />
                  <Button Content="STOP" Classes="TdSeg left" Command="{Binding SelectOrderTypeCommand}" CommandParameter="Stop"
                          Classes.active="{Binding SelectedOrderType, Converter={StaticResource StrEq}, ConverterParameter=Stop}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Classes="TdLabel" Text="MARKET MODE" />
                <StackPanel Spacing="3">
                  <Button Content="FUTURES" Classes="TdSeg left amber" Command="{Binding SelectMarketModeCommand}" CommandParameter="Futures"
                          Classes.active="{Binding SelectedCexMarketMode, Converter={StaticResource StrEq}, ConverterParameter=Futures}" />
                  <Button Content="SPOT" Classes="TdSeg left" Command="{Binding SelectMarketModeCommand}" CommandParameter="Spot"
                          Classes.active="{Binding SelectedCexMarketMode, Converter={StaticResource StrEq}, ConverterParameter=Spot}" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- Leverage / margin (futures) — carded -->
            <Border Classes="TdCard" IsVisible="{Binding IsManualFuturesMode}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="TdLabel" Text="LEVERAGE" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding ManualFuturesLeverage, StringFormat={}{0}×}" Foreground="#f4b860" FontWeight="Bold" FontSize="12" />
                </Grid>
                <Slider Minimum="1" Maximum="125" Value="{Binding ManualFuturesLeverage}" Classes="TradeSlider" />
                <Grid ColumnDefinitions="*,*,*,*">
                  <TextBlock Grid.Column="0" Text="1×" Foreground="{DynamicResource TextDim}" FontSize="9" />
                  <TextBlock Grid.Column="1" Text="25×" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="50×" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="125×" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                  <Button Grid.Column="0" Content="CROSS" Classes="TdSeg fill amber" Command="{Binding SelectMarginModeCommand}" CommandParameter="Cross"
                          Classes.active="{Binding ManualFuturesMarginMode, Converter={StaticResource StrEq}, ConverterParameter=Cross}" />
                  <Button Grid.Column="1" Content="ISOLATED" Classes="TdSeg fill amber" Command="{Binding SelectMarginModeCommand}" CommandParameter="Isolated"
                          Classes.active="{Binding ManualFuturesMarginMode, Converter={StaticResource StrEq}, ConverterParameter=Isolated}" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Limit price (centered display field, no steppers) -->
            <StackPanel Spacing="5" IsVisible="{Binding IsLimitOrderType}">
              <TextBlock Classes="TdLabel" Text="LIMIT PRICE (USDT)" />
              <Border Background="#07111a" BorderBrush="#1e3248" BorderThickness="1" CornerRadius="8" Padding="10,10">
                <TextBox Classes="TdInput" Text="{Binding LimitPrice, Converter={StaticResource DecField}}" Foreground="#5bc0ff" FontSize="20" FontWeight="ExtraBold"
                         TextAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" />
              </Border>
            </StackPanel>

            <!-- Size -->
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="TdLabel" Text="SIZE" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <TextBlock Classes="TdNum" Text="{Binding WalletVM.GlobalPositionSizingPercent, StringFormat={}{0:0}%}" Foreground="#e8f4ff" FontWeight="Bold" FontSize="11" />
                  <TextBlock Text="·" Foreground="{DynamicResource TextSoft}" FontSize="11" />
                  <TextBlock Classes="TdNum" Text="{Binding TradeNotionalLabel}" Foreground="#e8f4ff" FontWeight="Bold" FontSize="11" />
                </StackPanel>
              </Grid>
              <Slider Minimum="5" Maximum="100" Value="{Binding WalletVM.GlobalPositionSizingPercent}" Classes="TradeSlider" />
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                <Button Grid.Column="0" Content="25%" Classes="TdSeg fill" Command="{Binding SelectTradeAllocationCommand}" CommandParameter="25" />
                <Button Grid.Column="1" Content="50%" Classes="TdSeg fill" Command="{Binding SelectTradeAllocationCommand}" CommandParameter="50" />
                <Button Grid.Column="2" Content="75%" Classes="TdSeg fill" Command="{Binding SelectTradeAllocationCommand}" CommandParameter="75" />
                <Button Grid.Column="3" Content="100%" Classes="TdSeg fill" Command="{Binding SelectTradeAllocationCommand}" CommandParameter="100" />
              </Grid>
            </StackPanel>

            <!-- TP / SL (text inputs) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Classes="TdLabel" Text="TAKE PROFIT" />
                <Border Background="#07111a" BorderBrush="#152535" BorderThickness="1" CornerRadius="8" Padding="10,7">
                  <TextBox Classes="TdInput" Text="{Binding TakeProfitPrice, Converter={StaticResource DecField}}" Foreground="#3ddc84" FontSize="12" FontWeight="Bold" PlaceholderText="—" VerticalContentAlignment="Center" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Classes="TdLabel" Text="STOP LOSS" />
                <Border Background="#07111a" BorderBrush="#152535" BorderThickness="1" CornerRadius="8" Padding="10,7">
                  <TextBox Classes="TdInput" Text="{Binding StopLossPrice, Converter={StaticResource DecField}}" Foreground="#ff8080" FontSize="12" FontWeight="Bold" PlaceholderText="—" VerticalContentAlignment="Center" />
                </Border>
              </StackPanel>
            </Grid>

            <!-- Trading profile -->
            <StackPanel Spacing="5">
              <TextBlock Classes="TdLabel" Text="TRADING PROFILE" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <Button Grid.Column="0" Content="SWING" Classes="TdSeg fill" Command="{Binding SelectTradingProfileCommand}" CommandParameter="Swing"
                        Classes.active="{Binding SelectedTradingProfile, Converter={StaticResource StrEq}, ConverterParameter=Swing}" />
                <Button Grid.Column="1" Content="SCALP" Classes="TdSeg fill" Command="{Binding SelectTradingProfileCommand}" CommandParameter="Scalp"
                        Classes.active="{Binding SelectedTradingProfile, Converter={StaticResource StrEq}, ConverterParameter=Scalp}" />
                <Button Grid.Column="2" Content="AGGRO" Classes="TdSeg fill" Command="{Binding SelectTradingProfileCommand}" CommandParameter="Aggro"
                        Classes.active="{Binding SelectedTradingProfile, Converter={StaticResource StrEq}, ConverterParameter=Aggro}" />
              </Grid>
            </StackPanel>

            <!-- Slippage + fees -->
            <Border Classes="TdCard">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="TdLabel" Text="SLIPPAGE" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Classes="TdInput" Text="{Binding SlippageTolerancePercent, Converter={StaticResource DecField}}" Foreground="#f4b860" FontSize="11" FontWeight="Bold" TextAlignment="Right" MinWidth="28" VerticalContentAlignment="Center" />
                    <TextBlock Text="%" Foreground="#f4b860" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                  <TextBlock Grid.Row="0" Text="Trading fee (0.10%)" Foreground="{DynamicResource TextDim}" FontSize="10" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Classes="TdNum" Text="{Binding EstimatedTradingFeeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="10" />
                  <TextBlock Grid.Row="1" Text="Network / gas" Foreground="{DynamicResource TextDim}" FontSize="10" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="TdNum" Text="{Binding EstimatedNetworkFeeLabel}" Foreground="{DynamicResource TextSoft}" FontSize="10" />
                  <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="#111d29" Margin="0,2" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Total est." Foreground="#8fa3b8" FontWeight="Bold" FontSize="10" />
                  <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding EstimatedTotalCostLabel}" Foreground="#c8dcef" FontWeight="Bold" FontSize="10" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Futures telemetry -->
            <Border Classes="TdCard" IsVisible="{Binding IsManualFuturesMode}">
              <StackPanel Spacing="8">
                <TextBlock Classes="TdLabel" Text="FUTURES TELEMETRY" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Classes="TdLabel" Text="MARK" />
                    <TextBlock Classes="TdNum" Text="{Binding CurrentFuturesMarkPriceLabel}" Foreground="#21e6c1" FontWeight="Bold" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                    <TextBlock Classes="TdLabel" Text="LIQ" />
                    <TextBlock Classes="TdNum" Text="{Binding CurrentFuturesLiquidationLabel}" Foreground="#ff6b6b" FontWeight="Bold" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                    <TextBlock Classes="TdLabel" Text="MARGIN" />
                    <TextBlock Classes="TdNum" Text="{Binding CurrentFuturesEstimatedMarginLabel}" Foreground="#e8f4ff" FontWeight="Bold" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <TextBlock Classes="TdLabel" Text="ROE" />
                    <TextBlock Classes="TdNum" Text="{Binding CurrentFuturesRoeLabel}" Foreground="{Binding SessionPnlBrush}" FontWeight="Bold" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Execution guard (checks as chips) -->
            <Border Background="#061e14" BorderBrush="#0d2a1e" BorderThickness="1" CornerRadius="9" Padding="10,11">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="EXECUTION GUARD" Classes="TdLabel" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Background="#143ddc84" CornerRadius="5" Padding="8,2">
                    <TextBlock Text="{Binding GuardPassLabel}" Foreground="{Binding TradingGuardStatusBrush}" FontSize="9" FontWeight="ExtraBold" />
                  </Border>
                </Grid>
                <WrapPanel>
                  <Border Background="#07131a" BorderBrush="#0e2218" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,5,5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Ellipse Width="5" Height="5" Fill="#3ddc84" VerticalAlignment="Center" />
                      <TextBlock Text="Liquidity" Foreground="#4a7060" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                  </Border>
                  <Border Background="#07131a" BorderBrush="#0e2218" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,5,5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Ellipse Width="5" Height="5" Fill="#3ddc84" VerticalAlignment="Center" />
                      <TextBlock Text="Slippage" Foreground="#4a7060" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                  </Border>
                  <Border Background="#07131a" BorderBrush="#0e2218" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,5,5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Ellipse Width="5" Height="5" Fill="#3ddc84" VerticalAlignment="Center" />
                      <TextBlock Text="Exposure" Foreground="#4a7060" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                  </Border>
                  <Border Background="#07131a" BorderBrush="#0e2218" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,5,5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Ellipse Width="5" Height="5" Fill="#3ddc84" VerticalAlignment="Center" />
                      <TextBlock Text="Risk Limits" Foreground="#4a7060" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                  </Border>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Place order -->
            <Button Command="{Binding PlacePrimaryOrderCommand}" Classes="TdPrimary" Height="52"
                    IsEnabled="{Binding CanPlacePrimaryOrder}" ToolTip.Tip="{Binding PrimaryOrderBlockedReason}">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding PrimaryOrderButtonText}" Foreground="#051018" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PrimaryOrderButtonHint}" Foreground="#0b3e37" FontSize="10" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="#0d1b27" />

        <!-- ══ CENTER ══ -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">

          <Border Grid.Row="0" Background="#050c14" BorderBrush="#0d1b27" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Spacing="10">

              <!-- Metric row -->
              <StackPanel Orientation="Horizontal" Spacing="28">
                <StackPanel Spacing="3">
                  <TextBlock Classes="TdLabel" Text="MARK PRICE" />
                  <TextBlock Classes="TdNum" Text="{Binding CurrentTradePrice, StringFormat={}{0:N2} USDT}" Foreground="#21e6c1" FontWeight="Bold" FontSize="17" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="TdLabel" Text="SPREAD" />
                  <TextBlock Classes="TdNum" Text="{Binding SpreadLabel}" Foreground="#c8dcef" FontSize="15" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="TdLabel" Text="HIGH" />
                  <TextBlock Classes="TdNum" Text="{Binding ChartHighLabel}" Foreground="#4ff1c9" FontSize="15" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="TdLabel" Text="LOW" />
                  <TextBlock Classes="TdNum" Text="{Binding ChartLowLabel}" Foreground="#ff7b7b" FontSize="15" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="TdLabel" Text="VOLUME" />
                  <TextBlock Classes="TdNum" Text="{Binding ChartVolumeLabel}" Foreground="#c8dcef" FontSize="15" />
                </StackPanel>
              </StackPanel>

              <!-- Toolbar row 1: timeframes · chart type · zoom · alert · fullscreen -->
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                  <Button Content="1M" Classes="TdSeg mini" Command="{Binding SelectTradeTimeframeCommand}" CommandParameter="1M" Classes.active="{Binding SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=1M}" />
                  <Button Content="5M" Classes="TdSeg mini" Command="{Binding SelectTradeTimeframeCommand}" CommandParameter="5M" Classes.active="{Binding SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=5M}" />
                  <Button Content="15M" Classes="TdSeg mini" Command="{Binding SelectTradeTimeframeCommand}" CommandParameter="15M" Classes.active="{Binding SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=15M}" />
                  <Button Content="1H" Classes="TdSeg mini" Command="{Binding SelectTradeTimeframeCommand}" CommandParameter="1H" Classes.active="{Binding SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=1H}" />
                  <Button Content="4H" Classes="TdSeg mini" Command="{Binding SelectTradeTimeframeCommand}" CommandParameter="4H" Classes.active="{Binding SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=4H}" />
                  <Button Content="1D" Classes="TdSeg mini" Command="{Binding SelectTradeTimeframeCommand}" CommandParameter="1D" Classes.active="{Binding SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=1D}" />
                  <Button Content="1W" Classes="TdSeg mini" Command="{Binding SelectTradeTimeframeCommand}" CommandParameter="1W" Classes.active="{Binding SelectedTradeTimeframe, Converter={StaticResource StrEq}, ConverterParameter=1W}" />
                </StackPanel>
                <Border Grid.Column="1" Width="1" Background="#152535" Margin="6,2" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                  <Button Content="Candles" Classes="TdSeg mini" Command="{Binding SelectChartTypeCommand}" CommandParameter="Candles" Classes.active="{Binding SelectedChartType, Converter={StaticResource StrEq}, ConverterParameter=Candles}" />
                  <Button Content="HA" Classes="TdSeg mini" Command="{Binding SelectChartTypeCommand}" CommandParameter="HA" Classes.active="{Binding SelectedChartType, Converter={StaticResource StrEq}, ConverterParameter=HA}" />
                  <Button Content="Line" Classes="TdSeg mini" Command="{Binding SelectChartTypeCommand}" CommandParameter="Line" Classes.active="{Binding SelectedChartType, Converter={StaticResource StrEq}, ConverterParameter=Line}" />
                  <Button Content="Area" Classes="TdSeg mini" Command="{Binding SelectChartTypeCommand}" CommandParameter="Area" Classes.active="{Binding SelectedChartType, Converter={StaticResource StrEq}, ConverterParameter=Area}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Content="−" Classes="TdSeg mini" Command="{Binding ZoomChartOutCommand}" />
                  <TextBlock Classes="TdNum" Text="{Binding ChartZoomLabel}" Foreground="#8fa3b8" FontSize="10" VerticalAlignment="Center" Width="34" TextAlignment="Center" />
                  <Button Content="+" Classes="TdSeg mini" Command="{Binding ZoomChartInCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                  <TextBox Text="{Binding ChartAlertPriceInput}" PlaceholderText="Price alert…" Width="96" FontSize="11"
                           IsVisible="{Binding ShowChartAlertInput}" VerticalContentAlignment="Center" />
                  <Button Content="⚑ ALERT" Classes="TdSeg mini" Command="{Binding ChartAlertCommand}" Classes.active="{Binding ShowChartAlertInput}" />
                </StackPanel>
                <Button Grid.Column="6" Content="{Binding ChartFullscreenGlyph}" Classes="TdSeg mini" Margin="6,0,0,0"
                        Command="{Binding ToggleChartFullscreenCommand}" Classes.active="{Binding IsChartExpanded}" />
              </Grid>

              <!-- Toolbar row 2: drawing tools · IND indicators -->
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                  <Button Content="CURSOR" Classes="TdSeg mini" Command="{Binding SelectChartToolCommand}" CommandParameter="Cursor" Classes.active="{Binding SelectedChartTool, Converter={StaticResource StrEq}, ConverterParameter=Cursor}" />
                  <Button Content="TREND" Classes="TdSeg mini" Command="{Binding SelectChartToolCommand}" CommandParameter="Trend" Classes.active="{Binding SelectedChartTool, Converter={StaticResource StrEq}, ConverterParameter=Trend}" />
                  <Button Content="H-LINE" Classes="TdSeg mini" Command="{Binding SelectChartToolCommand}" CommandParameter="Horizontal" Classes.active="{Binding SelectedChartTool, Converter={StaticResource StrEq}, ConverterParameter=Horizontal}" />
                  <Button Content="RECT" Classes="TdSeg mini" Command="{Binding SelectChartToolCommand}" CommandParameter="Rectangle" Classes.active="{Binding SelectedChartTool, Converter={StaticResource StrEq}, ConverterParameter=Rectangle}" />
                  <Button Content="CHANNEL" Classes="TdSeg mini" Command="{Binding SelectChartToolCommand}" CommandParameter="Channel" Classes.active="{Binding SelectedChartTool, Converter={StaticResource StrEq}, ConverterParameter=Channel}" />
                  <Button Content="ERASE" Classes="TdSeg mini" Command="{Binding SelectChartToolCommand}" CommandParameter="Erase" Classes.active="{Binding SelectedChartTool, Converter={StaticResource StrEq}, ConverterParameter=Erase}" />
                  <Button Content="RESET" Classes="TdSeg mini" Command="{Binding ResetChartViewCommand}" />
                  <Button Content="CLEAR" Classes="TdSeg mini" Command="{Binding ClearChartDrawingsCommand}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="TdLabel" Text="IND" VerticalAlignment="Center" Margin="0,0,6,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                  <Button Content="MA20" Classes="TdSeg mini" Command="{Binding ToggleChartIndicatorCommand}" CommandParameter="MA20" Classes.active="{Binding ShowMa20}" />
                  <Button Content="MA50" Classes="TdSeg mini" Command="{Binding ToggleChartIndicatorCommand}" CommandParameter="MA50" Classes.active="{Binding ShowMa50}" />
                  <Button Content="BB" Classes="TdSeg mini" Command="{Binding ToggleChartIndicatorCommand}" CommandParameter="BB" Classes.active="{Binding ShowBollinger}" />
                  <Button Content="RSI" Classes="TdSeg mini" Command="{Binding ToggleChartIndicatorCommand}" CommandParameter="RSI" Classes.active="{Binding ShowRsi}" />
                  <Button Content="WALLS" Classes="TdSeg mini" Command="{Binding ToggleChartIndicatorCommand}" CommandParameter="WALLS" Classes.active="{Binding ShowWalls}" />
                </StackPanel>
              </Grid>

              <!-- Chart -->
              <Border Background="#040c14" BorderBrush="#111d29" BorderThickness="1" CornerRadius="8" Padding="6">
                <ctrl:CexCandlestickChart Height="{Binding ChartHeight}"
                                          Candles="{Binding ActiveTradingCandles}"
                                          ChartType="{Binding SelectedChartType}"
                                          ShowMa20="{Binding ShowMa20}"
                                          ShowMa50="{Binding ShowMa50}"
                                          ShowBollinger="{Binding ShowBollinger}"
                                          ShowRsi="{Binding ShowRsi}"
                                          ShowWalls="{Binding ShowWalls}"
                                          ToolMode="{Binding SelectedChartTool}"
                                          PersistenceKey="{Binding SelectedTradingSymbol}"
                                          ClearDrawingsVersion="{Binding ChartClearDrawingsVersion}"
                                          ResetViewVersion="{Binding ChartResetViewVersion}"
                                          ZoomInVersion="{Binding ChartZoomInVersion}"
                                          ZoomOutVersion="{Binding ChartZoomOutVersion}"
                                          Walls="{Binding SelectedMarket.LargeWalls}" />
              </Border>

              <!-- Trade tape -->
              <Border Classes="TdMid">
                <Grid>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TapeTrades}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TapeTradeViewModel">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding SideLabel}" Foreground="{Binding SideBrush}" FontWeight="Bold" FontSize="11" />
                            <TextBlock Classes="TdNum" Text="{Binding PriceLabel}" Foreground="#c8dcef" FontSize="11" />
                            <TextBlock Classes="TdNum" Text="{Binding QuantityLabel}" Foreground="{DynamicResource TextSoft}" FontSize="11" />
                            <TextBlock Classes="TdNum" Text="{Binding TimeLabel}" Foreground="{DynamicResource TextDim}" FontSize="11" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <TextBlock Text="Waiting for trade tape…" Foreground="{DynamicResource TextSoft}" FontSize="11" IsVisible="{Binding ShowTapePlaceholder}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- Blotter -->
          <Border Grid.Row="1" Background="#050c14" Padding="14,10">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <TextBlock Classes="TdLabel" Text="ORDERS" />
                  <TextBlock Classes="TdNum" Text="{Binding WorkingOrders.Count}" Foreground="#8fb9de" FontWeight="Bold" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <TextBlock Classes="TdLabel" Text="POSITIONS" />
                  <TextBlock Classes="TdNum" Text="{Binding PositionRows.Count}" Foreground="#f4b860" FontWeight="Bold" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <TextBlock Classes="TdLabel" Text="SESSION PNL" />
                  <TextBlock Classes="TdNum" Text="{Binding SessionPnlLabel}" Foreground="{Binding SessionPnlBrush}" FontWeight="Bold" FontSize="11" />
                </StackPanel>
              </StackPanel>

              <TabControl SelectedIndex="{Binding SelectedTradingBottomTabIndex}" Classes="DeskTabs">
                <TabItem Header="Orders">
                  <StackPanel Margin="0,12,0,0" Spacing="10">
                    <Grid ColumnDefinitions="0.8*,0.9*,0.7*,0.7*,0.9*,0.7*,0.7*,0.8*" ColumnSpacing="10">
                      <TextBlock Classes="TdLabel" Text="ID" />
                      <TextBlock Grid.Column="1" Classes="TdLabel" Text="SYMBOL" />
                      <TextBlock Grid.Column="2" Classes="TdLabel" Text="SIDE" />
                      <TextBlock Grid.Column="3" Classes="TdLabel" Text="TYPE" />
                      <TextBlock Grid.Column="4" Classes="TdLabel" Text="PRICE" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="5" Classes="TdLabel" Text="QTY" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="6" Classes="TdLabel" Text="STATUS" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="7" Classes="TdLabel" Text="CREATED" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer MaxHeight="240">
                      <ItemsControl ItemsSource="{Binding WorkingOrders}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:WorkingOrderViewModel">
                            <Border Classes="TdCardTight" Margin="0,0,0,6">
                              <Grid ColumnDefinitions="0.8*,0.9*,0.7*,0.7*,0.9*,0.7*,0.7*,0.8*" ColumnSpacing="10">
                                <TextBlock Classes="TdNum" Text="{Binding IdLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="#c8dcef" />
                                <TextBlock Grid.Column="2" Text="{Binding SideLabel}" Foreground="{Binding SideBrush}" FontWeight="Bold" />
                                <TextBlock Grid.Column="3" Text="{Binding TypeLabel}" Foreground="#8fa3b8" />
                                <TextBlock Grid.Column="4" Classes="TdNum" Text="{Binding TriggerLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Classes="TdNum" Text="{Binding QuantityLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" HorizontalAlignment="Center" FontSize="11" />
                                <TextBlock Grid.Column="7" Classes="TdNum" Text="{Binding CreatedLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSoft}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="No working orders yet. Arm a limit, TP or SL to populate the blotter."
                               Foreground="{DynamicResource TextSoft}" IsVisible="{Binding ShowWorkingOrdersPlaceholder}" />
                  </StackPanel>
                </TabItem>

                <TabItem Header="Positions">
                  <StackPanel Margin="0,12,0,0" Spacing="10">
                    <Grid ColumnDefinitions="0.9*,0.7*,0.8*,0.8*,0.9*,0.7*,0.7*,0.6*" ColumnSpacing="10">
                      <TextBlock Classes="TdLabel" Text="SYMBOL" />
                      <TextBlock Grid.Column="1" Classes="TdLabel" Text="SIZE" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Classes="TdLabel" Text="ENTRY" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Classes="TdLabel" Text="MARK" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Classes="TdLabel" Text="UPNL" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="5" Classes="TdLabel" Text="PNL %" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="6" Classes="TdLabel" Text="MARGIN" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="7" Classes="TdLabel" Text="ROE" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer MaxHeight="240">
                      <ItemsControl ItemsSource="{Binding PositionRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PositionRowViewModel">
                            <Border Classes="TdCardTight" Margin="0,0,0,6">
                              <Grid ColumnDefinitions="0.9*,0.7*,0.8*,0.8*,0.9*,0.7*,0.7*,0.6*" ColumnSpacing="10">
                                <TextBlock Text="{Binding Symbol}" Foreground="#c8dcef" />
                                <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding SizeLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding EntryPriceLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Classes="TdNum" Text="{Binding MarkPriceLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Classes="TdNum" Text="{Binding UnrealizedPnlLabel}" HorizontalAlignment="Right" Foreground="{Binding UnrealizedPnlBrush}" />
                                <TextBlock Grid.Column="5" Classes="TdNum" Text="{Binding PnlPercentLabel}" HorizontalAlignment="Right" Foreground="{Binding UnrealizedPnlBrush}" />
                                <TextBlock Grid.Column="6" Classes="TdNum" Text="{Binding MarginLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Classes="TdNum" Text="{Binding RoeLabel}" HorizontalAlignment="Right" Foreground="{Binding UnrealizedPnlBrush}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="No open positions. Use the ticket to open the first trade."
                               Foreground="{DynamicResource TextSoft}" IsVisible="{Binding ShowPositionRowsPlaceholder}" />
                  </StackPanel>
                </TabItem>

                <TabItem Header="Fills">
                  <StackPanel Margin="0,12,0,0" Spacing="10">
                    <Grid ColumnDefinitions="0.7*,0.9*,0.8*,0.6*,0.8*,0.7*" ColumnSpacing="10">
                      <TextBlock Classes="TdLabel" Text="SIDE" />
                      <TextBlock Grid.Column="1" Classes="TdLabel" Text="SYMBOL" />
                      <TextBlock Grid.Column="2" Classes="TdLabel" Text="PRICE" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Classes="TdLabel" Text="QTY" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Classes="TdLabel" Text="STATUS" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="5" Classes="TdLabel" Text="TIME" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer MaxHeight="240">
                      <ItemsControl ItemsSource="{Binding RecentFills}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TradeFillViewModel">
                            <Border Classes="TdCardTight" Margin="0,0,0,6">
                              <Grid ColumnDefinitions="0.7*,0.9*,0.8*,0.6*,0.8*,0.7*" ColumnSpacing="10">
                                <TextBlock Text="{Binding SideLabel}" Foreground="{Binding SideBrush}" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="#c8dcef" />
                                <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding PriceLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Classes="TdNum" Text="{Binding QuantityLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding Status}" HorizontalAlignment="Right" Foreground="{Binding StatusBrush}" />
                                <TextBlock Grid.Column="5" Classes="TdNum" Text="{Binding TimeLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSoft}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="No fills yet. Execution tape will appear here after the first order."
                               Foreground="{DynamicResource TextSoft}" IsVisible="{Binding ShowRecentFillsPlaceholder}" />
                  </StackPanel>
                </TabItem>

                <TabItem Header="Signals">
                  <StackPanel Margin="0,12,0,0" Spacing="10">
                    <Grid ColumnDefinitions="0.9*,1.2*,0.7*,0.7*,0.7*,0.7*" ColumnSpacing="10">
                      <TextBlock Classes="TdLabel" Text="SYMBOL" />
                      <TextBlock Grid.Column="1" Classes="TdLabel" Text="SETUP" />
                      <TextBlock Grid.Column="2" Classes="TdLabel" Text="ENTRY" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Classes="TdLabel" Text="TARGET" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Classes="TdLabel" Text="STOP" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="5" Classes="TdLabel" Text="STATUS" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer MaxHeight="240">
                      <ItemsControl ItemsSource="{Binding SignalRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SignalRowViewModel">
                            <Border Classes="TdCardTight" Margin="0,0,0,6">
                              <Grid ColumnDefinitions="0.9*,1.2*,0.7*,0.7*,0.7*,0.7*" ColumnSpacing="10">
                                <TextBlock Text="{Binding Symbol}" Foreground="#c8dcef" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Setup}" Foreground="#8fa3b8" />
                                <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding Entry}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Classes="TdNum" Text="{Binding Target}" HorizontalAlignment="Right" Foreground="#3ddc84" />
                                <TextBlock Grid.Column="4" Classes="TdNum" Text="{Binding Stop}" HorizontalAlignment="Right" Foreground="#ff6b6b" />
                                <TextBlock Grid.Column="5" Text="{Binding Status}" HorizontalAlignment="Right" Foreground="{Binding StatusBrush}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Signals are waiting for stronger market structure before activating."
                               Foreground="{DynamicResource TextSoft}" IsVisible="{Binding ShowSignalRowsPlaceholder}" />
                  </StackPanel>
                </TabItem>
              </TabControl>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Column="3" Background="#0d1b27" />

        <!-- ══ RIGHT RAIL (seamless aside) ══ -->
        <Border Grid.Column="4" Background="#050c14">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>

            <!-- Exchange selector tabs -->
            <ItemsControl ItemsSource="{Binding TradingVenues}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TradingVenueQuoteViewModel">
                  <Button Command="{Binding $parent[ItemsControl].DataContext.SelectTradingVenueQuoteCommand}"
                          CommandParameter="{Binding Exchange}"
                          Background="{Binding TabBackground}" BorderBrush="{Binding TabBorderBrush}"
                          BorderThickness="0,0,0,2" CornerRadius="0" Padding="4,7" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding Exchange}" Foreground="{Binding NameBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" />
                      <TextBlock Classes="TdNum" Text="{Binding DeltaLabel}" Foreground="{Binding DeltaBrush}" FontSize="9" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Background="#0d1b27" />

            <!-- Exchange info strip -->
            <Grid ColumnDefinitions="*,Auto" Margin="12,6">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="#3ddc84" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedSpotExchange}" Foreground="#e8f4ff" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedMarket.Symbol}" Foreground="{DynamicResource TextDim}" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="24H Vol" Foreground="{DynamicResource TextDim}" FontSize="9" VerticalAlignment="Center" />
                  <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.Volume24hLabel}" Foreground="#8fa3b8" FontSize="10" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Fee" Foreground="{DynamicResource TextDim}" FontSize="9" VerticalAlignment="Center" />
                  <TextBlock Classes="TdNum" Text="{Binding ExchangeFeeLabel}" Foreground="#f4b860" FontSize="10" FontWeight="Bold" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="#0d1b27" />

            <!-- Position | AI signal -->
            <Grid ColumnDefinitions="*,1,*">
              <!-- Position -->
              <StackPanel Grid.Column="0" Margin="10,8" Spacing="5">
                <TextBlock Classes="TdLabel" Text="POSITION" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="{Binding SelectedMarket.Symbol}" Foreground="#c8dcef" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                  <Border Background="{Binding PositionSideBackground}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PositionSideLabel}" Foreground="{Binding PositionSideBrush}" FontWeight="Bold" FontSize="9" />
                  </Border>
                  <TextBlock Text="{Binding ManualLeverageLabel}" Foreground="{DynamicResource TextDim}" FontSize="9" VerticalAlignment="Center" IsVisible="{Binding IsManualFuturesMode}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="Entry" Foreground="{DynamicResource TextDim}" FontSize="9" />
                    <TextBlock Classes="TdNum" Text="{Binding EntryPriceLabel}" Foreground="#8fa3b8" FontWeight="Bold" FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="uPnL" Foreground="{DynamicResource TextDim}" FontSize="9" />
                    <TextBlock Classes="TdNum" Text="{Binding ExchangeUnrealizedPnlLabel}" Foreground="{Binding SessionPnlBrush}" FontWeight="Bold" FontSize="11" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                  <Button Grid.Column="0" Content="REVERSE" Classes="TdSeg mini" Command="{Binding ReversePositionCommand}" IsEnabled="{Binding CanExecuteCexReverse}" ToolTip.Tip="{Binding CexReverseBlockedReason}" />
                  <Button Grid.Column="1" Content="CLOSE" Classes="TdDanger" FontSize="9" Padding="0,4" Command="{Binding ClosePositionCommand}" IsEnabled="{Binding CanExecuteCexClose}" ToolTip.Tip="{Binding CexCloseBlockedReason}" />
                </Grid>
              </StackPanel>
              <Border Grid.Column="1" Background="#0d1b27" />
              <!-- AI signal -->
              <StackPanel Grid.Column="2" Margin="10,8" Spacing="5" Background="{Binding SelectedMarket.AiSignalCardBackground}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="TdLabel" Text="AI SIGNAL" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Background="#0a1622" CornerRadius="4" Padding="7,1">
                    <TextBlock Text="{Binding SelectedMarket.AiSignalLabel}" Foreground="{Binding SelectedMarket.AiSignalForeground}" FontWeight="Bold" FontSize="10" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding SelectedMarket.AiSignalDetail}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" FontSize="9" LineHeight="14" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
                  <Border Grid.Column="0" Background="#07111a" CornerRadius="4" Padding="4,3">
                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                      <TextBlock Text="ENTRY" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                      <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.MidPriceLabel}" Foreground="#c8dcef" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#061e14" CornerRadius="4" Padding="4,3">
                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                      <TextBlock Text="TP" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                      <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.High24hLabel}" Foreground="#3ddc84" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="#200a0a" CornerRadius="4" Padding="4,3">
                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                      <TextBlock Text="SL" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                      <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.Low24hLabel}" Foreground="#ff8080" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="#0d1b27" />

            <!-- Order book header + depth toggle -->
            <Grid ColumnDefinitions="*,Auto" Margin="12,6">
              <TextBlock Classes="TdLabel" Text="ORDER BOOK" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Depth" Foreground="{DynamicResource TextDim}" FontSize="9" VerticalAlignment="Center" />
                <Button Content="0.01" Classes="TdSeg mini" Command="{Binding SelectObDepthCommand}" CommandParameter="0.01" Classes.active="{Binding SelectedObDepth, Converter={StaticResource StrEq}, ConverterParameter=0.01}" />
                <Button Content="0.1" Classes="TdSeg mini" Command="{Binding SelectObDepthCommand}" CommandParameter="0.1" Classes.active="{Binding SelectedObDepth, Converter={StaticResource StrEq}, ConverterParameter=0.1}" />
                <Button Content="1" Classes="TdSeg mini" Command="{Binding SelectObDepthCommand}" CommandParameter="1" Classes.active="{Binding SelectedObDepth, Converter={StaticResource StrEq}, ConverterParameter=1}" />
              </StackPanel>
            </Grid>

            <!-- Ask column labels -->
            <Grid ColumnDefinitions="0.9*,0.9*,1*,0.7*" Margin="12,2">
              <TextBlock Text="TOTAL" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="SIZE" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="2" Text="ASK PRICE" Foreground="#ff8080" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="DEPTH" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
            </Grid>

            <!-- Asks -->
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,0,0,2">
              <ItemsControl ItemsSource="{Binding SelectedMarket.AskLevels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OrderBookLevelViewModel">
                    <Grid Height="16" Margin="12,0">
                      <Rectangle Fill="#12ff6b6b" HorizontalAlignment="Right" Width="{Binding DepthWidth}" />
                      <Grid ColumnDefinitions="0.9*,0.9*,1*,0.7*">
                        <TextBlock Classes="TdNum" Text="{Binding CumulativeLabel}" Foreground="#4a6070" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding Quantity, StringFormat={}{0:0.###}}" Foreground="#8fa3b8" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding Price, StringFormat={}{0:N2}}" Foreground="#ff7070" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <Border Grid.Column="3" Height="8" Background="#59ff6b6b" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center" Width="{Binding DepthBarSmall}" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Mid price row -->
            <Border Background="#060e16" BorderBrush="#0d1b27" BorderThickness="0,1" Padding="12,7">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.MidPriceLabel}" Foreground="#21e6c1" FontWeight="Bold" FontSize="18" />
                  <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.ChangePercentLabel}" Foreground="{Binding SelectedMarket.ChangeBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                  <TextBlock Text="Spread" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Right" />
                  <TextBlock Classes="TdNum" Text="{Binding SelectedMarket.SpreadPercentLabel}" Foreground="#f4b860" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Bids -->
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
              <ItemsControl ItemsSource="{Binding SelectedMarket.BidLevels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OrderBookLevelViewModel">
                    <Grid Height="16" Margin="12,0">
                      <Rectangle Fill="#123ddc84" HorizontalAlignment="Left" Width="{Binding DepthWidth}" />
                      <Grid ColumnDefinitions="0.9*,0.9*,1*,0.7*">
                        <TextBlock Classes="TdNum" Text="{Binding CumulativeLabel}" Foreground="#4a6070" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding Quantity, StringFormat={}{0:0.###}}" Foreground="#8fa3b8" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding Price, StringFormat={}{0:N2}}" Foreground="#3ddc84" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <Border Grid.Column="3" Height="8" Background="#593ddc84" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center" Width="{Binding DepthBarSmall}" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Bid column labels -->
            <Border BorderBrush="#0d1b27" BorderThickness="0,1,0,0" Margin="0,2,0,0">
              <Grid ColumnDefinitions="0.9*,0.9*,1*,0.7*" Margin="12,3">
                <TextBlock Text="TOTAL" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="SIZE" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="BID PRICE" Foreground="#3ddc84" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="DEPTH" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
              </Grid>
            </Border>

            <!-- Risk | Wallets -->
            <Grid ColumnDefinitions="*,1,*" Background="#040b12">
              <StackPanel Grid.Column="0" Margin="10,8" Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="TdLabel" Text="RISK" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding RiskModeLabel}" Foreground="#f4b860" FontWeight="Bold" FontSize="9" />
                </Grid>
                <Border Height="6" Background="#0d1b27" CornerRadius="3">
                  <Border Background="#f4b860" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding WalletVM.GlobalPositionSizingPercent}" />
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Max DD" Foreground="{DynamicResource TextDim}" FontSize="9" />
                  <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding WalletVM.GlobalRiskCapLabel}" Foreground="#f4b860" FontSize="9" />
                </Grid>
              </StackPanel>
              <Border Grid.Column="1" Background="#0d1b27" />
              <StackPanel Grid.Column="2" Margin="10,8" Spacing="4">
                <TextBlock Classes="TdLabel" Text="WALLETS" />
                <ItemsControl ItemsSource="{Binding WalletVM.Assets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WalletAssetViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,3" ColumnSpacing="5">
                        <Ellipse Width="5" Height="5" Fill="#21e6c1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#8fa3b8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding Value}" Foreground="#c8dcef" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>

            <!-- AI Trade Assistant -->
            <views:AiTradeAssistantView DataContext="{Binding TradeAssistantVM}" Margin="10,4,10,10" />
          </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      </Grid>
    </Border>

    <!-- ═══════════════════════════ DEX TERMINAL ═══════════════════════════ -->
    <Border Classes="TdPanel" Padding="0" ClipToBounds="True" IsVisible="{Binding IsDexTradingMode}">
      <Grid RowDefinitions="Auto,*">

        <!-- ── TOP STATUS BAR ── -->
        <Border Grid.Row="0" BorderBrush="#0d1b27" BorderThickness="0,0,0,1" Padding="16,10">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="26">

            <!-- Identity -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
              <Border Width="42" Height="42" Background="#150a20" BorderBrush="#3a1f6e" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                <TextBlock Text="◈" Foreground="#a855f7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding DexTradingVM.SelectedTokenTitle}" Foreground="#e8f4ff" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                  <Border Classes="TdDexBadge" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DexDeskVM.SymbolTypeLabel}" Foreground="#a855f7" FontSize="9" FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding DexTradingVM.SelectedTokenSubtitle}" Foreground="{DynamicResource TextSoft}" FontSize="10" LetterSpacing="0.5" TextTrimming="CharacterEllipsis" MaxWidth="260" />
              </StackPanel>
            </Grid>

            <!-- Live stats -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
              <StackPanel Spacing="3">
                <TextBlock Classes="TdLabel" Text="PRICE USD" />
                <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.SelectedToken.PriceUsd, StringFormat=\$ {0:N6}}" Foreground="#a855f7" FontWeight="Bold" FontSize="16" />
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="TdLabel" Text="LIQUIDITY" />
                <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexLiquidityLabel}" Foreground="#8fa3b8" FontSize="14" />
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="TdLabel" Text="24H HIGH" />
                <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.ChartHighLabel}" Foreground="#4ff1c9" FontSize="14" />
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="TdLabel" Text="24H LOW" />
                <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.ChartLowLabel}" Foreground="#ff7b7b" FontSize="14" />
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="TdLabel" Text="VOL 24H" />
                <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexVolume24hLabel}" Foreground="#8fa3b8" FontSize="14" />
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="TdLabel" Text="GAS" />
                <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.SelectedGasTierGweiLabel}" Foreground="#f4b860" FontSize="14" />
              </StackPanel>
            </StackPanel>

            <!-- Venue / mode / account -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Width="128">
                  <Button Grid.Column="0" Content="CEX" Classes="TdSeg" Classes.active="{Binding IsCexTradingMode}" Command="{Binding SelectTradingVenueCommand}" CommandParameter="CEX" />
                  <Button Grid.Column="1" Content="DEX" Classes="TdSeg dex" Classes.active="{Binding IsDexTradingMode}" Command="{Binding SelectTradingVenueCommand}" CommandParameter="DEX" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Width="128">
                  <Button Grid.Column="0" Content="SWAP" Classes="TdSeg dex" Classes.active="{Binding DexDeskVM.IsSwapMode}" Command="{Binding DexDeskVM.SelectModeCommand}" CommandParameter="SWAP" />
                  <Button Grid.Column="1" Content="PERP" Classes="TdSeg dex" Classes.active="{Binding DexDeskVM.IsPerpMode}" Command="{Binding DexDeskVM.SelectModeCommand}" CommandParameter="PERP" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="TdLabel" Text="WALLET" />
                <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.WalletBalanceSummary}" Foreground="#e8f4ff" FontWeight="Bold" FontSize="13" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{Binding DexTradingVM.DexGuardStatusBrush}" VerticalAlignment="Center" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="TdLabel" Text="ROUTE" />
                  <TextBlock Text="{Binding DexTradingVM.DexGuardStatusLabel}" Foreground="{Binding DexTradingVM.DexGuardStatusBrush}" FontWeight="Bold" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ── 3-ZONE BODY ── -->
        <Grid Grid.Row="1" ColumnDefinitions="300,1,*,1,364">

          <!-- ══ LEFT: TICKET ══ -->
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="12">

              <!-- ─ SWAP TICKET ─ -->
              <StackPanel Spacing="10" IsVisible="{Binding DexDeskVM.IsSwapMode}">

                <Border Background="#150a20" BorderBrush="{Binding DexTradingVM.DexGuardStatusBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="TdLabel" Text="ROUTE GUARD" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding DexTradingVM.DexGuardStatusLabel}" Foreground="{Binding DexTradingVM.DexGuardStatusBrush}" FontWeight="Bold" FontSize="10" />
                    </Grid>
                    <TextBlock Text="{Binding DexTradingVM.DexGuardSummary}" Foreground="#c8dcef" TextWrapping="Wrap" FontSize="11" />
                  </StackPanel>
                </Border>

                <StackPanel Spacing="5">
                  <TextBlock Classes="TdLabel" Text="DEX MODE" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Content="SWAP" Classes="TdSeg dex" Classes.active="{Binding DexDeskVM.IsSwapMode}" Command="{Binding DexDeskVM.SelectModeCommand}" CommandParameter="SWAP" />
                    <Button Grid.Column="1" Content="PERP" Classes="TdSeg dex" Classes.active="{Binding DexDeskVM.IsPerpMode}" Command="{Binding DexDeskVM.SelectModeCommand}" CommandParameter="PERP" />
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Classes="TdLabel" Text="QUOTE ASSET" />
                  <ComboBox ItemsSource="{Binding DexTradingVM.QuoteAssetOptions}" SelectedItem="{Binding DexTradingVM.SelectedQuoteAssetSymbol}" HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Spacing="6" IsEnabled="{Binding DexTradingVM.CanTradeSelectedToken}">
                  <TextBlock Classes="TdLabel" Text="{Binding DexTradingVM.BuyAmountLabel}" />
                  <NumericUpDown Value="{Binding DexTradingVM.BuyAmountBnb}" Increment="0.001" FormatString="0.0000" Minimum="0" />
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Content="25%"  Classes="TdSeg fill" Command="{Binding DexTradingVM.ApplyBuyBalancePresetCommand}" CommandParameter="25" />
                    <Button Grid.Column="1" Content="50%"  Classes="TdSeg fill" Command="{Binding DexTradingVM.ApplyBuyBalancePresetCommand}" CommandParameter="50" />
                    <Button Grid.Column="2" Content="75%"  Classes="TdSeg fill" Command="{Binding DexTradingVM.ApplyBuyBalancePresetCommand}" CommandParameter="75" />
                    <Button Grid.Column="3" Content="MAX"  Classes="TdSeg fill" Command="{Binding DexTradingVM.ApplyBuyBalancePresetCommand}" CommandParameter="100" />
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="6" IsEnabled="{Binding DexTradingVM.CanTradeSelectedToken}">
                  <TextBlock Classes="TdLabel" Text="SELL TOKENS" />
                  <NumericUpDown Value="{Binding DexTradingVM.SellAmountTokens}" Increment="1" FormatString="0.########" Minimum="0" />
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Content="25%"  Classes="TdSeg fill" Command="{Binding DexTradingVM.ApplySellBalancePresetCommand}" CommandParameter="25" />
                    <Button Grid.Column="1" Content="50%"  Classes="TdSeg fill" Command="{Binding DexTradingVM.ApplySellBalancePresetCommand}" CommandParameter="50" />
                    <Button Grid.Column="2" Content="75%"  Classes="TdSeg fill" Command="{Binding DexTradingVM.ApplySellBalancePresetCommand}" CommandParameter="75" />
                    <Button Grid.Column="3" Content="MAX"  Classes="TdSeg fill" Command="{Binding DexTradingVM.ApplySellBalancePresetCommand}" CommandParameter="100" />
                  </Grid>
                </StackPanel>

                <!-- Slippage tolerance (real) -->
                <Border Background="#07111a" BorderBrush="#111d29" BorderThickness="1" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="TdLabel" Text="SLIPPAGE TOLERANCE" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexTradingVM.SlippagePercent, StringFormat={}{0:0.##}%}" Foreground="#a855f7" FontWeight="Bold" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                      <Button Grid.Column="0" Content="0.1" Classes="TdSeg dex fill" Command="{Binding DexTradingVM.SelectSlippagePresetCommand}" CommandParameter="0.1" Classes.active="{Binding DexTradingVM.SlippagePresetKey, Converter={StaticResource StrEq}, ConverterParameter=0.1}" />
                      <Button Grid.Column="1" Content="0.5" Classes="TdSeg dex fill" Command="{Binding DexTradingVM.SelectSlippagePresetCommand}" CommandParameter="0.5" Classes.active="{Binding DexTradingVM.SlippagePresetKey, Converter={StaticResource StrEq}, ConverterParameter=0.5}" />
                      <Button Grid.Column="2" Content="1.0" Classes="TdSeg dex fill" Command="{Binding DexTradingVM.SelectSlippagePresetCommand}" CommandParameter="1.0" Classes.active="{Binding DexTradingVM.SlippagePresetKey, Converter={StaticResource StrEq}, ConverterParameter=1.0}" />
                      <Button Grid.Column="3" Content="3.0" Classes="TdSeg dex fill" Command="{Binding DexTradingVM.SelectSlippagePresetCommand}" CommandParameter="3.0" Classes.active="{Binding DexTradingVM.SlippagePresetKey, Converter={StaticResource StrEq}, ConverterParameter=3.0}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Gas priority -->
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="TdLabel" Text="GAS PRIORITY" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.SelectedGasTierGweiLabel}" Foreground="#f4b860" FontSize="10" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding DexDeskVM.GasTiers}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DexGasTierViewModel">
                        <Button Classes="TdSeg dex" Margin="0,0,4,0" Padding="0,5" CornerRadius="6"
                                Classes.active="{Binding IsSelected}"
                                Command="{Binding $parent[ItemsControl].DataContext.DexDeskVM.SelectGasTierCommand}"
                                CommandParameter="{Binding Key}">
                          <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding GweiLabel}" FontSize="9" Foreground="{DynamicResource TextSoft}" HorizontalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- MEV protection -->
                <Border Background="#07111a" BorderBrush="#111d29" BorderThickness="1" CornerRadius="8" Padding="10,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                      <TextBlock Classes="TdLabel" Text="MEV PROTECTION" />
                      <TextBlock Text="Flashbots / private mempool" Foreground="{DynamicResource TextDim}" FontSize="9" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding DexDeskVM.MevLabel}" Classes="TdSeg dex" Width="62" VerticalAlignment="Center"
                            Classes.active="{Binding DexDeskVM.MevProtectionEnabled}" Command="{Binding DexDeskVM.ToggleMevCommand}" />
                  </Grid>
                </Border>

                <!-- Swap preview -->
                <Border Background="#07111a" BorderBrush="#111d29" BorderThickness="1" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="TdLabel" Text="SWAP PREVIEW" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="#150a20" BorderBrush="#3a1f6e" BorderThickness="1" CornerRadius="4" Padding="6,1" IsVisible="{Binding DexTradingVM.HasAggQuote}">
                        <TextBlock Text="BEST ROUTE" Foreground="#a855f7" FontSize="9" FontWeight="Bold" />
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="Est. output" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexTradingVM.BuyQuoteLabel}" Foreground="{Binding DexTradingVM.BuyQuoteBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding DexTradingVM.HasAggQuote}">
                      <TextBlock Text="Aggregator out" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexTradingVM.AggOutputLabel}" Foreground="#21e6c1" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding DexTradingVM.HasAggQuote}">
                      <TextBlock Text="Price impact" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexTradingVM.AggImpactLabel}" Foreground="{Binding DexTradingVM.AggImpactBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding DexTradingVM.HasAggQuote}">
                      <TextBlock Text="Route via" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Text="{Binding DexTradingVM.AggRouteLabel}" Foreground="#a855f7" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="Route" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexTradingVM.SelectedTokenSubtitle}" Foreground="#a855f7" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Border Height="1" Background="#111d29" />
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="Slippage" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexTradingVM.SlippagePercent, StringFormat={}{0:0.##}%}" Foreground="#8fa3b8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Balances -->
                <Border Classes="TdCard">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="TdLabel" Text="TOKEN BALANCE" />
                      <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.TokenBalanceLabel}" Foreground="#21e6c1" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="TdLabel" Text="QUOTE BALANCE" />
                      <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.QuoteAssetBalanceLabel}" Foreground="#e8f4ff" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Best-route execution toggle -->
                <CheckBox IsChecked="{Binding DexTradingVM.UseBestRouteSwap}" Padding="6,0,0,0"
                          ToolTip.Tip="When on, BUY routes through the aggregator's best cross-DEX path (real build + sign + send). Falls back to the direct router if the chain/wallet can't route.">
                  <TextBlock Text="Execute BUY via best route (aggregator)" Foreground="#8fa3b8" FontSize="10" VerticalAlignment="Center" />
                </CheckBox>

                <!-- Execute -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <Button Grid.Column="0" Content="BUY TOKEN" Classes="TdPrimary dex" Height="46"
                          Command="{Binding DexTradingVM.BuyCommand}" IsEnabled="{Binding DexTradingVM.CanBuySelectedTokenLive}"
                          ToolTip.Tip="{Binding DexTradingVM.ManualBuyBlockedReason}" />
                  <Button Grid.Column="1" Content="SELL TOKEN" Classes="TdDanger" Height="46"
                          Command="{Binding DexTradingVM.SellCommand}" IsEnabled="{Binding DexTradingVM.CanSellSelectedTokenLive}"
                          ToolTip.Tip="{Binding DexTradingVM.ManualSellBlockedReason}" />
                </Grid>

                <StackPanel Spacing="4">
                  <TextBlock Classes="TdSub" Text="{Binding DexTradingVM.WalletTradeStatus}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DexTradingVM.StatusMessage}" Foreground="#14e0c1" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>

                <!-- Automated orders (keeper) -->
                <Border Background="#07111a" BorderBrush="#111d29" BorderThickness="1" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="7">
                    <TextBlock Classes="TdLabel" Text="AUTOMATED ORDERS (KEEPER)" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                      <Button Grid.Column="0" Content="LIMIT" Classes="TdSeg dex fill" Command="{Binding DexTradingVM.SelectKeeperOrderTypeCommand}" CommandParameter="Limit"    Classes.active="{Binding DexTradingVM.IsKeeperLimit}" />
                      <Button Grid.Column="1" Content="STOP"  Classes="TdSeg dex fill" Command="{Binding DexTradingVM.SelectKeeperOrderTypeCommand}" CommandParameter="Stop"     Classes.active="{Binding DexTradingVM.IsKeeperStop}" />
                      <Button Grid.Column="2" Content="TRAIL" Classes="TdSeg dex fill" Command="{Binding DexTradingVM.SelectKeeperOrderTypeCommand}" CommandParameter="Trailing" Classes.active="{Binding DexTradingVM.IsKeeperTrailing}" />
                      <Button Grid.Column="3" Content="DCA"   Classes="TdSeg dex fill" Command="{Binding DexTradingVM.SelectKeeperOrderTypeCommand}" CommandParameter="DCA"      Classes.active="{Binding DexTradingVM.IsKeeperDca}" />
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding DexTradingVM.KeeperNeedsTrigger}">
                      <TextBlock Classes="TdLabel" Text="TRIGGER PRICE (USD)" />
                      <NumericUpDown Value="{Binding DexTradingVM.KeeperTriggerPrice}" Increment="0.0001" FormatString="0.######" Minimum="0" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding DexTradingVM.IsKeeperTrailing}">
                      <TextBlock Classes="TdLabel" Text="TRAIL DISTANCE %" />
                      <NumericUpDown Value="{Binding DexTradingVM.KeeperTrailingPct}" Increment="0.5" FormatString="0.##" Minimum="0.1" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding DexTradingVM.IsKeeperDca}">
                      <StackPanel Spacing="4"><TextBlock Classes="TdLabel" Text="LEGS" /><NumericUpDown Value="{Binding DexTradingVM.KeeperDcaLegs}" Increment="1" FormatString="0" Minimum="2" Maximum="20" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="TdLabel" Text="STEP %" /><NumericUpDown Value="{Binding DexTradingVM.KeeperDcaStepPct}" Increment="0.5" FormatString="0.##" Minimum="0.1" /></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                      <Button Grid.Column="0" Content="ARM BUY"  Classes="TdSeg dex" Command="{Binding DexTradingVM.ArmKeeperOrderCommand}" CommandParameter="BUY" />
                      <Button Grid.Column="1" Content="ARM SELL" Classes="TdDanger" Padding="0,5" Command="{Binding DexTradingVM.ArmKeeperOrderCommand}" CommandParameter="SELL" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DexTradingVM.KeeperOrders}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DexKeeperOrderViewModel">
                          <Border Classes="TdCardTight" Margin="0,0,0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                              <TextBlock Text="{Binding TypeLabel}" Foreground="{Binding SideBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding TriggerLabel}" Foreground="#c8dcef" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding AmountLabel}" Foreground="#8fa3b8" FontSize="9" VerticalAlignment="Center" Margin="6,0" />
                              <Button Grid.Column="3" Content="✕" Classes="TdSeg mini" Command="{Binding $parent[ItemsControl].DataContext.DexTradingVM.CancelKeeperOrderCommand}" CommandParameter="{Binding Id}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DexTradingVM.KeeperStatus}" Foreground="#8fa3b8" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ─ PERP TICKET (paper engine) ─ -->
              <StackPanel Spacing="10" IsVisible="{Binding DexDeskVM.IsPerpMode}">

                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="TdH2" Text="PERP Ticket" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="TdDexBadge" VerticalAlignment="Center">
                    <TextBlock Text="PAPER" Foreground="#a855f7" FontSize="9" FontWeight="Bold" />
                  </Border>
                </Grid>

                <!-- Side -->
                <Border BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                  <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Content="BUY / LONG" Classes="TdSide buy" Classes.active="{Binding DexDeskVM.Perp.IsLong}"
                            Command="{Binding DexDeskVM.Perp.SelectSideCommand}" CommandParameter="Long" />
                    <Button Grid.Column="1" Content="SELL / SHORT" Classes="TdSide sell" Classes.active="{Binding DexDeskVM.Perp.IsShort}"
                            Command="{Binding DexDeskVM.Perp.SelectSideCommand}" CommandParameter="Short" />
                  </Grid>
                </Border>

                <StackPanel Spacing="5">
                  <TextBlock Classes="TdLabel" Text="DEX MODE" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Content="SWAP" Classes="TdSeg dex" Classes.active="{Binding DexDeskVM.IsSwapMode}" Command="{Binding DexDeskVM.SelectModeCommand}" CommandParameter="SWAP" />
                    <Button Grid.Column="1" Content="PERP" Classes="TdSeg dex" Classes.active="{Binding DexDeskVM.IsPerpMode}" Command="{Binding DexDeskVM.SelectModeCommand}" CommandParameter="PERP" />
                  </Grid>
                </StackPanel>

                <!-- Order type + margin mode -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Classes="TdLabel" Text="ORDER TYPE" />
                    <StackPanel Spacing="3">
                      <Button Content="MARKET" Classes="TdSeg dex left" Command="{Binding DexDeskVM.Perp.SelectOrderTypeCommand}" CommandParameter="Market" Classes.active="{Binding DexDeskVM.Perp.IsMarket}" />
                      <Button Content="LIMIT"  Classes="TdSeg dex left" Command="{Binding DexDeskVM.Perp.SelectOrderTypeCommand}" CommandParameter="Limit"  Classes.active="{Binding DexDeskVM.Perp.IsLimit}" />
                      <Button Content="STOP"   Classes="TdSeg dex left" Command="{Binding DexDeskVM.Perp.SelectOrderTypeCommand}" CommandParameter="Stop"   Classes.active="{Binding DexDeskVM.Perp.IsStop}" />
                      <Button Content="DCA"    Classes="TdSeg dex left" Command="{Binding DexDeskVM.Perp.SelectOrderTypeCommand}" CommandParameter="DCA"    Classes.active="{Binding DexDeskVM.Perp.IsDca}" />
                      <Button Content="GRID"   Classes="TdSeg dex left" Command="{Binding DexDeskVM.Perp.SelectOrderTypeCommand}" CommandParameter="Grid"   Classes.active="{Binding DexDeskVM.Perp.IsGrid}" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Classes="TdLabel" Text="MARGIN MODE" />
                    <StackPanel Spacing="3">
                      <Button Content="CROSS"    Classes="TdSeg left amber" Command="{Binding DexDeskVM.Perp.SelectMarginModeCommand}" CommandParameter="Cross"    Classes.active="{Binding DexDeskVM.Perp.IsCross}" />
                      <Button Content="ISOLATED" Classes="TdSeg left amber" Command="{Binding DexDeskVM.Perp.SelectMarginModeCommand}" CommandParameter="Isolated" Classes.active="{Binding DexDeskVM.Perp.IsIsolated}" />
                    </StackPanel>
                    <TextBlock Classes="TdLabel" Text="EST. MARGIN" Margin="0,4,0,0" />
                    <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Perp.EstMarginLabel}" Foreground="#a855f7" FontWeight="Bold" FontSize="12" />
                  </StackPanel>
                </Grid>

                <!-- Leverage -->
                <Border Classes="TdCard">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="TdLabel" Text="LEVERAGE" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.Perp.LeverageLabel}" Foreground="#f4b860" FontWeight="Bold" FontSize="12" />
                    </Grid>
                    <Slider Minimum="1" Maximum="125" Value="{Binding DexDeskVM.Perp.Leverage}" Classes="TradeSlider" />
                    <Grid ColumnDefinitions="*,*,*,*">
                      <TextBlock Grid.Column="0" Text="1×" Foreground="{DynamicResource TextDim}" FontSize="9" />
                      <TextBlock Grid.Column="1" Text="25×" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="50×" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="125×" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Right" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Size -->
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="TdLabel" Text="SIZE (TOKENS)" />
                    <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.Perp.NotionalLabel}" Foreground="#8fa3b8" FontSize="10" />
                  </Grid>
                  <NumericUpDown Value="{Binding DexDeskVM.Perp.SizeTokens}" Increment="0.1" FormatString="0.####" Minimum="0" />
                </StackPanel>

                <!-- Trigger price (limit / stop / dca) -->
                <StackPanel Spacing="5" IsVisible="{Binding DexDeskVM.Perp.NeedsTriggerPrice}">
                  <TextBlock Classes="TdLabel" Text="TRIGGER PRICE (USDT)" />
                  <NumericUpDown Value="{Binding DexDeskVM.Perp.TriggerPrice}" Increment="0.01" FormatString="0.######" Minimum="0" />
                </StackPanel>

                <!-- DCA params -->
                <Border Classes="TdCard" IsVisible="{Binding DexDeskVM.Perp.IsDca}">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="TdLabel" Text="LEGS" />
                      <NumericUpDown Value="{Binding DexDeskVM.Perp.DcaLegs}" Increment="1" FormatString="0" Minimum="2" Maximum="20" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Classes="TdLabel" Text="STEP %" />
                      <NumericUpDown Value="{Binding DexDeskVM.Perp.DcaStepPercent}" Increment="0.5" FormatString="0.##" Minimum="0.1" />
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Grid params -->
                <Border Classes="TdCard" IsVisible="{Binding DexDeskVM.Perp.IsGrid}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <StackPanel Spacing="5">
                        <TextBlock Classes="TdLabel" Text="LOWER" />
                        <NumericUpDown Value="{Binding DexDeskVM.Perp.GridLower}" Increment="0.01" FormatString="0.######" Minimum="0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Classes="TdLabel" Text="UPPER" />
                        <NumericUpDown Value="{Binding DexDeskVM.Perp.GridUpper}" Increment="0.01" FormatString="0.######" Minimum="0" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                      <TextBlock Classes="TdLabel" Text="GRID LEVELS" />
                      <NumericUpDown Value="{Binding DexDeskVM.Perp.GridLevels}" Increment="1" FormatString="0" Minimum="2" Maximum="50" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- TP / SL -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Classes="TdLabel" Text="TAKE PROFIT" />
                    <NumericUpDown Value="{Binding DexDeskVM.Perp.TakeProfit}" Increment="0.01" FormatString="0.######" Minimum="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Classes="TdLabel" Text="STOP LOSS" />
                    <NumericUpDown Value="{Binding DexDeskVM.Perp.StopLoss}" Increment="0.01" FormatString="0.######" Minimum="0" />
                  </StackPanel>
                </Grid>

                <!-- Protocol / telemetry -->
                <Border Background="#07111a" BorderBrush="#111d29" BorderThickness="1" CornerRadius="9" Padding="10">
                  <StackPanel Spacing="7">
                    <TextBlock Classes="TdLabel" Text="PROTOCOL INFO (PAPER)" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Mark" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.Perp.MarkPriceLabel}" Foreground="#21e6c1" FontSize="10" FontWeight="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Funding" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.Perp.FundingRateLabel}" Foreground="{Binding DexDeskVM.Perp.FundingBrush}" FontSize="10" FontWeight="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Settlement" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.Perp.SettlementLabel}" Foreground="#8fa3b8" FontSize="10" FontWeight="Bold" />
                    </Grid>
                    <Border Height="1" Background="#111d29" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Est. liquidation" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.Perp.LiquidationLabel}" Foreground="#ff6b6b" FontSize="10" FontWeight="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Equity" Foreground="{DynamicResource TextDim}" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.Perp.EquityLabel}" Foreground="#c8dcef" FontSize="10" FontWeight="Bold" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- PAPER / LIVE mode toggle (LIVE routes Market/Limit to real Hyperliquid) -->
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding DexDeskVM.Perp.SupportsLiveTrading}">
                  <Border Background="#0a1622" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DexDeskVM.Perp.ModeBadge}"
                               Foreground="{Binding DexDeskVM.Perp.ModeBadgeBrush}" FontWeight="Bold" FontSize="11" />
                  </Border>
                  <Button Grid.Column="2" Classes="TdSeg dex" Padding="10,5"
                          Command="{Binding DexDeskVM.Perp.ToggleLiveTradingCommand}"
                          Content="PAPER / LIVE" FontSize="10" FontWeight="Bold" />
                </Grid>

                <!-- Place -->
                <Button Command="{Binding DexDeskVM.Perp.PlaceOrderCommand}" Classes="TdPrimary dex" Height="48"
                        Content="{Binding DexDeskVM.Perp.PlaceButtonText}" FontWeight="Bold" FontSize="13" />

                <!-- Manage open position -->
                <Border Classes="TdCard" IsVisible="{Binding DexDeskVM.Perp.HasPosition}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="TdLabel" Text="MANAGE POSITION" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.Perp.RoeLabel}" Foreground="{Binding DexDeskVM.Perp.UpnlBrush}" FontWeight="Bold" FontSize="11" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                      <Button Grid.Column="0" Content="CLOSE 25%" Classes="TdSeg fill" Command="{Binding DexDeskVM.Perp.ClosePartialCommand}" CommandParameter="25" />
                      <Button Grid.Column="1" Content="50%" Classes="TdSeg fill" Command="{Binding DexDeskVM.Perp.ClosePartialCommand}" CommandParameter="50" />
                      <Button Grid.Column="2" Content="75%" Classes="TdSeg fill" Command="{Binding DexDeskVM.Perp.ClosePartialCommand}" CommandParameter="75" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <NumericUpDown Value="{Binding DexDeskVM.Perp.TrailingDistance}" Increment="0.01" FormatString="0.####" Minimum="0" />
                      <Button Grid.Column="1" Content="ARM TRAIL" Classes="TdSeg dex" Command="{Binding DexDeskVM.Perp.ArmTrailingCommand}" VerticalAlignment="Center" Padding="8,5" />
                      <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding DexDeskVM.Perp.TrailingStopLabel}" Foreground="#f4b860" FontSize="10" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <Button Grid.Column="0" Content="REVERSE" Classes="TdSeg dex" Command="{Binding DexDeskVM.Perp.ReverseCommand}" />
                      <Button Grid.Column="1" Content="CLOSE" Classes="TdDanger" Padding="0,6" Command="{Binding DexDeskVM.Perp.CloseCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <TextBlock Text="Funding in" Foreground="{DynamicResource TextDim}" FontSize="9" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexDeskVM.Perp.FundingCountdownLabel}" Foreground="#8fa3b8" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="Funding paid" Foreground="{DynamicResource TextDim}" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBlock Grid.Column="3" Classes="TdNum" Text="{Binding DexDeskVM.Perp.FundingPaidLabel}" Foreground="#f4b860" FontSize="9" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding DexDeskVM.Perp.StatusMessage}" Foreground="#a855f7" TextWrapping="Wrap" FontSize="11" />
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <Border Grid.Column="1" Background="#0d1b27" />

          <!-- ══ CENTER ══ -->
          <Grid Grid.Column="2" RowDefinitions="Auto,*">

            <Border Grid.Row="0" Background="#050c14" BorderBrush="#0d1b27" BorderThickness="0,0,0,1" Padding="14,10">
              <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="28">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="TdLabel" Text="PRICE USD" />
                    <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.SelectedToken.PriceUsd, StringFormat=\$ {0:N6}}" Foreground="#a855f7" FontWeight="Bold" FontSize="17" />
                  </StackPanel>
                  <StackPanel Spacing="3">
                    <TextBlock Classes="TdLabel" Text="LIQUIDITY" />
                    <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexLiquidityLabel}" Foreground="#c8dcef" FontSize="15" />
                  </StackPanel>
                  <StackPanel Spacing="3">
                    <TextBlock Classes="TdLabel" Text="HIGH" />
                    <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.ChartHighLabel}" Foreground="#4ff1c9" FontSize="15" />
                  </StackPanel>
                  <StackPanel Spacing="3">
                    <TextBlock Classes="TdLabel" Text="LOW" />
                    <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.ChartLowLabel}" Foreground="#ff7b7b" FontSize="15" />
                  </StackPanel>
                  <StackPanel Spacing="3">
                    <TextBlock Classes="TdLabel" Text="VOL 24H" />
                    <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexVolume24hLabel}" Foreground="#c8dcef" FontSize="15" />
                  </StackPanel>
                  <StackPanel Spacing="3">
                    <TextBlock Classes="TdLabel" Text="CHANGE" />
                    <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.ChartChangePctLabel}" Foreground="{Binding DexTradingVM.ChartChangePctBrush}" FontSize="15" FontWeight="Bold" />
                  </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                    <Button Content="15M" Classes="TdSeg dex mini" Command="{Binding DexTradingVM.SelectChartRangeCommand}" CommandParameter="15M" Classes.active="{Binding DexTradingVM.SelectedChartRange, Converter={StaticResource StrEq}, ConverterParameter=15M}" />
                    <Button Content="1H"  Classes="TdSeg dex mini" Command="{Binding DexTradingVM.SelectChartRangeCommand}" CommandParameter="1H"  Classes.active="{Binding DexTradingVM.SelectedChartRange, Converter={StaticResource StrEq}, ConverterParameter=1H}" />
                    <Button Content="4H"  Classes="TdSeg dex mini" Command="{Binding DexTradingVM.SelectChartRangeCommand}" CommandParameter="4H"  Classes.active="{Binding DexTradingVM.SelectedChartRange, Converter={StaticResource StrEq}, ConverterParameter=4H}" />
                    <Button Content="1D"  Classes="TdSeg dex mini" Command="{Binding DexTradingVM.SelectChartRangeCommand}" CommandParameter="1D"  Classes.active="{Binding DexTradingVM.SelectedChartRange, Converter={StaticResource StrEq}, ConverterParameter=1D}" />
                    <Button Content="1W"  Classes="TdSeg dex mini" Command="{Binding DexTradingVM.SelectChartRangeCommand}" CommandParameter="1W"  Classes.active="{Binding DexTradingVM.SelectedChartRange, Converter={StaticResource StrEq}, ConverterParameter=1W}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="TdSub" Text="{Binding DexTradingVM.ChartSource}" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>

                <!-- Indicators -->
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="TdLabel" Text="IND" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <Button Content="MA20" Classes="TdSeg dex mini" Command="{Binding DexTradingVM.ToggleDexIndicatorCommand}" CommandParameter="MA20" Classes.active="{Binding DexTradingVM.ShowDexMa20}" />
                  <Button Content="MA50" Classes="TdSeg dex mini" Command="{Binding DexTradingVM.ToggleDexIndicatorCommand}" CommandParameter="MA50" Classes.active="{Binding DexTradingVM.ShowDexMa50}" />
                  <Button Content="BB"   Classes="TdSeg dex mini" Command="{Binding DexTradingVM.ToggleDexIndicatorCommand}" CommandParameter="BB"   Classes.active="{Binding DexTradingVM.ShowDexBollinger}" />
                  <Button Content="RSI"  Classes="TdSeg dex mini" Command="{Binding DexTradingVM.ToggleDexIndicatorCommand}" CommandParameter="RSI"  Classes.active="{Binding DexTradingVM.ShowDexRsi}" />
                  <Button Content="VWAP" Classes="TdSeg dex mini" Command="{Binding DexTradingVM.ToggleDexIndicatorCommand}" CommandParameter="VWAP" Classes.active="{Binding DexTradingVM.ShowDexVwap}" />
                </StackPanel>

                <Border Background="#040c14" BorderBrush="#111d29" BorderThickness="1" CornerRadius="8" Padding="6">
                  <ctrl:CexCandlestickChart Height="320" Candles="{Binding DexTradingVM.ChartCandles}"
                                            ShowMa20="{Binding DexTradingVM.ShowDexMa20}"
                                            ShowMa50="{Binding DexTradingVM.ShowDexMa50}"
                                            ShowBollinger="{Binding DexTradingVM.ShowDexBollinger}"
                                            ShowRsi="{Binding DexTradingVM.ShowDexRsi}"
                                            ShowVwap="{Binding DexTradingVM.ShowDexVwap}"
                                            PersistenceKey="{Binding DexTradingVM.SelectedToken.TokenAddress}" />
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Classes="TdSub" Text="{Binding DexTradingVM.ChartStatusMessage}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding DexTradingVM.ChartTelemetry}" Foreground="{DynamicResource TextSoft}" TextAlignment="Right" FontSize="10" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Blotter -->
            <Border Grid.Row="1" Background="#050c14" Padding="14,10">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="{Binding DexDeskVM.IsSwapMode}">
                    <TextBlock Classes="TdLabel" Text="TRADES" />
                    <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.RecentDexTrades.Count}" Foreground="#a855f7" FontWeight="Bold" FontSize="11" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="{Binding DexDeskVM.IsPerpMode}">
                    <TextBlock Classes="TdLabel" Text="EQUITY" />
                    <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Perp.EquityLabel}" Foreground="#a855f7" FontWeight="Bold" FontSize="11" />
                    <TextBlock Classes="TdLabel" Text="  PnL" />
                    <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Perp.RealizedPnlLabel}" Foreground="{Binding DexDeskVM.Perp.RealizedPnlBrush}" FontWeight="Bold" FontSize="11" />
                  </StackPanel>
                </StackPanel>

                <!-- SWAP blotter -->
                <TabControl Classes="DeskTabs" IsVisible="{Binding DexDeskVM.IsSwapMode}">
                  <TabItem Header="Trades">
                    <StackPanel Margin="0,12,0,0" Spacing="10">
                      <Grid ColumnDefinitions="0.6*,1.2*,0.7*,0.8*,0.6*,0.7*" ColumnSpacing="10">
                        <TextBlock Classes="TdLabel" Text="SIDE" />
                        <TextBlock Grid.Column="1" Classes="TdLabel" Text="SYMBOL" />
                        <TextBlock Grid.Column="2" Classes="TdLabel" Text="AMOUNT" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Classes="TdLabel" Text="PRICE" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="TdLabel" Text="STATUS" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Classes="TdLabel" Text="TIME" HorizontalAlignment="Right" />
                      </Grid>
                      <ScrollViewer MaxHeight="220">
                        <ItemsControl ItemsSource="{Binding DexTradingVM.RecentDexTrades}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DexTradeRecordViewModel">
                              <Border Classes="TdCardTight" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="0.6*,1.2*,0.7*,0.8*,0.6*,0.7*" ColumnSpacing="10">
                                  <TextBlock Text="{Binding SideLabel}" Foreground="{Binding SideBrush}" FontWeight="Bold" />
                                  <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="#c8dcef" />
                                  <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding AmountLabel}" HorizontalAlignment="Right" />
                                  <TextBlock Grid.Column="3" Classes="TdNum" Text="{Binding PriceLabel}" HorizontalAlignment="Right" />
                                  <TextBlock Grid.Column="4" Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" HorizontalAlignment="Center" FontSize="11" />
                                  <TextBlock Grid.Column="5" Classes="TdNum" Text="{Binding TimeLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSoft}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="No trades yet. Execute a buy or sell to populate the blotter."
                                 Foreground="{DynamicResource TextSoft}" IsVisible="{Binding DexTradingVM.ShowDexTradesPlaceholder}" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="Wallet">
                    <StackPanel Margin="0,12,0,0" Spacing="10">
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Classes="TdCard">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="TdLabel" Text="QUOTE MODE" />
                            <TextBlock Text="{Binding DexTradingVM.QuoteAssetModeLabel}" Foreground="{Binding DexTradingVM.QuoteAssetModeBrush}" FontWeight="Bold" />
                            <TextBlock Classes="TdSub" Text="{Binding DexTradingVM.QuoteAssetSummary}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="TdCard">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="TdLabel" Text="SPENDABLE" />
                            <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.SpendableQuoteBalanceLabel}" FontWeight="Bold" Foreground="#21e6c1" TextWrapping="Wrap" />
                            <TextBlock Classes="TdSub" Text="{Binding DexTradingVM.QuoteAssetBalanceLabel}" />
                          </StackPanel>
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding DexTradingVM.BuyAvailabilityMessage}" Foreground="{Binding DexTradingVM.BuyAvailabilityBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="Chart Info">
                    <StackPanel Margin="0,12,0,0" Spacing="8">
                      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Classes="TdCard">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="TdLabel" Text="RANGE START" />
                            <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.ChartStartLabel}" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="TdCard">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="TdLabel" Text="RANGE END" />
                            <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.ChartEndLabel}" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="TdCard">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="TdLabel" Text="CHANGE" />
                            <TextBlock Text="{Binding DexTradingVM.ChartChangePctLabel}" Foreground="{Binding DexTradingVM.ChartChangePctBrush}" FontWeight="Bold" />
                          </StackPanel>
                        </Border>
                      </Grid>
                      <TextBlock Classes="TdSub" Text="{Binding DexTradingVM.ChartDiagnostics}" TextWrapping="Wrap" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="Token">
                    <views:DexTokenProfileView DataContext="{Binding DexTradingVM}" />
                  </TabItem>
                  <TabItem Header="Flow">
                    <views:DexMarketFlowView DataContext="{Binding DexTradingVM}" />
                  </TabItem>
                  <TabItem Header="Portfolio">
                    <views:DexPortfolioView DataContext="{Binding DexTradingVM}" />
                  </TabItem>
                </TabControl>

                <!-- PERP blotter (paper) -->
                <TabControl Classes="DeskTabs" IsVisible="{Binding DexDeskVM.IsPerpMode}">
                  <TabItem Header="Positions">
                    <StackPanel Margin="0,12,0,0" Spacing="10">
                      <Grid ColumnDefinitions="0.9*,0.6*,0.7*,0.8*,0.8*,0.8*,0.7*,0.6*" ColumnSpacing="10">
                        <TextBlock Classes="TdLabel" Text="SYMBOL" />
                        <TextBlock Grid.Column="1" Classes="TdLabel" Text="SIDE" />
                        <TextBlock Grid.Column="2" Classes="TdLabel" Text="SIZE" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Classes="TdLabel" Text="ENTRY" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="TdLabel" Text="MARK" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Classes="TdLabel" Text="LIQ" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Classes="TdLabel" Text="UPNL" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Classes="TdLabel" Text="ROE" HorizontalAlignment="Right" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding DexDeskVM.Perp.Positions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DexPerpPositionRowViewModel">
                            <Border Classes="TdCardTight" Margin="0,0,0,6">
                              <Grid ColumnDefinitions="0.9*,0.6*,0.7*,0.8*,0.8*,0.8*,0.7*,0.6*" ColumnSpacing="10">
                                <TextBlock Text="{Binding Symbol}" Foreground="#c8dcef" />
                                <TextBlock Grid.Column="1" Text="{Binding SideLabel}" Foreground="{Binding SideBrush}" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding SizeLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Classes="TdNum" Text="{Binding EntryLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Classes="TdNum" Text="{Binding MarkLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Classes="TdNum" Text="{Binding LiqLabel}" HorizontalAlignment="Right" Foreground="#ff6b6b" />
                                <TextBlock Grid.Column="6" Classes="TdNum" Text="{Binding UpnlLabel}" HorizontalAlignment="Right" Foreground="{Binding UpnlBrush}" />
                                <TextBlock Grid.Column="7" Classes="TdNum" Text="{Binding RoeLabel}" HorizontalAlignment="Right" Foreground="{Binding UpnlBrush}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="No open paper position. Arm an order to simulate one."
                                 Foreground="{DynamicResource TextSoft}" IsVisible="{Binding DexDeskVM.Perp.ShowPositionsPlaceholder}" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="Orders">
                    <StackPanel Margin="0,12,0,0" Spacing="10">
                      <Grid ColumnDefinitions="0.6*,0.6*,0.7*,0.9*,0.7*,0.7*,0.5*" ColumnSpacing="10">
                        <TextBlock Classes="TdLabel" Text="ID" />
                        <TextBlock Grid.Column="1" Classes="TdLabel" Text="SIDE" />
                        <TextBlock Grid.Column="2" Classes="TdLabel" Text="TYPE" />
                        <TextBlock Grid.Column="3" Classes="TdLabel" Text="TRIGGER" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="TdLabel" Text="SIZE" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Classes="TdLabel" Text="STATUS" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Classes="TdLabel" Text="" />
                      </Grid>
                      <ScrollViewer MaxHeight="220">
                        <ItemsControl ItemsSource="{Binding DexDeskVM.Perp.Orders}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DexPerpOrderRowViewModel">
                              <Border Classes="TdCardTight" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="0.6*,0.6*,0.7*,0.9*,0.7*,0.7*,0.5*" ColumnSpacing="10">
                                  <TextBlock Classes="TdNum" Text="{Binding Id}" Foreground="{DynamicResource TextSoft}" />
                                  <TextBlock Grid.Column="1" Text="{Binding SideLabel}" Foreground="{Binding SideBrush}" FontWeight="Bold" />
                                  <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" Foreground="#a855f7" />
                                  <TextBlock Grid.Column="3" Classes="TdNum" Text="{Binding TriggerLabel}" HorizontalAlignment="Right" />
                                  <TextBlock Grid.Column="4" Classes="TdNum" Text="{Binding SizeLabel}" HorizontalAlignment="Right" />
                                  <TextBlock Grid.Column="5" Text="{Binding StatusLabel}" Foreground="#f4b860" HorizontalAlignment="Center" FontSize="11" />
                                  <Button Grid.Column="6" Content="✕" Classes="TdSeg mini" Command="{Binding $parent[ItemsControl].DataContext.DexDeskVM.Perp.CancelOrderCommand}" CommandParameter="{Binding Id}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="No working orders. Arm a limit, stop, DCA or grid to populate the blotter."
                                 Foreground="{DynamicResource TextSoft}" IsVisible="{Binding DexDeskVM.Perp.ShowOrdersPlaceholder}" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="Fills">
                    <StackPanel Margin="0,12,0,0" Spacing="10">
                      <Grid ColumnDefinitions="0.7*,0.9*,0.8*,0.7*,0.7*" ColumnSpacing="10">
                        <TextBlock Classes="TdLabel" Text="SIDE" />
                        <TextBlock Grid.Column="1" Classes="TdLabel" Text="KIND" />
                        <TextBlock Grid.Column="2" Classes="TdLabel" Text="PRICE" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Classes="TdLabel" Text="SIZE" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="TdLabel" Text="TIME" HorizontalAlignment="Right" />
                      </Grid>
                      <ScrollViewer MaxHeight="220">
                        <ItemsControl ItemsSource="{Binding DexDeskVM.Perp.FillsRows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DexPerpFillRowViewModel">
                              <Border Classes="TdCardTight" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="0.7*,0.9*,0.8*,0.7*,0.7*" ColumnSpacing="10">
                                  <TextBlock Text="{Binding SideLabel}" Foreground="{Binding SideBrush}" FontWeight="Bold" />
                                  <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Foreground="{Binding KindBrush}" />
                                  <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding PriceLabel}" HorizontalAlignment="Right" />
                                  <TextBlock Grid.Column="3" Classes="TdNum" Text="{Binding SizeLabel}" HorizontalAlignment="Right" />
                                  <TextBlock Grid.Column="4" Classes="TdNum" Text="{Binding TimeLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSoft}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="No fills yet. Paper executions will appear here."
                                 Foreground="{DynamicResource TextSoft}" IsVisible="{Binding DexDeskVM.Perp.ShowFillsPlaceholder}" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="Token">
                    <views:DexTokenProfileView DataContext="{Binding DexTradingVM}" />
                  </TabItem>
                  <TabItem Header="Flow">
                    <views:DexMarketFlowView DataContext="{Binding DexTradingVM}" />
                  </TabItem>
                  <TabItem Header="Portfolio">
                    <views:DexPortfolioView DataContext="{Binding DexTradingVM}" />
                  </TabItem>
                  <TabItem Header="Live Acct">
                    <views:DexLivePerpAccountView DataContext="{Binding DexTradingVM}" />
                  </TabItem>
                </TabControl>
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Column="3" Background="#0d1b27" />

          <!-- ══ RIGHT RAIL: MARKET (swap) / ORDER BOOK (perp) ══ -->
          <ScrollViewer Grid.Column="4" Background="#050c14" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0">

              <!-- ══ EXCHANGE TABS (CEX-style venue switcher) ══ -->
              <ItemsControl ItemsSource="{Binding DexDeskVM.Exchanges}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DexExchangeViewModel">
                    <Button Command="{Binding $parent[ItemsControl].DataContext.DexDeskVM.SelectExchangeCommand}"
                            CommandParameter="{Binding Key}"
                            Background="{Binding TabBackground}" BorderBrush="{Binding TabBorderBrush}"
                            BorderThickness="0,0,0,2" CornerRadius="0" Padding="2,7" HorizontalAlignment="Stretch"
                            ToolTip.Tip="{Binding Settlement}">
                      <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                          <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" Foreground="{Binding TabNameBrush}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="TdNum" Text="{Binding Vol}" Foreground="{DynamicResource TextSoft}" FontSize="9" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Height="1" Background="#0d1b27" />

              <!-- ══ rail content (margined) ══ -->
              <StackPanel Margin="12" Spacing="12">
                <TextBlock Classes="TdH2" Text="DEX Market" IsVisible="{Binding DexDeskVM.IsSwapMode}" />
                <TextBlock Classes="TdH2" Text="Order Book · Position" IsVisible="{Binding DexDeskVM.IsPerpMode}" />

                <!-- Selected exchange: live feed badge + stats + markets -->
                <Border Background="#0a0616" BorderBrush="#3a1f6e" BorderThickness="1" CornerRadius="8" Padding="8">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding DexDeskVM.SelectedExchangeName}" Foreground="#e8f4ff" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="#07221a" BorderBrush="#0e3a2a" BorderThickness="1" CornerRadius="999" Padding="7,1">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Ellipse Width="5" Height="5" Fill="#3ddc84" VerticalAlignment="Center" IsVisible="{Binding DexDeskVM.SelectedExchangeIsLive}" />
                          <TextBlock Text="{Binding DexDeskVM.SelectedExchangeFeedLabel}" Foreground="#3ddc84" FontSize="9" FontWeight="Bold" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                      <StackPanel Spacing="1">
                        <TextBlock Text="CHAIN" Foreground="{DynamicResource TextDim}" FontSize="9" />
                        <TextBlock Text="{Binding DexDeskVM.SelectedExchangeChainBadge}" Foreground="#a855f7" FontSize="9" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="FEE" Foreground="{DynamicResource TextDim}" FontSize="9" />
                        <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.SelectedExchangeFee}" Foreground="#f4b860" FontSize="9" FontWeight="Bold" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="1">
                        <TextBlock Text="FUNDING" Foreground="{DynamicResource TextDim}" FontSize="9" />
                        <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.SelectedExchangeFunding}" Foreground="#21e6c1" FontSize="9" FontWeight="Bold" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Spacing="1">
                        <TextBlock Text="MAX LEV" Foreground="{DynamicResource TextDim}" FontSize="9" />
                        <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.SelectedExchangeMaxLev}" Foreground="#c8dcef" FontSize="9" FontWeight="Bold" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding DexDeskVM.SelectedExchangeSettlement}" Foreground="{DynamicResource TextSoft}" FontSize="9" />

                    <!-- Live markets from the selected exchange -->
                    <StackPanel Spacing="3" IsVisible="{Binding DexDeskVM.ShowExchangeMarkets}">
                      <Border Height="1" Background="#0d1b27" />
                      <Grid ColumnDefinitions="1.1*,1.2*,0.9*,1*" Margin="2,0">
                        <TextBlock Text="MARKET" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="PRICE" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="24H" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="FUND" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding DexDeskVM.ExchangeMarkets}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DexExchangeMarketViewModel">
                            <Grid ColumnDefinitions="1.1*,1.2*,0.9*,1*" Height="16" Margin="2,0">
                              <TextBlock Text="{Binding Symbol}" Foreground="#c8dcef" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding PriceLabel}" Foreground="#8fa3b8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding ChangeLabel}" Foreground="{Binding ChangeBrush}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3" Classes="TdNum" Text="{Binding FundingLabel}" Foreground="{Binding FundingBrush}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>

              <!-- ── Exchange info strip (chain badge · 24h vol · fee) ── -->
              <Border Background="#07111a" BorderBrush="#152535" BorderThickness="1" CornerRadius="8" Padding="10,7" IsVisible="{Binding DexTradingVM.HasSelectedToken}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#3ddc84" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DexTradingVM.DexProtocolLabel}" Foreground="#e8f4ff" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                    <Border Background="#150a20" BorderBrush="#3a1f6e" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DexTradingVM.DexChainBadge}" Foreground="#a855f7" FontSize="9" FontWeight="Bold" />
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="24H Vol" Foreground="{DynamicResource TextDim}" FontSize="9" VerticalAlignment="Center" />
                      <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexVolume24hLabel}" Foreground="#8fa3b8" FontSize="10" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Fee" Foreground="{DynamicResource TextDim}" FontSize="9" VerticalAlignment="Center" />
                      <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexPairFeeLabel}" Foreground="#f4b860" FontSize="10" FontWeight="Bold" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- ── POSITION + AI (PERP) ── -->
              <Border Background="#050c14" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="8" IsVisible="{Binding DexDeskVM.IsPerpMode}">
                <Grid ColumnDefinitions="*,1,*">
                  <!-- Position -->
                  <StackPanel Grid.Column="0" Margin="10,8" Spacing="5">
                    <TextBlock Classes="TdLabel" Text="POSITION" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding DexDeskVM.Perp.PositionSideLabel}" Foreground="{Binding DexDeskVM.Perp.PositionSideBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DexDeskVM.Perp.LeverageLabel}" Foreground="{DynamicResource TextDim}" FontSize="9" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                      <StackPanel Spacing="1">
                        <TextBlock Text="Entry" Foreground="{DynamicResource TextDim}" FontSize="9" />
                        <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Perp.EntryLabel}" Foreground="#8fa3b8" FontWeight="Bold" FontSize="10" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="uPnL" Foreground="{DynamicResource TextDim}" FontSize="9" />
                        <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Perp.UpnlLabel}" Foreground="{Binding DexDeskVM.Perp.UpnlBrush}" FontWeight="Bold" FontSize="11" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                      <Button Grid.Column="0" Content="REVERSE" Classes="TdSeg mini" Command="{Binding DexDeskVM.Perp.ReverseCommand}" IsEnabled="{Binding DexDeskVM.Perp.HasPosition}" />
                      <Button Grid.Column="1" Content="CLOSE" Classes="TdDanger" FontSize="9" Padding="0,4" Command="{Binding DexDeskVM.Perp.CloseCommand}" IsEnabled="{Binding DexDeskVM.Perp.HasPosition}" />
                    </Grid>
                  </StackPanel>
                  <Border Grid.Column="1" Background="#0d1b27" />
                  <!-- AI signal -->
                  <StackPanel Grid.Column="2" Margin="10,8" Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="TdLabel" Text="AI SIGNAL" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="#0a1622" CornerRadius="4" Padding="7,1">
                        <TextBlock Text="{Binding DexDeskVM.Assistant.BiasLabel}" Foreground="{Binding DexDeskVM.Assistant.BiasBrush}" FontWeight="Bold" FontSize="10" />
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
                      <Border Grid.Column="0" Background="#07111a" CornerRadius="4" Padding="4,3">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                          <TextBlock Text="ENTRY" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                          <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Assistant.EntryLabel}" Foreground="#c8dcef" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Background="#061e14" CornerRadius="4" Padding="4,3">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                          <TextBlock Text="TP" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                          <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Assistant.TakeProfitLabel}" Foreground="#3ddc84" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Background="#200a0a" CornerRadius="4" Padding="4,3">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                          <TextBlock Text="SL" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Center" />
                          <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Assistant.StopLossLabel}" Foreground="#ff8080" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- ── DEX SWAP: Pool info panel ── -->
              <Border Background="#050c14" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="8" IsVisible="{Binding DexDeskVM.IsSwapMode}" ClipToBounds="True">
                <StackPanel>
                  <Grid ColumnDefinitions="*,*,*,*">
                    <StackPanel Margin="9,7" Spacing="3">
                      <TextBlock Text="TVL" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" />
                      <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexLiquidityLabel}" Foreground="#21e6c1" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="9,7" Spacing="3">
                      <TextBlock Text="24H VOL" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" />
                      <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexVolume24hLabel}" Foreground="#c8dcef" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="9,7" Spacing="3">
                      <TextBlock Text="MKT CAP" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" />
                      <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexMarketCapLabel}" Foreground="#a855f7" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="9,7" Spacing="3">
                      <TextBlock Text="24H FEES" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" />
                      <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexFees24hLabel}" Foreground="#f4b860" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                  </Grid>

                  <Border Height="1" Background="#0d1b27" />

                  <!-- Fee tiers -->
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,8" VerticalAlignment="Center">
                    <TextBlock Text="FEE TIERS" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Background="#150a20" BorderBrush="#6a2a9a" BorderThickness="1" CornerRadius="4" Padding="8,2">
                      <TextBlock Text="0.30%" Foreground="#a855f7" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <Border Background="#07111a" BorderBrush="#1e3248" BorderThickness="1" CornerRadius="4" Padding="8,2">
                      <TextBlock Text="0.01%" Foreground="{DynamicResource TextSoft}" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <Border Background="#07111a" BorderBrush="#1e3248" BorderThickness="1" CornerRadius="4" Padding="8,2">
                      <TextBlock Text="0.05%" Foreground="{DynamicResource TextSoft}" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <Border Background="#07111a" BorderBrush="#1e3248" BorderThickness="1" CornerRadius="4" Padding="8,2">
                      <TextBlock Text="1.00%" Foreground="{DynamicResource TextSoft}" FontSize="9" FontWeight="Bold" />
                    </Border>
                  </StackPanel>

                  <Border Height="1" Background="#0d1b27" />

                  <!-- Liquidity depth (representative, scaled to real utilization) -->
                  <StackPanel Margin="12,8" Spacing="6">
                    <TextBlock Text="LIQUIDITY DEPTH" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" />
                    <Border Height="34" Background="#040c14" BorderBrush="#111d29" BorderThickness="1" CornerRadius="6" Padding="6" ClipToBounds="True">
                      <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*" VerticalAlignment="Bottom">
                        <Border Grid.Column="0" Height="8"  Background="#123ddc84" CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom" />
                        <Border Grid.Column="1" Height="13" Background="#1e3ddc84" CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom" />
                        <Border Grid.Column="2" Height="19" Background="#2a3ddc84" CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom" />
                        <Border Grid.Column="3" Height="22" Background="#3ddc84"  CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom" />
                        <Border Grid.Column="4" Height="22" Background="#a855f7"  CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom" />
                        <Border Grid.Column="5" Height="22" Background="#ff6b6b"  CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom" />
                        <Border Grid.Column="6" Height="19" Background="#2aff6b6b" CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom" />
                        <Border Grid.Column="7" Height="13" Background="#1eff6b6b" CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom" />
                        <Border Grid.Column="8" Height="8"  Background="#12ff6b6b" CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom" />
                      </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*,*">
                      <StackPanel Spacing="1">
                        <TextBlock Text="UTILIZATION" Foreground="{DynamicResource TextDim}" FontSize="9" />
                        <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexUtilizationLabel}" Foreground="#3ddc84" FontWeight="Bold" FontSize="11" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="24H CHG" Foreground="{DynamicResource TextDim}" FontSize="9" />
                        <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.DexChange24hLabel}" Foreground="{Binding DexTradingVM.DexChange24hBrush}" FontWeight="Bold" FontSize="11" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="1">
                        <TextBlock Text="PRICE" Foreground="{DynamicResource TextDim}" FontSize="9" />
                        <TextBlock Classes="TdNum" Text="{Binding DexTradingVM.SelectedToken.PriceUsd, StringFormat=\$ {0:N6}}" Foreground="#a855f7" FontWeight="Bold" FontSize="11" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- ── REGULAR ORDER BOOK (PERP) ── -->
              <StackPanel Spacing="0" IsVisible="{Binding DexDeskVM.IsPerpMode}">
                <Grid ColumnDefinitions="1*,1*,1.1*" Margin="2,2">
                  <TextBlock Text="TOTAL" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="SIZE" Foreground="{DynamicResource TextDim}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="ASK PRICE" Foreground="#ff8080" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding DexDeskVM.Perp.AskLevels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DexPerpBookRowViewModel">
                      <Grid Height="15">
                        <Rectangle Fill="{Binding DepthBrush}" Width="{Binding DepthWidth}" HorizontalAlignment="Right" />
                        <Grid ColumnDefinitions="1*,1*,1.1*">
                          <TextBlock Classes="TdNum" Text="{Binding CumulativeLabel}" Foreground="#4a6070" FontSize="10" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding SizeLabel}" Foreground="#8fa3b8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding PriceLabel}" Foreground="{Binding PriceBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="#060e16" BorderBrush="#0d1b27" BorderThickness="0,1" Padding="2,6" Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Perp.MarkPriceLabel}" Foreground="#a855f7" FontWeight="Bold" FontSize="16" />
                    <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                      <TextBlock Text="Funding" Foreground="{DynamicResource TextDim}" FontSize="9" HorizontalAlignment="Right" />
                      <TextBlock Classes="TdNum" Text="{Binding DexDeskVM.Perp.FundingRateLabel}" Foreground="{Binding DexDeskVM.Perp.FundingBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding DexDeskVM.Perp.BidLevels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DexPerpBookRowViewModel">
                      <Grid Height="15">
                        <Rectangle Fill="{Binding DepthBrush}" Width="{Binding DepthWidth}" HorizontalAlignment="Left" />
                        <Grid ColumnDefinitions="1*,1*,1.1*">
                          <TextBlock Classes="TdNum" Text="{Binding CumulativeLabel}" Foreground="#4a6070" FontSize="10" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding SizeLabel}" Foreground="#8fa3b8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding PriceLabel}" Foreground="{Binding PriceBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- ── SWAP: token search + honeypot verdict + list ── -->
              <StackPanel Spacing="10" IsVisible="{Binding DexDeskVM.IsSwapMode}">
                <TextBox Text="{Binding DexTradingVM.SearchText}" PlaceholderText="Search by symbol, name or address" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Content="SEARCH"  Classes="TdSeg dex" Command="{Binding DexTradingVM.SearchCommand}" />
                  <Button Grid.Column="1" Content="🔥 TREND" Classes="TdSeg dex" Command="{Binding DexTradingVM.LoadTrendingCommand}" Classes.active="{Binding DexTradingVM.IsTrendingMode}" />
                  <Button Grid.Column="2" Content="REFRESH" Classes="TdSeg" Command="{Binding DexTradingVM.RefreshCommand}" />
                </Grid>

                <Button Content="★ WATCH SELECTED" Classes="TdSeg dex" HorizontalAlignment="Stretch"
                        Classes.active="{Binding DexTradingVM.IsSelectedWatched}" Command="{Binding DexTradingVM.ToggleWatchlistCommand}"
                        IsEnabled="{Binding DexTradingVM.HasSelectedToken}" />

                <StackPanel Spacing="4" IsVisible="{Binding DexTradingVM.HasWatchlist}">
                  <TextBlock Classes="TdLabel" Text="★ WATCHLIST" />
                  <ItemsControl ItemsSource="{Binding DexTradingVM.WatchlistItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DexWatchItemViewModel">
                        <Border Classes="TdCardTight" Margin="0,0,0,4">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <Button Grid.Column="0" Content="{Binding Symbol}" Classes="TdSeg dex" FontSize="10" Padding="8,3" HorizontalAlignment="Left"
                                    Command="{Binding $parent[ItemsControl].DataContext.DexTradingVM.OpenWatchlistCommand}" CommandParameter="{Binding TokenAddress}" />
                            <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding PriceLabel}" Foreground="#c8dcef" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="TdNum" Text="{Binding ChangeLabel}" Foreground="{Binding ChangeBrush}" FontSize="9" VerticalAlignment="Center" Margin="4,0" />
                            <Button Grid.Column="3" Content="✕" Classes="TdSeg mini" Command="{Binding $parent[ItemsControl].DataContext.DexTradingVM.RemoveWatchlistCommand}" CommandParameter="{Binding TokenAddress}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Classes="TdLabel" Text="CHAIN" />
                    <ComboBox ItemsSource="{Binding DexTradingVM.ChainFilterOptions}" SelectedItem="{Binding DexTradingVM.SelectedChainFilter}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                    <TextBlock Classes="TdLabel" Text="SORT" />
                    <ComboBox ItemsSource="{Binding DexTradingVM.SortModeOptions}" SelectedItem="{Binding DexTradingVM.SelectedSortMode}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                    <TextBlock Classes="TdLabel" Text="MIN LIQ" />
                    <ComboBox ItemsSource="{Binding DexTradingVM.MinLiquidityOptions}" SelectedItem="{Binding DexTradingVM.SelectedMinLiquidity}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <TextBlock Classes="TdLabel" Text="MIN VOL" />
                    <ComboBox ItemsSource="{Binding DexTradingVM.MinVolumeOptions}" SelectedItem="{Binding DexTradingVM.SelectedMinVolume}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Grid>
                <Border Classes="TdCard" IsVisible="{Binding DexTradingVM.HasSelectedToken}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <Border Grid.Column="0" Background="{Binding DexTradingVM.TokenVerdict.AccentHex}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DexTradingVM.TokenVerdict.Badge}" Foreground="White" FontWeight="Bold" FontSize="12" />
                      </Border>
                      <!-- Nested grid so the scanning hint gets its own cell: both are visible at
                           once (IsScanning is true while the previous verdict still shows), and two
                           siblings in one cell overlap on a narrow panel instead of sharing it. -->
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="TdSub" Text="{Binding DexTradingVM.TokenVerdict.ScoreLabel, StringFormat=risk {0}}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="TdSub" FontSize="10"
                                   Text="scanning…" IsVisible="{Binding DexTradingVM.TokenVerdict.IsScanning}" />
                      </Grid>
                      <Button Grid.Column="2" Content="Deep scan" Classes="TdSeg dex" FontSize="11" Padding="8,3"
                              Command="{Binding DexTradingVM.DeepScanTokenCommand}" IsEnabled="{Binding !DexTradingVM.TokenVerdict.DeepScanBusy}" />
                    </Grid>
                    <TextBlock Text="{Binding DexTradingVM.TokenVerdict.RedFlagsText}" Foreground="#c8dcef" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Classes="TdSub" Text="{Binding DexTradingVM.TokenVerdict.Reason}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DexTradingVM.TokenVerdict.SourceLabel}" Foreground="{Binding DexTradingVM.TokenVerdict.SourceHex}"
                               FontSize="9" FontWeight="Bold" IsVisible="{Binding DexTradingVM.TokenVerdict.HasSourceLabel}" />
                    <TextBlock Text="{Binding DexTradingVM.TokenVerdict.DeepScanNote}" Foreground="#f4b860" FontSize="10" TextWrapping="Wrap"
                               IsVisible="{Binding DexTradingVM.TokenVerdict.HasDeepScanNote}" />
                  </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding DexTradingVM.Tokens}" SelectedItem="{Binding DexTradingVM.SelectedToken}" MaxHeight="360">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DexTokenItemViewModel">
                      <Border Classes="TdCardTight" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                          <TextBlock Grid.Row="0" Text="{Binding DisplayName}" Foreground="#c8dcef" FontWeight="Bold" />
                          <TextBlock Grid.Row="0" Grid.Column="1" Classes="TdNum" Text="{Binding PriceUsd, StringFormat=\$ {0:N6}}" Foreground="#a855f7" />
                          <TextBlock Grid.Row="1" Classes="TdSub" Text="{Binding PairLabel}" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Classes="TdNum" Text="{Binding Volume24h, StringFormat=Vol \$ {0:N0}}" Foreground="{DynamicResource TextSoft}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>

              <!-- ── Risk + Wallets row ── -->
              <Border Background="#040b12" BorderBrush="#0d1b27" BorderThickness="1" CornerRadius="8">
                <Grid ColumnDefinitions="*,1,*">
                  <StackPanel Grid.Column="0" Margin="10,8" Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="TdLabel" Text="RISK" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding WalletVM.GlobalPositionSizingPercent, StringFormat={}{0:0}%}" Foreground="#f4b860" FontWeight="Bold" FontSize="9" />
                    </Grid>
                    <Border Height="6" Background="#0d1b27" CornerRadius="3">
                      <Border Background="#f4b860" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding WalletVM.GlobalPositionSizingPercent}" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Max DD" Foreground="{DynamicResource TextDim}" FontSize="9" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding WalletVM.GlobalRiskCapLabel}" Foreground="#f4b860" FontSize="9" />
                    </Grid>
                  </StackPanel>
                  <Border Grid.Column="1" Background="#0d1b27" />
                  <StackPanel Grid.Column="2" Margin="10,8" Spacing="4">
                    <TextBlock Classes="TdLabel" Text="WALLETS" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                      <Ellipse Width="5" Height="5" Fill="#21e6c1" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="TdNum" Text="{Binding DexTradingVM.WalletBalanceSummary}" Foreground="#c8dcef" FontWeight="Bold" FontSize="10" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Classes="TdSub" Text="{Binding DexTradingVM.SelectedQuoteAssetSymbol, StringFormat=Quote: {0}}" FontSize="9" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- AI Trade Assistant (both modes) -->
              <views:AiTradeAssistantView DataContext="{Binding DexDeskVM.Assistant}" />
            </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>

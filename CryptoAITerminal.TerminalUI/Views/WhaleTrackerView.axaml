<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CryptoAITerminal.TerminalUI.ViewModels"
             xmlns:ctrl="clr-namespace:CryptoAITerminal.TerminalUI.Controls"
             xmlns:wt="clr-namespace:CryptoAITerminal.WhaleTracker.Models;assembly=CryptoAITerminal.WhaleTracker"
             x:Class="CryptoAITerminal.TerminalUI.Views.WhaleTrackerView"
             x:DataType="vm:WhaleTrackerViewModel"
             x:CompileBindings="True">
          <StackPanel Spacing="16">

            <!-- Header stats + controls -->
            <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="SurfaceCard">
                <StackPanel Spacing="4">
                  <TextBlock Classes="Overline" Text="Min Transfer" />
                  <TextBlock Text="{Binding MinUsdValue, StringFormat='${0:N0}'}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsTitle}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="SurfaceCard">
                <StackPanel Spacing="4">
                  <TextBlock Classes="Overline" Text="Alerts Captured" />
                  <TextBlock Text="{Binding TotalAlertsCount}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsTitle}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="SurfaceCard">
                <StackPanel Spacing="4">
                  <TextBlock Classes="Overline" Text="Labeled Wallet Alerts" />
                  <TextBlock Text="{Binding LabeledAlertsCount}" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsTitle}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Button Grid.Column="3" Classes="BuyButton" Command="{Binding StartCommand}" Width="110" IsVisible="{Binding !IsTracking}">Start Tracking</Button>
              <Button Grid.Column="4" Classes="SellButton" Command="{Binding StopCommand}" Width="110" IsVisible="{Binding IsTracking}">Stop Tracking</Button>
            </Grid>

            <!-- Status bar. Grid, not a horizontal StackPanel: HorizontalAlignment="Right" is a
                 no-op inside one, so Clear used to sit glued to the API-key hint mid-panel. -->
            <Border Classes="Panel" Padding="12,8">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">
                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding IsTracking, Converter={StaticResource BoolToColorConverter}}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding KnownWalletCount, StringFormat='{}Polling ETH · BSC · Solana  ·  {0} known wallets tracked'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="·  ETHERSCAN_API_KEY / BSCSCAN_API_KEY env vars for higher rate limits" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="3" Classes="LinkButton" Command="{Binding ClearCommand}" HorizontalAlignment="Right">Clear</Button>
              </Grid>
            </Border>

            <!-- ── AI Flow Insight (#6) ── -->
            <Border Classes="Panel" Padding="14,12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="🧠 AI Flow Insight" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FsBody}" />
                    <TextBlock Text="Accumulation or distribution? AI reads recent whale flows."
                               Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" />
                  </StackPanel>
                  <!-- Подпись «чем отвечено» рисует карточка ниже, рядом с самим ответом. -->
                  <Button Grid.Column="2" Content="Analyze with AI"
                          Command="{Binding AnalyzeWithAiCommand}"
                          IsEnabled="{Binding !InsightRunning}" Foreground="{DynamicResource Accent}" />
                </Grid>
                <!-- Общая карточка вердикта: плашка сигнала, доводы строками, отдельная полоса,
                     когда ответ собран без модели. Видимостью управляет сама. -->
                <ctrl:AiVerdictCard DataContext="{Binding InsightVerdict}" />
              </StackPanel>
            </Border>

            <!-- Main split: alerts list + known wallets sidebar -->
            <Grid ColumnDefinitions="*,280" ColumnSpacing="16">

              <!-- Alerts feed -->
              <Border Grid.Column="0" Classes="Panel" Padding="0">
                <StackPanel>
                  <Border Padding="16,12" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
                    <TextBlock Classes="H2" Text="Live Whale Alerts" />
                  </Border>
                  <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecentAlerts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WhaleAlertViewModel">
                          <Border Padding="16,10" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">

                              <!-- Chain badge -->
                              <Border Grid.Column="0" CornerRadius="3" Padding="4,2" Background="{DynamicResource Surface3}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ChainBadge}" Foreground="{Binding ChainBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                              </Border>

                              <!-- Alert type -->
                              <Border Grid.Column="1" CornerRadius="3" Padding="4,2" Background="{DynamicResource Surface3}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AlertBadge}" Foreground="{Binding AlertBrush, Converter={StaticResource StringToBrush}}" FontSize="{DynamicResource FsMicro}" FontWeight="Bold" />
                              </Border>

                              <!-- Main info -->
                              <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding AmountLabel}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding TokenSymbol}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsSmall}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FsCaption}" />
                                <TextBlock Text="{Binding ActiveWalletLabel}" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource FsCaption}" IsVisible="{Binding HasLabel}" />
                              </StackPanel>

                              <!-- Time -->
                              <TextBlock Grid.Column="3" Text="{Binding TimeLabel}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />

                              <!-- 1h price trend (Alchemy-enriched, appears asynchronously) -->
                              <Border Grid.Column="4" CornerRadius="3" Padding="6,2"
                                      Background="{DynamicResource Surface3}" VerticalAlignment="Center"
                                      IsVisible="{Binding HasPriceTrend}">
                                <TextBlock Text="{Binding PriceTrendLabel}"
                                           Foreground="{Binding PriceTrendBrush, Converter={StaticResource StringToBrush}}"
                                           FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" />
                              </Border>

                              <!-- Snipe button -->
                              <Button Grid.Column="5" Classes="BuyButton" Command="{Binding SniperBuyCommand}"
                                      IsVisible="{Binding CanSnipe}" Padding="8,4" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center">
                                ⚡ Snipe
                              </Button>

                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <TextBlock Text="No whale alerts yet. Press Start Tracking — transfers above the minimum land here."
                             IsVisible="{Binding !RecentAlerts.Count}"
                             Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsSmall}"
                             HorizontalAlignment="Center" TextWrapping="Wrap" Margin="16,24" />
                </StackPanel>
              </Border>

              <!-- Known wallets sidebar -->
              <StackPanel Grid.Column="1" Spacing="12">
                <Border Classes="Panel" Padding="0">
                  <StackPanel>
                    <Border Padding="14,10" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="H2" Text="Tracked Wallets" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding KnownWalletCount}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding KnownWallets}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="wt:LabeledWallet">
                            <Border Padding="14,8" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Border Grid.Column="0" CornerRadius="3" Padding="4,2" Background="{DynamicResource Surface3}" VerticalAlignment="Top">
                                  <TextBlock Text="{Binding Chain}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource TextMuted}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1">
                                  <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FsSmall}" />
                                  <TextBlock Text="{Binding Category}" Foreground="#4D7EA8" FontSize="{DynamicResource FsMicro}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>

                <!-- API keys note -->
                <Border Classes="Panel">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="H2" Text="API Keys" />
                    <TextBlock Text="ETHERSCAN_API_KEY" Foreground="{DynamicResource Accent}" FontFamily="Consolas" FontSize="{DynamicResource FsCaption}" />
                    <TextBlock Text="BSCSCAN_API_KEY" Foreground="{DynamicResource Accent}" FontFamily="Consolas" FontSize="{DynamicResource FsCaption}" />
                    <TextBlock Text="Free keys increase rate limits from 1 req/5s to 5 req/s. Solscan uses public API." Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>

            </Grid>
          </StackPanel>
</UserControl>
